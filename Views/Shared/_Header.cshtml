<header id="mainHeader" class="header-utama">
    <div class="d-flex justify-content-between align-items-end" 
         style="padding: 15px 30px;">

        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none">
            <div class="d-flex flex-column">
                <img src="~/img/logo-pertaminaa.png" alt="Pertamina" style="height: 40px; width: auto; align-self: flex-start; margin-bottom: 2px;" />
                <span style="color: #E31B23; font-size: 0.9rem; font-weight: 500; letter-spacing: 0.5px;">
                    Semangat Terbarukan
                </span>
            </div>
        </a>

        <div class="d-flex flex-column align-items-end">
            <img src="~/img/logo-sinta.png" alt="Sinta" style="height: 50px; width: auto; margin-bottom: 2px;" />
        </div>

    </div>

    <div class="header-red-bar"></div>
</header>

<script>
    // Tunggu halaman siap
    document.addEventListener("DOMContentLoaded", function() {
        var header = document.getElementById("mainHeader");

        // Fungsi saat di-scroll
        window.onscroll = function() {
            // Jika scroll lebih dari 50px ke bawah
            if (window.scrollY > 50) {
                header.classList.add("scrolled");
            } else {
                // Jika kembali ke paling atas
                header.classList.remove("scrolled");
            }
        };
    });
</script>