                    <div class="modal-header-premium">
                        <div class="header-flex-container">
                            <img id="d-foto" src="/img/default-user.png" class="profile-circle-frame" 
                                title="Klik untuk lihat foto asli" onclick="window.open(this.src, '_blank')">
                            <div class="header-text-info">
                                <div id="d-status-badge-container"></div>
                                <h2 id="d-nama" class="mb-1 fw-bold"></h2>
                                <span class="opacity-75 small">
                                    <i class="fas fa-clock me-1"></i> Terdaftar: <span id="d-created-at"></span>
                                </span>
