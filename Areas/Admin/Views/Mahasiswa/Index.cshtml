<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // ── State filter masing-masing tab terpisah ───────────────────────────────
    let magStatusFilter = 'all';
    let penStatusFilter = 'all';

    // ── Tab Switch ────────────────────────────────────────────────────────────
    function switchTab(tab, btn) {
        if (btn.classList.contains('active')) return;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        document.getElementById('tab-' + tab).classList.add('active');
    }

    // ── Filter Status (magang & penelitian terpisah) ──────────────────────────
    function filterByStatus(scope, status, cardId) {
        // Hanya reset card dalam scope yang sama
        const prefix = scope === 'magang' ? 'mag-card' : 'pen-card';
        document.querySelectorAll(`[id^="${prefix}"]`).forEach(c => c.classList.remove('active'));
        document.getElementById(cardId).classList.add('active');

        if (scope === 'magang') {
            magStatusFilter = status;
            applyMagangFilter();
        } else {
            penStatusFilter = status;
            applyPenelitianFilter();
        }
    }

    function applyMagangFilter() {
        const search = $("#tableSearch").val().toLowerCase();
        $(".magang-row").each(function () {
            const matchStatus = magStatusFilter === 'all' || $(this).attr('data-status') === magStatusFilter;
            const matchSearch = $(this).text().toLowerCase().indexOf(search) > -1;
            $(this).toggle(matchStatus && matchSearch);
        });
    }

    function applyPenelitianFilter() {
        const search = $("#penTableSearch").val().toLowerCase();
        $(".penelitian-row").each(function () {
            const matchStatus = penStatusFilter === 'all' || $(this).attr('data-status') === penStatusFilter;
            const matchSearch = $(this).text().toLowerCase().indexOf(search) > -1;
            $(this).toggle(matchStatus && matchSearch);
        });
    }

    $("#tableSearch").on("keyup",    function() { applyMagangFilter(); });
    $("#penTableSearch").on("keyup", function() { applyPenelitianFilter(); });

    // ── Region ────────────────────────────────────────────────────────────────
    function changeRegion(region) {
        Swal.fire({ title: 'Memproses...', text: 'Mengambil data region ' + (region === 'all' ? 'Semua' : region), allowOutsideClick: false, didOpen: () => Swal.showLoading() });
        window.location.href = `/Admin/Mahasiswa/Index?selectedRegion=${encodeURIComponent(region)}`;
    }

    // ── Show Detail Magang ────────────────────────────────────────────────────
    function showDetailMagang(data) {
        $("#d-id").val(data.Id || data.id);
        $("#d-nama").text(data.NamaLengkap || data.namaLengkap);
        $("#d-noreg").text(data.NoPendaftaran || data.noPendaftaran || "BELUM TERSEDIA");

        const createdAt = data.CreatedAt || data.createdAt;
        if (createdAt) {
            const dt = new Date(createdAt);
            $("#d-created-at").text(dt.toLocaleDateString('id-ID', {day:'2-digit',month:'long',year:'numeric'}) + ' | ' + dt.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'}) + ' WIB');
        }

        const st = data.Status || data.status;
        $("#d-status-badge-container").html(`<span class="status-pill-modal status-${st}">${st}</span>`);
        if (st === "Menunggu" && "@adminRole" !== "SuperAdmin") { $("#mag-action-area").show(); } else { $("#mag-action-area").hide(); }

        const pf = data.FotoProfil || data.fotoProfil;
        const finalFoto = pf ? "/uploads/foto/" + pf.split('/').pop() : "/img/default-user.png";
        $("#d-foto").attr("src", finalFoto);
        $("#d-foto-link").attr("href", finalFoto);

        $("#d-email").text(data.EmailPribadi || data.emailPribadi || "-");
        const rawHp = data.NoHp || data.noHp || "";
        let cleanHp = rawHp.replace(/\D/g,'');
        if (cleanHp.startsWith('0')) cleanHp = '62' + cleanHp.slice(1);
        $("#d-hp").text(rawHp || "-");
        $("#d-hp-link").attr("href", cleanHp ? `https://wa.me/${cleanHp}` : "#");
        $("#d-ttl").text(`${data.TempatLahir||data.tempatLahir||"-"}, ${formatDate(data.TanggalLahir||data.tanggalLahir)}`);
        $("#d-ig-text").text((data.Instagram||data.instagram||"").replace(/@@/g,'').trim() || "-");

        $("#d-univ").text(data.NamaPerguruanTinggi||data.namaPerguruanTinggi||"-");
        $("#d-nim").text(data.NIM||data.nim||"-");
        $("#d-fakultas").text(data.Fakultas||data.fakultas||"-");
        $("#d-jurusan").text(data.Jurusan||data.jurusan||"-");
        $("#d-company-region").text(`${data.Company||data.company||"-"} - ${data.Region||data.region||"-"}`);
        $("#d-lokasi").text(data.Lokasi||data.lokasi||"-");
        $("#d-periode").text(formatDate(data.MulaiMagang||data.mulaiMagang) + " - " + formatDate(data.SelesaiMagang||data.selesaiMagang));

        const rekom = data.RekomendasiPegawai||data.rekomendasiPegawai;
        $("#d-rekomendasi").text(rekom && rekom !== "-" ? rekom : "Tidak ada rekomendasi pegawai.");

        $("#link-cv").attr("href","/uploads/cv/"+(data.FileCv||data.fileCv||"").split('/').pop());
        $("#link-surat").attr("href","/uploads/surat/"+(data.FileSuratPengantar||data.fileSuratPengantar||"").split('/').pop());
        $("#link-proposal").attr("href","/uploads/proposal/"+(data.FileProposal||data.fileProposal||"").split('/').pop());

        $("#modalDetailMagang").modal('show');
    }

    // ── Show Detail Penelitian ────────────────────────────────────────────────
    function showDetailPenelitian(data) {
        $("#p-id").val(data.Id);
        $("#p-nama").text(data.Nama || "-");
        $("#p-noreg").text(data.NomorPendaftaran || "BELUM TERSEDIA");

        const createdAt = data.CreatedAt;
        if (createdAt) {
            const dt = new Date(createdAt);
            $("#p-created-at").text(
                dt.toLocaleDateString('id-ID', {day:'2-digit',month:'long',year:'numeric'}) +
                ' | ' +
                dt.toLocaleTimeString('id-ID', {hour:'2-digit',minute:'2-digit'}) +
                ' WIB'
            );
        }

        const st = data.Status;
        $("#p-status-badge-container").html(`<span class="status-pill-modal status-${st}">${st}</span>`);
        if (st === "Menunggu" && "@adminRole" !== "SuperAdmin") {
            $("#pen-action-area").show();
        } else {
            $("#pen-action-area").hide();
        }

        const pf = data.PathFoto3x4;
        const finalFoto = pf ? "/uploads/foto/" + pf.split('/').pop() : "/img/default-user.png";
        $("#p-foto").attr("src", finalFoto);
        $("#p-foto-link").attr("href", finalFoto);

        $("#p-email").text(data.Email || "-");
        const rawHp = data.NoHp || "";
        let cleanHp = rawHp.replace(/\D/g, '');
        if (cleanHp.startsWith('0')) cleanHp = '62' + cleanHp.slice(1);
        $("#p-hp").text(rawHp || "-");
        $("#p-hp-link").attr("href", cleanHp ? `https://wa.me/${cleanHp}` : "#");
        $("#p-ttl").text(`${data.TempatLahir || "-"}, ${formatDate(data.TglLahir)}`);
        $("#p-ig-text").text((data.Instagram || "").replace(/@@/g, '').trim() || "-");

        $("#p-univ").text(data.Universitas || "-");
        $("#p-nim").text(data.Nim || "-");
        $("#p-fakultas").text(data.Fakultas || "-");
        $("#p-jurusan").text(data.Jurusan || "-");
        $("#p-judul").text(data.JudulPenelitian || "-");
        $("#p-company-region").text(`${data.Company || "-"} - ${data.Region || "-"}`);
        $("#p-lokasi").text(data.LokasiPenelitian || "-");
        $("#p-periode").text(formatDate(data.TglMulai) + " - " + formatDate(data.TglSelesai));

        $("#p-link-cv").attr("href", "/uploads/cv/" + (data.PathCV || "").split('/').pop());
        $("#p-link-surat").attr("href", "/uploads/surat/" + (data.PathSurat || "").split('/').pop());
        $("#p-link-proposal").attr("href", "/uploads/proposal/" + (data.PathProposal || "").split('/').pop());

        $("#modalDetailPenelitian").modal('show');
    }

    // ── Update Status ─────────────────────────────────────────────────────────
    function updateStatus(scope, s) {
        const isMag  = scope === 'magang';
        const id     = isMag ? $("#d-id").val() : $("#p-id").val();
        const rowSel = isMag ? `#mag-row-${id}` : `#pen-row-${id}`;
        const oldSt  = $(rowSel).attr("data-status");

        Swal.fire({
            title: 'Konfirmasi', text: `Ubah status menjadi ${s}?`, icon: 'question',
            showCancelButton: true,
            confirmButtonColor: s === 'Diterima' ? (isMag ? '#00549B' : '#7C3AED') : '#EC1C24',
            confirmButtonText: 'Ya, Simpan', cancelButtonText: 'Batal'
        }).then(result => {
            if (!result.isConfirmed) return;

            $(rowSel).attr("data-status", s).removeClass("unread");
            $(rowSel).find(".badge-status").attr("class", `badge-status status-${s}`).text(s);

            if (isMag) {
                $("#d-status-badge-container").html(`<span class="status-pill-modal status-${s}">${s}</span>`);
                $("#mag-action-area").hide();
                if (oldSt !== s) { updateCount('mag', oldSt, -1); updateCount('mag', s, 1); }
                $("#modalDetailMagang").modal('hide');
                $.post("/Admin/Mahasiswa/UpdateStatus", { id, status: s }, res => {
                    if (!res.success) Swal.fire('Error', res.message||'Gagal update.', 'error').then(() => location.reload());
                    else Swal.fire('Berhasil!', res.message, 'success');
                });
            } else {
                $("#p-status-badge-container").html(`<span class="status-pill-modal status-${s}">${s}</span>`);
                $("#pen-action-area").hide();
                if (oldSt !== s) { updateCount('pen', oldSt, -1); updateCount('pen', s, 1); }
                $("#modalDetailPenelitian").modal('hide');
                $.post("/Admin/Mahasiswa/UpdateStatusPenelitian", { id, status: s }, res => {

                    if (!res.success) Swal.fire('Error', res.message||'Gagal update.', 'error').then(() => location.reload());
                    else Swal.fire('Berhasil!', res.message, 'success');
                });
            }
        });
    }

    function updateCount(prefix, status, change) {
        const map = { Menunggu: `#${prefix}-val-proses`, Diterima: `#${prefix}-val-terima`, Ditolak: `#${prefix}-val-tolak` };
        if (map[status]) { const el = $(map[status]); el.text(Math.max(0, (parseInt(el.text())||0) + change)); }
    }

    // ── Export Excel ──────────────────────────────────────────────────────────
    function exportExcel() {
        const isMag = document.getElementById('tab-magang').classList.contains('active');

        if (isMag) {
            const rawData = @Html.Raw(JsonSerializer.Serialize(daftarMagang));
            if (!rawData || rawData.length === 0) {
                Swal.fire('Info', 'Tidak ada data magang.', 'info');
                return;
            }

            const excelData = rawData.map((item, i) => ({
                "No": i + 1,
                "Tanggal Daftar": item.CreatedAt ? new Date(item.CreatedAt).toLocaleDateString('id-ID') : "-",
                "NIM": item.NIM || item.nim || "-",
                "Nama Lengkap": item.NamaLengkap || item.namaLengkap || "-",
                "Email": item.EmailPribadi || item.emailPribadi || "-",
                "No. HP": item.NoHp || item.noHp || "-",
                "Perguruan Tinggi": item.NamaPerguruanTinggi || item.namaPerguruanTinggi || "-",
                "Fakultas": item.Fakultas || item.fakultas || "-",
                "Jurusan": item.Jurusan || item.jurusan || "-",
                "Company": item.Company || item.company || "-",
                "Region": item.Region || item.region || "-",
                "Lokasi": item.Lokasi || item.lokasi || "-",
                "Mulai Magang": item.MulaiMagang ? new Date(item.MulaiMagang).toLocaleDateString('id-ID') : "-",
                "Selesai Magang": item.SelesaiMagang ? new Date(item.SelesaiMagang).toLocaleDateString('id-ID') : "-",
                "Status": item.Status || item.status || "-"
            }));

            const ws = XLSX.utils.json_to_sheet(excelData);

            // === Styling header biru ===
            const headerKeys = Object.keys(excelData[0]);
            headerKeys.forEach((_, colIdx) => {
                const cellAddr = XLSX.utils.encode_cell({ r: 0, c: colIdx });
                if (!ws[cellAddr]) return;
                ws[cellAddr].s = {
                    font: { bold: true, color: { rgb: "FFFFFF" } },
                    fill: { fgColor: { rgb: "00549B" } },
                    alignment: { horizontal: "center", vertical: "center" }
                };
            });

            // Set lebar kolom otomatis
            ws['!cols'] = headerKeys.map(key => ({ wch: Math.max(key.length + 2, 14) }));

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Data Magang");
            XLSX.writeFile(wb, `Data_Magang_SINTA_@(displayRegion.Replace(" ","_")).xlsx`);

        } else {
            const rawData = @Html.Raw(JsonSerializer.Serialize(daftarPenelitian));
            if (!rawData || rawData.length === 0) {
                Swal.fire('Info', 'Tidak ada data penelitian.', 'info');
                return;
            }

            const excelData = rawData.map((item, i) => ({
                "No": i + 1,
                "Tanggal Daftar": item.CreatedAt ? new Date(item.CreatedAt).toLocaleDateString('id-ID') : "-",
                "NIM": item.Nim || item.nim || item.NIM || "-",
                "Nama": item.Nama || item.nama || "-",
                "Email": item.Email || item.email || "-",
                "No. HP": item.NoHp || item.noHp || "-",
                "Universitas": item.Universitas || item.universitas || "-",
                "Fakultas": item.Fakultas || item.fakultas || "-",
                "Jurusan": item.Jurusan || item.jurusan || "-",
                "Judul Penelitian": item.JudulPenelitian || item.judulPenelitian || "-",
                "Lokasi Penelitian": item.LokasiPenelitian || item.lokasiPenelitian || "-",
                "Region": item.Region || item.region || "-",
                "Mulai": item.TglMulai ? new Date(item.TglMulai).toLocaleDateString('id-ID') : "-",
                "Selesai": item.TglSelesai ? new Date(item.TglSelesai).toLocaleDateString('id-ID') : "-",
                "Status": item.Status || item.status || "-"
            }));

            const ws = XLSX.utils.json_to_sheet(excelData);

            // === Styling header biru ===
            const headerKeys = Object.keys(excelData[0]);
            headerKeys.forEach((_, colIdx) => {
                const cellAddr = XLSX.utils.encode_cell({ r: 0, c: colIdx });
                if (!ws[cellAddr]) return;
                ws[cellAddr].s = {
                    font: { bold: true, color: { rgb: "FFFFFF" } },
                    fill: { fgColor: { rgb: "00549B" } },
                    alignment: { horizontal: "center", vertical: "center" }
                };
            });

            ws['!cols'] = headerKeys.map(key => ({ wch: Math.max(key.length + 2, 16) }));

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Data Penelitian");
            XLSX.writeFile(wb, `Data_Penelitian_SINTA_@(displayRegion.Replace(" ","_")).xlsx`);
        }
    }

    function formatDate(d) {
        if (!d) return "-";
        return new Date(d).toLocaleDateString('id-ID', {day:'2-digit',month:'long',year:'numeric'});
    }
</script>
