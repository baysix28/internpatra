            text-transform: uppercase; /* Wajib kapital semua biar gagah */
            letter-spacing: 1px;    /* Tambah spasi antar huruf dikit */
            
            opacity: 0;
            transform: translateY(-40px);
        }

        .hero-lead {
            font-family: 'Inter', sans-serif;
            font-size: 1.1rem;
            font-weight: 400;
            letter-spacing: 0.5px;
            color: #e0e0e0;
            
            /* --- PERBAIKAN DI SINI (KITA RAPATKAN) --- */
            margin-bottom: 15px !important; /* Jarak ke tombol cuma 15px (Deket banget) */
            margin-top: 0 !important;
            /* ---------------------------------------- */
            
            opacity: 0;
            transform: translateY(-40px);
        }

     /* 5. TOMBOL PREMIUM (ANIMASI FILL KIRI KE KANAN) */
    .btn-apply-hero {
        position: relative; /* Wajib: sebagai jangkar animasi */
        overflow: hidden;   /* Wajib: biar warna tidak bocor keluar sudut melengkung */
        z-index: 1;         /* Pastikan teks ada di layer paling atas */
        
        background-color: transparent; 
        border: 2px solid white;
        
        color: white;
        padding: 14px 35px;;
        
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 50px !important;
        text-decoration: none;
        
        /* Transisi warna teks biar halus saat background jadi putih */
        transition: color 0.4s ease; 
        
        display: inline-block;
        margin-top: 5px; /* Jarak dari teks di atasnya */
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);

        opacity: 0;                   
        transform: translateY(-40px);
        }

        /* --- BAGIAN INI WAJIB ADA (JANGAN LUPA) --- */
    
        /* Saat class ini ditempel sama JS, baru elemennya muncul */
        .animasi-aktif {
            animation: turunCantik 0.8s ease-out forwards;
        }
        
        /* Delay biar munculnya antri (Judul -> Teks -> Tombol) */
        .hero-lead.animasi-aktif {
            animation-delay: 0.3s;
        }
        .btn-apply-hero.animasi-aktif {
            animation-delay: 0.6s;
        }

        /* Definisi Gerakannya */
        @@keyframes turunCantik {
            0% { opacity: 0; transform: translateY(-40px); }
            100% { opacity: 1; transform: translateY(0); }
        }

   /* TOMBOL HERO PROFESSIONAL (GLASS + ANIMASI FILL) */
    .btn-apply-hero {
        position: relative;
        overflow: hidden; /* Wajib biar animasi putih gak bocor */
        z-index: 1;
        
        /* 1. TYPOGRAPHY BARU */
        font-family: 'Inter', sans-serif; /* Ganti ke Inter biar clean */
        font-weight: 700;                 /* SemiBold (Tegas) */
        font-size: 0.9rem;                /* Ukuran sedikit dikecilkan biar elegan */
        letter-spacing: 2px;              /* JARAK ANTAR HURUF (Kunci tampilan mewah) */
        text-transform: uppercase;
        text-decoration: none;
        
        /* 2. WARNA & EFEK KACA */
        color: #ffffff;
        border: 2px solid rgba(255, 255, 255, 0.6); /* Border putih agak transparan */
        background-color: rgba(0, 0, 0, 0.5);       /* Latar hitam transparan TIPIS banget */
        backdrop-filter: blur(4px);                 /* Efek BLUR di belakang tombol (Biar teks kebaca) */
        
        /* 3. DIMENSI */
        padding: 18px 45px;
        border-radius: 50px !important;
        display: inline-block;
        margin-top: 0px;
        
        /* Animasi Transisi */
        transition: all 0.4s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);

        /* State Awal Animasi Muncul */
        opacity: 0;                   
        transform: translateY(-40px);
    }

    /* KEADAAN HOVER (SAAT KURSOR MASUK) */
    .btn-apply-hero:hover {
        color: #003B76;       /* Teks berubah jadi Biru Gelap biar kontras sama background putih */
        border-color: #ffffff;
        box-shadow: 0 10px 25px rgba(255, 255, 255, 0.2); /* Glow putih */
    }

    /* --- ANIMASI FILL PUTIH DARI KIRI KE KANAN (TETAP ADA) --- */
    .btn-apply-hero::before {
        content: "";
        position: absolute;
        top: 0; left: 0; width: 0%; height: 100%;
        background-color: #ffffff; /* Warna Fill Putih */
        z-index: -1;
        transition: width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); /* Gerakan smooth */
    }

    /* Pemicu Animasi */
    .btn-apply-hero:hover::before {
        width: 100%;
    }

    
    .hero-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        
        /* GANTI DENGAN GRADASI YANG LEBIH GELAP INI */
        background: linear-gradient(to right, 
            rgba(0, 0, 0, 0.85) 0%,      /* Hitam Pekat di Kiri */
            rgba(0, 0, 0, 0.6) 50%,      /* Agak Gelap di Tengah */
            rgba(0, 0, 0, 0.4) 100%      /* Sedikit terang di Kanan */
        );
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
        
        /* TAMBAHAN BARU: GESER KE ATAS SEDIKIT */
        padding-bottom: 180px; /* Memberi ruang di bawah, otomatis konten terdorong ke atas */
    }

    /* TYPOGRAPHY BARU */
    .badge-custom {
        background-color: #00A950;
        color: white; padding: 8px 20px; border-radius: 50px;
        text-transform: uppercase; font-weight: 700; font-size: 0.8rem;
        letter-spacing: 1px; margin-bottom: 20px; display: inline-block;
    }
    
    .hero-title { font-size: 4rem; font-weight: 700; margin-bottom: 10px; }
    .hero-lead { font-size: 1.2rem; font-weight: 400; margin-bottom: 15px; }

    /* LAYOUT UTAMA */
    .main-container {
        max-width: 100%;
        margin: 0 auto;
        
        /* Layout */
        margin-top: -60px !important;
        position: relative;
        z-index: 10;
        
        /* --- WARNA SOLID PREMIUM (Ice Blue) --- */
        background: #f1f5f9;  /* Solid, bukan gradasi, bukan pattern. */
        /* -------------------------------------- */

        /* Bentuk */
        border-radius: 50px 50px 0 0;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.05); /* Shadow halus */
        
        padding: 60px 40px 100px 40px;
        min-height: 80vh;
        
        /* --- ANIMASI AWAL (NGUMPET DI BAWAH) --- */
        opacity: 0;
        transform: translateY(100px); /* Turun 100px */
        
        /* Transisi Halus (1 detik) */
        transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* --- KELAS UNTUK MUNCUL --- */
    .main-container.muncul-container {
        opacity: 1;
        transform: translateY(0); /* Naik ke posisi normal */
    }

    /* Responsif HP (Tetap Aman) */
    @@media (max-width: 768px) {
        .main-container {
            margin-top: -50px !important;
            border-radius: 25px 25px 0 0;
            padding: 30px 20px;
        }
    }

        .job-board-layout { display: grid; grid-template-columns: 280px 1fr; gap: 50px; }


    /* COMPONENTS */
    .intro-header { display: flex; justify-content: space-between; margin-bottom: 30px; padding-bottom: 30px; border-bottom: 1px solid #eee; }
    .btn-apply {
        background-color: #00a048; color: white; padding: 10px 25px;
        border-radius: 50px; text-decoration: none; font-weight: 600; display: inline-block;
    }
    
        /* 1. PANEL FILTER UTAMA */
        /* UPDATE BAGIAN .filters BIAR GAK KEPANJANGAN */
    .filters {
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        padding: 30px;
        border: 1px solid #f1f5f9;
        
        /* --- INI SOLUSINYA --- */
        height: fit-content !important; /* Tinggi menyesuaikan isi, gak melar */
        align-self: start !important;   /* Grid jangan menarik dia ke bawah */
        /* -------------------- */

        /* Biar tetap nempel di atas pas discroll */
        position: -webkit-sticky;
        position: sticky; 
        top: 20px;
        z-index: 10;
    }

        /* 2. LABEL JUDUL KECIL */
        .filters label, 
        /* Tangkap juga div label manual yang ada di HTML Anda */
        .filters div[style*="font-size: 0.75rem"] { 
            font-family: 'Poppins', sans-serif !important; 
            font-size: 0.75rem !important; 
            font-weight: 700 !important;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #334155 !important; /* Abu tua (Slate) biar tajam */
            margin-bottom: 10px !important;
            display: block; 
        }
        
        /* 3. INPUT & SELECT (BENTUK KAPSUL MODERN) */
        .form-control-custom, 
        .form-control,
        select.form-control-custom,
        input#inputCari {
            width: 100%; 
            padding: 12px 20px;      /* Padding kiri-kanan lega */
            font-size: 0.9rem;
            
            /* KUNCI DESAIN MODERN: */
            border-radius: 10px !important;  /* Bentuk Kapsul/Pil */
            background-color: #f8fafc;       /* Abu sangat muda (bukan putih polos) */
            border: 1px solid #e2e8f0;       /* Border abu tipis */
            
            outline: none;
            color: #333;
            appearance: none; -webkit-appearance: none; -moz-appearance: none;
            transition: all 0.3s ease;
        }

        /* Efek saat diklik (Fokus) */
        .form-control-custom:focus, 
        .form-control:focus,
        input#inputCari:focus {
            background-color: #ffffff;       /* Jadi putih bersih */
            border-color: #00529C;           /* Border Biru Pertamina */
            box-shadow: 0 0 0 4px rgba(0, 82, 156, 0.1); /* Glow biru */
        }

        /* 4. KHUSUS SELECT (DROPDOWN PANAH) */
        select.form-control-custom {
            /* Icon Panah Merah (Bawaan Anda) */
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23d81c22' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat; 
            background-position: right 20px center; /* Geser panah agak ke kiri dikit */
            background-size: 16px; 
            padding-right: 45px; /* Beri ruang biar teks gak nabrak panah */
            cursor: pointer;
        }

        /* 5. KHUSUS INPUT SEARCH */
        input.form-control-custom, input#inputCari { 
            background-image: none !important; 
            padding-right: 45px; 
        }

        .search-wrapper { position: relative; }
        
        /* Icon Kaca Pembesar */
        .search-wrapper i { 
            position: absolute; 
            right: 20px;          /* Geser icon agak ke dalam karena sudutnya bulat */
            top: 50%; 
            transform: translateY(-50%); 
            color: #d81c22;       /* Merah Pertamina */
            pointer-events: none; 
            font-size: 0.9rem;
        }

        /* Responsif di HP */
        @@media (max-width: 768px) { 
            .job-board-layout { grid-template-columns: 1fr; } 
            .filters { position: relative; top: 0; } /* Gak usah sticky di HP */
        }


  
    /* =========================================
       1. STRUKTUR UTAMA KARTU (SUDAH DIPERBAIKI)
       ========================================= */
    /* PONDASI YANG DIHILANGKAN */
    .flip-card {
        background-color: transparent;
        width: 100%;
        height: 310px; /* Wajib ada tingginya */
        perspective: 1000px;
        cursor: pointer;
        margin-bottom: 25px;
    }

    /* MANTRA ANTI CERMIN & PENUMPUK KARTU */
    .flip-card-front, .flip-card-back {
        position: absolute !important; /* Wajib absolute biar numpuk */
        top: 0; left: 0; width: 100%; height: 100%;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden; 
    }
        
    .flip-card-front {
        /* 1. Background Gradasi Biru Gelap (Sesuai Gambar Referensi) */
        background: linear-gradient(135deg, #00529C 0%, #061f3d 100%);
        
        /* 2. Warna Teks Utama Putih */
        color: #ffffff !important;
        
        /* Layout */
        padding: 20px;
        padding-top: 35px; /* Tambah padding atas biar ga nabrak logo */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start !important;
        text-align: left !important;
        
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 20px rgba(0, 59, 118, 0.3);
        position: relative;
        overflow: hidden; /* Penting biar sudut tumpul */
    }

    .logo-corner {
        position: absolute;
        top: 0;
        right: 0;
        background-color: #ffffff; /* Latar putih */
        padding: 8px 15px 8px 20px;
        border-bottom-left-radius: 25px; /* Membuat lengkungan cantik */
        z-index: 10;
        box-shadow: -2px 2px 5px rgba(0,0,0,0.1);
    }

    .logo-corner img {
        height: 25px; /* Ukuran logo, sesuaikan jika terlalu besar/kecil */
        width: auto;
        display: block;
    }
        
    /* UPDATE WARNA TEKS BIAR PUTIH */
    .split-title {
        color: #ffffff !important;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }    

    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: left;
        transition: transform 0.8s;
        transform-style: preserve-3d;
    }

    .flip-card:hover .flip-card-inner {
        transform: rotateY(180deg);
    }

    /* Efek saat mouse diarahkan (Hover) */
    .flip-card:hover .flip-card-front {
        color: #00529C;      /* Border jadi Biru Pertamina */
        transform: translateY(-5px);  /* Naik sedikit */
        box-shadow: 0 12px 20px rgba(0, 82, 156, 0.1);
    }

    .flip-card-front hr {
        background-color: rgba(255, 255, 255, 0.3) !important;
    }


    /* 2. AREA ICON (ATAS) */
    /* UPDATE BAGIAN INI BIAR ICON TENGAH LAGI */
    .card-icon-area {
        width: 100% !important;
        margin-bottom: 10px;
        
        display: flex !important;
        
        /* GANTI 'flex-start' JADI 'center' */
        justify-content: center !important; 
        
        align-items: center !important;
        
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
    }

    .category-icon {
        margin-left: 0 !important; 
        margin-right: 0 !important; /* Jangan auto, nanti dia dorong elemen lain */
        
        width: 50px; /* Kecilkan dikit biar proporsional */
        height: 50px;
        object-fit: contain;
        filter: grayscale(100%);
    }

    /* 3. AREA DETAIL TEKS (BAWAH) */
    .card-detail-area {
        width: 100%;
        /* Hapus height % biar fleksibel */
        
        /* PENTING: Padding 0 supaya lurus vertikal dengan icon */
        padding: 0 !important; 
        
        display: flex;
        flex-direction: column;
        justify-content: flex-start !important;
        align-items: flex-start !important; /* Paksa Kiri */
        text-align: left !important;
    }

    /* JUDUL */
    /* 2. JUDUL (Ubah jadi Hitam/Biru Tua) */
    .split-title {
        /* Gunakan Inter, jika gagal pakai font bawaan sistem yang bersih (Arial/San Francisco) */
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif !important; 
        
        font-size: 1rem;       
        font-weight: 600;      
        line-height: 1.4;
        margin-bottom: 8px;
        
        color: #003B76;        /* Kembali ke warna Biru Gelap Profesional */
        text-align: left;
        width: 100%;
    }

    /* 3. INFO TAMBAHAN (Ubah jadi Abu-abu) */
    .split-info {
        font-size: 0.8rem;
        color: #64748b;        /* GANTI JADI ABU-ABU */
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        justify-content: flex-start !important; 
        gap: 8px;
        width: 100%;
        padding: 0 !important;
    }

    /* TEKS SINGKAT (Titik-titik...) */
    .split-info span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        display: block; /* Ganti inline-block jadi block biar manut width */
    }

    .card-icon-area, 
    .card-detail-area,
    .split-title, 
    .split-info {
        position: relative;
        z-index: 2; /* Harus lebih tinggi dari z-index watermark (0) */
    }

    /* =========================================
       3. TAMPILAN BELAKANG (TETAP SEPERTI LAMA)
       ========================================= */
    .flip-card-back {
        background-color: #ffffff;
        color: #333;
        transform: rotateY(180deg);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 20px;
        text-align: center;
        border: 1px solid #eee;
    }

    /* WATERMARK LOGO BELAKANG */
    .flip-card-back::after {
        content: "";
        position: absolute;
        
        /* Posisi: Tengah (Center) */
        top: 50%; 
        left: 50%; 
        transform: translate(-50%, -50%);
        
        /* Ukuran Logo (Lebih besar) */
        width: 60%; 
        height: 60%;
        
        /* GANTI PATH INI sesuai nama file logomu */
        /* background-image: url('/img/logoo.png'); */
        
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
        
        /* Transparansi */
        opacity: 0.50; 
        
        z-index: 0;
        pointer-events: none;
    }

    .back-title {
        color: #00529C;
        font-weight: 700;
        margin-bottom: 10px;
        font-size: 0.7rem;
        text-transform: uppercase;
        border-bottom: 2px solid #00529C;
        padding-bottom: 5px;
    }

    .back-desc {
        font-size: 0.85rem;
        color: #666;
        line-height: 1.5;
        margin-bottom: 15px;
        display: -webkit-box;
        -webkit-line-clamp:10; /* Limit teks deskripsi jadi 3 baris aja biar muat */
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-card-clean {
        background-color: #00529C;
        color: white;
        padding: 8px 25px;
        border-radius: 50px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(0, 82, 156, 0.3);
        transition: all 0.3s;
    }
    .btn-card-clean:hover {
        background-color: #003366;
        color: white;
        transform: translateY(-2px);
    }
    /* =========================================
    PAGINATION SEGMENTED (Menyatu & Rapi)
    ========================================= */

    .pagination-wrapper-flat {
        margin-top: 60px;
        margin-bottom: 40px;
        display: flex;
        justify-content: center;
        width: 100%;
    }

    /* Container Utama (Pembungkus Luar) */
    /* Container Utama (Lebih Ramping) */
    .pagination-flat {
        display: inline-flex;
        list-style: none;
        padding: 0;
        margin: 0;
        
        border: 1px solid #cbd5e1;
        border-radius: 4px; /* Sudut lebih kecil biar tajam & rapi */
        background-color: #ffffff;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03); /* Shadow super tipis */
    }

    /* Style Tombol (Kecil & Tipis) */
    .page-link-flat {
        width: 35px;               /* Dikecilkan dari 45px */
        height: 32px;              /* Dikecilkan dari 40px (Slim) */
        
        display: flex;
        align-items: center;
        justify-content: center;
        
        background-color: #ffffff;
        color: #475569;            /* Abu Slate yang lembut */
        text-decoration: none;
        
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;        /* Font diperkecil biar proporsional */
        font-weight: 500;          /* Tidak terlalu tebal */
        
        border: none;
        border-right: 1px solid #e2e8f0; /* Garis pemisah super tipis */
        
        transition: all 0.2s ease;
    }

    /* Hapus garis di tombol terakhir */
    .page-item:last-child .page-link-flat {
        border-right: none;
    }

    /* Hover (Mouse Lewat) */
    .page-link-flat:hover:not(.active-page) {
        background-color: #f8fafc;
        color: #003B76;
    }

    /* Halaman Aktif (Biru Elegan) */
    .page-item.active .page-link-flat {
        background-color: #003B76; /* Biru Tua */
        color: #ffffff;
        font-weight: 600;
    }

    /* Ukuran Icon Panah (< >) */
    .page-link-flat i {
        font-size: 0.7rem; /* Icon panah diperkecil juga */
    }
    /* 2. Kondisi Akhir (Muncul & Naik) */
    .item-lowongan.muncul-boss {
        opacity: 1;
        transform: translateY(0); /* Kembali ke posisi asal */
    }

    /* Opsional: Efek delay biar munculnya gantian (Staggering) */
    /* Kartu 2, 3, 4 munculnya telat dikit biar kece */
    .item-lowongan:nth-child(2) { transition-delay: 0.1s; }
    .item-lowongan:nth-child(3) { transition-delay: 0.2s; }
    .item-lowongan:nth-child(4) { transition-delay: 0.3s; }


    /* Keadaan Awal: Hilang & Turun Sedikit */
    .animasi-naik {
        opacity: 0;
        transform: translateY(40px); /* Turun 40px */
        transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94); /* Gerakan Smooth */
    }

    /* Keadaan Akhir: Muncul & Posisi Normal */
    .animasi-naik.kelihatan {
        opacity: 1;
        transform: translateY(0);
    }

    /* Opsional: Biar Box Search munculnya agak telat sedikit setelah Judul */
    .filters.animasi-naik {
        transition-delay: 0.2s;
    }

        /* PERBAIKAN TAMPILAN ISI DROPDOWN */

    /* UPDATE CSS INI DI DALAM <STYLE> */

    select.form-control-custom option,
    select option {
        background-color: #ffffff !important;
        color: #334155 !important;
        
        /* 1. SAYA KECILKAN PADDINGNYA */
        /* Tadi 15px 20px (terlalu gembung), sekarang jadi lebih rapat */
        padding: 6px 10px !important; 
        
        /* 2. SAYA KECILKAN FONTNYA */
        /* Biar muat dan tidak terlalu lebar ke samping */
        font-size: 0.8rem !important; 
        
        font-family: 'Poppins', sans-serif !important;
        line-height: 1.5 !important; /* Jarak antar baris dirapatkan */
    }

    select.form-control-custom option:checked,
    select.form-control-custom option:hover {
        background-color: #f1f5f9 !important;
        color: #00529C !important;
    }

    
</style>



