@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>


    <script>
        
        // ================================================================
        // STATE
        // ================================================================
        let currentStatusFilterMagang    = 'all';
        let currentStatusFilterPenelitian = 'all';
        let activeTab = 'magang';

        // ================================================================
        // TAB SWITCHING
        // ================================================================
        function switchTab(tab) {
            activeTab = tab;
            const isMagang = tab === 'magang';

            document.getElementById('panel-magang').style.display     = isMagang ? '' : 'none';
            document.getElementById('panel-penelitian').style.display = isMagang ? 'none' : '';

            const btnM = document.getElementById('tab-magang-btn');
            const btnP = document.getElementById('tab-penelitian-btn');

            btnM.className = 'dashboard-tab-btn' + (isMagang  ? ' active-magang'     : '');
            btnP.className = 'dashboard-tab-btn' + (!isMagang ? ' active-penelitian' : '');
        }

        // Auto switch tab dari URL param
        (function() {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam  = urlParams.get('tab');
            if (tabParam === 'penelitian') {
                switchTab('penelitian');
            }
        })();

        // ================================================================
        // FILTER BY STATUS (support dua tabel)
        // ================================================================
        function filterByStatus(status, cardId, tabel) {
            if (tabel === 'magang') {
                currentStatusFilterMagang = status;
                document.querySelectorAll('#panel-magang .stat-card').forEach(c => c.classList.remove('active'));
            } else {
                currentStatusFilterPenelitian = status;
                document.querySelectorAll('#panel-penelitian .stat-card').forEach(c => c.classList.remove('active'));
            }
            document.getElementById(cardId).classList.add('active');
            applyAllFilters();
        }

        // ================================================================
        // SEARCH + FILTER
        // ================================================================
        $("#tableSearch").on("keyup", function () { applyAllFilters(); });
        $("#searchPenelitian").on("keyup", function () { applyAllFilters(); });

        function applyAllFilters() {
            // --- Magang ---
            const searchM = $("#tableSearch").val().toLowerCase();
            $(".magang-row").each(function () {
                const matchSearch = $(this).text().toLowerCase().includes(searchM);
                const matchStatus = currentStatusFilterMagang === 'all'
                    || $(this).attr("data-status") === currentStatusFilterMagang;
                $(this).toggle(matchSearch && matchStatus);
            });

            // --- Penelitian ---
            const searchP = $("#searchPenelitian").val().toLowerCase();
            $(".penelitian-row").each(function () {
                const matchSearch = $(this).text().toLowerCase().includes(searchP);
                const matchStatus = currentStatusFilterPenelitian === 'all'
                    || $(this).attr("data-status") === currentStatusFilterPenelitian;
                $(this).toggle(matchSearch && matchStatus);
            });
        }

        // ================================================================
        // REGION CHANGE
        // ================================================================
        function changeRegion(region) {
            Swal.fire({
                title: 'Memproses...', text: 'Mengambil data region ' + (region === 'all' ? 'Semua' : region),
                allowOutsideClick: false, didOpen: () => { Swal.showLoading(); }
            });
            window.location.href = `/Admin/Mahasiswa/Index?selectedRegion=${encodeURIComponent(region)}`;
        }

        // ================================================================
        // HELPER
        // ================================================================
        function formatDate(d) {
            if (!d) return "-";
            return new Date(d).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' });
        }

        function calculateDuration(start, end) {
            if (!start || !end) return "-";
            const diffDays = Math.ceil(Math.abs(new Date(end) - new Date(start)) / (1000 * 60 * 60 * 24));
            const months = Math.floor(diffDays / 30);
            const days   = diffDays % 30;
            return months > 0 ? `${months} Bulan ${days} Hari` : `${days} Hari`;
        }

        function buildWaLink(rawHp) {
            let clean = (rawHp || "").replace(/\D/g, '');
            if (clean.startsWith('0')) clean = '62' + clean.slice(1);
            return clean ? `https://wa.me/${clean}` : "#";
        }

        // ================================================================
        // MODAL MAGANG — showDetail (tidak diubah dari versi asli)
        // ================================================================
        function showDetail(data) {
            $("#d-id").val(data.Id || data.id);
            $("#d-nama").text(data.NamaLengkap || data.namaLengkap || "-");
            $("#d-noreg").text(data.NomorPendaftaran || data.nomorPendaftaran || data.Id || data.id || "-");
            $("#d-created-at").text(formatDate(data.CreatedAt || data.createdAt));

            const st = data.Status || data.status;
            updateModalStatusUI(st);

            const pf = data.FotoProfil || data.fotoProfil;
            const finalFoto = pf ? "/uploads/foto/" + pf.split('/').pop() : "/img/default-user.png";
            $("#d-foto").attr("src", finalFoto);
            $("#d-foto-link").attr("href", finalFoto);

            $("#d-email").text(data.EmailPribadi || data.emailPribadi);
            const rawHp = data.NoHp || data.noHp || "";
            $("#d-hp").text(rawHp || "-");
            $("#d-hp-link").attr("href", buildWaLink(rawHp));
            $("#d-ttl").text(`${data.TempatLahir || data.tempatLahir || "-"}, ${formatDate(data.TanggalLahir || data.tanggalLahir)}`);
            let rawIg = (data.Instagram || data.instagram || "").replace(/@@/g, '').trim();
            $("#d-ig-text").text(rawIg || "-");

            $("#d-univ").text(data.NamaPerguruanTinggi || data.namaPerguruanTinggi || "-");
            $("#d-nim").text(data.NIM || data.nim || "-");
            $("#d-fakultas").text(data.Fakultas || data.fakultas || "-");
            $("#d-jurusan").text(data.Jurusan || data.jurusan || "-");
            $("#d-company-region").text(`${data.Company || data.company || "-"} - ${data.Region || data.region || "-"}`);
            $("#d-lokasi").text(data.Lokasi || data.lokasi || "-");
            $("#d-periode").text(formatDate(data.MulaiMagang || data.mulaiMagang) + " - " + formatDate(data.SelesaiMagang || data.selesaiMagang));

            const rekom = data.RekomendasiPegawai || data.rekomendasiPegawai;
            $("#d-rekomendasi").text(rekom && rekom !== "-" ? rekom : "Tidak ada rekomendasi pegawai.");

            $("#link-cv").attr("href", "/uploads/cv/" + (data.FileCv || data.fileCv || "").split('/').pop());
            $("#link-surat").attr("href", "/uploads/surat/" + (data.FileSuratPengantar || data.fileSuratPengantar || "").split('/').pop());
            $("#link-proposal").attr("href", "/uploads/proposal/" + (data.FileProposal || data.fileProposal || "").split('/').pop());

            $("#modalDetail").modal('show');
        }

        function updateModalStatusUI(st) {
            $("#d-status-badge-container").html(`<span class="status-pill-modal status-${st}">${st}</span>`);
            if (st === "Menunggu" && "@adminRole" !== "SuperAdmin") {
                $("#action-area-minimal").show();
            } else {
                $("#action-area-minimal").hide();
            }
        }

        // ================================================================
        // MODAL PENELITIAN — showDetailPenelitian
        // ================================================================
        function showDetailPenelitian(data) {
            $("#dp-id").val(data.Id || data.id);

            const nama = data.Nama || data.nama || "-";
            const judul = data.JudulPenelitian || data.judulPenelitian || "-";
            const st = data.Status || data.status || "Dalam Proses";

            $("#dp-nama").text(nama);
            $("#dp-judul-header").text(judul);
            $("#dp-judul").text(judul);
            $("#dp-noreg").text(data.NomorPendaftaran || data.nomorPendaftaran || data.Id || data.id || "-");

            // Status badge
            const badgeClass = st === "Diterima" ? "Diterima" : st === "Ditolak" ? "Ditolak" : "Menunggu";
            $("#dp-status-badge-container").html(`<span class="status-pill-modal status-${badgeClass}">${st}</span>`);

            // Foto
            const pf = data.PathFoto3x4 || data.pathFoto3x4 || "";
            const finalFoto = pf ? "/uploads/foto/" + pf.split('/').pop() : "/img/default-user.png";
            $("#dp-foto").attr("src", finalFoto);
            $("#dp-foto-link").attr("href", finalFoto);

            // Kontak
            $("#dp-email").text(data.Email || data.email || "-");
            const rawHp = data.NoHp || data.noHp || "";
            $("#dp-hp").text(rawHp || "-");
            $("#dp-hp-link").attr("href", buildWaLink(rawHp));
            $("#dp-ttl").text(`${data.TempatLahir || data.tempatLahir || "-"}, ${formatDate(data.TglLahir || data.tglLahir)}`);
            let rawIg = (data.Instagram || data.instagram || "").replace(/@@/g, '').trim();
            $("#dp-ig-text").text(rawIg || "-");

            // Akademik
            $("#dp-univ").text(data.Universitas || data.universitas || "-");
            $("#dp-nim").text(data.Nim || data.nim || "-");
            $("#dp-fakultas").text(data.Fakultas || data.fakultas || "-");
            $("#dp-jurusan").text(data.Jurusan || data.jurusan || "-");
            $("#dp-company-region").text(`${data.Company || data.company || "-"} - ${data.Region || data.region || "-"}`);
            $("#dp-lokasi").text(data.LokasiPenelitian || data.lokasiPenelitian || "-");
            $("#dp-periode").text(formatDate(data.TglMulai || data.tglMulai) + " - " + formatDate(data.TglSelesai || data.tglSelesai));

            // Berkas
            // Sesuaikan nama field path file di entity DB penelitian kamu
            $("#dp-link-cv").attr("href", "/uploads/cv/" + (data.PathCV || data.pathCV || "").split('/').pop());
            $("#dp-link-surat").attr("href", "/uploads/surat/" + (data.PathSurat || data.pathSurat || "").split('/').pop());
            $("#dp-link-proposal").attr("href", "/uploads/proposal/" + (data.PathProposal || data.pathProposal || "").split('/').pop());
            // Tampilkan/sembunyikan tombol aksi
            if (st === "Dalam Proses" && "@adminRole" !== "SuperAdmin") {
                $("#dp-action-area").show();
            } else {
                $("#dp-action-area").hide();
            }

            $("#modalPenelitian").modal('show');
        }

        // ================================================================
        // UPDATE STATUS MAGANG (tidak diubah dari versi asli)
        // ================================================================
        function updateStatus(s) {
            const id = $("#d-id").val();
            const oldStatus = $(`#row-${id}`).attr("data-status");

            Swal.fire({
                title: 'Konfirmasi', text: `Ubah status menjadi ${s}?`, icon: 'question',
                showCancelButton: true,
                confirmButtonColor: s === 'Diterima' ? '#00549B' : '#EC1C24',
                confirmButtonText: 'Ya, Simpan', cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    const row = $(`#row-${id}`);
                    row.attr("data-status", s);
                    row.find(".badge-status").attr("class", `badge-status status-${s}`).text(s);
                    row.removeClass("unread");
                    updateModalStatusUI(s);

                    if (oldStatus !== s) { updateStatCount(oldStatus, -1); updateStatCount(s, 1); }

                    $("#modalDetail").modal('hide');
                    $.post("/Admin/Mahasiswa/UpdateStatus", { id: id, status: s }, function (res) {
                        if (!res.success) {
                            Swal.fire('Error', res.message || 'Gagal update.', 'error').then(() => location.reload());
                        } else {
                            Swal.fire('Berhasil!', res.message, 'success');
                        }
                    });
                }
            });
        }

        function updateStatCount(status, change) {
            let el = "";
            if (status === "Menunggu") el = "#val-proses";
            else if (status === "Diterima") el = "#val-terima";
            else if (status === "Ditolak")  el = "#val-tolak";
            if (el) $(el).text(Math.max(0, (parseInt($(el).text()) || 0) + change));
            // Total tidak dikurangi karena status berubah, bukan data dihapus
        }

        // ================================================================
        // UPDATE STATUS PENELITIAN
        // ================================================================
        function updateStatusPenelitian(s) {
            const id = $("#dp-id").val();
            const oldStatus = $(`#prow-${id}`).attr("data-status");

            Swal.fire({
                title: 'Konfirmasi', text: `Ubah status penelitian menjadi ${s}?`, icon: 'question',
                showCancelButton: true,
                confirmButtonColor: s === 'Diterima' ? '#7c3aed' : '#EC1C24',
                confirmButtonText: 'Ya, Simpan', cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    const row = $(`#prow-${id}`);
                    row.attr("data-status", s);
                    const badgeClass = s === "Diterima" ? "Diterima" : s === "Ditolak" ? "Ditolak" : "Menunggu";
                    row.find(".badge-status").attr("class", `badge-status status-${badgeClass}`).text(s);
                    row.removeClass("unread");

                    // Update badge di modal
                    $("#dp-status-badge-container").html(`<span class="status-pill-modal status-${badgeClass}">${s}</span>`);
                    $("#dp-action-area").hide();

                    if (oldStatus !== s) { updateStatCountPenelitian(oldStatus, -1); updateStatCountPenelitian(s, 1); }

                    $("#modalPenelitian").modal('hide');
                    $.post("/Admin/Mahasiswa/UpdateStatusPenelitian", { id: id, status: s }, function (res) {
                        if (!res.success) {
                            Swal.fire('Error', res.message || 'Gagal update.', 'error').then(() => location.reload());
                        } else {
                            Swal.fire('Berhasil!', res.message, 'success');
                        }
                    });
                }
            });
        }

        function updateStatCountPenelitian(status, change) {
            let el = "";
            if (status === "Dalam Proses") el = "#p-val-proses";
            else if (status === "Diterima") el = "#p-val-terima";
            else if (status === "Ditolak")  el = "#p-val-tolak";
            if (el) $(el).text(Math.max(0, (parseInt($(el).text()) || 0) + change));
        }
        // ================================================================
        // EXPORT EXCEL — otomatis berdasarkan tab aktif
        // ================================================================
        function exportExcel() {
            if (activeTab === 'magang') {
                exportExcelMagang();
            } else {
                exportExcelPenelitian();
            }
        }

