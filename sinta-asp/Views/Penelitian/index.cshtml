@model sinta_asp.Models.LowonganViewModel
@{
    ViewData["Title"] = "Dashboard Penelitian";
    
    // Ambil data filter
    var selectedCompany = ViewData["SelectedCompany"] as string;
    var selectedSearch = ViewData["SelectedSearch"] as string;
    var selectedRegion = ViewData["SelectedRegion"] as string;
    var lastScroll = Context.Request.Query["lastScroll"].ToString();
}

<style>

    /* 1. IMPORT FONT BARU */
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500&display=swap');
    
    /* GLOBAL STYLE - UPDATE FULL WIDTH */
    .penelitian-wrapper { 
        background-color: #F4F4F4; /* Background Biru Muda */
        color: #333; 
        min-height: 100vh;
        font-family: 'Inter', sans-serif;

        /* INI MANTRA RAHASIANYA BIAR FULL KE POJOK */
        width: 100vw;           /* Paksa lebar selebar layar monitor */
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;     /* Tarik paksa ke kiri mentok */
        margin-right: -50vw;    /* Tarik paksa ke kanan mentok */
    }

    /* TAMBAHAN PENTING: */
    /* Agar kartu & filter tidak ikut jadi biru (transparan), kita wajib kasih warna putih */
    .flip-card-front, .filters {
        background-color: #ffffff; /* Kartu & Filter tetap putih bersih */
        border-radius: 15px;       /* Sudut melengkung biar cantik */
        box-shadow: 0 10px 25px rgba(0,0,0,0.05); /* Bayangan halus biar elegan */
    }
    
    /* Reset elemen teks biar gak ngerusak layout Bootstrap */
    .penelitian-wrapper h1, .penelitian-wrapper h2, .penelitian-wrapper p { margin: 0; padding: 0; }

    
    /* 2. HERO SECTION BARU (FULL LAYAR 100%) */
    .hero-section {
        position: relative;
        
        /* KUNCI 1: UBAH TINGGI JADI 100% LAYAR MONITOR */
        height: 100vh;       
        min-height: 100vh;   /* Paksa minimal setinggi layar */
        
        /* KUNCI 2: HAPUS SEMUA MARGIN BIAR GAK ADA PUTIH-PUTIH */
        margin: 0;           
        padding: 0;
        
        /* Background Gambar */
        background-image: url('https://images.unsplash.com/photo-1516216628859-9bccecab13ca?q=80&w=869&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'); 
        background-size: cover;          /* Gambar cover full area */
        background-position: center;     /* Posisi tengah */
        
        /* Layout Flexbox (Supaya Teks Tetap di Tengah Layar) */
        width: 100%;
        display: flex; 
        align-items: center;      /* Vertikal Tengah */
        justify-content: center;  /* Horizontal Tengah */
        
        font-family: 'Inter', sans-serif;
    }
    

        /* 3. GRADIENT ELEGAN (Merah Kiri -> Bening Kanan) */
        .hero-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(90deg, 
                rgba(139, 0, 0, 0.95) 0%,      /* Kiri: Merah Gelap Pekat */
                rgba(237, 27, 36, 0.7) 45%,    /* Tengah: Merah Pertamina */
                rgba(237, 27, 36, 0.0) 100%    /* Kanan: Bening (Gambar Asli) */
            );
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center; /* Teks di tengah vertikal */
            align-items: flex-start; /* Teks Rata Kiri */
            color: white;
            padding-left: 5%; /* Geser dikit dari pinggir kiri */
        }

        /* 4. TYPOGRAPHY BARU (Poppins & Inter) */
        .hero-title {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 3.5rem;
            line-height: 1.1;
            margin-bottom: 10px;
            text-shadow: 0 4px 10px rgba(0,0,0,0.3);
            /* State Awal: Hilang & Di Atas */
            opacity: 0; 
            transform: translateY(-40px);
            /* Animation dihapus dari sini */
        }

        .hero-lead {
            font-family: 'Inter', sans-serif;
            font-size: 1.1rem;
            font-weight: 400;
            margin-bottom: 20px !important;
            max-width: 600px;
            /* State Awal */
            opacity: 0;
            transform: translateY(-40px);
        }

     /* 5. TOMBOL PREMIUM (ANIMASI FILL KIRI KE KANAN) */
    .btn-apply-hero {
        position: relative; /* Wajib: sebagai jangkar animasi */
        overflow: hidden;   /* Wajib: biar warna tidak bocor keluar sudut melengkung */
        z-index: 1;         /* Pastikan teks ada di layer paling atas */
        
        background-color: transparent; 
        border: 2px solid white;
        
        color: white;
        padding: 15px 40px;
        
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 50px !important;
        text-decoration: none;
        
        /* Transisi warna teks biar halus saat background jadi putih */
        transition: color 0.4s ease; 
        
        display: inline-block;
        margin-top: -10px; /* Jarak dari teks di atasnya */
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);

        opacity: 0;                   
        transform: translateY(-40px);
        }

        /* --- BAGIAN INI WAJIB ADA (JANGAN LUPA) --- */
    
        /* Saat class ini ditempel sama JS, baru elemennya muncul */
        .animasi-aktif {
            animation: turunCantik 0.8s ease-out forwards;
        }
        
        /* Delay biar munculnya antri (Judul -> Teks -> Tombol) */
        .hero-lead.animasi-aktif {
            animation-delay: 0.3s;
        }
        .btn-apply-hero.animasi-aktif {
            animation-delay: 0.6s;
        }

        /* Definisi Gerakannya */
        @@keyframes turunCantik {
            0% { opacity: 0; transform: translateY(-40px); }
            100% { opacity: 1; transform: translateY(0); }
        }

    /* INI LAYER PUTIH YANG AKAN BERGERAK */
    /* PERBAIKAN TOMBOL: Kode bersih tanpa sampah copy-paste */
    .btn-apply-hero::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        
        width: 0%;        /* Mulai dari 0 */
        height: 100%;
        
        background-color: white; /* Warna Putih */
        z-index: -1;      /* Wajib di belakang teks */
        
        /* Animasi */
        transition: width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); 
    }

    /* EFEK SAAT MOUSE DI ARAHKAN (HOVER) */
    .btn-apply-hero:hover {
        color: #121c2d; /* Ubah warna teks jadi Biru Gelap biar terbaca */
        /* Kalau mau teks merah Pertamina, ganti jadi color: #ED1B24; */
        border-color: white;
    }

    /* Pemicu Animasi: Lebarkan layer putih jadi 100% */
    .btn-apply-hero:hover::before {
        width: 100%; 
    }

    
    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        
        /* GANTI GRADASI MERAH LAMA DENGAN INI (Dark Blue Slate) */
        /* Kode warna diambil dari sampel gambar referensimu */
        background: linear-gradient(90deg, 
            rgba(20, 35, 50, 0.95) 0%,     /* Kiri: Biru Gelap Pekat (Hampir Hitam) */
            rgba(20, 35, 50, 0.6) 45%,     /* Tengah: Mulai memudar */
            rgba(20, 35, 50, 0.0) 100%     /* Kanan: Transparan (Gambar terlihat) */
        );
        
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
    }

    /* TYPOGRAPHY BARU */
    .badge-custom {
        background-color: #00A950;
        color: white; padding: 8px 20px; border-radius: 50px;
        text-transform: uppercase; font-weight: 700; font-size: 0.8rem;
        letter-spacing: 1px; margin-bottom: 20px; display: inline-block;
    }
    
    .hero-title { font-size: 4rem; font-weight: 700; margin-bottom: 10px; }
    .hero-lead { font-size: 1.2rem; font-weight: 400; margin-bottom: 40px; }

    /* LAYOUT UTAMA */
    /* UPDATE: MAIN CONTAINER DENGAN EFEK OVERLAP (MENUMPUK) */
    .main-container {
        max-width: 100%;
        margin: 0 auto; /* Posisi tengah horizontal */
        
        /* --- 1. KUNCI EFEK OVERLAP (MANTRA UTAMA) --- */
        margin-top: -30px !important;  /* Menarik kotak ini NAIK 80px ke atas menutupi Hero */
        position: relative;            /* Wajib ada biar bisa diatur urutan layernya */
        z-index: 10;                   /* Pastikan layer ini DI ATAS gambar Hero (yg z-indexnya cuma 2) */
        
        /* --- 2. STYLE ALA KARTU/SHEET (REFERENSI GAMBARMU) --- */
        background-color: #F4F4F4;     /* Warna dasar harus solid (Biru Muda) biar gambar Hero ketutup */
        border-radius: 40px 40px 0 0;  /* Membuat sudut Kiri-Atas & Kanan-Atas melengkung */
        box-shadow: 0 -15px 40px rgba(0, 0, 0, 0.15); /* Bayangan ke arah atas biar terlihat mengambang */
        
        /* --- 3. KERAPIAN ISI --- */
        padding: 50px 40px 100px 40px; /* Memberi jarak nafas di dalam kotak (Atas Kanan Bawah Kiri) */
    }
    
    /* OPSIONAL: Agar di layar HP lengkungannya tidak terlalu ekstrem */
    @@media (max-width: 768px) {
        .main-container {
            margin-top: -50px !important;
            border-radius: 25px 25px 0 0;
            padding: 30px 20px;
        }
    }
    .job-board-layout { display: grid; grid-template-columns: 280px 1fr; gap: 50px; }

    /* COMPONENTS */
    .intro-header { display: flex; justify-content: space-between; margin-bottom: 30px; padding-bottom: 30px; border-bottom: 1px solid #eee; }
    .btn-apply {
        background-color: #00a048; color: white; padding: 10px 25px;
        border-radius: 50px; text-decoration: none; font-weight: 600; display: inline-block;
    }
    .filters {
        background-color: #ffffff;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        
        /* 1. KUNCI AGAR TINGGI 'DIPASKAN' SESUAI ISI (TIDAK MELAR KE BAWAH) */
        height: fit-content; 
        
        /* 2. MEMPERKECIL UKURAN (BIAR LEBIH RAMPING) */
        padding: 20px;     /* Kurangi padding (jarak dalam) biar tidak gembung */
        font-size: 0.9rem; /* Kecilkan sedikit hurufnya */
    }
    .filters label { font-size: 0.85rem; color:#1976D2; font-weight: 600; margin-bottom: 8px; display: block; }
    
    /* FORM STYLING */
    .form-control-custom {
        width: 100%; padding: 12px 15px; font-size: 0.95rem;
        border: 1px solid #e0e0e0; border-radius: 8px; outline: none; background: white;
        appearance: none; -webkit-appearance: none; -moz-appearance: none;
    }
    select.form-control-custom {
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23d81c22' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat; background-position: right 15px center; 
        background-size: 16px; padding-right: 40px; cursor: pointer;
    }
    input.form-control-custom { background-image: none !important; padding-right: 40px; }
    .search-wrapper { position: relative; }
    .search-wrapper i { 
        position: absolute; right: 15px; top: 50%; 
        transform: translateY(-50%); color: #d81c22; pointer-events: none; 
    }
    @@media (max-width: 768px) { .job-board-layout { grid-template-columns: 1fr; } }
    
    /* =========================================
       FIX STRUKTUR KARTU (Supaya Gak Numpuk)
       ========================================= */
    .flip-card {
        background-color: transparent;
        width: 100%;
        height: 300px; /* Tinggi harus ditetapkan agar tidak gepeng */
        perspective: 1000px; /* Efek 3D */
        margin-bottom: 30px;
    }

    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: left;
        transition: transform 0.8s;
        transform-style: preserve-3d;
    }

    /* Trigger putar saat hover */
    .flip-card:hover .flip-card-inner {
        transform: rotateY(180deg);
    }

    /* INI KUNCINYA AGAR TIDAK NUMPUK: Wajib Absolute! */
    .flip-card-front, .flip-card-back {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        overflow: hidden; /* Biar isi gak bocor */
    }

    /* =========================================
       TAMPILAN DEPAN (Gradient Biru)
       ========================================= */
    .flip-card-front {
        /* Gradient Biru seperti request */
        background: linear-gradient(#608ecf 0%, #648dc5 50%, #7ba7ce 99%  );
        color: white;
        
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center; /* Rata Tengah */
        padding: 20px;
        text-align: center;
    }

    /* Judul di Depan */
    .card-title {
        font-weight: 800;
        font-size: 1.2rem;
        margin-bottom: 20px;
        line-height: 1.3;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }

    /* Baris Info (Icon + Teks) */
    .info-row {
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }
    .info-icon {
        margin-right: 8px;
        width: 20px;
        text-align: center;
    }

    /* =========================================
       TAMPILAN BELAKANG (PUTIH BERSIH)
       ========================================= */
    .flip-card-back {
        background-color: #ffffff; /* BALIK JADI PUTIH */
        color: #333;               /* Teks jadi Gelap */
        transform: rotateY(180deg);
        
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 25px;
        text-align: center;
        border: 1px solid #eee; /* List pinggir tipis */
    }

    .back-title {
        color: #00529C; /* Judul Biru */
        font-weight: 700;
        margin-bottom: 15px;
        font-size: 1.1rem;
        text-transform: uppercase;
        border-bottom: 2px solid #00529C;
        padding-bottom: 5px;
    }

    .back-desc {
        font-size: 0.9rem;
        color: #666;
        line-height: 1.6;
        margin-bottom: 20px;
        /* Batasi teks 4 baris */
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Tombol Daftar di Belakang */
    .btn-card-clean {
        background-color: #00529C; /* Tombol Biru */
        color: white;
        padding: 10px 30px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(0, 82, 156, 0.3);
        transition: all 0.3s;
    }
    .btn-card-clean:hover {
        background-color: #003366;
        color: white;
        transform: translateY(-2px);
    }

    /* =========================================
       PAGINATION SIMPEL (Flat & Clean)
       ========================================= */
    .pagination {
        gap: 5px;                  /* Jarak kecil antar tombol */
        align-items: center;
        border: none;
    }

    .page-item {
        margin: 0;
    }

    /* Style Dasar Tombol */
    .page-item .page-link {
        border: 1px solid #e0e0e0; /* Garis pinggir tipis abu-abu */
        border-radius: 6px !important; /* Sudut sedikit melengkung (tidak bulat total) */
        padding: 8px 16px;         /* Ukuran pas (tidak terlalu besar) */
        
        color: #555;               /* Teks abu gelap */
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        background-color: white; 
        
        /* Hapus semua efek bayangan & animasi */
        box-shadow: none;
        transition: background-color 0.2s; /* Transisi warna saja (cepat) */
    }

    /* Efek Saat Mouse Diarahkan (Hover) */
    .page-item:not(.disabled) .page-link:hover {
        background-color: #f0f0f0; /* Ganti warna background jadi abu muda */
        color: #333;
        border-color: #d0d0d0;
        transform: none;           /* MATIKAN gerakan naik */
    }

    /* Halaman Aktif */
    .page-item.active .page-link {
        background-color: #00529C; /* Biru Solid (Tanpa Gradasi) */
        border-color: #00529C;
        color: white !important;
        
        /* Pastikan tidak ada efek zoom/besar */
        transform: none; 
        box-shadow: none;
    }

    /* Tombol Mati (Disabled) */
    .page-item.disabled .page-link {
        background-color: #f9f9f9;
        color: #ccc;
        border-color: #eee;
        cursor: default;
    }

    
</style>



<script>
    if ('scrollRestoration' in history) { history.scrollRestoration = 'manual'; }
</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="penelitian-wrapper">
    <header class="hero-section">
        <div class="hero-overlay"></div>

        <div class="container hero-content">
            
            <h1 class="hero-title">READY TO LEVEL UP?</h1>
            
            <p class="hero-lead">Salurkan ide brilian dan ciptakan dampak nyata bersama kami.</p>
            
            <div>
                <a asp-controller="Penelitian" asp-action="Daftar" class="btn-apply-hero">
                    Apply For Opportunities
                </a>
            </div>
        </div>
    </header>
    <div class="main-container" id="area-lowongan">
        <div class="job-board-layout">
            
            <aside class="filters">
                <a href="/Penelitian" style="text-decoration:none; color:#666; font-size:0.9rem; margin-bottom:15px; display:inline-block;">Clear filters</a>

                <form onsubmit="return false;" style="width: 100%;">
                    <input type="hidden" name="lastScroll" id="lastScrollInput" value="" />

                    <div style="margin-bottom: 25px;">
                        <label>Can't find what you looking for?</label>
                        <div class="search-wrapper">
                            <input type="text" 
                                id="inputCari" 
                                name="search" 
                                class="form-control" 
                                placeholder="Search..." 
                                autocomplete="off" 
                                value="@selectedSearch"> <i class="fas fa-search"></i>
                        </div>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <label>Filtered by Company</label>
                        <select name="company" id="companySelect" class="form-control-custom" onchange="onCompanyChange()">
                            <option value="All" selected="@(selectedCompany == "All" ? "selected" : null)">All Companies</option>
                            <option value="PT Kilang Pertamina Internasional (KPI)" 
                                    selected="@(selectedCompany == "PT Kilang Pertamina Internasional (KPI)" ? "selected" : null)">
                                PT Kilang Pertamina Internasional (KPI)
                            </option>
                            <option value="PT Pertamina Patra Niaga" selected="@(selectedCompany == "PT Pertamina Patra Niaga" ? "selected" : null)">
                                PT Pertamina Patra Niaga (C&T)
                            </option>
                        </select>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <label>By Region</label>
                        <select name="region" id="regionSelect" class="form-control-custom" onchange="refreshData()">
                        </select>
                    </div>
                </form>
            </aside>

            <main id="area-konten">
                @if (Model.Lowongan == null || Model.Lowongan.Count == 0)
                {
                    <div style="text-align:center; padding: 60px; color:#999; border: 2px dashed #eee; border-radius:15px; background-color:#fafafa;">
                        <i class="fas fa-search fa-3x" style="margin-bottom:15px; color:#ddd;"></i>
                        <h3>Tidak Ada Lowongan</h3>
                        <p>Coba ubah filter atau kata kunci pencarian Anda.</p>
                    </div>
                }
                else
                {
                    <div class="row" id="containerKartu">
                        @foreach (var item in Model.Lowongan)
                        {
                            <div class="col-12 col-md-6 col-lg-3 item-lowongan">
                                <div class="flip-card">
                                    <div class="flip-card-inner">
                                        
                                        <div class="flip-card-front">
                                            <div class="front-text-container">
                                                
                                                <h5 class="card-title">@item.Title</h5>

                                                <div class="info-row">
                                                    @if (item.Company != null && item.Company.Contains("Kilang"))
                                                    {
                                                        <span class="info-icon" style="color: #4ade80 !important;">
                                                            <i class="fas fa-briefcase"></i> </span>
                                                        
                                                        <span style="color: #e0e0e0; font-weight: 700; text-shadow: 0 1px 3px rgba(0,0,0,0.3);">
                                                            @item.Company </span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="info-icon" style="color: #4ade80 !important;">
                                                            <i class="fas fa-briefcase"></i>
                                                        </span>
                                                        <span style="color: #e0e0e0;">@item.Company</span>
                                                    }
                                                </div>

                                                <div class="info-row">
                                                    <span class="info-icon"><i class="fas fa-map-marker-alt"></i></span>
                                                    <span>@item.Region</span>
                                                </div>

                                            </div>
                                        </div>

                                        <div class="flip-card-back">
                                            <h6 class="back-title">Detail Posisi</h6>
                                            
                                            <p class="back-desc">
                                                @item.Description
                                            </p>
                                            
                                            <a asp-action="Daftar" 
                                            asp-route-preCompany="@item.Company" 
                                            asp-route-preRegion="@item.Region"
                                            asp-route-preTargetLokasi="@item.Title"   
                                            asp-route-preTargetJurusan="@item.Title"
                                            class="btn-card-clean">
                                            Daftar Sekarang
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div id="pesanKosong" style="display: none; text-align: center; padding: 40px; margin-top: 20px; color: #666;">
                        <i class="fas fa-search" style="font-size: 3rem; color: #ddd; margin-bottom: 15px;"></i>
                        <h3>Yah, nggak ketemu...</h3>
                        <p>Coba cari pakai kata kunci lain ya.</p>
                    </div>
                }

                @if (Model.TotalPages > 0)
                {
                    <div style="margin-top: 40px; display: flex; justify-content: center;">
                        <nav aria-label="Page navigation">
                            <ul class="pagination">
                                
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" 
                                    asp-action="Index" 
                                    asp-route-page="@(Model.CurrentPage - 1)"
                                    asp-route-search="@ViewData["SelectedSearch"]"
                                    asp-route-company="@ViewData["SelectedCompany"]"
                                    asp-route-region="@ViewData["SelectedRegion"]">
                                        &laquo; Previous
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link" 
                                        asp-action="Index" 
                                        asp-route-page="@i"
                                        asp-route-search="@ViewData["SelectedSearch"]"
                                        asp-route-company="@ViewData["SelectedCompany"]"
                                        asp-route-region="@ViewData["SelectedRegion"]">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" 
                                    asp-action="Index" 
                                    asp-route-page="@(Model.CurrentPage + 1)"
                                    asp-route-search="@ViewData["SelectedSearch"]"
                                    asp-route-company="@ViewData["SelectedCompany"]"
                                    asp-route-region="@ViewData["SelectedRegion"]">
                                        Next &raquo;
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }

            </main>
        </div>
    </div>
</div>

<script>
    // ==========================================
    // BAGIAN 1: DATA & LOGIKA TAMPILAN
    // ==========================================
    const dataRegion = {
        "PT Pertamina Patra Niaga": ["Regional Jatimbalinus", "Regional Jawa Bagian Tengah", "Regional Jawa Bagian Barat", "Regional Kalimantan", "Regional Maluku Papua", "Regional Sumbagut"],
        "PT Kilang Pertamina Internasional (KPI)": ["Refinery Unit VI Balongan"]
    };

    function updateRegionOptions() {
        const companySelect = document.getElementById('companySelect');
        const regionSelect = document.getElementById('regionSelect');
        const selectedCompany = companySelect.value;
        const currentRegion = regionSelect.value || '@ViewData["SelectedRegion"]' || "All"; 

        regionSelect.innerHTML = '';

        // Logika KPI (Balongan Only) vs Lainnya
        if (selectedCompany !== "PT Kilang Pertamina Internasional (KPI)") {
            const allOption = document.createElement('option');
            allOption.value = "All";
            allOption.text = "All Regions";
            regionSelect.appendChild(allOption);
        }

        if (selectedCompany && dataRegion[selectedCompany]) {
            dataRegion[selectedCompany].forEach(reg => {
                const option = document.createElement('option');
                option.value = reg; option.text = reg;
                regionSelect.appendChild(option);
            });
        }
        
        // Cek dulu, ini KPI bukan?
        if (selectedCompany === "PT Kilang Pertamina Internasional (KPI)") {
            regionSelect.selectedIndex = 0; // <--- INI CODE VIP YG HILANG (Paksa pilih opsi pertama/Balongan)
        } else {
            // Kalau bukan KPI, baru jalankan logic lama
            Array.from(regionSelect.options).forEach(opt => {
                if (opt.value === currentRegion) regionSelect.value = currentRegion;
            });
        }
    }

    // ==========================================
    // BAGIAN 2: LOGIKA AJAX (SMOOTH & FIX REGION)
    // ==========================================

    // 1. FUNGSI INTI (LOAD DATA)
    function loadDataTanpaReload(customUrl = null) {
        const valSearch = document.getElementById('inputCari').value;
        const valCompany = document.getElementById('companySelect').value;
        const valRegion = document.getElementById('regionSelect').value;

        let url = customUrl;
        if (!url) {
            url = `/Penelitian/Index?search=${encodeURIComponent(valSearch)}&company=${encodeURIComponent(valCompany)}&region=${encodeURIComponent(valRegion)}&page=1`;
        }

        // Efek Loading: Ganti ikon kaca pembesar jadi spinner
        const searchIcon = document.querySelector('.fa-search');
        if (searchIcon) {
            searchIcon.classList.remove('fa-search');
            searchIcon.classList.add('fa-circle-notch', 'fa-spin'); 
        }

        fetch(url)
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const kontenBaru = doc.getElementById('area-konten');
                const areaLama = document.getElementById('area-konten');
                
                if (areaLama && kontenBaru) {
                    areaLama.innerHTML = kontenBaru.innerHTML;
                    window.history.pushState({}, '', url);
                    pasangEventPagination();
                }
            })
            .catch(err => console.error('Error:', err))
            .finally(() => {
                // Balikin ikon jadi normal
                if (searchIcon) {
                    searchIcon.classList.remove('fa-circle-notch', 'fa-spin');
                    searchIcon.classList.add('fa-search');
                }
            });
    }

    // 2. TRIGGER DARI HTML (Jembatan Event)
    
    // Dipanggil saat Company Ganti
    window.onCompanyChange = function() { 
        document.getElementById('regionSelect').value = "All"; 
        updateRegionOptions(); 
        loadDataTanpaReload(); 
    };
    // Backup nama lama (biar aman)
    window.gantiCompany = window.onCompanyChange;

    // Dipanggil saat Region Ganti (INI YANG TADI HILANG)
    window.refreshData = function() {
        loadDataTanpaReload();
    };

    // Dipanggil Form Submit (Enter)
    window.submitFilter = function() { 
        loadDataTanpaReload(); 
    };

    // 3. PAGINATION HANDLING
    function pasangEventPagination() {
        const links = document.querySelectorAll('.page-link');
        links.forEach(link => {
            const newLink = link.cloneNode(true);
            link.parentNode.replaceChild(newLink, link);
            newLink.addEventListener('click', function(e) {
                e.preventDefault();
                const href = this.getAttribute('href');
                if (href && href !== '#') loadDataTanpaReload(href);
            });
        });
    }

    // ==========================================
    // BAGIAN 3: SETUP AWAL
    // ==========================================
    document.addEventListener("DOMContentLoaded", function() {
        updateRegionOptions();
        pasangEventPagination();

        const inputCari = document.getElementById('inputCari');
        if (inputCari) {
            let timeout = null;

            // Live Search Cepat (300ms)
            inputCari.addEventListener('input', function() {
                clearTimeout(timeout);
                timeout = setTimeout(function() {
                    loadDataTanpaReload(); 
                }, 300);
            });

            inputCari.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    loadDataTanpaReload();
                }
            });
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // 1. Daftar elemen yang mau dipanggil
        const elemenAnimasi = document.querySelectorAll('.hero-title, .hero-lead, .btn-apply-hero');

        // 2. Satpam pemantau (Observer)
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // Kalau terlihat, TEMPEL class animasi (MUNCUL!)
                    entry.target.classList.add('animasi-aktif');
                } else {
                    // Kalau discroll jauh ke bawah, CABUT class (NGUMPET LAGI)
                    // Supaya nanti pas scroll ke atas bisa muncul lagi (Replay)
                    entry.target.classList.remove('animasi-aktif'); 
                }
            });
        }, { threshold: 0.1 }); // Muncul pas 10% elemen kelihatan

        // 3. Mulai memantau
        elemenAnimasi.forEach(el => observer.observe(el));
    });
</script>

