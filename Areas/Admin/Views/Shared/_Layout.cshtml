@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var adminNama = HttpContextAccessor.HttpContext?.Session.GetString("AdminNama") ?? "Admin";
    var adminEmail = HttpContextAccessor.HttpContext?.Session.GetString("AdminEmail");
    var adminRole = HttpContextAccessor.HttpContext?.Session.GetString("AdminRole");
    var avatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(adminNama)}&background=00549B&color=fff";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin SINTA</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">

    <style>
        :root {
            --p-blue: #00549B;
            --p-red: #ec1c24;
            --sidebar-width: 280px;
            --topbar-height: 80px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            overflow-x: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #fff;
            border-right: 1px solid #e2e8f0;
            z-index: 1000;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
        }

        .brand-container { margin-bottom: 50px; padding: 0 10px; }
        .brand-logo-pertamina { height: 60px; }

        .nav-link-custom {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #64748b;
            border-radius: 12px;
            text-decoration: none !important;
            margin-bottom: 6px;
            font-weight: 600;
            transition: var(--transition);
        }

        .nav-link-custom:hover {
            background: rgba(0, 84, 155, 0.05);
            color: var(--p-blue);
            transform: translateX(5px);
        }

        .nav-link-custom.active {
            background: var(--p-blue);
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(0, 84, 155, 0.2);
        }

        .nav-link-logout {
            color: var(--p-red) !important;
            border: 1px solid #fee2e2;
            background: #fffafa;
            margin-top: auto;
        }

        /* Topbar Styling */
        .topbar {
            height: var(--topbar-height);
            position: fixed; top: 0; right: 0; left: var(--sidebar-width);
            background: #fff; border-bottom: 1px solid #e2e8f0;
            z-index: 999; display: flex; align-items: center;
            justify-content: space-between; padding: 0 30px;
        }

        .brand-logo-sinta { height: 45px; }
        .main-content { margin-left: var(--sidebar-width); padding-top: var(--topbar-height); }

        /* NOTIFIKASI UPGRADE */
        .notif-dropdown-wrapper { position: relative; }

        .notif-btn {
            background: transparent;
            border: none;
            font-size: 1.25rem;
            color: #64748b;
            cursor: pointer;
            padding: 5px;
            transition: var(--transition);
            outline: none !important;
        }

        .notif-btn:hover { color: var(--p-blue); }

        .notif-dropdown-wrapper:hover .notif-dropdown {
            display: block; opacity: 1; visibility: visible; transform: translateY(0);
        }

        .notif-dropdown {
            display: block; opacity: 0; visibility: hidden;
            transform: translateY(10px); transition: var(--transition);
            position: absolute; right: 0; top: 100%; width: 330px;
            background: white; border-radius: 16px; border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08); padding: 8px 0; z-index: 1001;
        }

        .notif-header {
            padding: 12px 20px;
            display: flex; justify-content: space-between; align-items: center;
            background: #fff;
        }

        .notif-badge {
            position: absolute; top: 0px; right: 0px;
            background: var(--p-red); color: white; font-size: 9px;
            padding: 1px 5px; border-radius: 50px; border: 1.5px solid #fff;
            min-width: 18px; text-align: center;
        }
        
        .notif-item {
            padding: 12px 20px;
            display: flex; align-items: center; text-decoration: none !important;
            transition: 0.2s; border: none;
        }
        .notif-item:hover { background-color: #f8fafc; }
        .notif-item.unread { background-color: rgba(0, 84, 155, 0.03); }

        .notif-dot {
            width: 7px; height: 7px; background: var(--p-blue);
            border-radius: 50%; margin-left: auto; flex-shrink: 0;
        }
        
        .notif-icon-circle {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            margin-right: 12px; flex-shrink: 0; background: #f1f5f9; font-size: 14px;
        }

        /* Sidebar Bubble */
        .sidebar-notif-bubble {
            background: var(--p-red); color: white; font-size: 10px;
            padding: 2px 7px; border-radius: 20px; margin-left: auto; font-weight: 700;
        }

        /* --- FITUR FLASH HIGHLIGHT --- */
        .row-highlight-flash {
            animation: flashHighlight 2s ease-out;
        }

        @@keyframes flashHighlight {
            0% { background-color: rgba(0, 84, 155, 0.3) !important; }
            100% { background-color: transparent; }
        }

        /* Row Unread Background (Pale Blue) */
        .magang-row.unread {
            background-color: rgba(0, 84, 155, 0.05) !important;
        }

    </style>
</head>
<body>

<nav class="sidebar">
    <div class="brand-container">
        <img src="~/images/logo-pertamina.png" class="brand-logo-pertamina" alt="Pertamina">
    </div>

    <ul style="list-style:none; padding:0; flex-grow:1;">
        <li><a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-house mr-2"></i> Dashboard</a></li>
        <li>
            <a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mahasiswa" ? "active" : "")" asp-area="Admin" asp-controller="Mahasiswa" asp-action="Index">
                <i class="fa-solid fa-users mr-2"></i> Data Mahasiswa
                <span id="sidebarNotifBadge" class="sidebar-notif-bubble d-none">0</span>
            </a>
        </li>
        
        @if (adminRole == "SuperAdmin")
        {
            <li><a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admins" ? "active" : "")" asp-area="Admin" asp-controller="Admins" asp-action="Index"><i class="fa-solid fa-user-gear mr-2"></i> Manajemen Admin</a></li>
        }

        @if (adminRole != "SuperAdmin")
        {
            <li><a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "EmailTemplate" ? "active" : "")" asp-area="Admin" asp-controller="EmailTemplate" asp-action="Index"><i class="fa-solid fa-envelope-open-text mr-2"></i> Format Konfirmasi</a></li>
        }

        <li><a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="fa-solid fa-gear mr-2"></i> Settings</a></li>
    </ul>

    <a asp-area="Admin" asp-controller="Login" asp-action="Logout" class="nav-link-custom nav-link-logout">
        <i class="fa-solid fa-right-from-bracket mr-2"></i> Logout
    </a>
</nav>

<header class="topbar">
    <div class="d-flex align-items-center">
        <i class="fa-solid fa-bars-staggered mr-3 text-muted d-none d-md-block"></i>
        <span class="font-weight-bold text-muted" style="font-size: 0.9rem;">Panel Administrator</span>
    </div>

    <div class="d-flex align-items-center">
        <img src="~/images/logo-sinta.png" class="brand-logo-sinta mr-4">

        <div class="notif-dropdown-wrapper mr-3">
            <button class="notif-btn" type="button">
                <i class="fa-solid fa-bell"></i>
                <span id="notifBadge" class="notif-badge d-none">0</span>
            </button>
            <div class="notif-dropdown shadow border-0">
                <div class="notif-header">
                    <span class="small font-weight-bold text-dark">Notifikasi Terbaru</span>
                    <span id="notifCountLabel" class="badge badge-pill badge-light text-primary small" style="font-size: 10px;">0</span>
                </div>
                <div id="notificationList" style="max-height: 300px; overflow-y: auto;">
                    <div class="text-center p-3 text-muted small">Memuat...</div>
                </div>
                <button type="button" class="btn btn-link btn-sm btn-block p-2 text-center small font-weight-bold text-primary" style="text-decoration:none;" data-toggle="modal" data-target="#modalAllNotifications">
                    Lihat Semua
                </button>
            </div>
        </div>

        <div class="text-right mr-3" style="border-left:1px solid #e2e8f0; padding-left:15px;">
            <div class="small font-weight-bold" style="line-height: 1;">@adminNama</div>
            <small class="text-success font-weight-bold" style="font-size: 10px;">Online</small>
        </div>

        <div class="dropdown profile-dropdown">
            <a data-toggle="dropdown" style="cursor: pointer;">
                <img src="@avatarUrl" class="rounded-circle shadow-sm border" width="38">
            </a>
            <div class="dropdown-menu dropdown-menu-right shadow border-0" style="border-radius:10px">
                <a class="dropdown-item small" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="fa-solid fa-user-shield mr-2"></i> Profil</a>
                <a class="dropdown-item small text-danger" asp-area="Admin" asp-controller="Login" asp-action="Logout"><i class="fa-solid fa-power-off mr-2"></i> Keluar</a>
            </div>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="container-fluid py-4">
        @RenderBody()
    </div>
</main>

<div class="modal fade" id="modalAllNotifications" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-primary text-white border-0">
                <h6 class="modal-title font-weight-bold mb-0"><i class="fas fa-bell mr-2"></i> Riwayat Notifikasi</h6>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0" id="fullNotifContainer" style="max-height: 60vh; overflow-y: auto;">
                <div class="text-center p-4 text-muted small">Memuat riwayat...</div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        fetchAdminNotifications();
        setInterval(fetchAdminNotifications, 60000);

        const urlParams = new URLSearchParams(window.location.search);
        const highlightId = urlParams.get('highlightId');
        if (highlightId) {
            setTimeout(() => {
                const targetRow = $(`#row-${highlightId}`);
                if (targetRow.length) {
                    $('html, body').animate({
                        scrollTop: targetRow.offset().top - 150
                    }, 500);
                    targetRow.addClass('row-highlight-flash').removeClass('unread');
                    setTimeout(() => targetRow.removeClass('row-highlight-flash'), 2000);
                }
            }, 500);
        }
    });

    function fetchAdminNotifications() {
        $.ajax({
            url: '/Admin/Dashboard/GetNotifications',
            type: 'GET',
            success: function (data) {
                const list = $('#notificationList');
                const fullContainer = $('#fullNotifContainer');
                const badge = $('#notifBadge');
                const sidebarBadge = $('#sidebarNotifBadge');
                const countLabel = $('#notifCountLabel');
                
                list.empty();
                fullContainer.empty();

                let unreadCount = data.filter(n => !n.isRead).length;

                if (unreadCount > 0) {
                    badge.text(unreadCount).removeClass('d-none');
                    sidebarBadge.text(unreadCount).removeClass('d-none');
                    countLabel.text(unreadCount + ' Baru');
                } else {
                    badge.addClass('d-none');
                    sidebarBadge.addClass('d-none');
                    countLabel.text('0');
                }

                if (data.length === 0) {
                    list.append('<div class="p-3 text-center text-muted small">Tidak ada notifikasi</div>');
                    fullContainer.append('<div class="p-4 text-center text-muted small">Belum ada riwayat</div>');
                    return;
                }

                data.forEach(n => {
                    const unreadClass = n.isRead ? '' : 'unread';
                    const iconColor = n.type === 'Baru' ? 'text-primary' : 'text-success';

                    const itemHtml = `
                        <a href="javascript:void(0)" class="notif-item ${unreadClass}" onclick="handleNotifClick(${n.id}, ${n.magangId})">
                            <div class="notif-icon-circle ${iconColor}">
                                <i class="fas ${n.iconClass || 'fa-user-plus'}"></i>
                            </div>
                            <div style="flex:1">
                                <div class="small font-weight-bold text-dark" style="font-size: 0.8rem;">${n.title}</div>
                                <div class="text-muted small" style="font-size: 0.75rem; line-height: 1.2;">${n.message}</div>
                                <div class="text-primary mt-1" style="font-size:9px">${n.timeAgo}</div>
                            </div>
                            ${!n.isRead ? '<div class="notif-dot"></div>' : ''}
                        </a>
                    `;
                    list.append(itemHtml);
                    fullContainer.append(itemHtml);
                });
            }
        });
    }

    function handleNotifClick(notifId, magangId) {
        $.post('/Admin/Dashboard/MarkAsRead', { id: notifId }, function () {
            window.location.href = '/Admin/Mahasiswa?highlightId=' + magangId;
        });
    }
</script>

@RenderSection("Scripts", required: false)
</body>
</html>