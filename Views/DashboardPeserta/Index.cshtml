                                                style="flex:1; border:1px solid #e2e8f0; border-radius:6px; padding:4px 8px;" disabled>
                                            <input id="revisiSelesai" type="date" class="revisi-input" 
                                                style="flex:1; border:1px solid #e2e8f0; border-radius:6px; padding:4px 8px;" disabled>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
