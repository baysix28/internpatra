@model IEnumerable<sinta_asp.Models.Mahasiswa>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manajemen Pendaftaran | SINTA";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">

<style>
    :root {
        --primary: #00549B;
        --primary-light: #e6f0f8;
        --primary-gradient: linear-gradient(135deg, #00549B 0%, #0086D6 100%);
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-400: #94a3b8;
        --slate-600: #475569;
        --slate-900: #0f172a;
        --radius-lg: 20px;
        --radius-md: 12px;
        --radius-sm: 8px;
        --shadow-sm: 0 4px 12px rgba(0, 84, 155, 0.08);
        --shadow-md: 0 8px 32px rgba(0, 84, 155, 0.12);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: #f8fafc;
        color: var(--slate-900);
    }

    /* Table Styles */
    .table-modern thead th {
        background: var(--primary);
        color: white;
        padding: 1rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        border: none;
    }

    .table-modern tbody tr {
        transition: all 0.2s;
    }

    .table-modern tbody tr:hover {
        background-color: var(--slate-50);
    }

    .name-bold { font-weight: 700; color: var(--slate-900); }
    .email-sub { font-size: 0.75rem; color: var(--slate-400); }

    /* Custom Checkbox */
    .form-check-input:checked {
        background-color: var(--primary);
        border-color: var(--primary);
    }

    /* Modal Styling */
    .border-dashed {
        border: 2px dashed var(--slate-200);
        border-radius: var(--radius-md);
        transition: all 0.3s;
    }
    .border-dashed:hover { border-color: var(--primary); background: var(--primary-light); }
</style>

<div class="admin-container">
    <div class="header-section">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-4">
            <div>
                <h1 class="fw-800 mb-2" style="font-size: 2.2rem; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Registrations Management
                </h1>
                <p class="text-muted">Kelola dan monitor seluruh pendaftaran mahasiswa</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn-secondary-modern" data-bs-toggle="modal" data-bs-target="#importModal">
                    <i class="fas fa-file-import"></i> Import
                </button>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card total">
                <div class="stat-value">@Model?.Count()</div>
                <div class="stat-label">Total Pendaftar</div>
            </div>
            <div class="stat-card pending">
                <div class="stat-value">@Model?.Count(m => m.Status == "Pending" || m.Status == null)</div>
                <div class="stat-label">Pending</div>
            </div>
            <div class="stat-card approved">
                <div class="stat-value">@Model?.Count(m => m.Status == "Diterima")</div>
                <div class="stat-label">Diterima</div>
            </div>
        </div>
    </div>

    <div class="advanced-search-card mt-4">
        <div class="row g-3">
            <div class="col-md-8">
                <div class="search-input-group">
                    <i class="fas fa-search"></i>
                    <input type="text" id="customSearch" placeholder="Cari Mahasiswa, NIM, atau Kampus...">
                </div>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn-secondary-modern" onclick="location.reload()">
                    <i class="fas fa-sync"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <div class="custom-card mt-4">
        <div class="table-responsive">
            <table class="table-modern" id="registrationTable">
                <thead>
                    <tr>
                        <th width="40"><input type="checkbox" class="form-check-input" id="selectAll"></th>
                        <th>Mahasiswa</th>
                        <th>Institusi</th>
                        <th>Kategori</th>
                        <th>Status</th>
                        <th class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td><input type="checkbox" class="form-check-input row-checkbox" value="@item.Id"></td>
                                <td>
                                    <div class="avatar-wrapper">
                                        <div class="avatar-img">@(string.IsNullOrEmpty(item.NamaLengkap) ? "?" : item.NamaLengkap.Substring(0, 1))</div>
                                        <div>
                                            <div class="name-bold">@item.NamaLengkap</div>
                                            <div class="email-sub">@item.NIM</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-600">@item.NamaKampus</div>
                                    <div class="small text-muted">@item.Jurusan</div>
                                </td>
                                <td><span class="badge bg-light text-primary border">@item.TipePendaftaran</span></td>
                                <td>
                                    @{
                                        var s = item.Status ?? "Pending";
                                        var cls = s == "Diterima" ? "status-approve" : (s == "Ditolak" ? "status-reject" : "status-pending");
                                        var icon = s == "Diterima" ? "fa-check" : (s == "Ditolak" ? "fa-times" : "fa-clock");
                                    }
                                    <span class="badge-status @cls">
                                        <i class="fas @icon"></i> @s
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="@Url.Action("Details", "Mahasiswa", new { id = item.Id })" class="btn-action view"><i class="far fa-eye"></i></a>
                                        <button class="btn-action delete" onclick="deleteRegistration('@item.Id')"><i class="far fa-trash-alt"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="bulk-actions-panel" id="bulkActionsPanel" style="display: none;">
    <span class="fw-600 me-3" id="bulkSelectionCount">0 terpilih</span>
    <button class="btn btn-sm btn-success" onclick="bulkApprove()">Terima</button>
    <button class="btn btn-sm btn-danger" onclick="bulkReject()">Tolak</button>
    <button class="btn btn-sm btn-link text-dark" onclick="clearSelection()">Batal</button>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    $(document).ready(function() {
        // Search Logic
        $("#customSearch").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $("#registrationTable tbody tr").filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });

        // Select All Logic
        $("#selectAll").click(function() {
            $(".row-checkbox").prop('checked', $(this).prop('checked'));
            updateBulkPanel();
        });

        $(".row-checkbox").change(function() {
            updateBulkPanel();
        });

        function updateBulkPanel() {
            var count = $(".row-checkbox:checked").length;
            $("#bulkSelectionCount").text(count + " item dipilih");
            if (count > 0) {
                $("#bulkActionsPanel").fadeIn().css('display', 'flex');
            } else {
                $("#bulkActionsPanel").fadeOut();
            }
        }
    });

    function deleteRegistration(id) {
        if(confirm('Apakah Anda yakin ingin menghapus data ini?')) {
            // Lakukan AJAX Delete di sini
            console.log("Deleting ID: " + id);
        }
    }

    function clearSelection() {
        $(".row-checkbox, #selectAll").prop('checked', false);
        $("#bulkActionsPanel").fadeOut();
    }
</script>