@model sinta_asp.Models.Magang

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="~/js/Tooltip.js"></script>


@{
    ViewData["Title"] = "Data Diri - Program Magang Pertamina";
}

<style>
    :root {
        --pertamina-blue: #005EB8;
        --pertamina-green: #00A859;
        --pertamina-red: #E30613;
        --pertamina-dark: #003B76;
        --background-light: #F4F6F8;
        --text-dark: #333333;
        --text-light: #666666;
        --border-color: #D1D5DB;
        --shadow-light: rgba(0, 94, 184, 0.08);
        --shadow-medium: rgba(0, 94, 184, 0.15);
    }

    body {
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
        position: relative;
        overflow-x: hidden;
        min-height: 100vh;
        font-size: 14px;
    }

    body::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background-image: 
            radial-gradient(circle at 15% 50%, rgba(0, 94, 184, 0.03) 0%, transparent 20%),
            radial-gradient(circle at 85% 30%, rgba(0, 168, 89, 0.03) 0%, transparent 20%),
            radial-gradient(circle at 50% 80%, rgba(227, 6, 19, 0.02) 0%, transparent 20%);
        z-index: -1;
    }

    /* ================= STEPPER ================= */
    .step-wrapper {
        background: white;
        padding: 18px 0;
        box-shadow: 0 2px 10px var(--shadow-light);
        margin-bottom: 25px;
    }

    .step {
        position: relative;
        display: flex;
        justify-content: space-between;
        max-width: 760px;
        margin: auto;
        padding: 0 20px;
    }

    .step::before {
        content: "";
        position: absolute;
        top: 18px;
        left: 15%;
        right: 15%;
        height: 2px;
        background: var(--border-color);
        z-index: 0;
    }

    .step-item {
        text-align: center;
        font-size: 12px;
        color: var(--text-light);
        width: 25%;
        position: relative;
        z-index: 1;
        cursor: pointer;
    }

    .step-circle {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 2px solid var(--border-color);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 8px;
        font-weight: 700;
        font-size: 13px;
        box-shadow: 0 2px 6px var(--shadow-light);
    }

    .error-dot {
        position: absolute;
        top: -6px;
        right: 26%;
        background: var(--pertamina-red);
        color: white;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        font-size: 11px;
        font-weight: bold;
        display: none;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        z-index: 5;
    }

    .step-active {
        color: var(--pertamina-red);
        font-weight: 600;
    }

    .step-active .step-circle {
        background: var(--pertamina-red);
        color: white;
        border-color: var(--pertamina-red);
        transform: scale(1.1);
    }

    /* ================= CARD ================= */
    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px var(--shadow-medium);
        background: white;
        overflow: hidden;
        position: relative;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 4px;
        background: linear-gradient(90deg, var(--pertamina-blue), var(--pertamina-green), var(--pertamina-red));
    }

    .card-body {
        padding: 24px !important;
    }

    /* ================= UPLOAD FOTO ================= */
    .upload-box {
        border: 2px dashed var(--pertamina-blue);
        border-radius: 14px;
        width: 180px;
        height: 230px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background: #f9fbfd;
        overflow: hidden;
    }

    .upload-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ================= FORM ================= */
    .form-label {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 6px;
        font-size: 13px;
    }

    .form-control {
        padding: 10px 14px;
        border-radius: 8px;
        border: 1.8px solid var(--border-color);
        font-size: 13px;
    }

    /* ================= BUTTON ================= */
    .btn-custom {
        padding: 10px 26px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
    }

    .btn-back {
        background: #6c757d;
        color: white;
    }

    .btn-next {
        background: var(--pertamina-blue);
        color: white;
    }

    /* ===== STEP VISIBILITY FIX ===== */
    .step-content {
        display: none;
    }

    .step-content.active {
        display: block;
    }

   /* ================= TOOLTIP HOVER ================= */
    .lokasi-tooltip {
        position: fixed; /* WAJIB: Agar bisa muncul di atas dropdown yang melayang */
        background: linear-gradient(135deg, #2c3e50, #1a1a2e);
        color: #fff;
        padding: 14px;
        border-radius: 10px;
        font-size: 12px;
        width: 280px;
        z-index: 99999; /* Sangat tinggi */
        display: none;
        box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        border-left: 5px solid var(--pertamina-red);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .lokasi-tooltip.show {
        display: block;
        opacity: 1;
    }

    .lokasi-tooltip h6 {
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 6px;
        color: #fff;
    }

    .lokasi-tooltip p {
        margin-bottom: 0;
        line-height: 1.5;
        color: #e0e0e0;
    }

    .lokasi-tooltip::after {
        content: "";
        position: absolute;
        top: 20px;
        left: -10px;
        border-width: 5px;
        border-style: solid;
        border-color: transparent var(--pertamina-red) transparent transparent;
    }

    /* ================= MODAL KONFIRMASI ================= */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .modal-overlay.show {
        display: flex;
    }

    .modal-box {
        background: white;
        border-radius: 14px;
        padding: 28px 24px;
        max-width: 420px;
        width: 100%;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
        text-align: center;
        animation: scaleIn 0.25s ease;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0.9);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-icon {
        font-size: 42px;
        color: var(--pertamina-blue);
        margin-bottom: 12px;
    }

    .modal-title {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .modal-text {
        font-size: 13px;
        color: var(--text-light);
        margin-bottom: 22px;
    }

    .modal-buttons {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .modal-btn {
        padding: 8px 18px;
        border-radius: 6px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .modal-btn-cancel {
        background: #6c757d;
        color: white;
    }

    .modal-btn-confirm {
        background: var(--pertamina-green);
        color: white;
    }

    /* Gaya untuk pesan error di bawah input */
    .error-message {
        color: var(--pertamina-red);
        font-size: 11px;
        font-weight: 600;
        margin-top: 4px;
        display: none; /* Sembunyi secara default */
        align-items: center;
        gap: 4px;
    }

    .is-invalid {
        border-color: var(--pertamina-red) !important;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }

    #error-final {
        animation: shake 0.3s ease-in-out;
        background-color: rgba(227, 6, 19, 0.05); /* Merah tipis transparan */
        padding: 10px;
        border-radius: 8px;
        border: 1px solid var(--pertamina-red);
    }

    /* Container untuk mengatur posisi tombol di kanan */
    .header-action-container {
        display: flex;
        justify-content: flex-end; /* Memindah tombol ke sisi kanan */
        margin-bottom: 20px;
    }

    .btn-sinta-back {
        display: inline-flex;
        align-items: center;
        padding: 8px 24px;
        background-color: var(--pertamina-blue); /* Biru Pertamina sesuai :root kamu */
        color: #ffffff !important;
        border-radius: 50px; /* Membuat bentuk kapsul sempurna */
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(0, 94, 184, 0.2);
        border: none;
    }

    .btn-sinta-back i {
        margin-right: 10px;
        font-size: 12px;
    }

    .btn-sinta-back:hover {
        background-color: var(--pertamina-dark);
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(0, 94, 184, 0.3);
        color: #ffffff;
    }

    /* Biar gak tabrakan sama elemen lain di mobile */
    @@media (max-width: 768px) {
        .btn-sinta-back {
            padding: 6px 18px;
            font-size: 13px;
        }
    }
</style>

<div class="step-wrapper">
    <div class="step">
        <div class="step-item step-active" onclick="showStep(1)" id="step-tab-1">
            <div class="error-dot" id="dot-1">!</div>
            <div class="step-circle">1</div>
            <div>Data Diri</div>
        </div>
        <div class="step-item" onclick="showStep(2)" id="step-tab-2">
            <div class="error-dot" id="dot-2">!</div>
            <div class="step-circle">2</div>
            <div>Data Kampus</div>
        </div>
        <div class="step-item" onclick="showStep(3)" id="step-tab-3">
            <div class="error-dot" id="dot-3">!</div>
            <div class="step-circle">3</div>
            <div>Data Magang</div>
        </div>
        <div class="step-item" onclick="showStep(4)" id="step-tab-4">
            <div class="error-dot" id="dot-4">!</div>
            <div class="step-circle">4</div>
            <div>File Pendukung</div>
        </div>
    </div>
</div>

<div class="container my-3" style="max-width: 700px;">
    <div class="d-flex justify-content-between mb-3">
        <a href="javascript:history.back()" class="btn-sinta-back">
            <i class="fas fa-chevron-left"></i> Back
        </a>
    </div>

    <div class="card">
        <div class="card-body p-4">

            <form id="formMagang" asp-action="Store" asp-controller="PendaftaranMagang" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

            <!-- ================= STEP 1 ================= -->
            <div id="content-1" class="step-content active">
                <h5><i class="fas fa-user-circle"></i> Data Diri Peserta</h5>

                <div class="mb-3 text-center">
                    <input type="file" id="foto" name="Foto" hidden accept="image/*">
                    <label for="foto" style="cursor: pointer;">
                        <div class="upload-box" id="uploadBox">
                            <img id="preview" style="display: none;">
                            <div class="upload-placeholder" id="placeholder">
                                <i class="fas fa-camera fa-3x mb-2 text-primary"></i><br>
                                <strong>Upload Foto</strong><br>
                                <small>Pas Foto (Max 2MB)</small>
                            </div>
                        </div>
                    </label>
                    <div id="error-foto" class="error-message justify-content-center">
                        <i class="fas fa-exclamation-circle"></i> Ukuran foto maksimal 2MB!
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nama Lengkap <span class="text-danger">*</span></label>
                        <input type="text" class="form-control wajib" id="nama" name="NamaLengkap" placeholder="Masukkan nama lengkap">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Email</label>
                        <input type="email" class="form-control" value="@Model.EmailPribadi" readonly />
                        <input type="hidden" name="EmailPribadi" value="@Model.EmailPribadi" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tempat Lahir <span class="text-danger">*</span></label>
                        <input type="text" class="form-control wajib" id="tempat_lahir" name="TempatLahir" placeholder="Masukkan tempat lahir">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tanggal Lahir <span class="text-danger">*</span></label>
                        <input type="date" class="form-control wajib" id="tanggal_lahir" name="TanggalLahir">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">No HP <span class="text-danger">*</span></label>
                        <input type="tel" class="form-control wajib" id="no_hp" name="NoHp" placeholder="Contoh: 08123456789" maxlength="13"
                            oninput="validatePhone(this)" pattern="^08[0-9]{7,11}$">
                        <div id="hp-error" class="error-message">Nomor harus diawali 08 dan maksimal 13 digit.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Instagram <span class="text-danger">*</span></label>
                        <input type="text" class="form-control wajib" id="instagram" name="Instagram" placeholder="Masukkan username Instagram">
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn-custom btn-next" onclick="showStep(2)">Selanjutnya</button>
                </div>
            </div>

            <!-- ================= STEP 2 ================= -->
            <div id="content-2" class="step-content">
                <h5><i class="fas fa-university"></i> Data Kampus</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nama Perguruan Tinggi <span class="text-danger">*</span></label>
                        <input type="text" class="form-control wajib" id="perguruan_tinggi" name="NamaPerguruanTinggi" placeholder="Masukkan nama perguruan tinggi">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fakultas <span class="text-danger">*</span></label>
                        <input type="text" class="form-control wajib" id="fakultas" name="Fakultas" placeholder="Masukkan fakultas">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Jurusan <span class="text-danger">*</span></label>
                        <input type="text" class="form-control wajib" id="jurusan" name="Jurusan" placeholder="Masukkan jurusan">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">NIM <span class="text-danger">*</span></label>
                        <input type="text" class="form-control wajib" id="nim" name="NIM" placeholder="Masukkan NIM">
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="button" class="btn-custom btn-back" onclick="showStep(1)">Kembali</button>
                    <button type="button" class="btn-custom btn-next" onclick="showStep(3)">Selanjutnya</button>
                </div>
            </div>

            <!-- ================= STEP 3 ================= -->
            <div id="content-3" class="step-content">
                <h5><i class="fas fa-briefcase"></i> Data Magang</h5>

                <div class="mb-3">
                    <label class="form-label">Company <span class="text-danger">*</span></label>
                    <select class="form-select form-control wajib" id="company" name="Company">
                        <option value="">Pilih Company</option>
                        <option value="KPI">PT Kilang Pertamina Internasional</option>
                        <option value="PPN">PT Pertamina Patra Niaga</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Region<span class="text-danger">*</span></label>
                    <select class="form-select form-control wajib" id="region" name="Region">
                        <option value="">Pilih Region</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Lokasi<span class="text-danger">*</span></label>
                    <select class="form-select form-control wajib" id="lokasi" name="Lokasi">
                        <option value="">Pilih Lokasi</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rekomendasi Pegawai</label>
                    <input type="text" class="form-control" id="rekomendasi" name="RekomendasiPegawai" placeholder="Nama Pegawai (fungsi)">
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mulai Magang <span class="text-danger">*</span></label>
                        <input type="date" class="form-control wajib" id="tanggal_mulai" name="MulaiMagang">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Selesai Magang <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="SelesaiMagang" name="SelesaiMagang">
                        <div id="error-selesai" class="text-danger" style="display:none; font-size: 12px; margin-top: 5px;">
                            Tanggal tidak valid!
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="button" class="btn-custom btn-back" onclick="showStep(2)">Kembali</button>
                    <button type="button" class="btn-custom btn-next" onclick="showStep(4)">Selanjutnya</button>
                </div>
            </div>

            <!-- ================= STEP 4 ================= -->
            <div id="content-4" class="step-content">
                <h5><i class="fas fa-file-alt"></i> File Pendukung</h5>

                <div class="mb-3">
                    <label class="form-label">CV <span class="text-danger">*</span></label>
                    <input type="file" class="form-control wajib" id="file_cv" name="FileCV" accept=".pdf">
                    <div id="error-file_cv" class="error-message">
                        <i class="fas fa-exclamation-circle"></i> Ukuran file maksimal 5MB!
                    </div>
                    <small class="text-muted">Format PDF, maksimal 5MB.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Surat Pengantar <span class="text-danger">*</span></label>
                    <input type="file" class="form-control wajib" id="file_surat_pengantar" name="FileSuratPengantar" accept=".pdf">
                    <div id="error-file_surat_pengantar" class="error-message">
                        <i class="fas fa-exclamation-circle"></i> Ukuran file maksimal 5MB!
                    </div>
                    <small class="text-muted">Format PDF, maksimal 5MB.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label">Proposal <span class="text-danger">*</span></label>
                    <input type="file" class="form-control wajib" id="file_transkrip" name="FileProposal" accept=".pdf">
                    <div id="error-file_transkrip" class="error-message">
                        <i class="fas fa-exclamation-circle"></i> Ukuran file maksimal 5MB!
                    </div>
                    <small class="text-muted">Format PDF, maksimal 5MB.</small>
                </div>

                <div id="error-final" class="error-message justify-content-center mb-3" style="font-size: 14px;">
                    <i class="fas fa-exclamation-triangle"></i> Mohon lengkapi semua data yang wajib diisi (cek tanda seru merah di atas)!
                </div>

                <div class="d-flex justify-content-between">
                    <button type="button" class="btn-custom btn-back" onclick="showStep(3)">Kembali</button>
                    <button type="button" class="btn-custom btn-next"
                            style="background:var(--pertamina-green)"
                            onclick="simpanSemua()">
                        Simpan Data
                    </button>
                </div>
            </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Konfirmasi -->
<div class="modal-overlay" id="modalKonfirmasi">
    <div class="modal-box">
        <div class="modal-icon">
            <i class="fas fa-question-circle"></i>
        </div>
        <div class="modal-title">Konfirmasi Pengiriman Data</div>
        <div class="modal-text">
            Apakah Anda yakin data yang Anda isi sudah benar dan siap untuk dikirim?
            Pastikan semua informasi sudah sesuai sebelum melanjutkan.
        </div>
        <div class="modal-buttons">
            <button type="button"
                    class="modal-btn modal-btn-cancel"
                    onclick="tutupModal()">
                Tidak
            </button>

            <button type="button"
                    class="modal-btn modal-btn-confirm"
                    onclick="konfirmasiKirim()">
                Ya, Kirim Data
            </button>
        </div>
    </div>
</div>

<!-- Tooltip diletakkan di sini, di luar container -->
<div id="tooltipHover" class="lokasi-tooltip">
    <h6 id="tooltipHoverTitle">Tentang Posisi</h6>
    <p id="tooltipHoverDesc"></p>
</div>

@section Scripts {
<script>
    let fotoTerisi = false;
    
