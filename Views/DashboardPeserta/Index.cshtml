                                <i class="fa-solid fa-floppy-disk me-2"></i> Simpan Perubahan
                            </button>

                            <button type="button" id="btnEditTrigger" class="btn-edit-link">
                                <i class="fa-solid fa-pencil mr-1"></i> Edit Informasi
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="tab-security" role="tabpanel">
                <div class="p-4">
                    <div class="mb-4">
                        <h5 class="font-weight-bold">Keamanan Akun</h5>
                        <p class="text-muted small">Disarankan untuk mengganti kata sandi secara berkala untuk menjaga keamanan akun Anda.</p>
                    </div>
                    <form id="securityForm" onsubmit="updatePassword(event)" style="max-width: 100%;">
                        <!-- KATA SANDI SAAT INI -->
                        <div class="mb-4">
                            <label class="label-custom">KATA SANDI SAAT INI</label>
                            <div class="input-group-security">
                                <input type="password" id="oldPass" class="form-control input-security-clean" 
                                    placeholder="••••••••" readonly required>
                                <div class="append-security" style="display: none;">
                                    <span onclick="togglePassword('oldPass')" style="cursor: pointer;">
                                        <i class="fa-solid fa-eye" id="icon-oldPass"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <!-- KATA SANDI BARU -->
                            <div class="col-md-6 mb-4">
                                <label class="label-custom">KATA SANDI BARU</label>
                                <div class="input-group-security">
                                    <input type="password" id="newPass" class="form-control input-security-clean" 
                                        placeholder="••••••••" readonly required>
                                    <div class="append-security" style="display: none;">
                                        <span onclick="togglePassword('newPass')" style="cursor: pointer;">
                                            <i class="fa-solid fa-eye" id="icon-newPass"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- KONFIRMASI PASSWORD -->
                            <div class="col-md-6 mb-4">
                                <label class="label-custom">KONFIRMASI PASSWORD</label>
                                <div class="input-group-security">
                                    <input type="password" id="confirmPass" class="form-control input-security-clean" 
                                        placeholder="••••••••" readonly required>
                                    <div class="append-security" style="display: none;">
                                        <span onclick="togglePassword('confirmPass')" style="cursor: pointer;">
                                            <i class="fa-solid fa-eye" id="icon-confirmPass"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-right mt-4">
                            <button type="button" id="btnBatalPassword" class="btn btn-batal-custom mr-2" style="display: none;">
                                <i class="fa-solid fa-xmark"></i> Batal
                            </button>
                            <button type="submit" id="btnSimpanPassword" class="btn btn-simpan-pertamina px-4" style="display: none;">
                                <i class="fa-solid fa-check-circle me-2"></i> Perbarui Kata Sandi
                            </button>

                            <button type="button" id="btnEditPassword" class="btn-edit-link">
                                <i class="fa-solid fa-key mr-1"></i> Ubah Kata Sandi
                            </button>
                        </div>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
</div>

    </div><!-- /container-fluid -->
</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // ===== GLOBAL FUNCTIONS (harus di luar document.ready agar onclick inline bisa akses) =====

    var isEditing = false;
    var originalData = "";

    function getSnapshot() {
        return JSON.stringify({
            nama: $('#inputNama').val(),
            noHp: $('#inputNoHP').val(),
            univ: $('#inputUniv').val(),
            old: $('#oldPass').val(),
            newp: $('#newPass').val(),
            conf: $('#confirmPass').val()
        });
    }

    function isDirty() {
        if (!isEditing) return false;
        return getSnapshot() !== originalData;
    }

    function forceReset() {
        isEditing = false;
        originalData = "";

        $('.input-security-clean').prop('readonly', true).css('background-color', '#f8fafc');

        $('#btnSimpan, #btnBatal').hide();
        $('#btnEditTrigger').show();

        $('.append-security').hide();
        $('#btnSimpanPassword, #btnBatalPassword').hide();
        $('#btnEditPassword').show();
    }

    function _navigatePage(pageId) {
        document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
        var target = document.getElementById('page-' + pageId);
        if (target) target.classList.add('active');

        document.querySelectorAll('.nav-link-custom').forEach(n => n.classList.remove('active'));
        var navTarget = document.getElementById('nav-' + pageId);
        if (navTarget) navTarget.classList.add('active');

        localStorage.setItem('lastOpenedPage', pageId);
    }

    function showPage(pageId) {
        if (isDirty()) {
            Swal.fire({
                title: 'Simpan Perubahan?',
                text: "Kamu sudah mengubah data. Jika pindah, perubahanmu akan hilang.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#00549B',
                confirmButtonText: 'Ya, Pindah',
                cancelButtonText: 'Tetap di Sini'
            }).then(function(result) {
                if (result.isConfirmed) {
                    forceReset();
                    _navigatePage(pageId);
                }
            });
        } else {
            forceReset();
            _navigatePage(pageId);
        }
    }

    function toggleSidebar() {
        document.querySelector('.sidebar').classList.toggle('collapsed');
        document.querySelector('.main-content').classList.toggle('expanded');
        document.querySelector('.topbar').classList.toggle('expanded');
    }

    function togglePassword(inputId) {
        var input = document.getElementById(inputId);
        var icon = document.getElementById('icon-' + inputId);
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = "password";
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    function filterTabel(status, element) {
        // Reset semua card
        document.querySelectorAll('[data-color]').forEach(function(card) {
            var c = card.getAttribute('data-color');
            card.style.background = '#fff';
            card.style.transform = 'none';
            card.style.border = 'none';
            card.style.borderTop = '4px solid ' + c;
        });

        // Highlight hanya yang diklik
        var color = element.getAttribute('data-color');
        element.style.background = color + '18';
        element.style.transform = 'translateY(-2px)';
        element.style.borderTop = '4px solid ' + color;

        // Filter baris tabel
        document.querySelectorAll('#tabelBodyRiwayat .baris-magang').forEach(function(row) {
            var statusBaris = row.getAttribute('data-status');
            row.style.display = (status === 'Semua' || statusBaris === status) ? '' : 'none';
        });
    }

    function handleLogout() {
        Swal.fire({
            title: 'Keluar?',
            text: "Sesi akan berakhir",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ec1c24',
            confirmButtonText: 'Logout'
        }).then(function(r) {
            if (r.isConfirmed) {
                localStorage.removeItem('form_magang_draft');
                localStorage.clear();
                sessionStorage.clear();
                window.location.href = '/Auth/Logout';
            }
        });
    }

    function saveProfile() {
        Swal.fire({
            title: 'Menyimpan...',
            allowOutsideClick: false,
            didOpen: function() { Swal.showLoading(); }
        });

        $.ajax({
            url: '/DashboardPeserta/UpdateProfil',
            type: 'POST',
            data: {
                nama: $('#inputNama').val(),
                noHp: $('#inputNoHP').val(),
                univ: $('#inputUniv').val()
            },
            success: function(res) {
                if (res.success) {
                    Swal.fire('Berhasil', 'Profil diperbarui!', 'success').then(function() {
                        forceReset();
                        $('.font-weight-bold.mb-1').text($('#inputNama').val());
                    });
                } else {
                    Swal.fire('Gagal', res.message, 'error');
                }
            },
            error: function() {
                Swal.fire('Error', 'Gagal tersambung ke server', 'error');
            }
        });
    }

    function updatePassword(e) {
        e.preventDefault();

        var oldP = $('#oldPass').val();
        var newP = $('#newPass').val();
        var confirmP = $('#confirmPass').val();

        if (!oldP || !newP || !confirmP) {
            Swal.fire('Opps!', 'Semua kolom password wajib diisi.', 'warning');
            return;
        }
        if (newP !== confirmP) {
            Swal.fire('Error', 'Konfirmasi password tidak cocok!', 'error');
            return;
        }

        Swal.fire({ title: 'Memproses...', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });

        $.ajax({
            url: '/DashboardPeserta/UpdatePassword',
            type: 'POST',
            data: {
                oldPass: oldP,
                newPass: newP,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(res) {
                if (res.success) {
                    Swal.fire('Berhasil!', 'Password diperbarui.', 'success');
                    $('#securityForm')[0].reset();
                    forceReset();
                } else {
                    Swal.fire('Gagal!', res.message, 'error');
                }
            },
            error: function(xhr) {
                console.log(xhr.responseText);
                Swal.fire('Error!', 'Terjadi kesalahan sistem.', 'error');
            }
        });
    }

    function uploadFoto(input) {
        if (!input.files || !input.files[0]) return;
        var file = input.files[0];

        if (file.size > 2 * 1024 * 1024) {
            Swal.fire('Opps!', 'Ukuran file terlalu besar (Max 2MB)', 'error');
            input.value = '';
            return;
        }

        var formData = new FormData();
        formData.append('fotoProfil', file);

        $.ajax({
            url: '/DashboardPeserta/UpdateFoto',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                if (res.success) {
                    var newPath = res.filePath + '?t=' + new Date().getTime();
                    if ($('#imgPreview').length) {
                        $('#imgPreview').attr('src', newPath);
                    } else {
                        $('#avatarContainer').html('<img src="' + newPath + '" id="imgPreview" style="width:100%; height:100%; object-fit:cover;">');
                    }
                    $('#navbarAvatar').attr('src', newPath);
                    Swal.fire({ icon: 'success', title: 'Berhasil!', text: 'Foto profil diperbarui.', timer: 1500, showConfirmButton: false });
                } else {
                    Swal.fire('Gagal!', res.message, 'error');
                }
            },
            error: function() {
                Swal.fire('Error!', 'Gagal menghubungi server.', 'error');
            }
        });
    }

    function deletePhoto() {
        Swal.fire({
            title: 'Hapus foto?',
            text: 'Foto profil akan dihapus.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Ya, Hapus'
        }).then(function(result) {
            if (result.isConfirmed) {
                $.post('/DashboardPeserta/DeleteFoto', function(res) {
                    if (res.success) { location.reload(); }
                });
            }
        });
    }

    function viewPhoto() {
        var photoUrl = $('#imgPreview').attr('src');
        if (!photoUrl) {
            Swal.fire('Info', 'Anda belum mengunggah foto profil.', 'info');
            return;
        }
        Swal.fire({ imageUrl: photoUrl, imageAlt: 'Foto Profil', showCloseButton: true, showConfirmButton: false, background: '#fff' });
    }

    function selectPhoto() {
        $('#fileInputFoto').click();
    }

    // ===== INFORMASI TERSEDIA =====
    var informasiData = [];

    function loadInformasiTersedia() {
        var container = document.getElementById('informasiGroupedContainer');

        fetch('/DashboardPeserta/GetInformasiTersedia')
            .then(function(response) { return response.json(); })
            .then(function(data) {
                informasiData = (data || []).map(function(item) {
                    var isKPI = (item.region || '').trim() === 'Refinery Unit VI Balongan';
                    return Object.assign({}, item, {
                        companyCode: isKPI ? 'KPI' : 'PPN',
                        companyName: isKPI ? 'PT Kilang Pertamina Internasional' : 'PT Pertamina Patra Niaga'
                    });
                });
                updateSummary(informasiData);
                populateCompanyFilter(informasiData);
                populateRegionFilter(informasiData);
                renderGroupedInformasi(informasiData);
                bindInformasiFilterEvents();
            })
            .catch(function(error) {
                container.innerHTML = '<div class="info-empty-state"><i class="fa fa-circle-exclamation mb-3" style="font-size:32px;"></i><div class="font-weight-bold mb-1">Gagal memuat data lokasi magang</div><div class="small">Silakan coba beberapa saat lagi.</div></div>';
                console.error(error);
            });
    }

    function updateSummary(data) {
        document.getElementById('summaryTotalLokasi').textContent = data.length;
        document.getElementById('summaryTotalCompany').textContent = 2;
        document.getElementById('summaryTotalRegion').textContent = new Set(data.map(function(x) { return x.region; })).size;
    }

    function populateCompanyFilter(data) {
        var companySelect = document.getElementById('filterCompanyInformasi');
        var selectedCompany = companySelect.value;
        var companies = [...new Set(data.map(function(x) { return x.companyName; }))].sort();
        companySelect.innerHTML = '<option value="">Semua Company</option>' +
            companies.map(function(x) { return '<option value="' + x + '">' + x + '</option>'; }).join('');
        companySelect.value = selectedCompany;
    }

    function populateRegionFilter(data) {
        var companySelect = document.getElementById('filterCompanyInformasi');
        var regionSelect = document.getElementById('filterRegionInformasi');
        var selectedCompany = companySelect.value;
        var previousRegion = regionSelect.value;

        if (!selectedCompany) {
            regionSelect.innerHTML = '<option value="">Pilih company terlebih dahulu</option>';
            regionSelect.value = '';
            regionSelect.disabled = true;
            return;
        }

        var filteredByCompany = data.filter(function(item) { return item.companyName === selectedCompany; });
        var regions = [...new Set(filteredByCompany.map(function(x) { return x.region; }))].sort();

        regionSelect.disabled = false;
        regionSelect.innerHTML = '<option value="">Semua Regional</option>' +
            regions.map(function(x) { return '<option value="' + x + '">' + x + '</option>'; }).join('');

        if (regions.includes(previousRegion)) {
            regionSelect.value = previousRegion;
        } else {
            regionSelect.value = '';
        }
    }

    function resetInformasiFilter() {
        document.getElementById('filterSearchInformasi').value = '';
        document.getElementById('filterCompanyInformasi').value = '';
        populateRegionFilter(informasiData);
        renderGroupedInformasi(informasiData);
    }

    function renderGroupedInformasi(data) {
        var container = document.getElementById('informasiGroupedContainer');
        var search = document.getElementById('filterSearchInformasi').value.toLowerCase().trim();
        var company = document.getElementById('filterCompanyInformasi').value;
        var region = document.getElementById('filterRegionInformasi').value;

        var filtered = data.filter(function(item) {
            var companyName = (item.companyName || '').toLowerCase();
            var regionName = (item.region || '').toLowerCase();
            var lokasiName = (item.lokasi || '').toLowerCase();
            var matchSearch = lokasiName.includes(search) || regionName.includes(search) || companyName.includes(search);
            var matchCompany = !company || item.companyName === company;
            var matchRegion = !region || item.region === region;
            return matchSearch && matchCompany && matchRegion;
        });

        if (filtered.length === 0) {
            container.innerHTML = '<div class="info-empty-state"><i class="fa fa-folder-open mb-3" style="font-size:32px;"></i><div class="font-weight-bold mb-1">Data tidak ditemukan</div><div class="small">Coba ubah kata kunci pencarian atau filter yang dipilih.</div></div>';
            return;
        }

        var grouped = { KPI: [], PPN: [] };
        filtered.forEach(function(item) {
            if (item.companyCode === 'KPI') grouped.KPI.push(item);
            else grouped.PPN.push(item);
        });

        var companyMeta = {
            KPI: { code: 'KPI', name: 'PT Kilang Pertamina Internasional', labelClass: 'kpi' },
            PPN: { code: 'PPN', name: 'PT Pertamina Patra Niaga', labelClass: 'ppn' }
        };

        function groupByRegion(items) {
            var regionMap = {};
            items.forEach(function(item) {
                if (!regionMap[item.region]) regionMap[item.region] = [];
                regionMap[item.region].push(item);
            });
            return regionMap;
        }

        function renderCompanyCard(companyCode, items) {
            if (!items.length) {
                return '<div class="col-lg-6 mb-4"><div class="info-company-main-card"><div class="info-company-header"><span class="info-company-label ' + companyMeta[companyCode].labelClass + '">' + companyCode + '</span><div class="info-company-name">' + companyMeta[companyCode].name + '</div><div class="info-company-code">Lokasi magang yang tersedia</div></div><div class="info-company-body"><div class="info-empty-state">Belum ada data lokasi yang tampil untuk filter ini.</div></div></div></div>';
            }

            var byRegion = groupByRegion(items);
            var totalLokasi = items.length;
            var totalRegional = Object.keys(byRegion).length;
            var regionHtml = '';

            Object.keys(byRegion).sort().forEach(function(regionName) {
                var lokasiItems = byRegion[regionName];
                var lokasiHtml = lokasiItems.map(function(item) {
                    return '<div class="info-lokasi-item d-flex justify-content-between align-items-center"><div class="info-lokasi-left"><div class="info-lokasi-name font-weight-bold" style="color: #334155;">' + item.lokasi + '</div><div class="text-success small d-flex align-items-center" style="font-weight: 700;"><i class="fa-solid fa-circle-check mr-1"></i> Terbuka</div></div><div class="info-lokasi-right"><button class="btn btn-sm btn-detail-lokasi" style="background-color: var(--p-blue); color: white; border-radius: 20px; font-weight: 800; font-size: 10px; padding: 5px 15px; border: none;" data-lokasi="' + item.lokasi + '" data-region="' + item.region + '" data-company="' + companyCode + '" onclick="showDetailLokasi(this)">DETAIL</button></div></div>';
                }).join('');

                regionHtml += '<div class="info-region-card"><div class="info-region-header"><div class="info-region-title font-weight-bold">' + regionName + '</div><div class="info-region-count">' + lokasiItems.length + ' lokasi / unit</div></div><div class="info-lokasi-list">' + lokasiHtml + '</div></div>';
            });

            return '<div class="col-lg-6 mb-4"><div class="info-company-main-card"><div class="info-company-header"><span class="info-company-label ' + companyMeta[companyCode].labelClass + '">' + companyCode + '</span><div class="info-company-name">' + companyMeta[companyCode].name + '</div><div class="info-company-code">Daftar lokasi magang yang sedang membuka pendaftaran</div><div class="info-company-stats"><span class="info-stat-pill"><i class="fa-solid fa-location-dot"></i> ' + totalLokasi + ' lokasi / unit</span><span class="info-stat-pill"><i class="fa-solid fa-map"></i> ' + totalRegional + ' regional</span><span class="info-stat-pill badge-open-status"><i class="fa-solid fa-circle-check"></i> Membuka pendaftaran</span></div></div><div class="info-company-body">' + regionHtml + '</div></div></div>';
        }

        container.innerHTML = '<div class="row info-company-row">' + renderCompanyCard('KPI', grouped.KPI) + renderCompanyCard('PPN', grouped.PPN) + '</div>';
    }

    function bindInformasiFilterEvents() {
        var searchInput = document.getElementById('filterSearchInformasi');
        var companySelect = document.getElementById('filterCompanyInformasi');
        var regionSelect = document.getElementById('filterRegionInformasi');
        if (!searchInput || !companySelect || !regionSelect) return;

        searchInput.oninput = function() { renderGroupedInformasi(informasiData); };
        companySelect.onchange = function() { populateRegionFilter(informasiData); renderGroupedInformasi(informasiData); };
        regionSelect.onchange = function() { renderGroupedInformasi(informasiData); };
    }

    loadInformasiTersedia();
    bindInformasiFilterEvents();

    function showDetailLokasi(el) {
        var lokasiRaw = el.getAttribute('data-lokasi');
        var lokasi = lokasiRaw ? lokasiRaw.trim() : "";
        var region = el.getAttribute('data-region') || "";
        var company = el.getAttribute('data-company');

        document.getElementById('modalTitle').innerText = lokasi;
        var fullCompany = (company === 'KPI') ? 'PT Kilang Pertamina Internasional' : 'PT Pertamina Patra Niaga';
        document.getElementById('modalSubtitle').innerText = (region ? region + " - " : "") + fullCompany;

        var deskripsiFinal = "Deskripsi tidak tersedia.";

        if (company === 'KPI') {
            if (deskripsiPosisi[lokasi]) {
                deskripsiFinal = deskripsiPosisi[lokasi];
            } else {
                var keyMatch = Object.keys(deskripsiPosisi).find(function(k) {
                    return k.toLowerCase().replace(/\s/g, '') === lokasi.toLowerCase().replace(/\s/g, '');
                });
                deskripsiFinal = keyMatch ? deskripsiPosisi[keyMatch] : "Deskripsi posisi belum tersedia untuk bidang ini.";
            }
        } else if (company === 'PPN') {
            deskripsiFinal = "Unit operasional distribusi energi regional.";
        }

        var descElement = document.getElementById('modalDescriptionText');
        if (descElement) descElement.innerText = deskripsiFinal;

        $('#modalDetailLokasi').modal('show');
    }

    function showReviewDetail(id) {
        // Reset panel revisi setiap buka modal
        document.getElementById('revisiPanelMhs').style.display = 'none';
        document.getElementById('revisiFileCV').value = '';
        document.getElementById('revisiFileSurat').value = '';
        document.getElementById('revisiFileProposal').value = '';

        $.ajax({
            url: '/PendaftaranMagang/GetDetailMagang/' + id,
            type: 'GET',
            success: function(m) {
                // Simpan id untuk submit nanti
                document.getElementById('d-magang-id').value = id;

                document.getElementById('d-nama').innerText = m.nama || '-';
                document.getElementById('d-email').innerText = m.email || '-';

                var hpElem = document.getElementById('d-hp-link');
                if (m.wa) {
                    var cleanWa = m.wa.replace(/[^0-9]/g, '');
                    hpElem.innerText = m.wa;
                    hpElem.href = 'https://wa.me/' + cleanWa;
                } else { hpElem.innerText = '-'; }

                var igElem = document.getElementById('d-ig-link');
                if (m.instagram) {
                    var cleanIg = m.instagram.replace('@@', '');
                    igElem.innerText = m.instagram;
                    igElem.href = 'https://instagram.com/' + cleanIg;
                } else { igElem.innerText = '-'; }

                document.getElementById('d-univ').innerText   = m.univ || '-';
                document.getElementById('d-nim').innerText    = m.nim || '-';
                document.getElementById('d-jurusan').innerText = m.jurusan || '-';
                document.getElementById('d-fakultas').innerText = m.fakultas || '-';
                document.getElementById('d-company').innerText = m.company || '-';
                document.getElementById('d-lokasi').innerText  = m.lokasi || '-';
                document.getElementById('d-tempat').innerText  = m.tempatLahir || '-';
                document.getElementById('d-tgl-lahir').innerText = m.tglLahir || '-';
                document.getElementById('d-created-at').innerText = m.createdAtFormatted || '-';
                document.getElementById('d-periode').innerText = m.tglMulai + ' s/d ' + m.tglSelesai;
                document.getElementById('d-foto').src = m.fotoProfil || '/images/default-user.png';
                document.getElementById('link-cv').href     = m.pathCV || '#';
                document.getElementById('link-surat').href  = m.pathSurat || '#';
                document.getElementById('link-proposal').href = m.pathProposal || '#';

                // Status badge
                var sClass = m.status === 'Diterima' ? 'bg-light-green' :
                            m.status === 'Ditolak'  ? 'bg-light-red'   :
                            m.status === 'Revisi'   ? 'bg-light-revisi' :
                            'bg-light-orange';
                document.getElementById('d-status-badge-container').innerHTML =
                    '<span class="status-pill-modal ' + sClass + '">' + m.status + '</span>';

                // Bangun panel revisi jika status Revisi
                if (m.status === 'Revisi') {
                    buildRevisiPanel(m);
                }

                var myModal = new bootstrap.Modal(document.getElementById('modalDetail'));
                myModal.show();
            },
            error: function() { alert('Data tidak ditemukan'); }
        });
    }

    // Bangun panel revisi berdasarkan data dari server
    function buildRevisiPanel(m) {
        var fields = (m.revisiFields || '').split(',').map(function(x) { return x.trim().toLowerCase(); });
        var catatan = m.catatanRevisi || '';

        // Chips
        var chipsHtml = fields.filter(Boolean).map(function(f) {
            return '<span class="revisi-chip-item">' + f + '</span>';
        }).join('');
        document.getElementById('revisiChipsMhs').innerHTML = chipsHtml || '<span class="text-muted small">-</span>';

        // Catatan
        document.getElementById('revisiCatatanText').innerText = catatan || 'Tidak ada catatan tambahan.';
        document.getElementById('revisiCatatanBox').style.display = catatan ? 'block' : 'none';

        // Pre-fill nilai saat ini ke input
        document.getElementById('revisiNIM').value = m.nim || '';
        document.getElementById('revisiHP').value  = m.wa  || '';

        // Nama file saat ini
        document.getElementById('namaFileCV').innerText = 
            m.pathCV ? m.pathCV.split('/').pop() : 'Belum ada file';
        document.getElementById('namaFileSurat').innerText = 
            m.pathSurat ? m.pathSurat.split('/').pop() : 'Belum ada file';
        document.getElementById('namaFileProposal').innerText = 
            m.pathProposal ? m.pathProposal.split('/').pop() : 'Belum ada file';

        // Aktifkan/kunci field sesuai permintaan admin
        setFieldRevisi('rowRevisiNIM',    'badgeNIM',     'revisiNIM',     
                    fields.some(function(f){ return f.includes('akademik'); }));

        setFieldRevisi('rowRevisiHP',     'badgeHP',      'revisiHP',      
                    fields.some(function(f){ return f.includes('kontak'); }));

        setFieldRevisi('rowRevisiDurasi', 'badgeDurasi',  null,            
                    fields.some(function(f){ return f.includes('durasi'); }), true);

        setFieldRevisiFile('rowRevisiCV',       'badgeCV',       'triggerCV',      
                        fields.some(function(f){ return f.includes('cv'); }));

        setFieldRevisiFile('rowRevisiSurat',    'badgeSurat',    'triggerSurat',   
                        fields.some(function(f){ return f.includes('surat'); }));

        setFieldRevisiFile('rowRevisiProposal', 'badgeProposal', 'triggerProposal',
                        fields.some(function(f){ return f.includes('proposal'); }));

        document.getElementById('revisiPanelMhs').style.display = 'block';
    }

    // Helper: aktifkan/kunci input teks
    function setFieldRevisi(rowId, badgeId, inputId, aktif, isDurasi) {
        var row   = document.getElementById(rowId);
        var badge = document.getElementById(badgeId);
        if (!row || !badge) return;

        if (aktif) {
            row.classList.add('field-aktif');
            badge.className = 'badge-edit-aktif';
            badge.innerText = 'EDIT';
            if (isDurasi) {
                document.getElementById('revisiMulai').disabled   = false;
                document.getElementById('revisiSelesai').disabled = false;
            } else if (inputId) {
                document.getElementById(inputId).disabled = false;
            }
        } else {
            row.classList.remove('field-aktif');
            badge.className = 'badge-terkunci';
            badge.innerText = 'TERKUNCI';
            if (isDurasi) {
                document.getElementById('revisiMulai').disabled   = true;
                document.getElementById('revisiSelesai').disabled = true;
            } else if (inputId) {
                document.getElementById(inputId).disabled = true;
            }
        }
    }

    // Helper: aktifkan/kunci field upload file
    function setFieldRevisiFile(rowId, badgeId, triggerId, aktif) {
        var row     = document.getElementById(rowId);
        var badge   = document.getElementById(badgeId);
        var trigger = document.getElementById(triggerId);
        if (!row || !badge || !trigger) return;

        if (aktif) {
            row.classList.add('field-aktif');
            badge.className = 'badge-edit-aktif';
            badge.innerText = 'UPLOAD BARU';
            trigger.style.display = 'flex';
        } else {
            row.classList.remove('field-aktif');
            badge.className = 'badge-terkunci';
            badge.innerText = 'TERKUNCI';
            trigger.style.display = 'none';
        }
    }

    // Preview nama file setelah dipilih
    function previewNamaFile(input, targetId) {
        var el = document.getElementById(targetId);
        if (input.files && input.files[0]) {
            el.innerText = input.files[0].name;
            el.style.color = '#00549B';
            el.style.fontWeight = '700';
        }
    }

    // Submit revisi mahasiswa
    function submitRevisiMahasiswa() {
        var id = document.getElementById('d-magang-id').value;
        var formData = new FormData();
        formData.append('id', id);

        // Field teks — hanya kirim kalau tidak disabled
        var nim = document.getElementById('revisiNIM');
        if (!nim.disabled) formData.append('nim', nim.value);

        var hp = document.getElementById('revisiHP');
        if (!hp.disabled) formData.append('noHp', hp.value);

        var mulai = document.getElementById('revisiMulai');
        if (!mulai.disabled && mulai.value) formData.append('mulaiMagang', mulai.value);

        var selesai = document.getElementById('revisiSelesai');
        if (!selesai.disabled && selesai.value) formData.append('selesaiMagang', selesai.value);

        // File — hanya kirim kalau ada file dipilih
        var cv = document.getElementById('revisiFileCV');
        if (cv.files && cv.files[0]) formData.append('fileCv', cv.files[0]);

        var surat = document.getElementById('revisiFileSurat');
        if (surat.files && surat.files[0]) formData.append('fileSurat', surat.files[0]);

        var proposal = document.getElementById('revisiFileProposal');
        if (proposal.files && proposal.files[0]) formData.append('fileProposal', proposal.files[0]);

        Swal.fire({
            title: 'Kirim revisi?',
            text: 'Pastikan semua field yang diminta sudah kamu perbaiki.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#00549B',
            confirmButtonText: 'Ya, Kirim',
            cancelButtonText: 'Cek Lagi'
        }).then(function(result) {
            if (!result.isConfirmed) return;

            Swal.fire({ title: 'Mengirim...', allowOutsideClick: false, didOpen: function(){ Swal.showLoading(); } });

            $.ajax({
                url: '/DashboardPeserta/SubmitRevisi',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Revisi Terkirim!',
                            text: 'Status pengajuan kamu kembali ke Menunggu Review.',
                            confirmButtonColor: '#00549B'
                        }).then(function() { location.reload(); });
                    } else {
                        Swal.fire('Gagal', res.message || 'Terjadi kesalahan.', 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'Gagal menghubungi server.', 'error');
                }
            });
        });
    }

    // ===== NOTIFIKASI =====
    function loadNotifications() {
        $.get('/Notification/GetUserNotifications', function(data) {
            var html = '';
            if (!data || data.length === 0) {
                html = '<div class="p-4 text-center text-muted"><i class="fa fa-bell-slash mb-2" style="font-size:28px; opacity:0.3;"></i><div class="small">Tidak ada notifikasi</div></div>';
                $('#notifList').html(html);
                return;
            }

            data.forEach(function(n) {
                var iconHtml = '', borderColor = '';
                if (n.type === 'success') {
                    iconHtml = '<div style="width:36px;height:36px;border-radius:10px;background:#dcfce7;display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;"><i class="fa fa-check text-success" style="font-size:14px;"></i></div>';
                    borderColor = 'border-left: 3px solid #22c55e;';
                } else if (n.type === 'error') {
                    iconHtml = '<div style="width:36px;height:36px;border-radius:10px;background:#fee2e2;display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;"><i class="fa fa-times text-danger" style="font-size:14px;"></i></div>';
                    borderColor = 'border-left: 3px solid #ef4444;';
                } else if (n.type === 'new') {
                    iconHtml = '<div style="width:36px;height:36px;border-radius:10px;background:#dbeafe;display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;"><i class="fa fa-paper-plane text-primary" style="font-size:14px;"></i></div>';
                    borderColor = 'border-left: 3px solid #3b82f6;';
                } else {
                    iconHtml = '<div style="width:36px;height:36px;border-radius:10px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;"><i class="fa fa-bell text-muted" style="font-size:14px;"></i></div>';
                    borderColor = 'border-left: 3px solid #94a3b8;';
                }
                var unreadBg = n.isRead ? 'background:#fff;' : 'background:#f0f7ff;';
                var dotHtml = n.isRead ? '' : '<span style="width:8px;height:8px;background:#00549B;border-radius:50%;flex-shrink:0;margin-left:8px;display:inline-block;"></span>';

                html += '<a href="/Notification/GoTo/' + n.id + '" class="d-flex align-items-start text-decoration-none" style="padding:12px 16px; border-bottom:1px solid #f1f5f9; ' + unreadBg + ' ' + borderColor + ' transition:background 0.2s;">' + iconHtml + '<div style="flex:1; min-width:0;"><div style="font-size:13px;font-weight:700;color:#1e293b;line-height:1.3;">' + n.title + '</div><div style="font-size:12px;color:#64748b;margin-top:2px;line-height:1.4;">' + n.message + '</div><div style="font-size:10px;color:#94a3b8;margin-top:4px;"><i class="fa fa-clock mr-1"></i>' + n.timeAgo + '</div></div>' + dotHtml + '</a>';
            });

            $('#notifList').html(html);
        }).fail(function() {
            $('#notifList').html('<div class="p-3 text-center text-muted small">Gagal memuat notifikasi.</div>');
        });
    }

    function loadUnreadCount() {
        $.get('/Notification/UnreadCount', function(count) {
            if (count > 0) $('#notifBadge').text(count).show();
            else $('#notifBadge').hide();
        });
    }

    loadUnreadCount();

    // ===== DOCUMENT READY =====
    $(document).ready(function() {
        loadNotifications();
        loadUnreadCount();

        setInterval(function() {
            loadUnreadCount();
            loadNotifications();
        }, 5000);

        $('#markAllReadBtn').on('click', function(e) {
            e.preventDefault();
            $.ajax({
                url: '/DashboardPeserta/MarkAllRead',
                type: 'POST',
                success: function() {
                    $('#notifBadge').hide().text('');
                    loadNotifications();
                },
                error: function(xhr) {
                    console.log('Status:', xhr.status);
                    console.log('Response:', xhr.responseText);
                    Swal.fire('Error ' + xhr.status, xhr.responseText, 'error');
                }
            });
        });

        // Navigasi awal
        var params = new URLSearchParams(window.location.search);
        var tabFromUrl = params.get('tab');
        var highlightId = params.get('highlight');

        if (tabFromUrl) {
            showPage(tabFromUrl);
            localStorage.setItem('lastOpenedPage', tabFromUrl);
        } else {
            var lastPage = localStorage.getItem('lastOpenedPage') || 'dashboard';
            showPage(lastPage);
        }

        if (highlightId) {
            setTimeout(function() {
                var targetRow = document.querySelector('tr[data-id="' + highlightId + '"]');
                if (targetRow) {
                    targetRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    targetRow.classList.add('highlight-row');
                }
            }, 450);
        }

        // Restore tab profil
        var activeTab = localStorage.getItem('activeProfileTab');
        if (activeTab) { $('#' + activeTab).tab('show'); }

        $('a[data-toggle="tab"]').on('shown.bs.tab', function(e) {
            localStorage.setItem('activeProfileTab', $(e.target).attr('id'));
        });

        // Proteksi pindah tab saat dirty
        $('#profileTab a').on('click', function(e) {
            if (isDirty()) {
                e.preventDefault();
                var targetTab = $(this);
                Swal.fire({
                    title: 'Data Belum Disimpan',
                    text: "Jika pindah tab, perubahan ketikanmu akan hilang.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#00549B',
                    confirmButtonText: 'Ya, Pindah',
                    cancelButtonText: 'Tetap di Sini'
                }).then(function(result) {
                    if (result.isConfirmed) { forceReset(); targetTab.tab('show'); }
                });
            } else {
                forceReset();
            }
        });

        // Tombol Edit Profil
        $('#btnEditTrigger').on('click', function() {
            isEditing = true;
            originalData = getSnapshot();
            $('.input-security-clean').not('#inputEmail, #oldPass, #newPass, #confirmPass').prop('readonly', false).css('background-color', '#fff');
            $(this).hide();
            $('#btnSimpan, #btnBatal').fadeIn(300);
        });

        // Tombol Edit Password
        $('#btnEditPassword').on('click', function() {
            isEditing = true;
            originalData = getSnapshot();
            $('#oldPass, #newPass, #confirmPass').prop('readonly', false).css('background-color', '#fff');
            $('.append-security').fadeIn();
            $(this).hide();
            $('#btnSimpanPassword, #btnBatalPassword').fadeIn(300);
        });

        // Highlight input saat fokus
        $('.input-security-clean, .input-custom').on('focus', function() {
            if ($(this).prop('readonly') === false) {
                $(this).closest('.input-group-security').css({ 'border-color': '#00529C', 'box-shadow': '0 0 0 3px rgba(0, 82, 156, 0.1)' });
            }
        }).on('blur', function() {
            $(this).closest('.input-group-security').css({ 'border-color': '#e2e8f0', 'box-shadow': 'none' });
        });

        // Tombol Batal
        $('#btnBatal, #btnBatalPassword').on('click', function() {
            forceReset();
        });
    });

</script>

