                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="label-custom">USERNAME / EMAIL</label>
                            <input type="email" id="inputEmail" class="form-control input-custom" value="@userEmail" readonly>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="label-custom">NOMOR HANDPHONE</label>
                            <input type="text" id="inputNoHP" class="form-control input-custom" value="@Model?.NoHP" placeholder="Contoh: 0888..." readonly>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="label-custom">INSTANSI / PERGURUAN TINGGI</label>
                            <input type="text" id="inputUniv" class="form-control input-custom" value="@Model?.NamaPerguruanTinggi" placeholder="Nama Perguruan Tinggi" readonly>
                        </div>
                    </div>

                    <div class="text-right mt-2">
                        <button type="button" class="btn btn-primary" id="btnSimpan" onclick="saveProfile()" disabled>Simpan Perubahan</button>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-security" role="tabpanel">
                <div class="p-4">
                    <div class="mb-4">
                        <h5 class="font-weight-bold">Keamanan Akun</h5>
                        <p class="text-muted small">Disarankan untuk mengganti kata sandi secara berkala untuk menjaga keamanan akun Anda.</p>
                    </div>

                    <form id="securityForm" onsubmit="updatePassword(event)" style="max-width: 500px;">
                        <div class="mb-4">
                            <label class="label-custom">KATA SANDI SAAT INI</label>
                            <div class="input-group">
                                <input type="password" id="oldPass" class="form-control input-custom" placeholder="Masukkan password lama" required>
                                <div class="input-group-append">
                                    <span class="input-group-text bg-light border-0" onclick="togglePassword('oldPass')" style="cursor: pointer; border-radius: 0 8px 8px 0;">
                                        <i class="fa-solid fa-eye" id="icon-oldPass"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="label-custom">KATA SANDI BARU</label>
                                <div class="input-group">
                                    <input type="password" id="newPass" class="form-control input-custom" placeholder="Min 6 karakter" required>
                                    <div class="input-group-append">
                                        <span class="input-group-text bg-light border-0" onclick="togglePassword('newPass')" style="cursor: pointer; border-radius: 0 8px 8px 0;">
                                            <i class="fa-solid fa-eye" id="icon-newPass"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="label-custom">KONFIRMASI PASSWORD</label>
                                <div class="input-group">
                                    <input type="password" id="confirmPass" class="form-control input-custom" placeholder="Ulangi password baru" required>
                                    <div class="input-group-append">
                                        <span class="input-group-text bg-light border-0" onclick="togglePassword('confirmPass')" style="cursor: pointer; border-radius: 0 8px 8px 0;">
                                            <i class="fa-solid fa-eye" id="icon-confirmPass"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 shadow-sm" style="border-radius: 10px; background: #e0efff; color: #00549b;">
                            <i class="fa-solid fa-circle-info mr-2"></i>
                            <small>Password harus minimal 6 karakter kombinasi huruf dan angka.</small>
                        </div>

                        <div class="text-right mt-4">
                            <button type="submit" class="btn btn-danger px-5 py-2 font-weight-bold shadow-sm" style="border-radius:8px; background: var(--p-red); border: none;">
                                Perbarui Kata Sandi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let informasiData = [];

    async function loadInformasiTersedia() {
        const container = document.getElementById('informasiGroupedContainer');

        try {
            const response = await fetch('/DashboardPeserta/GetInformasiTersedia');
            let data = await response.json();

            // Normalisasi data:
            // KPI hanya punya 1 regional = Refinery Unit VI Balongan
            // selain itu masuk PPN
            informasiData = (data || []).map(item => {
                const isKPI = (item.region || '').trim() === 'Refinery Unit VI Balongan';

                return {
                    ...item,
                    companyCode: isKPI ? 'KPI' : 'PPN',
                    companyName: isKPI
                        ? 'PT Kilang Pertamina Internasional'
                        : 'PT Pertamina Patra Niaga'
                };
            });

            updateSummary(informasiData);
            populateCompanyFilter(informasiData);
            populateRegionFilter(informasiData);
            renderGroupedInformasi(informasiData);
            bindInformasiFilterEvents();
        } catch (error) {
            container.innerHTML = `
                <div class="info-empty-state">
                    <i class="fa fa-circle-exclamation mb-3" style="font-size:32px;"></i>
                    <div class="font-weight-bold mb-1">Gagal memuat data lokasi magang</div>
                    <div class="small">Silakan coba beberapa saat lagi.</div>
                </div>
            `;
            console.error(error);
        }
    }

    function updateSummary(data) {
        document.getElementById('summaryTotalLokasi').textContent = data.length;
        document.getElementById('summaryTotalCompany').textContent = 2;
        document.getElementById('summaryTotalRegion').textContent = new Set(data.map(x => x.region)).size;
    }

    function populateCompanyFilter(data) {
        const companySelect = document.getElementById('filterCompanyInformasi');
        const selectedCompany = companySelect.value;

        const companies = [...new Set(data.map(x => x.companyName))].sort();

        companySelect.innerHTML = `<option value="">Semua Company</option>` +
            companies.map(x => `<option value="${x}">${x}</option>`).join('');

        companySelect.value = selectedCompany;
    }

    function populateRegionFilter(data) {
        const companySelect = document.getElementById('filterCompanyInformasi');
        const regionSelect = document.getElementById('filterRegionInformasi');
        const selectedCompany = companySelect.value;
        const previousRegion = regionSelect.value;

        if (!selectedCompany) {
            regionSelect.innerHTML = `<option value="">Pilih company terlebih dahulu</option>`;
            regionSelect.value = '';
            regionSelect.disabled = true;
            return;
        }

        const filteredByCompany = data.filter(item => item.companyName === selectedCompany);
        const regions = [...new Set(filteredByCompany.map(x => x.region))].sort();

        regionSelect.disabled = false;
        regionSelect.innerHTML = `<option value="">Semua Regional</option>` +
            regions.map(x => `<option value="${x}">${x}</option>`).join('');

        if (regions.includes(previousRegion)) {
            regionSelect.value = previousRegion;
        } else {
            regionSelect.value = '';
        }
    }

    function resetInformasiFilter() {
        document.getElementById('filterSearchInformasi').value = '';
        document.getElementById('filterCompanyInformasi').value = '';
        populateRegionFilter(informasiData);
        renderGroupedInformasi(informasiData);
    }

    function renderGroupedInformasi(data) {
        const container = document.getElementById('informasiGroupedContainer');
        const search = document.getElementById('filterSearchInformasi').value.toLowerCase().trim();
        const company = document.getElementById('filterCompanyInformasi').value;
        const region = document.getElementById('filterRegionInformasi').value;

        const filtered = data.filter(item => {
            const companyName = (item.companyName || '').toLowerCase();
            const regionName = (item.region || '').toLowerCase();
            const lokasiName = (item.lokasi || '').toLowerCase();

            const matchSearch =
                lokasiName.includes(search) ||
                regionName.includes(search) ||
                companyName.includes(search);

            const matchCompany = !company || item.companyName === company;
            const matchRegion = !region || item.region === region;

            return matchSearch && matchCompany && matchRegion;
        });

        if (filtered.length === 0) {
            container.innerHTML = `
                <div class="info-empty-state">
                    <i class="fa fa-folder-open mb-3" style="font-size:32px;"></i>
                    <div class="font-weight-bold mb-1">Data tidak ditemukan</div>
                    <div class="small">Coba ubah kata kunci pencarian atau filter yang dipilih.</div>
                </div>
            `;
            return;
        }

        const grouped = {
            KPI: [],
            PPN: []
        };

        filtered.forEach(item => {
            if (item.companyCode === 'KPI') grouped.KPI.push(item);
            else grouped.PPN.push(item);
        });

        const companyMeta = {
            KPI: {
                code: 'KPI',
                name: 'PT Kilang Pertamina Internasional',
                labelClass: 'kpi'
            },
            PPN: {
                code: 'PPN',
                name: 'PT Pertamina Patra Niaga',
                labelClass: 'ppn'
            }
        };

        function groupByRegion(items) {
            const regionMap = {};
            items.forEach(item => {
                if (!regionMap[item.region]) regionMap[item.region] = [];
                regionMap[item.region].push(item);
            });
            return regionMap;
        }

        function renderCompanyCard(companyCode, items) {
            if (!items.length) {
                return `
                    <div class="col-lg-6 mb-4">
                        <div class="info-company-main-card">
                            <div class="info-company-header">
                                <span class="info-company-label ${companyMeta[companyCode].labelClass}">
                                    ${companyCode}
                                </span>
                                <div class="info-company-name">${companyMeta[companyCode].name}</div>
                                <div class="info-company-code">Lokasi magang yang tersedia</div>
                            </div>
                            <div class="info-company-body">
                                <div class="info-empty-state">
                                    Belum ada data lokasi yang tampil untuk filter ini.
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            const byRegion = groupByRegion(items);
            const totalLokasi = items.length;
            const totalRegional = Object.keys(byRegion).length;

            let regionHtml = '';
            Object.keys(byRegion).sort().forEach(regionName => {
                const lokasiItems = byRegion[regionName];

                regionHtml += `
                    <div class="info-region-card">
                        <div class="info-region-header">
                            <div class="info-region-title">${regionName}</div>
                            <div class="info-region-count">${lokasiItems.length} lokasi / unit</div>
                        </div>
                        <div class="info-lokasi-list">
                            ${lokasiItems.map(item => `
                                <div class="info-lokasi-item">
                                    <div class="info-lokasi-name">${item.lokasi}</div>
                                    <span class="info-open-badge">Membuka Pendaftaran</span>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            });

            return `
                <div class="col-lg-6 mb-4">
                    <div class="info-company-main-card">
                        <div class="info-company-header">
                            <span class="info-company-label ${companyMeta[companyCode].labelClass}">
                                ${companyCode}
                            </span>
                            <div class="info-company-name">${companyMeta[companyCode].name}</div>
                            <div class="info-company-code">Daftar lokasi magang yang sedang membuka pendaftaran</div>

                            <div class="info-company-stats">
                                <span class="info-stat-pill">
                                    <i class="fa fa-location-dot"></i> ${totalLokasi} lokasi / unit
                                </span>
                                <span class="info-stat-pill">
                                    <i class="fa fa-map"></i> ${totalRegional} regional
                                </span>
                                <span class="info-stat-pill">
                                    <i class="fa fa-circle-check"></i> Membuka pendaftaran
                                </span>
                            </div>
                        </div>
                        <div class="info-company-body">
                            ${regionHtml}
                        </div>
                    </div>
                </div>
            `;
        }

        container.innerHTML = `
            <div class="row info-company-row">
                ${renderCompanyCard('KPI', grouped.KPI)}
                ${renderCompanyCard('PPN', grouped.PPN)}
            </div>
        `;
    }

    function bindInformasiFilterEvents() {
        const searchInput = document.getElementById('filterSearchInformasi');
        const companySelect = document.getElementById('filterCompanyInformasi');
        const regionSelect = document.getElementById('filterRegionInformasi');

        if (!searchInput || !companySelect || !regionSelect) return;

        searchInput.oninput = function () {
            renderGroupedInformasi(informasiData);
        };

        companySelect.onchange = function () {
            populateRegionFilter(informasiData);
            renderGroupedInformasi(informasiData);
        };

        regionSelect.onchange = function () {
            renderGroupedInformasi(informasiData);
        };
    }

    loadInformasiTersedia();
    bindInformasiFilterEvents();

    function showReviewDetail(id) {
        $.ajax({
            url: '/PendaftaranMagang/GetDetailMagang/' + id,
            type: 'GET',
            success: function (m) {
                // Mapping data dasar
                document.getElementById('d-nama').innerText = m.nama || '-';
                document.getElementById('d-email').innerText = m.email || '-';
                
                // WhatsApp Link (Ganti template literals ke string biasa)
                const hpElem = document.getElementById('d-hp-link');
                if(m.wa) {
                    var cleanWa = m.wa.replace(/[^0-9]/g, '');
                    hpElem.innerText = m.wa;
                    hpElem.href = 'https://wa.me/' + cleanWa;
                } else {
                    hpElem.innerText = '-';
                }

                // Instagram Link
                const igElem = document.getElementById('d-ig-link');
                if(m.instagram) {
                    var cleanIg = m.instagram.replace('@@', ''); 
                    igElem.innerText = m.instagram;
                    igElem.href = 'https://instagram.com/' + cleanIg;
                } else {
                    igElem.innerText = '-';
                }

                document.getElementById('d-univ').innerText = m.univ || '-';
                document.getElementById('d-nim').innerText = m.nim || '-';
                document.getElementById('d-jurusan').innerText = m.jurusan || '-';
                document.getElementById('d-fakultas').innerText = m.fakultas || '-';
                document.getElementById('d-company').innerText = m.company || '-';
                document.getElementById('d-lokasi').innerText = m.lokasi || '-';
                document.getElementById('d-tempat').innerText = m.tempatLahir || '-';
                document.getElementById('d-tgl-lahir').innerText = m.tglLahir || '-';
                document.getElementById('d-created-at').innerText = m.createdAtFormatted || '-';
                
                // Gabungkan string tanpa backtick
                document.getElementById('d-periode').innerText = m.tglMulai + ' s/d ' + m.tglSelesai;
                
                // Files & Photo
                document.getElementById('d-foto').src = m.fotoProfil || '/img/default-user.png';
                document.getElementById('link-cv').href = m.pathCV || '#';
                document.getElementById('link-surat').href = m.pathSurat || '#';
                document.getElementById('link-proposal').href = m.pathProposal || '#';

                // Status Badge (Hindari backtick di sini)
                const sClass = m.status === 'Diterima' ? 'bg-light-green' : (m.status === 'Ditolak' ? 'bg-light-red' : 'bg-light-orange');
                document.getElementById('d-status-badge-container').innerHTML = '<span class="status-pill-modal ' + sClass + '">' + m.status + '</span>';
                
                // Show Modal
                var myModal = new bootstrap.Modal(document.getElementById('modalDetail'));
                myModal.show();
            },
            error: function() {
                alert('Data tidak ditemukan');
            }
        });
    }

    function loadNotifications() {
        $.get('/Notification/GetUserNotifications', function (data) {

            let html = '';

            if (data.length === 0) {
                html = `<div class="p-3 text-center text-muted">Tidak ada notifikasi</div>`;
            }

            data.forEach(n => {

                let cls = n.isRead ? '' : 'notif-unread';

                html += `
                    <a href="/Notification/GoTo/${n.id}" class="notif-item ${cls} d-block">
                        <div class="notif-title">${n.title}</div>
                        <div class="notif-msg">${n.message}</div>
                    </a>
                `;
            });

            $('#notifList').html(html);
        });
    }

    loadNotifications();

    $('#markAllReadBtn').click(function (e) {
        e.preventDefault();

        $('#notifBadge').hide(); // langsung sembunyikan badge

        $.post('/Notification/MarkAllRead', function () {
            loadNotifications();
            loadUnreadCount();
        });
    });

    function loadUnreadCount() {
        $.get('/Notification/UnreadCount', function (count) {
            if (count > 0)
                $('#notifBadge').text(count).show();
            else
                $('#notifBadge').hide();
        });
    }

    loadUnreadCount();

    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById('icon-' + inputId);
        
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = "password";
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    $(document).ready(function() {
        loadNotifications();
        loadUnreadCount();

        setInterval(function(){
            loadUnreadCount();
        }, 5000); // cek setiap 5 detik

        const params = new URLSearchParams(window.location.search);
        const tabFromNotif = params.get('tab');

        if (tabFromNotif) {
            showPage(tabFromNotif);
            localStorage.setItem('lastOpenedPage', tabFromNotif);
        }

        const lastPage = localStorage.getItem('lastOpenedPage') || 'dashboard';
        showPage(lastPage);

        const activeTab = localStorage.getItem('activeProfileTab');
        if (activeTab) {
            // Aktifkan tab berdasarkan ID link-nya
            $(`#${activeTab}`).tab('show');
        }

        // 2. Simpan tab ke LocalStorage setiap kali tab diklik
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            const tabId = $(e.target).attr('id');
            localStorage.setItem('activeProfileTab', tabId);
        });

        // Fungsi ketika tombol Edit Informasi diklik
        $('#btnEditInfo').on('click', function() {
            const isReadOnly = $('#inputNama').prop('readonly');

            if (isReadOnly) {
                // AKTIFKAN MODE EDIT
                $('.input-custom').prop('readonly', false); // Lepas status readonly
                $('#btnSimpan').prop('disabled', false); 
                $('.input-custom').css('background-color', '#fff'); // Ubah background jadi putih agar kontras
                $('.input-custom').first().focus(); // Fokuskan ke input pertama
                
                $(this).html('<i class="fa-solid fa-xmark mr-1"></i> Batal Edit'); // Ganti teks tombol
                $(this).removeClass('text-muted').addClass('text-danger');
            } else {
                // KEMBALI KE MODE LOCK (Batal)
                $('.input-custom').prop('readonly', true);
                $('#btnSimpan').prop('disabled', true);
                $('.input-custom').css('background-color', '#f8fafc'); // Kembalikan warna abu-abu
                
                $(this).html('<i class="fa-solid fa-pencil mr-1"></i> Edit Informasi');
                $(this).removeClass('text-danger').addClass('text-muted');
            }
        });
    });

    function showPhotoOptions() {
        Swal.fire({
            title: 'Foto Profil',
            showDenyButton: true,
            showCancelButton: true,
            confirmButtonText: 'Unggah Foto Baru',
            denyButtonText: 'Hapus Foto',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#00549B',
            denyButtonColor: '#ec1c24',
        }).then((result) => {
            if (result.isConfirmed) {
                $('#fileInput').click();
            } else if (result.isDenied) {
                deletePhoto();
            }
        });
    }

    function uploadFoto(input) {
        if (!input.files || !input.files[0]) return;

        const file = input.files[0];

        if (file.size > 2 * 1024 * 1024) {
            Swal.fire('Opps!', 'Ukuran file terlalu besar (Max 2MB)', 'error');
            input.value = '';
            return;
        }

        const formData = new FormData();
        formData.append('fotoProfil', file);

        $.ajax({
            url: '/DashboardPeserta/UpdateFoto',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res.success) {
                    const newPath = res.filePath + '?t=' + new Date().getTime();

                    if ($('#imgPreview').length) {
                        $('#imgPreview').attr('src', newPath);
                    } else {
                        $('#avatarContainer').html(
                            '<img src="' + newPath + '" id="imgPreview" style="width:100%; height:100%; object-fit:cover;">'
                        );
                    }

                    $('#navbarAvatar').attr('src', newPath);

                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil!',
                        text: 'Foto profil diperbarui.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire('Gagal!', res.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Error!', 'Gagal menghubungi server.', 'error');
            }
        });
    }

    function deletePhoto() {
        Swal.fire({
            title: 'Hapus foto?',
            text: 'Foto profil akan dihapus.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Ya, Hapus'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/DashboardPeserta/DeleteFoto', function(res) {
                    if (res.success) {
                        location.reload();
                    }
                });
            }
        });
    }

    // --- FUNGSI LIHAT FOTO ---
    function viewPhoto() {
        const photoUrl = $('#imgPreview').attr('src');

        if (!photoUrl) {
            Swal.fire('Info', 'Anda belum mengunggah foto profil.', 'info');
            return;
        }

        Swal.fire({
            imageUrl: photoUrl,
            imageAlt: 'Foto Profil',
            showCloseButton: true,
            showConfirmButton: false,
            background: '#fff'
        });
    }

    // --- FUNGSI PILIH FOTO ---
    function selectPhoto() {
        $('#fileInputFoto').click(); // Trigger klik pada input file tersembunyi
    }

    function updatePassword(e) {
        e.preventDefault(); 

        const oldP = $('#oldPass').val();
        const newP = $('#newPass').val();
        const confirmP = $('#confirmPass').val();

        if (!oldP || !newP || !confirmP) {
            Swal.fire('Opps!', 'Semua kolom password wajib diisi.', 'warning');
            return;
        }

        if (newP !== confirmP) {
            Swal.fire('Error', 'Konfirmasi password tidak cocok!', 'error');
            return;
        }

        Swal.fire({ title: 'Memproses...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

        $.ajax({
            url: '/DashboardPeserta/UpdatePassword',
            type: 'POST',
            data: { 
                oldPass: oldP, 
                newPass: newP,
                // Token keamanan ASP.NET Core
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
            },
            success: function(res) {
                if (res.success) {
                    Swal.fire('Berhasil!', 'Password diperbarui.', 'success');
                    $('#securityForm')[0].reset(); 
                } else {
                    Swal.fire('Gagal!', res.message, 'error');
                }
            },
            error: function(xhr) {
                console.log(xhr.responseText);
                Swal.fire('Error!', 'Terjadi kesalahan sistem.', 'error');
            }
        });
    }

    function showPage(pageId) {
        $('.page-section').removeClass('active');
        $('#page-' + pageId).addClass('active');
        $('.nav-link-custom').removeClass('active');
        $('#nav-' + pageId).addClass('active');

        const breadcrumbs = {
            'dashboard': 'Panel Peserta / Dashboard',
            'informasi': 'Panel Peserta / Informasi Tersedia',
            'riwayat': 'Panel Peserta / Riwayat Magang',
            'penelitian': 'Panel Peserta / Riwayat Riset',
            'profil': 'Panel Peserta / Pengaturan Profil'
        };
        $('#page-breadcrumb').text(breadcrumbs[pageId]);

        localStorage.setItem('lastOpenedPage', pageId);
    }

    function saveProfile() {
        // Tampilkan loading
        Swal.fire({ 
            title: 'Menyimpan...', 
            allowOutsideClick: false, 
            didOpen: () => { Swal.showLoading() } 
        });

        $.ajax({
            url: '/DashboardPeserta/UpdateProfil',
            type: 'POST',
            data: {
                nama: $('#inputNama').val(),
                noHp: $('#inputNoHP').val(),
                univ: $('#inputUniv').val()
            },
            success: function(res) {
                if(res.success) {
                    Swal.fire('Berhasil', 'Profil diperbarui!', 'success').then(() => {
                        // Hanya mengunci input yang ada di tab profil
                        $('#tab-data .input-custom').prop('readonly', true);
                        
                        // Kembalikan tombol edit ke mode normal
                        $('#btnEditInfo').html('<i class="fa-solid fa-pencil mr-1"></i> Edit Informasi');
                        $('#btnEditInfo').removeClass('text-danger');
                        
                        // Update nama di header agar sinkron
                        $('.font-weight-bold.mb-1').text($('#inputNama').val());
                    });
                } else {
                    Swal.fire('Gagal', res.message, 'error');
                }
            }, // Tutup success
            error: function() {
                Swal.fire('Error', 'Gagal tersambung ke server', 'error');
            }
        }); // Tutup $.ajax
    }

    function handleLogout() {
        Swal.fire({
            title: 'Keluar?',
            text: "Sesi akan berakhir",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ec1c24',
            confirmButtonText: 'Logout'
        }).then((r) => { 
            if (r.isConfirmed) {
                // Hapus draft spesifik dan bersihkan semuanya
                localStorage.removeItem('form_magang_draft'); 
                localStorage.clear();
                sessionStorage.clear();

                window.location.href = '/Auth/Logout'; 
            }
        });
    }

    function filterTabel(status, element) {
        // 1. Hapus class 'active-filter' dari semua card dulu
        document.querySelectorAll('.stat-card').forEach(c => c.classList.remove('active-filter'));
        // 2. Tambah class 'active-filter' ke card yang barusan diklik
        element.classList.add('active-filter');

        // 3. Logika Filter Tabel (Sama seperti sebelumnya)
        const baris = document.querySelectorAll('#tabelBodyRiwayat .baris-magang');
        baris.forEach(row => {
            const statusBaris = row.getAttribute('data-status');
            if (status === 'Semua') {
                row.style.display = '';
            } else {
                row.style.display = (statusBaris === status) ? '' : 'none';
            }
        });
    }
</script>
</body>
</html>