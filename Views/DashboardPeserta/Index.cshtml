                                            <i class="fas fa-phone"></i> No. WhatsApp
                                            <span id="badgeHP" class="badge-terkunci">TERKUNCI</span>
                                        </div>
                                        <input id="revisiHP" type="text" class="revisi-input" disabled>
                                    </div>

                                    <!-- Durasi -->
                                    <div id="rowRevisiDurasi" class="revisi-field-row">
