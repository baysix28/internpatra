@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using System.Text.Json
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manajemen Mahasiswa & Penelitian";

    var adminRole           = HttpContextAccessor.HttpContext.Session.GetString("AdminRole");
    var adminRegionManaged  = HttpContextAccessor.HttpContext.Session.GetString("AdminRegion");
    bool canChangeRegionMhs = adminRole == "SuperAdmin" || 
                            string.Equals(adminRegionManaged, "Regional Jawa Bagian Tengah", StringComparison.OrdinalIgnoreCase);

    var rawSelectedRegion = ViewBag.RawSelectedRegion as string ?? "all";
    var displayRegion     = ViewBag.SelectedRegion    as string ?? "Semua Region";

    var daftarMagang     = Model.DaftarMagang     as IEnumerable<Magang>     ?? new List<Magang>();
    var daftarPenelitian = Model.DaftarPenelitian as IEnumerable<Pendaftaran> ?? new List<Pendaftaran>();

    var totalMagang     = daftarMagang.Count();
    var totalPenelitian = daftarPenelitian.Count();

    var staticRegions = new List<string>
    {
        "Refinery Unit VI Balongan",
        "Regional Jatimalinus",
        "Regional Jawa Bagian Barat",
        "Regional Jawa Bagian Tengah",
        "Regional Kalimantan",
        "Regional Maluku Papua",
        "Regional Sumbagut"
    };
}
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
    :root {
        --p-blue:   #00549B;
        --p-red:    #EC1C24;
        --p-green:  #10b981;
        --p-orange: #f59e0b;
        --p-purple: #7C3AED;
        --p-bg:     #F8FAFC;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body { background-color: var(--p-bg); font-family: 'Plus Jakarta Sans', sans-serif; color: #334155; }
    .dashboard-wrapper { padding: 1.2rem 1.8rem; margin-top: -20px; }
    .title-bold { font-weight: 800; color: var(--p-blue); letter-spacing: -0.8px; font-size: 1.5rem; }

    /* ── Tab Switcher ── */
    .tab-switcher {
        display: inline-flex; background: #f1f5f9; border-radius: 16px;
        padding: 5px; gap: 4px; margin-bottom: 1.5rem; border: 1px solid #e2e8f0;
    }
    .tab-switcher .tab-btn {
        border: none; background: none; padding: 9px 22px; font-size: 0.78rem; font-weight: 700;
        color: #64748b; border-radius: 12px; cursor: pointer; transition: var(--transition);
        display: flex; align-items: center; gap: 7px; white-space: nowrap;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .tab-switcher .tab-btn.active        { background: white; color: var(--p-blue);   box-shadow: 0 2px 8px rgba(0,84,155,0.12); }
    .tab-switcher .tab-btn.pen.active    { background: white; color: var(--p-purple); box-shadow: 0 2px 8px rgba(124,58,237,0.12); }
    .tab-switcher .tab-btn:not(.active):hover { background: #e8edf5; color: #334155; }
    .tab-count { background: #e2e8f0; color: #475569; border-radius: 20px; padding: 2px 9px; font-size: 0.65rem; font-weight: 800; transition: var(--transition); }
    .tab-btn.active     .tab-count { background: var(--p-blue);   color: white; }
    .tab-btn.pen.active .tab-count { background: var(--p-purple); color: white; }

    /* ── Tab Pane ── */
    .tab-pane        { display: none; }
    .tab-pane.active { display: block; animation: tabFadeIn 0.32s cubic-bezier(0.4,0,0.2,1) both; }
    @@keyframes tabFadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0);    }
    }

    /* ── Stat Cards ── */
    .stat-card {
        background: #fff; border-radius: 12px; padding: 0.85rem 1rem; border: 1px solid #e2e8f0;
        transition: var(--transition); cursor: pointer; display: flex; align-items: center; height: 100%;
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
    .stat-card.active[data-status="all"]      { border: 2px solid var(--p-blue);   background: #f0f7ff; }
    .stat-card.active[data-status="Menunggu"] { border: 2px solid var(--p-orange); background: #fffbeb; }
    .stat-card.active[data-status="Diterima"] { border: 2px solid var(--p-green);  background: #ecfdf5; }
    .stat-card.active[data-status="Ditolak"]  { border: 2px solid var(--p-red);    background: #fef2f2; }

    .icon-box { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px; font-size: 1.1rem; }
    .bg-light-blue   { background: rgba(0,84,155,0.1);   color: var(--p-blue);   }
    .bg-light-orange { background: rgba(245,158,11,0.1); color: var(--p-orange); }
    .bg-light-green  { background: rgba(16,185,129,0.1); color: var(--p-green);  }
    .bg-light-red    { background: rgba(236,28,36,0.1);  color: var(--p-red);    }
    .bg-light-purple { background: rgba(124,58,237,0.1); color: var(--p-purple); }

    .stat-label { color: #64748b; font-size: 0.7rem; font-weight: 700; }
    .stat-value { font-weight: 800; font-size: 1.15rem; color: #1e293b; }

    /* ── Table Card ── */
    .main-table-card { background: #fff; border-radius: 12px; border: 1px solid #E2E8F0; position: static !important; }
    .filter-toolbar  { display: flex; align-items: center; justify-content: space-between; width: 100%; }

    .table thead th { background: #f8fafc; font-weight: 700; color: #64748b; font-size: 0.7rem; padding: 12px 15px; text-transform: uppercase; border: none; }
    .badge-status { padding: 5px 12px; border-radius: 50px; font-weight: 700; font-size: 0.65rem; text-transform: uppercase; }
    .status-Diterima { background: #dcfce7; color: #065f46; }
    .status-Ditolak  { background: #fee2e2; color: #991b1b; }
    .status-Menunggu { background: #fef3c7; color: #92400e; }

    .btn-review {
        border: none; padding: 6px 20px; border-radius: 8px; font-weight: 700; font-size: 0.75rem;
        transition: var(--transition); display: inline-flex; align-items: center; justify-content: center; color: #fff;
    }
    .btn-review.mag { background: var(--p-blue); }
    .btn-review.mag:hover { background: #003d70; transform: translateY(-1px); color: #fff; }
    .btn-review.pen { background: var(--p-purple); }
    .btn-review.pen:hover { background: #5B21B6; transform: translateY(-1px); color: #fff; }

    #tableSearch, #penTableSearch {
        border-radius: 10px; border: 1.5px solid #e2e8f0; padding: 9px 15px;
        transition: var(--transition); background-color: #fff; font-weight: 600; font-size: 0.85rem; color: #475569; outline: none;
        width: 380px;
    }

    .btn-region-select {
        min-width: 220px; text-align: left; padding: 8px 12px; font-weight: 700; font-size: 0.8rem;
        color: var(--p-blue); border: 1.5px solid #e2e8f0; border-radius: 10px; background-color: white;
        display: flex; justify-content: space-between; align-items: center; transition: var(--transition);
    }
    .dropdown-menu-premium { border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border-radius: 10px; padding: 5px; min-width: 220px; max-height: 350px; overflow-y: auto; }
    .dropdown-item-premium { font-weight: 600; padding: 8px 12px; color: #475569; border-radius: 6px; transition: 0.2s; font-size: 0.8rem; }
    .dropdown-item-premium:hover { background: #f1f5f9; color: var(--p-blue); }
    .dropdown-item-premium.active { background: var(--p-blue); color: white; }

    .btn-pertamina { background: var(--p-blue); color: white; border: none; font-weight: 700; border-radius: 6px; padding: 8px 16px; font-size: 0.8rem; transition: var(--transition); }
    .user-avatar-list { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; }

    #pen-card-all.active {
        border: 2px solid var(--p-purple) !important;
        background: rgba(124,58,237,0.08) !important;
    }
    /* ── Modal Magang ── */
    .modal-content { border-radius: 28px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); position: relative; }
    .modal-header-magang    { background: linear-gradient(135deg, #00549B 0%, #003d70 100%);  padding: 1.5rem 2rem; color: white; }
    .modal-header-penelitian { background: linear-gradient(135deg, #7C3AED 0%, #5B21B6 100%); padding: 1.5rem 2rem; color: white; }

    .header-flex-container { display: flex; align-items: center; gap: 20px; }
    .profile-circle-frame { width: 90px; height: 90px; border-radius: 50% !important; object-fit: cover; border: 4px solid rgba(255,255,255,0.2); background: white; flex-shrink: 0; }
    .header-text-info h2 { font-weight: 800; font-size: 1.5rem; margin: 0; letter-spacing: -0.5px; line-height: 1.2; }
    .status-pill-modal { display: inline-block; width: fit-content; padding: 2px 12px; border-radius: 50px; font-size: 0.6rem; font-weight: 800; text-transform: uppercase; margin-bottom: 5px; }

    .btn-action-standard { padding: 8px 24px; min-width: 130px; font-size: 0.8rem; font-weight: 700; border-radius: 10px; border: none; transition: var(--transition); display: flex; align-items: center; justify-content: center; gap: 8px; }
    .btn-accept-modern { background: var(--p-blue);   color: white; box-shadow: 0 4px 10px rgba(0,84,155,0.15); }
    .btn-accept-modern:hover { background: #003d70; transform: translateY(-1px); color: white; }
    .btn-accept-pen    { background: var(--p-purple); color: white; box-shadow: 0 4px 10px rgba(124,58,237,0.15); }
    .btn-accept-pen:hover { background: #5B21B6; transform: translateY(-1px); color: white; }
    .btn-reject-modern { background: var(--p-red); color: white; box-shadow: 0 4px 10px rgba(236,28,36,0.15); }
    .btn-reject-modern:hover { background: #c1121a; transform: translateY(-1px); color: white; }

    .detail-body { padding: 30px 40px 110px 40px; background: #fff; position: relative; }
    .info-card-premium { background: #f8fafc; border-radius: 16px; padding: 18px; height: 100%; border: 1px solid #eef2f6; }
    .info-label { color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-transform: uppercase; margin-bottom: 4px; display: flex; align-items: center; }
    .info-value { color: #000 !important; font-weight: 700; font-size: 0.9rem; margin-bottom: 12px; line-height: 1.4; }
    .highlight-noreg  { color: var(--p-orange)  !important; font-weight: 800; font-size: 1.1rem; }
    .highlight-email  { color: var(--p-blue)    !important; text-decoration: underline; }
    .highlight-wa     { color: var(--p-green)   !important; }
    .highlight-lokasi { color: var(--p-red)     !important; font-size: 1rem; }
    .highlight-judul  { color: var(--p-purple)  !important; font-size: 0.9rem; font-weight: 700; line-height: 1.4; }

    .doc-link { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: #fff; border-radius: 10px; text-decoration: none !important; color: #000; font-weight: 700; border: 1px solid #e2e8f0; margin-bottom: 8px; font-size: 0.85rem; transition: 0.2s; }
    .doc-link:hover { border-color: var(--p-blue); background: #f0f7ff; }

    .rekomendasi-box { background: transparent; border: none; padding: 0; }
    .text-rekomendasi { color: #000 !important; font-weight: 700; font-size: 0.9rem; line-height: 1.5; }
    .action-wrapper-minimal { position: absolute; bottom: 30px; right: 40px; display: flex; gap: 10px; z-index: 10; }

    .magang-row.unread, .penelitian-row.unread {
        background-color: rgba(0, 84, 155, 0.04) !important;
        border-left: 4px solid var(--p-blue);
    }
</style>

<div class="dashboard-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="title-bold mb-0">Manajemen Mahasiswa</h3>
            <p class="text-muted small mb-0">Portal Kendali <span class="fw-bold text-danger">Internship & Penelitian Pertamina</span>
            @if (adminRole != "SuperAdmin")
            {
                <span class="ms-1 fw-bold" style="color:var(--p-red);">@adminRegionManaged</span>
            }</p>
        </div>
        <button class="btn btn-pertamina shadow-sm" style="background:var(--p-blue);" onclick="exportExcel()">
            <i class="fas fa-file-excel me-1"></i> Export Excel
        </button>
    </div>

    <div class="tab-switcher">
        <button class="tab-btn active" id="tabBtnMagang" onclick="switchTab('magang', this)">
            <i class="fas fa-user-graduate"></i>
            Program Magang
            <span class="tab-count">@totalMagang</span>
        </button>
        <button class="tab-btn pen" id="tabBtnPenelitian" onclick="switchTab('penelitian', this)">
            <i class="fas fa-flask"></i>
            Program Penelitian
            <span class="tab-count">@totalPenelitian</span>
        </button>
    </div>

    <div id="tab-magang" class="tab-pane active">
        <div class="row g-3 mb-4">
            <div class="col-md">
                <div class="stat-card active" data-status="all" id="mag-card-all" onclick="filterByStatus('magang','all','mag-card-all')">
                    <div class="icon-box bg-light-blue"><i class="fas fa-user-group"></i></div>
                    <div><div class="stat-label">Total</div><div class="stat-value" id="mag-val-all">@totalMagang</div></div>
                </div>
            </div>
            <div class="col-md">
                <div class="stat-card" data-status="Menunggu" id="mag-card-proses" onclick="filterByStatus('magang','Menunggu','mag-card-proses')">
                    <div class="icon-box bg-light-orange"><i class="fas fa-hourglass-half"></i></div>
                    <div><div class="stat-label">Menunggu</div><div class="stat-value" id="mag-val-proses">@Model.StatusDiproses</div></div>
                </div>
            </div>
            <div class="col-md">
                <div class="stat-card" data-status="Diterima" id="mag-card-terima" onclick="filterByStatus('magang','Diterima','mag-card-terima')">
                    <div class="icon-box bg-light-green"><i class="fas fa-check-double"></i></div>
                    <div><div class="stat-label">Diterima</div><div class="stat-value" id="mag-val-terima">@Model.StatusDiterima</div></div>
                </div>
            </div>
            <div class="col-md">
                <div class="stat-card" data-status="Ditolak" id="mag-card-tolak" onclick="filterByStatus('magang','Ditolak','mag-card-tolak')">
                    <div class="icon-box bg-light-red"><i class="fas fa-user-xmark"></i></div>
                    <div><div class="stat-label">Ditolak</div><div class="stat-value" id="mag-val-tolak">@Model.StatusDitolak</div></div>
                </div>
            </div>
        </div>

        <div class="main-table-card">
            <div class="p-3 border-bottom bg-white">
                <div class="filter-toolbar">
                    <input type="text" id="tableSearch" class="form-control" placeholder="Cari nama, NIM, atau kampus...">
                    @if (canChangeRegionMhs)
                    {
                        <div class="dropdown">
                            <button class="btn-region-select dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
                                <span><i class="fas fa-map-marker-alt me-2"></i> @displayRegion</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-premium shadow-lg">
                                <li><a class="dropdown-item dropdown-item-premium @(rawSelectedRegion=="all"?"active":"")" href="javascript:void(0)" onclick="changeRegion('all')">Semua Region</a></li>
                                @foreach (var region in staticRegions)
                                {
                                    <li><a class="dropdown-item dropdown-item-premium @(rawSelectedRegion==region?"active":"")" href="javascript:void(0)" onclick="changeRegion('@region')">@region</a></li>
                                }
                                @if (ViewBag.AllRegions != null)
                                {
                                    foreach (var region in (IEnumerable<string>)ViewBag.AllRegions)
                                    {
                                        if (!staticRegions.Contains(region))
                                        {
                                            <li><a class="dropdown-item dropdown-item-premium @(rawSelectedRegion==region?"active":"")" href="javascript:void(0)" onclick="changeRegion('@region')">@region</a></li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover" id="magangTable">
                    <thead>
                        <tr>
                            <th class="ps-4">Mahasiswa</th>
                            <th>Institusi</th>
                            <th>Penempatan & Lokasi</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in daftarMagang)
                        {
                            <tr class="magang-row @(m.Status=="Menunggu"?"unread":"")" data-status="@m.Status" data-region="@m.Region" id="mag-row-@m.Id">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @{ var cleanFoto = m.FotoProfil?.Split('/').Last(); var fotoPath = string.IsNullOrEmpty(cleanFoto) ? "/img/default-user.png" : "/uploads/foto/" + cleanFoto; }
                                        <img src="@fotoPath" class="user-avatar-list me-3 shadow-sm">
                                        <div>
                                            <div class="fw-700 text-dark">@m.NamaLengkap</div>
                                            <div class="text-muted small">@m.NIM</div>
                                        </div>
                                    </div>
                                </td>
                                <td><div class="fw-600">@m.NamaPerguruanTinggi</div><div class="text-muted small">@m.Jurusan</div></td>
                                <td>
                                    <div class="text-primary fw-700">@m.Company</div>
                                    <div class="text-muted small">@m.Region | <span class="fw-bold text-danger">@m.Lokasi</span></div>
                                </td>
                                <td class="text-center"><span class="badge-status status-@m.Status">@m.Status</span></td>
                                <td class="text-center">
                                    <button class="btn-review mag" onclick='showDetailMagang(@Html.Raw(JsonSerializer.Serialize(m)))'>Review</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="tab-penelitian" class="tab-pane">
        <div class="row g-3 mb-4">
            <div class="col-md">
                <div class="stat-card active" data-status="all" id="pen-card-all" onclick="filterByStatus('penelitian','all','pen-card-all')">
                    <div class="icon-box bg-light-purple"><i class="fas fa-flask"></i></div>
                    <div><div class="stat-label">Total</div><div class="stat-value" id="pen-val-all">@totalPenelitian</div></div>
                </div>
            </div>
            <div class="col-md">
                <div class="stat-card" data-status="Menunggu" id="pen-card-proses" onclick="filterByStatus('penelitian','Menunggu','pen-card-proses')">
                    <div class="icon-box bg-light-orange"><i class="fas fa-hourglass-half"></i></div>
                    <div><div class="stat-label">Menunggu</div><div class="stat-value" id="pen-val-proses">@Model.PenStatusDiproses</div></div>
                </div>
            </div>
            <div class="col-md">
                <div class="stat-card" data-status="Diterima" id="pen-card-terima" onclick="filterByStatus('penelitian','Diterima','pen-card-terima')">
                    <div class="icon-box bg-light-green"><i class="fas fa-check-double"></i></div>
                    <div><div class="stat-label">Diterima</div><div class="stat-value" id="pen-val-terima">@Model.PenStatusDiterima</div></div>
                </div>
            </div>
            <div class="col-md">
                <div class="stat-card" data-status="Ditolak" id="pen-card-tolak" onclick="filterByStatus('penelitian','Ditolak','pen-card-tolak')">
                    <div class="icon-box bg-light-red"><i class="fas fa-user-xmark"></i></div>
                    <div><div class="stat-label">Ditolak</div><div class="stat-value" id="pen-val-tolak">@Model.PenStatusDitolak</div></div>
                </div>
            </div>
        </div>

        <div class="main-table-card">
            <div class="p-3 border-bottom bg-white">
                <div class="filter-toolbar">
                    <input type="text" id="penTableSearch" class="form-control" placeholder="Cari nama, NIM, atau kampus...">
                    @if (adminRole == "SuperAdmin")
                    {
                        <div class="dropdown">
                            <button class="btn-region-select dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
                                <span><i class="fas fa-map-marker-alt me-2"></i> @displayRegion</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-premium shadow-lg">
                                <li><a class="dropdown-item dropdown-item-premium @(rawSelectedRegion=="all"?"active":"")" href="javascript:void(0)" onclick="changeRegion('all')">Semua Region</a></li>
                                @foreach (var region in staticRegions)
                                {
                                    <li><a class="dropdown-item dropdown-item-premium @(rawSelectedRegion==region?"active":"")" href="javascript:void(0)" onclick="changeRegion('@region')">@region</a></li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover" id="penelitianTable">
                    <thead>
                        <tr>
                            <th class="ps-4">Peneliti</th>
                            <th>Institusi</th>
                            <th>Judul & Lokasi</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in daftarPenelitian)
                        {
                            <tr class="penelitian-row @(p.Status=="Menunggu"?"unread":"")" data-status="@p.Status" data-region="@p.Region" id="pen-row-@p.Id">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @{ var pFoto = p.PathFoto3x4?.Split('/').Last(); var pFotoPath = string.IsNullOrEmpty(pFoto) ? "/img/default-user.png" : "/uploads/foto/" + pFoto; }
                                        <img src="@pFotoPath" class="user-avatar-list me-3 shadow-sm">
                                        <div>
                                            <div class="fw-700 text-dark">@p.Nama</div>
                                            <div class="text-muted small">@p.Nim</div>
                                        </div>
                                    </div>
                                </td>
                                <td><div class="fw-600">@p.Universitas</div><div class="text-muted small">@p.Jurusan</div></td>
                                <td>
                                    <div class="fw-700" style="color:var(--p-purple); font-size:0.82rem; line-height:1.3;">@p.JudulPenelitian</div>
                                    <div class="text-muted small">@p.Region | <span class="fw-bold text-danger">@p.LokasiPenelitian</span></div>
                                </td>
                                <td class="text-center"><span class="badge-status status-@p.Status">@p.Status</span></td>
                                <td class="text-center">
                                    <button class="btn-review pen" onclick='showDetailPenelitian(@Html.Raw(JsonSerializer.Serialize(p)))'>Review</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

