                                            <i class="fas fa-upload"></i> Pilih file surat baru (PDF, maks 5MB)
                                        </div>
                                        <input id="revisiFileSurat" type="file" accept=".pdf" style="display:none;" 
                                            onchange="previewNamaFile(this, 'namaFileSurat')">
