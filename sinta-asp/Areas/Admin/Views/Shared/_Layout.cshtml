@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var adminNama = HttpContextAccessor.HttpContext?.Session.GetString("AdminNama") ?? "Admin";
    var adminEmail = HttpContextAccessor.HttpContext?.Session.GetString("AdminEmail");
    var avatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(adminNama)}&background=00549B&color=fff";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin SINTA</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">

    <style>
        :root {
            --p-blue: #00549B;
            --p-red: #ec1c24;
            --sidebar-width: 280px;
            --topbar-height: 80px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            overflow-x: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #fff;
            border-right: 1px solid #e2e8f0;
            z-index: 1000;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
        }

        .brand-container {
            margin-bottom: 50px;
            padding: 0 10px;
        }

        .brand-logo-pertamina {
            height: 60px;
        }

        .nav-link-custom {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #64748b;
            border-radius: 12px;
            text-decoration: none !important;
            margin-bottom: 6px;
            font-weight: 600;
            transition: var(--transition);
        }

        .nav-link-custom:hover {
            background: rgba(0, 84, 155, 0.05);
            color: var(--p-blue);
            transform: translateX(5px);
        }

        .nav-link-custom.active {
            background: var(--p-blue);
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(0, 84, 155, 0.2);
        }

        /* Logout Button */
        .nav-link-logout {
            color: var(--p-red) !important;
            border: 1px solid #fee2e2;
            background: #fffafa;
            margin-top: auto;
        }
        .nav-link-logout:hover {
            background: #fee2e2;
            transform: none;
        }

        /* Topbar Styling */
        .topbar {
            height: var(--topbar-height);
            position: fixed;
            top: 0;
            right: 0;
            left: var(--sidebar-width);
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            z-index: 999;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .brand-logo-sinta {
            height: 45px;
        }

        .main-content {
            margin-left: var(--sidebar-width);
            padding-top: var(--topbar-height);
        }

        .profile-dropdown .dropdown-toggle::after { display: none; }
        .profile-dropdown .dropdown-menu {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 10px;
        }
        
        /* Badge for notification/new */
        .badge-new {
            background: var(--p-red);
            color: white;
            font-size: 0.6rem;
            padding: 2px 6px;
            border-radius: 50px;
            margin-left: auto;
        }
    </style>
</head>
<body>

<nav class="sidebar">
    <div class="brand-container">
        <img src="~/images/logo-pertamina.png" class="brand-logo-pertamina" alt="Pertamina">
    </div>

    <ul style="list-style:none; padding:0; flex-grow:1;">
        <li>
            <a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="fa-solid fa-house mr-2"></i> Dashboard
            </a>
        </li>
        <li>
            <a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mahasiswa" ? "active" : "")"
               asp-area="Admin" asp-controller="Mahasiswa" asp-action="Index">
                <i class="fa-solid fa-users mr-2"></i> Data Mahasiswa
            </a>
        </li>
        
        <li>
            <a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "EmailTemplate" ? "active" : "")"
               asp-area="Admin" asp-controller="EmailTemplate" asp-action="Index">
                <i class="fa-solid fa-envelope-open-text mr-2"></i> Format Konfirmasi
            </a>
        </li>

        <li>
            <a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")"
               asp-area="Admin" asp-controller="Settings" asp-action="Index">
                <i class="fa-solid fa-gear mr-2"></i> Settings
            </a>
        </li>
    </ul>

    <a asp-area="Admin" asp-controller="Login" asp-action="Logout"
       class="nav-link-custom nav-link-logout">
        <i class="fa-solid fa-right-from-bracket mr-2"></i> Logout
    </a>
</nav>

<header class="topbar">
    <div class="d-flex align-items-center">
        <i class="fa-solid fa-bars-staggered mr-3 text-muted d-none d-md-block"></i>
        <span class="font-weight-bold text-muted">Panel Administrator</span>
    </div>

    <div class="d-flex align-items-center">
        <img src="~/images/logo-sinta.png" class="brand-logo-sinta mr-4">

        <div class="text-right mr-3" style="border-left:1px solid #e2e8f0; padding-left:20px;">
            <div class="small font-weight-bold">@adminNama</div>
            <small class="text-success font-weight-bold">
                <i class="fa-solid fa-circle text-success mr-1" style="font-size: 8px;"></i> Online
            </small>
        </div>

        <div class="dropdown profile-dropdown">
            <a class="dropdown-toggle" data-toggle="dropdown" style="cursor: pointer;">
                <img src="@avatarUrl" class="rounded-circle shadow-sm border" width="45">
            </a>
            <div class="dropdown-menu dropdown-menu-right">
                <h6 class="dropdown-header">Akun Admin</h6>
                <div class="dropdown-item-text small text-muted">@adminEmail</div>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="#"><i class="fa-solid fa-user-shield mr-2"></i> Profil</a>
                <a class="dropdown-item text-danger"
                   asp-area="Admin" asp-controller="Login" asp-action="Logout">
                    <i class="fa-solid fa-power-off mr-2"></i> Keluar
                </a>
            </div>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="container-fluid py-4">
        @RenderBody()
    </div>
</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

@RenderSection("Scripts", required: false)

</body>
</html>