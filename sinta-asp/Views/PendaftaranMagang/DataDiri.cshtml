            regions = Object.keys(dataKPI);
        } else if (this.value === 'PPN') {
            regions = Object.keys(dataPPN);
        }
        regions.forEach(region => {
            const option = document.createElement('option');
            option.value = region;
            option.textContent = region;
            regionSelect.appendChild(option);
        });
    });

