@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var namaUser = User?.Identity?.IsAuthenticated == true ? User.Identity.Name : "Peserta SINTA";
    var safeName = namaUser ?? "Peserta";
    var avatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(safeName)}&background=00549B&color=fff";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SINTA Pertamina</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    
    <style>
        :root {
            --p-blue: #00549B;
            --p-red: #ec1c24;
            --sidebar-width: 280px;
            --topbar-height: 80px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --p-gray-bg: #f8fafc;
        }

        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--p-gray-bg); overflow-x: hidden; }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed;
            left: 0; top: 0; background: #fff; border-right: 1px solid #e2e8f0;
            z-index: 1000; padding: 30px 20px; display: flex; flex-direction: column;
        }
        .brand-container { margin-bottom: 50px; padding: 0 10px; }
        .brand-logo-pertamina { height: 45px; }

        .nav-link-custom {
            display: flex; align-items: center; padding: 12px 16px; color: #64748b;
            border-radius: 12px; text-decoration: none !important; margin-bottom: 6px;
            font-weight: 600; transition: var(--transition); border: none; background: transparent; width: 100%;
        }
        .nav-link-custom:hover { background: rgba(0, 84, 155, 0.05); color: var(--p-blue); }
        .nav-link-custom.active { background: var(--p-blue); color: #fff !important; box-shadow: 0 4px 12px rgba(0, 84, 155, 0.2); }
        .nav-link-logout { color: var(--p-red) !important; border: 1px solid #fee2e2; background: #fffafa; margin-top: auto; }

        /* Topbar */
        .topbar {
            height: var(--topbar-height); position: fixed; top: 0; right: 0; left: var(--sidebar-width);
            background: #fff; border-bottom: 1px solid #e2e8f0; z-index: 999;
            display: flex; align-items: center; justify-content: space-between; padding: 0 30px;
        }
        .main-content { margin-left: var(--sidebar-width); padding-top: var(--topbar-height); min-height: 100vh; }

        /* Global Cards */
        .glass-card {
            background: white; border-radius: 16px; border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); padding: 25px; height: 100%;
        }
        .status-badge { padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; }
        .status-review { background: #fef9c3; color: #854d0e; }
        .status-approved { background: #dcfce7; color: #166534; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

<nav class="sidebar">
    <div class="brand-container">
        <img src="~/images/logo-pertamina.png" class="brand-logo-pertamina" alt="Pertamina">
    </div>
    <div style="flex-grow: 1;">
        <a class="nav-link-custom @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" asp-action="Index">
            <i class="fa-solid fa-house mr-3"></i> Dashboard
        </a>
        <a class="nav-link-custom" href="#riwayat">
            <i class="fa-solid fa-clipboard-list mr-3"></i> Riwayat Magang
        </a>
        <a class="nav-link-custom" href="#riset">
            <i class="fa-solid fa-flask mr-3"></i> Riwayat Riset
        </a>
        <a class="nav-link-custom" href="#profil">
            <i class="fa-solid fa-user-gear mr-3"></i> Pengaturan Profil
        </a>
    </div>
    <a href="javascript:void(0)" onclick="confirmLogout()" class="nav-link-custom nav-link-logout">
        <i class="fa-solid fa-right-from-bracket mr-3"></i> Logout
    </a>
</nav>

<header class="topbar">
    <div class="d-flex align-items-center">
        <i class="fa-solid fa-bars-staggered mr-3 text-muted"></i>
        <span class="font-weight-bold text-muted">Panel Peserta / Dashboard</span>
    </div>
    <div class="d-flex align-items-center">
        <img src="~/images/logo-sinta.png" style="height:40px;" class="mr-4">
        <div class="text-right mr-3 border-left pl-3">
            <div class="small font-weight-bold">@namaUser</div>
            <small class="text-success font-weight-bold"><i class="fa-solid fa-circle mr-1" style="font-size: 8px;"></i> Online</small>
        </div>
        <img src="@avatarUrl" class="rounded-circle shadow-sm border" width="45">
    </div>
</header>

<main class="main-content">
    <div class="container-fluid py-4">
        @RenderBody()
    </div>
</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmLogout() {
        Swal.fire({
            title: 'Keluar Sesi?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ec1c24',
            confirmButtonText: 'Ya, Logout'
        }).then((result) => { if (result.isConfirmed) { window.location.href = '/Auth/Logout'; } });
    }
</script>
@RenderSection("Scripts", required: false)
</body>
</html>