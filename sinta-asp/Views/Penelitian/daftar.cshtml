@model sinta_asp.Models.PendaftaranPenelitianModel
@{
    ViewData["Title"] = "Formulir Pendaftaran";
    
    
    // VARIABEL PENYELAMAT SIMBOL @
    var at = "@";
    // 1. TANGKAP DATA DARI URL
    var preCompany = Context.Request.Query["preCompany"].ToString();
    var preRegion = Context.Request.Query["preRegion"].ToString();
    var preTargetJurusan = Context.Request.Query["preTargetJurusan"].ToString();

    // --- [BARU] TANGKAP LOKASI DARI URL ---
    var preTargetLokasi = Context.Request.Query["preTargetLokasi"].ToString(); 

    // 2. LOGIKA JALUR KHUSUS (VIP)
    bool isJalurKhusus = !string.IsNullOrEmpty(preCompany);
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">

<style>

    /* 2. CONFIG WARNA & FONT */
    :root { 
        --p-blue-tua: #003B76;
        --p-green: #5CB85C; 
        --p-red: #E30613; 
    }

    html, body {
        background-color: #ffffff !important;
        font-family: 'Inter', sans-serif;
        font-size: 15px;
    }

    .penelitian-wrapper {
        width: 100%; min-height: 100vh;
        background-color: #ffffff !important;
        padding-top: 20px; /* Jarak atas dikurangi biar compact */
        padding-bottom: 50px;
        display: flex; flex-direction: column; align-items: center;
        position: relative;
    }

    /* 3. JUDUL (Font Size Disesuaikan) */
    .page-title-section { text-align: center; margin-bottom: 25px; width: 100%; }
    .page-title-section h2 {
        font-family: 'Montserrat', sans-serif !important;
        font-weight: 800;
        font-size: 1.7rem; /* Font Judul Dikecilkan */
        color: var(--p-blue-tua) !important;
        margin-bottom: 5px; letter-spacing: -0.5px;
    }
    .page-title-section p { color: #64748b !important; font-size: 0.75rem; font-family: 'Montserrat', sans-serif;}

    /* 4. CARD FORM (COMPACT STYLE) */
    .card-form {
        background: #ffffff;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08); 
        border: 1px solid #f1f5f9; border-radius: 16px; 
        width: 100%; max-width: 700px;
        margin: 0 auto; overflow: hidden; position: relative; font-size: 19px;
    }
    /* Trik Compact: Rapatkan jarak antar kolom Bootstrap (Override Gutter) */
    .card-form .row { --bs-gutter-y: 12px !important; } 

    /* 5. TOMBOL BACK */
    .btn-back-home {
        position: absolute; left: 40px; top: 25px; 
        background: #f8fafc; color: var(--p-blue-tua) !important;
        border: 1px solid #e2e8f0; padding: 6px 16px; border-radius: 50px;
        font-weight: 600; text-decoration: none; 
        display: inline-flex; align-items: center; gap: 6px;
        transition: all 0.2s; font-size: 0.8rem; /* Font tombol back kecil */
    }
    .btn-back-home:hover { background: var(--p-blue-tua); color: white !important; }

    /* --- [UPDATE] STEPPER (ALIGNMENT & COLOR) --- */
    .nav-pills { 
        margin-bottom: 20px; 
        justify-content: center; 
        gap: 8px; 
    }
    
    .nav-link { 
        background: #f8fafc; 
        color: #475569; /* [FIX] Warna Teks JELAS (Abu Gelap) */
        border-radius: 50px !important;
        padding: 9px 18px; 
        font-weight: 600; 
        border: 1px solid #e2e8f0; /* Default border abu tipis */
        font-size: 0.9rem; /* Font step kecil */
        
        /* [FIX] Alignment Rapih Icon & Teks */
        display: inline-flex; 
        align-items: center; 
        justify-content: center;
    }
    
    /* Active State */
    .nav-link.active { 
        background: var(--p-blue-tua) !important; 
        color: white !important; 
        border-color: var(--p-blue-tua);
        box-shadow: 0 4px 10px rgba(15, 52, 96, 0.2);
    }

    /* Done State (Border HAPUS, Teks Tetap, Icon Hijau) */
    .nav-link.done {
        background-color: #fff !important; 
        border-color: #e2e8f0 !important; /* [FIX] Border balik ke abu biasa */
        color: #475569 !important;
    }
    .nav-link.done .step-marker {
        background: transparent !important;
        color: var(--p-green) !important; /* Cuma Icon yang Hijau */
        /* font-size: 1.1rem; Icon dibesarkan dikit biar jelas */
    }

    /* Error State (Border HAPUS, Teks Tetap, Icon Merah) */
    .nav-link.error {
        background-color: #fff !important; 
        border-color: #e2e8f0 !important; /* [FIX] Border balik ke abu biasa */
        color: #475569 !important;
    }
    .nav-link.error .step-marker {
        background: transparent !important;
        color: var(--p-red) !important; /* Cuma Icon yang Merah */
        /* font-size: 1.1rem; */
    }

    .step-marker { margin-right: 6px; display: flex; align-items: center; }

    /* --- [UPDATE] INPUT COMPACT & FONT KECIL --- */
    .form-control, .form-select { 
        padding: 8px 12px; /* Padding dikecilkan */
        border-radius: 8px; 
        border: 1px solid #cbd5e1; 
        background-color: #fff; 
        font-size: 0.9rem; /* [FIX] Font Input tidak besar */
    }
    .form-control:focus, .form-select:focus { 
        border-color: var(--p-blue-tua); 
        box-shadow: 0 0 0 3px rgba(15, 52, 96, 0.1); 
    }
    
    /* Label Compact */
    label.form-label { 
        font-weight: 700; 
        color: #334155; 
        margin-bottom: 4px; /* Jarak label ke input didempetin */
        font-size: 0.85rem; /* [FIX] Font Label kecil rapi */
        text-transform: capitalize; 
        letter-spacing: 0.5px; 
    }

    label.form-label::after {
        content: " *";
        color: var(--p-red);
        font-weight: bold;
    }

    /* VIP Input (Readonly) */
    .readonly-input, input[readonly] {
        background-color: #f1f5f9 !important; 
        color: #64748b !important;
        border-color: #cbd5e1 !important;
        cursor: not-allowed !important;
    }

    /* Tombol Bawah (Solid, No Transparent Hover) */
    .btn-next, .btn-submit, .btn-back {
        border-radius: 8px; font-weight: 600; border: none; font-size: 0.95rem;
        transition: background-color 0.2s; opacity: 1 !important;
    }
    .btn-next { background: var(--p-blue-tua); color: white; padding: 8px 16px; }
    .btn-next:hover { background-color: #0a2545; }

    .btn-submit { 
        background-color: #1a7a4a !important; /* Hijau Emerald Gelap */
        color: #ffffff !important; 
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        border: none !important;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        opacity: 1 !important; /* Memastikan tidak transparan */
        transition: background-color 0.2s ease-in-out;
    }

    /* Saat Kursor di Atas Tombol (Hover) */
    .btn-submit:hover { 
        background-color: #145d39 !important; /* Hijau lebih gelap sedikit */
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(26, 122, 74, 0.2);
    }

    .btn-back { background: #fff; border: 1px solid #cbd5e1; color: #64748b; padding: 8px 16px; }
    .btn-back:hover { background-color: #164a8a !important; box-shadow: 0 4px 12px rgba(15, 52, 96, 0.2);}
    
    .d-none { display: none; }
    .invalid-feedback { color: var(--p-red); margin-top: 3px; font-size: 0.75rem; }

    /* Mengubah Background Alert Info menjadi Navy */
    .alert-info {
        background-color: var(--p-blue-tua) !important; /* Background Navy Solid */
        color: #ffffff !important; /* Teks Putih agar kontras */
        border: none !important;
        border-radius: 8px;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;   /* <--- Font dikecilkan (agar seimbang) */
        margin-bottom: 10px; /* Opsional: Mengurangi jarak ke bawahnya */
    }

    /* Memastikan Icon di dalam alert juga berwarna putih */
    .alert-info i, .alert-info small {
        color: #ffffff !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .card-form { max-width: 95%; box-shadow: none; border: none; }
        .page-title-section h2 { font-size: 1.5rem; }
    }

    /* Menambahkan bintang merah otomatis pada label */
    label.form-label::after {
        content: " *";
        color: var(--p-red); /* Menggunakan variabel warna merah yang sudah Anda buat */
        font-weight: bold;
    }

    /* Mewarnai placeholder standar (Nama, Email, dll) */
    ::placeholder {
        color: #94a3b8 !important; /* Warna abu-abu (Slate 400) */
        opacity: 1; 
    }

    /* Khusus untuk input tipe Date (dd/mm/yyyy) */
    input[type="date"] {
        color: #94a3b8; /* Warna teks saat masih kosong */
    }

    /* Mengubah warna teks date menjadi gelap kembali setelah diisi */
    input[type="date"]:focus, 
    input[type="date"]:valid {
        color: #334155; /* Warna teks gelap (Slate 700) */
    }

    /* Penyesuaian browser webkit (Chrome/Edge) untuk input tanggal */
    ::-webkit-datetime-edit-text,
    ::-webkit-datetime-edit-month-field,
    ::-webkit-datetime-edit-day-field,
    ::-webkit-datetime-edit-year-field {
        color: #94a3b8;
    }

    /* Mengembalikan warna field tanggal saat ada isinya */
    input[type="date"]:valid::-webkit-datetime-edit-text,
    input[type="date"]:valid::-webkit-datetime-edit-month-field,
    input[type="date"]:valid::-webkit-datetime-edit-day-field,
    input[type="date"]:valid::-webkit-datetime-edit-year-field {
        color: #334155;
    }
</style>

<div class="penelitian-wrapper">
    <div class="container mb-5">
        <div class="row justify-content-center">
            <div class="col-12">
                
                <div class="page-title-section">
                    <a asp-action="Index" class="btn-back-home"><i class="bi bi-arrow-left"></i> Back</a>
                    <h2>Pendaftaran Penelitian</h2>
                    <p>Lengkapi formulir di bawah ini dengan data yang benar.</p>
                </div>

                <form asp-action="SubmitPendaftaran" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="TargetJurusan" value="@preTargetJurusan" />
                    
                    <input type="hidden" id="vipLokasiData" value="@preTargetLokasi" />

                    <ul class="nav nav-pills step-indicator" id="pills-tab" role="tablist">
                        <li class="nav-item"><button class="nav-link active" id="tab-1" data-bs-toggle="pill" data-bs-target="#step-1" type="button"><span class="step-marker">1</span> Personal</button></li>
                        <li class="nav-item"><button class="nav-link" id="tab-2" data-bs-toggle="pill" data-bs-target="#step-2" type="button"><span class="step-marker">2</span> Education</button></li>
                        <li class="nav-item"><button class="nav-link" id="tab-3" data-bs-toggle="pill" data-bs-target="#step-3" type="button"><span class="step-marker">3</span> Research</button></li>
                        <li class="nav-item"><button class="nav-link" id="tab-4" data-bs-toggle="pill" data-bs-target="#step-4" type="button"><span class="step-marker">4</span> Files</button></li>
                    </ul>
                    
                    <div class="card card-form">
                        <div class="card-body p-4"> 
                            <div class="tab-content" id="pills-tabContent">
                                
                                <div class="tab-pane fade show active" id="step-1">
                                    <div class="row g-2">
                                        <div class="col-12 d-flex justify-content-center mb-1">
                                        <div class="text-center mb-2">
                                        <input type="file" asp-for="Foto3x4" id="inputFoto" class="d-none" accept="image/*" onchange="tampilkanPreview(this)" required>

                                        <div class="mx-auto position-relative" 
                                            onclick="document.getElementById('inputFoto').click()" 
                                            style="width: 105px; height: 135px; cursor: pointer; border-radius: 12px; overflow: hidden; border: 2px dashed #cbd5e1; background: #f1f5f9; transition: all 0.2s;">
                                            
                                            <img id="previewFoto" 
                                                src="https://upload.wikimedia.org/wikipedia/commons/7/7c/Profile_avatar_placeholder_large.png" 
                                                alt="Pas Foto" 
                                                style="width: 100%; height: 100%; object-fit: cover;">
                                            
                                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" 
                                                style="background: rgba(0,0,0,0.05); opacity: 0; transition: opacity 0.2s;" 
                                                onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0">
                                                <i class="bi bi-camera-fill text-dark fs-3"></i>
                                            </div>
                                        </div>

                                        <div class="mt-2 small text-muted fw-semibold" style="font-size: 0.8rem; text-transform: capitalize;">
                                            Pas Foto 3x4
                                        </div>
                                        <span id="pesanErrorFoto" 
                                            class="text-danger fw-bold mt-1" 
                                            style="display:none; font-size: 0.7rem;"> </span>
                                        <span asp-validation-for="Foto3x4" class="text-danger small fw-bold d-block"></span>
                                    </div>
                                    </div>
                                        <div class="col-12">
                                            <label class="form-label">Nama Lengkap</label>
                                            <input type="text" class="form-control" asp-for="Nama" required>
                                            <div class="invalid-feedback">Nama wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" asp-for="Email" required>
                                            <div class="invalid-feedback">Email tidak valid.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">No. Telepone</label>
                                            <input type="number" class="form-control" asp-for="NoHp" required>
                                            <div class="invalid-feedback">Harus diawali 08 (min 10 digit).</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Tempat Lahir</label>
                                            <input type="text" class="form-control" asp-for="TempatLahir" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Tanggal Lahir</label>
                                            <input type="date" class="form-control" asp-for="TglLahir" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Instagram</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light text-muted">&#64;</span>
                                                <input type="text" class="form-control" asp-for="Instagram" required>
                                                <div class="invalid-feedback">Wajib diisi.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-5 text-center">
                                        <button type="button" class="btn btn-next" onclick="cekStep1()">Selanjutnya <i class="bi bi-arrow-right ms-2"></i></button>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="step-2">
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <label class="form-label">Universitas</label>
                                            <input type="text" class="form-control" asp-for="Universitas" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Fakultas</label>
                                            <input type="text" class="form-control" asp-for="Fakultas" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Jurusan</label>
                                            <input type="text" class="form-control" asp-for="Jurusan" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">NIM</label>
                                            <input type="text" class="form-control" asp-for="Nim" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                    </div>
                                    <div class="mt-5 d-flex justify-content-center gap-3">
                                        <button type="button" class="btn btn-back" onclick="prevStep('tab-1')">Kembali</button>
                                        <button type="button" class="btn btn-next" onclick="nextStep('tab-2', 'tab-3')">Selanjutnya <i class="bi bi-arrow-right"></i></button>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="step-3">
                                    <div class="row g-4">
                                        
                                        <div class="col-md-6">
                                            <label class="form-label">Company Tujuan</label>
                                            @if (isJalurKhusus)
                                            {
                                                <input type="text" class="form-control readonly-input" value="@preCompany" readonly>
                                                <input type="hidden" asp-for="Company" value="@preCompany" id="companyInputLocked">
                                            }
                                            else
                                            {
                                                <select class="form-select" asp-for="Company" required id="companySelect">
                                                    <option value="">Pilih Company...</option>
                                                    <option value="PT Pertamina Patra Niaga (C&T)">PT Pertamina Patra Niaga (C&T)</option>
                                                    <option value="PT Kilang Pertamina Internasional (KPI)">PT Kilang Pertamina Internasional (KPI)</option>
                                                </select>
                                            }
                                            <div class="invalid-feedback">Wajib dipilih.</div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Region / Unit Operasi</label>
                                            @if (isJalurKhusus)
                                            {
                                                <input type="text" class="form-control readonly-input" value="@preRegion" readonly id="regionInputLocked">
                                                <input type="hidden" asp-for="Region" value="@preRegion">
                                            }
                                            else
                                            {
                                                <select class="form-select" asp-for="Region" required id="regionSelect">
                                                    <option value="">Pilih Company Dahulu...</option>
                                                </select>
                                            }
                                            <div class="invalid-feedback">Wajib dipilih.</div>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Lokasi Penelitian</label>
                                            <select class="form-select" asp-for="LokasiPenelitian" required id="lokasiSelect">
                                                 <option value="">Pilih Region Dahulu...</option>
                                            </select>
                                            <div class="invalid-feedback">Wajib dipilih.</div>
                                        
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Judul Penelitian</label>
                                            <input type="text" class="form-control" asp-for="JudulPenelitian" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Mulai</label>
                                            <input type="date" class="form-control" asp-for="TglMulai" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Selesai</label>
                                            <input type="date" class="form-control" asp-for="TglSelesai" required>
                                            <div class="invalid-feedback">Wajib diisi.</div> 
                                        </div>
                                    </div>
                                    <div class="mt-5 d-flex justify-content-center gap-3">
                                        <button type="button" class="btn btn-back" onclick="prevStep('tab-2')">Kembali</button>
                                        <button type="button" class="btn btn-next" onclick="nextStep('tab-3', 'tab-4')">Selanjutnya <i class="bi bi-arrow-right ms-2"></i></button>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="step-4">
                                    <div class="row g-4">
                                        <div class="col-12 alert alert-info">
                                            <small><i class="bi bi-info-circle"></i> Pastikan file berformat PDF dan ukuran maks 2MB.</small>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-bold">Resume / CV (PDF)</label>
                                            <input type="file" class="form-control" asp-for="FileCV" accept=".pdf" required>
                                            <div class="invalid-feedback">Wajib upload.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-bold">Proposal (PDF)</label>
                                            <input type="file" class="form-control" asp-for="FileProposal" accept=".pdf" required>
                                            <div class="invalid-feedback">Wajib upload.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-bold">Surat Pengantar (PDF)</label>
                                            <input type="file" class="form-control" asp-for="FileSurat" accept=".pdf" required>
                                            <div class="invalid-feedback">Wajib upload.</div>
                                        </div>
                                    </div>
                                    <div class="mt-5 d-flex justify-content-center gap-3">
                                        <button type="button" class="btn btn-back" onclick="prevStep('tab-3')">Kembali</button>
                                        
                                        <button type="submit" class="btn btn-submit" id="btnSubmit" onclick="cekFoto(event)">
                                            Kirim Pendaftaran <i class="bi bi-send-fill"></i>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
    // --- DATA LOKASI PENELITIAN PER REGION (SAMA SEPERTI SEBELUMNYA) ---
    const dataLokasi = {
        "Refinery Unit VI Balongan": [
