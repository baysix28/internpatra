@{
    ViewData["Title"] = "Monitoring Status Pendaftaran - SINTA";
}

<style>
    :root {
        --pertamina-blue: #005EB8;
        --pertamina-green: #00A859;
        --pertamina-red: #E30613;
        --pertamina-dark: #003B76;
        --shadow-medium: rgba(0, 94, 184, 0.15);
    }

    .header-status {
        background: linear-gradient(135deg, var(--pertamina-blue) 0%, var(--pertamina-dark) 100%);
        color: white; padding: 22px 0 30px 0; text-align: center;
    }
    .header-status h2 { font-weight: 700; font-size: 26px; margin-bottom: 2px; }
    .header-status p  { font-size: 12px; margin-bottom: 0; opacity: 0.9; }

    .search-container { margin-top: 20px; margin-bottom: 15px; }

    .status-card {
        background: white; border-radius: 12px; padding: 18px;
        box-shadow: 0 6px 18px var(--shadow-medium);
        border-top: 4px solid var(--pertamina-green);
    }

    .input-group-custom {
        display: flex; background: #f8fbff; border: 1.5px solid #e1e8f0;
        border-radius: 35px; padding: 3px 3px 3px 16px; align-items: center;
    }
    .input-group-custom input {
        border: none; background: transparent; width: 100%;
        outline: none; font-size: 13px; text-transform: uppercase;
    }
    .btn-periksa {
        background: linear-gradient(135deg, var(--pertamina-green), #008a49);
        color: white; border: none; padding: 7px 18px;
        border-radius: 35px; font-weight: 600; font-size: 13px; cursor: pointer;
    }

    #searchResult { display: none; margin-top: 14px; }
    .result-box {
        border: 1px solid #e1e8f0; border-radius: 10px;
        padding: 14px; background-color: #ffffff;
    }
    .result-box h6 { font-size: 13px; }
    .table td { font-size: 12.5px; padding: 5px; }

    .status-badge { padding: 3px 10px; border-radius: 14px; font-weight: 600; font-size: 11px; }
    .status-pending  { background: #fff3cd; color: #856404; }
    .status-diterima { background: #dcfce7; color: #065f46; }
    .status-ditolak  { background: #fee2e2; color: #991b1b; }

    .alert-danger {
        background-color: #FEF2F2; border: 1px solid #FCA5A5;
        color: #991B1B; font-weight: 500;
    }

    .type-label {
        font-size: 10px; font-weight: 800; text-transform: uppercase;
        padding: 2px 8px; border-radius: 20px; margin-right: 6px;
    }
    .type-label.magang    { background: #dbeafe; color: #1e40af; }
    .type-label.penelitian { background: #ede9fe; color: #5b21b6; }
</style>

<section class="header-status">
    <div class="container">
        <h2>Monitoring Status Pendaftaran</h2>
        <p>Cek progres lamaran magang & penelitian Anda</p>
    </div>
</section>

<div class="container search-container">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="status-card">
                <form id="searchForm">
                    <div class="input-group-custom">
                        <input type="text" id="searchInput" placeholder="Masukkan Nomor Pendaftaran Anda" required>
                        <button type="submit" class="btn-periksa">
                            <i class="fas fa-search"></i> Periksa
                        </button>
                    </div>
                </form>

                <div id="searchResult">
                    <hr class="my-2">
                    <div class="result-box">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0" id="resultTitle">Hasil Pencarian</h6>
                            <span class="status-badge status-pending" id="statusBadge">Menunggu</span>
                        </div>
                        <table class="table table-sm table-borderless mb-0" id="resultTable"></table>
                    </div>
                </div>

                <div class="mt-2 p-2 rounded-3" style="background-color: #fff9e6; border-left: 4px solid #ffc107;">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        Sesuaikan nomor pendaftaran yang telah dikirim di Email.
                    </small>
                </div>

                <div id="alertNotFound" class="alert alert-danger mt-3" style="display: none; border-radius: 10px; font-size: 13px;">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    Maaf, nomor pendaftaran <strong><span id="invalidNo"></span></strong> tidak ditemukan. Silakan periksa kembali.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('searchForm').addEventListener('submit', function (e) {
        e.preventDefault();

        const no        = document.getElementById('searchInput').value.trim();
        const resultDiv = document.getElementById('searchResult');
        const alertDiv  = document.getElementById('alertNotFound');

        resultDiv.style.display = 'none';
        alertDiv.style.display  = 'none';

        // Cek magang dulu, kalau tidak ada cek penelitian
        fetch(`/HasilPendaftaran/CekStatus?no=${encodeURIComponent(no)}`)
            .then(r => r.json())
            .then(data => {
                if (data) {
                    tampilkanHasil(data, 'magang');
                } else {
                    // Tidak ditemukan di magang, coba penelitian
                    return fetch(`/HasilPendaftaran/CekStatusPenelitian?no=${encodeURIComponent(no)}`)
                        .then(r => r.json())
                        .then(data2 => {
                            if (data2) {
                                tampilkanHasil(data2, 'penelitian');
                            } else {
                                document.getElementById('invalidNo').innerText = no;
                                alertDiv.style.display = 'block';
                            }
                        });
                }
            })
            .catch(() => {
                document.getElementById('invalidNo').innerText = 'sistem';
                alertDiv.style.display = 'block';
            });
    });

    function tampilkanHasil(data, tipe) {
        const badge   = document.getElementById('statusBadge');
        const table   = document.getElementById('resultTable');
        const titleEl = document.getElementById('resultTitle');
        const result  = document.getElementById('searchResult');
        const culture = 'id-ID';

        // Badge status
        badge.innerText = data.status;
        badge.className = data.status === 'Diterima' ? 'status-badge status-diterima'
                        : data.status === 'Ditolak'  ? 'status-badge status-ditolak'
                        : 'status-badge status-pending';

        if (tipe === 'magang') {
            titleEl.innerHTML = '<span class="type-label magang">Magang</span> Hasil Pencarian';
            table.innerHTML = `
                <tr><td width="140" class="text-muted">Nama Pelamar</td><td>: ${data.nama}</td></tr>
                <tr><td class="text-muted">Email</td><td>: ${data.email}</td></tr>
                <tr><td class="text-muted">Universitas</td><td>: ${data.universitas || '-'}</td></tr>
                <tr><td class="text-muted">Jurusan</td><td>: ${data.jurusan || '-'}</td></tr>
                <tr><td class="text-muted">Region</td><td>: ${data.region || '-'}</td></tr>
                <tr><td class="text-muted">Lokasi</td><td>: ${data.lokasi || '-'}</td></tr>
                <tr><td class="text-muted">Periode</td><td>: ${data.mulai} s/d ${data.selesai}</td></tr>
            `;
        } else {
            titleEl.innerHTML = '<span class="type-label penelitian">Penelitian</span> Hasil Pencarian';
            table.innerHTML = `
                <tr><td width="140" class="text-muted">Nama Peneliti</td><td>: ${data.nama}</td></tr>
                <tr><td class="text-muted">Email</td><td>: ${data.email}</td></tr>
                <tr><td class="text-muted">Universitas</td><td>: ${data.universitas || '-'}</td></tr>
                <tr><td class="text-muted">Jurusan</td><td>: ${data.jurusan || '-'}</td></tr>
                <tr><td class="text-muted">Judul Penelitian</td><td>: ${data.judulPenelitian || '-'}</td></tr>
                <tr><td class="text-muted">Lokasi Penelitian</td><td>: ${data.lokasiPenelitian || '-'}</td></tr>
                <tr><td class="text-muted">Periode</td><td>: ${data.mulai} s/d ${data.selesai}</td></tr>
            `;
        }

        result.style.display = 'block';
    }
</script>
}