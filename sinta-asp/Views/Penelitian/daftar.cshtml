            "Kelautan/ Perkapalan", "Kimia Murni/ MIPA", "Konversi Energi/ Migas/ Kimia Air Bersih/ Balnding/ Loading", "Logistik/ Pergudangan/ Procurement", "Manajemen/ SDM/ Psikologi",
            "Metalurgi/ Material / Dirgantara", "Safety (K3)/ SMK3", "Teknik Fisika", "Teknik Industri", "Teknik Informatika", "Teknik Kimia", "Teknik Lingkungan", "Teknik Mesin", "Teknik Mesin (Rotating)", "Teknik Sipil"
        ],
        "Regional Jatimbalinus": [
