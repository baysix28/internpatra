@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using sinta_asp.Models
@model sinta_asp.Models.UserProfile
@inject IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    // Ambil Username: Jika Authenticated ambil Name, jika tidak pakai "Guest"
    // Ditambah .ToString() atau null-coalescing agar tidak dianggap null oleh compiler
    var namaUser = (User.Identity?.IsAuthenticated == true 
                   ? (User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User.Identity.Name) 
                   : "Guest") ?? "Guest";

    // Ambil Email secara dinamis
    var userEmail = (User.Identity?.IsAuthenticated == true 
                    ? (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name) 
                    : "belum_login@mail.com") ?? "user@mail.com";

    // Ambil Foto Profil dari Model
    var fotoUser = Model?.FotoProfil;
    var avatarUrl = !string.IsNullOrEmpty(fotoUser) 
                   ? $"/uploads/profile/{fotoUser}" 
                   : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(namaUser)}&background=00549B&color=fff";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Peserta | SINTA Pertamina</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --p-blue: #00549B;
            --p-red: #ec1c24;
            --p-green: #28a745;
            --sidebar-width: 280px;
            --topbar-height: 80px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --p-gray-bg: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--p-gray-bg);
            overflow-x: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed;
            left: 0; top: 0; background: #fff; border-right: 1px solid #e2e8f0;
            z-index: 1000; padding: 30px 20px; display: flex; flex-direction: column;
        }

        .brand-container { margin-bottom: 50px; padding: 0 10px; }
        .brand-logo-pertamina { height: 50px; }

        .nav-link-custom {
            display: flex; align-items: center; padding: 12px 16px; color: #64748b;
            border-radius: 12px; text-decoration: none !important; margin-bottom: 6px;
            font-weight: 600; transition: var(--transition); border: none; background: transparent;
            width: 100%; text-align: left; cursor: pointer;
        }

        .nav-link-custom:hover { background: rgba(0, 84, 155, 0.05); color: var(--p-blue); transform: translateX(5px); }
        .nav-link-custom.active { 
            background: var(--p-blue); color: #fff !important; 
            box-shadow: 0 4px 12px rgba(0, 84, 155, 0.2); 
        }

        .nav-link-logout { color: var(--p-red) !important; border: 1px solid #fee2e2; background: #fffafa; margin-top: auto; }

        /* Topbar Styling */
        .topbar {
            height: var(--topbar-height); position: fixed; top: 0; right: 0; left: var(--sidebar-width);
            background: #fff; border-bottom: 1px solid #e2e8f0; z-index: 999;
            display: flex; align-items: center; justify-content: space-between; padding: 0 30px;
        }

        .main-content { margin-left: var(--sidebar-width); padding-top: var(--topbar-height); padding-bottom: 40px; }

        /* Card Styling - Equal Height Fix */
        .glass-card {
            background: white; border-radius: 16px; border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); padding: 25px;
            height: 100%; display: flex; flex-direction: column;
        }

                /* Warna Default (Kuning) */
        .status-badge.status-review { background: #fff3cd; color: #856404; }

        /* Warna Diterima (Hijau) */
        .status-badge.status-success { background: #d4edda; color: #155724; }

        /* Warna Ditolak (Merah) */
        .status-badge.status-danger { background: #f8d7da; color: #721c24; }

        .status-badge { padding: 5px 12px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; }
        .status-approved { background: #dcfce7; color: #166534; }
        .status-review { background: #fef9c3; color: #854d0e; }

        .page-section { display: none; }
        .page-section.active { display: block; animation: slideUp 0.4s ease-out; }

        @@keyframes slideUp { 
            from { opacity: 0; transform: translateY(15px); } 
            to { opacity: 1; transform: translateY(0); } 
        }

        /* Styling tambahan untuk Profil ala Gambar 2 */
        .profile-card {
            background: white;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }

        .profile-nav-tabs {
            border-bottom: 1px solid #f1f5f9;
            padding: 0 20px;
        }

        .profile-nav-tabs .nav-link {
            border: none;
            font-weight: 700;
            font-size: 13px;
            padding: 15px 20px;
            color: #64748b;
            text-transform: uppercase;
        }

        .profile-nav-tabs .nav-link.active {
            color: var(--p-blue);
            border-bottom: 3px solid var(--p-blue);
            background: transparent;
        }

        .avatar-box {
            width: 70px;
            height: 70px;
            background-color: var(--p-blue);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 800;
            border-radius: 12px;
        }

        .badge-role-peserta {
            background: #e0efff;
            color: #00549b;
            font-size: 10px;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 5px;
        }

        .label-custom {
            font-size: 11px;
            font-weight: 800;
            color: #94a3b8;
            margin-bottom: 8px;
            display: block;
        }

        .input-custom {
            background-color: #f8fafc !important;
            border: none !important;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 14px;
            color: #334155;
        }

        /* Styling Modal Premium */
        .modal-content { border-radius: 24px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); }
        .modal-header-premium { background: var(--p-blue); padding: 30px; color: white; position: relative; }
        .header-flex-container { display: flex; align-items: center; gap: 20px; }

        .profile-circle-frame { 
            width: 90px; height: 90px; border-radius: 50%; border: 4px solid rgba(255,255,255,0.3); 
            object-fit: cover; cursor: pointer; transition: transform 0.3s; background: white;
        }
        .profile-circle-frame:hover { transform: scale(1.05); }

        .status-pill-modal {
            padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.5px; display: inline-block; margin-bottom: 8px;
        }
        .bg-light-green { background: #d1fae5; color: #065f46; }
        .bg-light-orange { background: #fef3c7; color: #92400e; }
        .bg-light-red { background: #fee2e2; color: #991b1b; }

        .detail-body { padding: 30px; background: #f8fafc; }
        .info-card-premium { 
            background: white; border-radius: 16px; padding: 20px; 
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); height: 100%;
        }
        .info-label { color: #64748b; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px; margin-top: 12px; }
        .info-value { color: #1e293b; font-size: 14px; font-weight: 600; line-height: 1.4; }

        .doc-link {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px 16px; background: white; border-radius: 12px; 
            margin-bottom: 10px; text-decoration: none; color: #334155;
            border: 1px solid #e2e8f0; transition: all 0.2s;
        }
        .doc-link:hover { background: #f1f5f9; border-color: var(--p-blue); transform: translateY(-2px); }
        .doc-link span { font-size: 13px; font-weight: 600; }

        /* Efek saat input terkunci (readonly) */
        .input-custom[readonly] {
            cursor: not-allowed;
            opacity: 0.7;
            background-color: #f8fafc !important; /* Warna abu-abu panel */
        }

        /* Efek saat input aktif */
        .input-custom:not([readonly]) {
            background-color: #ffffff !important;
            border: 1px solid var(--p-blue) !important;
            box-shadow: 0 0 0 3px rgba(0, 84, 155, 0.1);
        }

        /* Notifikasi ala Tokopedia */
        .notification-btn { position: relative; cursor: pointer; padding: 10px; border-radius: 10px; border: 1px solid #e2e8f0; transition: 0.2s; }
        .notification-btn:hover { background: #f8fafc; }
        .notification-badge-dot { width: 10px; height: 10px; background: var(--p-red); border-radius: 50%; position: absolute; top: -2px; right: -2px; border: 2px solid white; }

        #notiTab .nav-link { border: none; color: #64748b; font-weight: 700; font-size: 13px; padding: 12px; }
        #notiTab .nav-link.active { color: var(--p-green); border-bottom: 3px solid var(--p-green) !important; background: transparent; }
        .dropdown-menu-right {
            right: 0 !important;
            left: auto !important;
        }

        /* Pastikan dropdown tidak menempel terlalu atas */
        .dropdown-menu {
            margin-top: 10px !important;
            display: none; /* Default hidden */
        }

        /* Saat dropdown terbuka (class show dari bootstrap), jalankan animasi */
        .dropdown-menu.show {
            display: block;
            animation: slideDown 0.2s ease-out forwards;
        }
        
        @@keyframes slideDown {
        from { 
            opacity: 0; 
            transform: translateY(0);}
        to { 
            opacity: 1; 
            transform: translateY(10px);}
        }
    </style>
</head>
