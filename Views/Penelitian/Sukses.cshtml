@{
    ViewData["Title"] = "Pendaftaran Berhasil - SINTA Pertamina";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --pertamina-blue: #005EB8;
        --pertamina-green: #00A859;
        --pertamina-red: #E30613;
    }

    body {
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
        min-height: 100vh;
    }

    .success-container {
        max-width: 900px;
        margin: 40px auto 30px;
        padding: 20px;
    }

    .success-card {
        background: white;
        border-radius: 25px;
        padding: 40px 50px;
        box-shadow: 0 20px 60px rgba(0, 94, 184, 0.15);
        text-align: center;
        position: relative;
        overflow: hidden;
        animation: slideUp 0.6s ease;
    }

    .success-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 6px;
        background: linear-gradient(90deg, var(--pertamina-blue), var(--pertamina-green), var(--pertamina-red));
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .success-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, var(--pertamina-green), #00c76a);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        animation: scaleIn 0.5s ease 0.3s both;
        box-shadow: 0 10px 40px rgba(0, 168, 89, 0.3);
    }

    .success-icon i {
        font-size: 50px;
        color: white;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .success-title {
        font-size: 28px;
        font-weight: 700;
        color: #333;
        margin-bottom: 15px;
        animation: fadeIn 0.6s ease 0.5s both;
    }

    .success-subtitle {
        font-size: 16px;
        color: #666;
        margin-bottom: 15px;
        line-height: 1.6;
        animation: fadeIn 0.6s ease 0.7s both;
    }

    .success-email {
        background: #f0f9ff;
        border: 2px solid var(--pertamina-blue);
        border-radius: 12px;
        padding: 20px;
        margin: 25px 0;
        animation: fadeIn 0.6s ease 0.9s both;
    }

    .success-email i {
        color: var(--pertamina-blue);
        font-size: 24px;
        margin-bottom: 10px;
    }

    .success-email p {
        margin: 0;
        color: #333;
        font-size: 15px;
        line-height: 1.8;
    }

    .success-email strong {
        color: var(--pertamina-blue);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .info-box {
        background: linear-gradient(135deg, #fff5f5 0%, #ffe5e5 100%);
        border-left: 5px solid var(--pertamina-red);
        border-radius: 12px;
        padding: 20px;
        margin: 20px 0;
        text-align: left;
        animation: fadeIn 0.6s ease 1.1s both;
    }

    .info-box h6 {
        color: var(--pertamina-red);
        font-weight: 700;
        margin-bottom: 12px;
        font-size: 15px;
    }

    .info-box ul {
        margin: 0;
        padding-left: 20px;
        color: #555;
        font-size: 13px;
        line-height: 1.8;
    }

    .info-box li {
        margin-bottom: 8px;
    }

    .btn-home {
        background: var(--pertamina-blue);
        color: white;
        padding: 14px 45px;
        border: none;
        border-radius: 50px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
        margin-top: 20px;
        animation: fadeIn 0.6s ease 1.3s both;
        box-shadow: 0 10px 30px rgba(0, 94, 184, 0.3);
    }

    .btn-home:hover {
        background: #004a94;
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(0, 94, 184, 0.4);
        text-decoration: none;
        color: white;
    }

    .success-actions {
        margin-top: 30px;
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    /* Tombol utama (primary) */
    .btn-primary-action {
        background: var(--pertamina-blue);
        color: white;
        padding: 14px 40px;
        border-radius: 50px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: 0.3s;
        box-shadow: 0 10px 30px rgba(0, 94, 184, 0.3);
    }

    .btn-primary-action:hover {
        background: #004a94;
        transform: translateY(-3px);
        color: white;
    }

    /* Tombol secondary */
    .btn-secondary-action {
        background: white;
        color: var(--pertamina-blue);
        border: 2px solid var(--pertamina-blue);
        padding: 14px 35px;
        border-radius: 50px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: 0.3s;
    }

    .btn-secondary-action:hover {
        background: var(--pertamina-blue);
        color: white;
        transform: translateY(-3px);
    }

    @@media (max-width: 768px) {
        .success-container {
            margin: 40px auto;
            padding: 15px;
        }

        .success-card {
            padding: 40px 25px;
        }

        .success-title {
            font-size: 26px;
        }

        .success-subtitle {
            font-size: 16px;
        }
        @if (ViewBag.NomorPendaftaran != null)
        {
            <div class="alert alert-info">
                Nomor Pendaftaran Anda: <strong>@ViewBag.NomorPendaftaran</strong>
            </div>
        }

        .btn-home {
            padding: 14px 35px;
            font-size: 15px;
        }

        .success-email {
            padding: 20px;
        }

        .info-box {
            padding: 20px;
        }
    }
</style>

<div class="success-container">
    <div class="success-card">
        <div class="success-icon">
            <i class="fas fa-check"></i>
        </div>

        <h1 class="success-title">Pendaftaran Berhasil!</h1>
        <p class="success-subtitle">
            Terima kasih telah mendaftar Program Penelitian Pertamina.<br>
            Data Anda telah berhasil kami terima dan sedang dalam proses verifikasi.
        </p>

        <div class="success-email">
            <i class="fas fa-envelope-open-text"></i>
            <p>
                Informasi mengenai status pendaftaran Anda akan kami kirimkan melalui <strong>email</strong> yang telah Anda daftarkan.<br>
                Mohon periksa email secara berkala, termasuk folder <strong>spam</strong>.
            </p>
        </div>

        <div class="success-actions">
            <!-- Lihat Riwayat Penelitian -->
            <a asp-controller="DashboardPeserta"
            asp-action="Index"
            asp-route-tab="riwayat"
            class="btn-primary-action">
                <i class="fas fa-clock-rotate-left"></i>
                Lihat Riwayat Penelitian
            </a>

            <!-- Kembali ke Beranda -->
            <a asp-controller="Home"
            asp-action="Index"
            class="btn-secondary-action">
                <i class="fas fa-home"></i>
                Kembali ke Beranda
            </a>
        </div>
    </div>
</div>

<script>
    setTimeout(function () {
        window.location.href = '/DashboardPeserta?tab=riwayat';
    }, 10000);

    localStorage.removeItem('form_penelitian_draft');
    localStorage.removeItem('profile_completion');
</script>