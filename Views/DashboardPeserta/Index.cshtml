                                        <span id="d-tempat"></span>, <span id="d-tgl-lahir"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-2 px-2 fw-bold text-secondary" style="font-size:12px;">
