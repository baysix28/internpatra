@model sinta_asp.Areas.Admin.Models.DashboardModel
@using System.Text.Json
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manajemen Mahasiswa Magang";

    // Cek Role & Region dari Session
    var adminRole = HttpContextAccessor.HttpContext.Session.GetString("AdminRole");
    var adminRegionManaged = HttpContextAccessor.HttpContext.Session.GetString("AdminRegion");
    var selectedRegion = ViewBag.SelectedRegion as string ?? "all";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
    :root { 
        --p-blue: #00549B; --p-red: #EC1C24; --p-green: #10b981; --p-orange: #f59e0b; --p-bg: #F8FAFC;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body { background-color: var(--p-bg); font-family: 'Plus Jakarta Sans', sans-serif; color: #334155; }
    .dashboard-wrapper { padding: 1.2rem 1.8rem; margin-top: -20px; overflow: visible !important; }
    .title-bold { font-weight: 800; color: var(--p-blue); letter-spacing: -0.8px; font-size: 1.5rem; }

    /* --- Stat Cards --- */
    .stat-card {
        background: #fff; border-radius: 12px; padding: 0.85rem 1rem; border: 1px solid #e2e8f0;
        transition: var(--transition); cursor: pointer; display: flex; align-items: center; height: 100%;
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
    .stat-card.active[data-status="all"] { border: 2px solid var(--p-blue); background: #f0f7ff; }
    .stat-card.active[data-status="Menunggu"] { border: 2px solid var(--p-orange); background: #fffbeb; }
    .stat-card.active[data-status="Diterima"] { border: 2px solid var(--p-green); background: #ecfdf5; }
    .stat-card.active[data-status="Ditolak"] { border: 2px solid var(--p-red); background: #fef2f2; }

    .icon-box {
        width: 40px; height: 40px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center; margin-right: 12px; font-size: 1.1rem;
    }
    .bg-light-blue { background: rgba(0, 84, 155, 0.1); color: var(--p-blue); }
    .bg-light-orange { background: rgba(245, 158, 11, 0.1); color: var(--p-orange); }
    .bg-light-green { background: rgba(16, 185, 129, 0.1); color: var(--p-green); }
    .bg-light-red { background: rgba(236, 28, 36, 0.1); color: var(--p-red); }

    .stat-label { color: #64748b; font-size: 0.7rem; font-weight: 700; }
    .stat-value { font-weight: 800; font-size: 1.15rem; color: #1e293b; }

    /* --- Table Styling --- */
    .main-table-card { background: #fff; border-radius: 12px; border: 1px solid #E2E8F0; overflow: visible !important; }
    .table thead th { background: #f8fafc; font-weight: 700; color: #64748b; font-size: 0.7rem; padding: 12px 15px; text-transform: uppercase; border: none; }
    .badge-status { padding: 5px 12px; border-radius: 50px; font-weight: 700; font-size: 0.65rem; text-transform: uppercase; }
    .status-Diterima { background: #dcfce7; color: #065f46; }
    .status-Ditolak { background: #fee2e2; color: #991b1b; }
    .status-Menunggu { background: #fef3c7; color: #92400e; }

    /* --- Action Button Update --- */
    .btn-review {
        background: var(--p-blue); color: #fff; border: none;
        padding: 6px 20px; border-radius: 8px; font-weight: 700; font-size: 0.75rem;
        transition: var(--transition); display: inline-flex; align-items: center; justify-content: center;
    }
    .btn-review:hover { background: #003d70; transform: translateY(-1px); box-shadow: 0 4px 10px rgba(0, 84, 155, 0.2); color: #fff; }

    /* Toolbar Helper */
    .filter-toolbar { display: flex; align-items: center; justify-content: space-between; width: 100%; position: relative; z-index: 1020; }
    
    /* Shared Input & Dropdown Style */
    #tableSearch {
        border-radius: 10px; border: 1.5px solid #e2e8f0; padding: 9px 15px;
        transition: var(--transition); background-color: #fff; font-weight: 600; font-size: 0.85rem; color: #475569; outline: none;
    }

    /* --- UPDATE: Compact & Hover Dropdown --- */
    .dropdown:hover > .dropdown-menu { 
        display: block; 
        margin-top: 0; 
    }
    .btn-region-select {
        min-width: 180px; text-align: left; padding: 8px 12px; font-weight: 700; font-size: 0.8rem;
        color: var(--p-blue); border: 1.5px solid #e2e8f0; border-radius: 10px; background-color: white;
        display: flex; justify-content: space-between; align-items: center; transition: var(--transition);
    }
    .btn-region-select:hover { border-color: var(--p-blue); background-color: #f0f7ff; }
    
    .dropdown-menu-premium {
        border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border-radius: 10px; 
        padding: 5px; min-width: 180px; z-index: 9999 !important;
        max-height: 250px; overflow-y: auto;
    }
    .dropdown-item-premium {
        font-weight: 600; padding: 8px 12px; color: #475569; border-radius: 6px; transition: 0.2s; font-size: 0.8rem;
    }
    .dropdown-item-premium:hover { background: #f1f5f9; color: var(--p-blue); }
    .dropdown-item-premium.active { background: var(--p-blue); color: white; }

    #tableSearch:hover { border-color: var(--p-blue); box-shadow: 0 4px 12px rgba(0, 84, 155, 0.08); }
    #tableSearch:focus { border-color: var(--p-blue); background-color: #f0f7ff; color: var(--p-blue); }

    .btn-pertamina { 
        background: var(--p-blue); color: white; border: none; font-weight: 700; 
        border-radius: 6px; padding: 8px 16px; font-size: 0.8rem; transition: var(--transition);
    }
    .user-avatar-list { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; }

    /* --- MODAL DETAIL --- */
    .modal-content { border-radius: 28px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); }
    .modal-header-premium { 
        background: linear-gradient(135deg, #00549B 0%, #003d70 100%); 
        padding: 2.5rem; color: white; position: relative;
    }
    .header-flex-container { display: flex; align-items: center; gap: 25px; }
    .profile-circle-frame { 
        width: 110px; height: 110px; border-radius: 50% !important; 
        object-fit: cover; border: 5px solid rgba(255,255,255,0.2); 
        background: white; flex-shrink: 0; box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
    .header-text-info h2 { font-weight: 800; font-size: 1.8rem; margin: 0; letter-spacing: -0.5px; }
    .status-pill-modal {
        display: inline-block; width: fit-content; padding: 4px 15px; border-radius: 50px;
        font-size: 0.7rem; font-weight: 800; text-transform: uppercase; margin-top: 5px;
    }

    .action-area { background: #f8fafc; padding: 25px 40px; border-top: 1px solid #e2e8f0; }
    .btn-primary-modern {
        background: var(--p-blue); color: white; border: none;
        padding: 10px 25px; border-radius: 12px; font-size: 0.85rem; font-weight: 700;
        box-shadow: 0 4px 12px rgba(0, 84, 155, 0.2); transition: var(--transition);
    }
    .btn-danger-light {
        background: #fff; color: #dc2626; border: 1.5px solid #fee2e2;
        padding: 10px 20px; border-radius: 12px; font-size: 0.85rem; font-weight: 700; transition: var(--transition);
    }

    .detail-body { padding: 40px; background: #fff; }
    .info-card-premium { background: #f8fafc; border-radius: 16px; padding: 20px; height: 100%; border: 1px solid #eef2f6; }
    .info-label { color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-transform: uppercase; margin-bottom: 4px; }
    .info-value { color: #1e293b; font-weight: 700; font-size: 0.95rem; margin-bottom: 15px; }
    
    .doc-link {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 18px; background: #fff; border-radius: 12px;
        text-decoration: none !important; color: #1e293b; font-weight: 700;
        border: 1px solid #e2e8f0; margin-bottom: 12px; transition: 0.2s;
    }
    .doc-link:hover { border-color: var(--p-blue); background: #f0f7ff; }

    .row-highlight {
        background-color: rgba(0, 84, 155, 0.08) !important;
        transition: background-color 2s ease;
    }
</style>

<div class="dashboard-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="title-bold mb-0">Manajemen Mahasiswa</h3>
            <p class="text-muted small mb-0">Portal Kendali <span class="fw-bold text-danger">Internship Pertamina</span> 
                @if(adminRole != "SuperAdmin") { <span class="badge bg-primary ms-2">Region: @adminRegionManaged</span> }
            </p>
        </div>
        <button class="btn btn-pertamina shadow-sm" style="background: #10b981;" onclick="exportExcel()">
            <i class="fas fa-file-excel me-1"></i> Export Excel
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="stat-card active" data-status="all" id="card-all" onclick="filterByStatus('all', 'card-all')"><div class="icon-box bg-light-blue"><i class="fas fa-user-group"></i></div><div><div class="stat-label">Total Pendaftar</div><div class="stat-value" id="val-all">@Model.DaftarMagang.Count</div></div></div></div>
        <div class="col-md-3"><div class="stat-card" data-status="Menunggu" id="card-proses" onclick="filterByStatus('Menunggu', 'card-proses')"><div class="icon-box bg-light-orange"><i class="fas fa-hourglass-half"></i></div><div><div class="stat-label">Menunggu</div><div class="stat-value" id="val-proses">@Model.StatusDiproses</div></div></div></div>
        <div class="col-md-3"><div class="stat-card" data-status="Diterima" id="card-terima" onclick="filterByStatus('Diterima', 'card-terima')"><div class="icon-box bg-light-green"><i class="fas fa-check-double"></i></div><div><div class="stat-label">Diterima</div><div class="stat-value" id="val-terima">@Model.StatusDiterima</div></div></div></div>
        <div class="col-md-3"><div class="stat-card" data-status="Ditolak" id="card-tolak" onclick="filterByStatus('Ditolak', 'card-tolak')"><div class="icon-box bg-light-red"><i class="fas fa-user-xmark"></i></div><div><div class="stat-label">Ditolak</div><div class="stat-value" id="val-tolak">@Model.StatusDitolak</div></div></div></div>
    </div>

    <div class="main-table-card">
        <div class="p-3 border-bottom bg-white">
            <div class="filter-toolbar">
                <div style="width: 380px;">
                    <input type="text" id="tableSearch" class="form-control" placeholder="Cari nama, NIM, atau kampus...">
                </div>
                
                @if (adminRole == "SuperAdmin")
                {
                    <div class="dropdown">
                        <button class="btn-region-select dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
                            <span><i class="fas fa-map-marker-alt me-2"></i> @(selectedRegion == "all" ? "Semua Region" : selectedRegion)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-premium shadow-lg">
                            <li><a class="dropdown-item dropdown-item-premium @(selectedRegion == "all" ? "active" : "")" href="javascript:void(0)" onclick="changeRegion('all')">Semua Region</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var region in (IEnumerable<string>)ViewBag.AllRegions)
                            {
                                <li>
                                    <a class="dropdown-item dropdown-item-premium @(selectedRegion == region ? "active" : "")" 
                                       href="javascript:void(0)" onclick="changeRegion('@region')">
                                       @region
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover" id="magangTable">
                <thead>
                    <tr>
                        <th class="ps-4">Mahasiswa</th>
                        <th>Institusi</th>
                        <th>Penempatan</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.DaftarMagang) {
                        <tr class="magang-row" data-status="@m.Status" data-region="@m.Region" id="row-@m.Id">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    @{
                                        var cleanFoto = m.FotoProfil?.Split('/').Last();
                                        var fotoPath = string.IsNullOrEmpty(cleanFoto) ? "/img/default-user.png" : "/uploads/foto/" + cleanFoto;
                                    }
                                    <img src="@fotoPath" class="user-avatar-list me-3 shadow-sm">
                                    <div>
                                        <div class="fw-700 text-dark">@m.NamaLengkap</div>
                                        <div class="text-muted small">@m.NIM</div>
                                    </div>
                                </div>
                            </td>
                            <td><div class="fw-600">@m.NamaPerguruanTinggi</div><div class="text-muted small">@m.Jurusan</div></td>
                            <td><div class="text-primary fw-700">@m.Company</div><div class="text-muted small">@m.Region</div></td>
                            <td class="text-center"><span class="badge-status status-@m.Status">@m.Status</span></td>
                            <td class="text-center">
                                <button class="btn-review" onclick='showDetail(@Html.Raw(JsonSerializer.Serialize(m)))'>
                                    Review
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Modal Detail *@
<div class="modal fade" id="modalDetail" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header-premium">
                <div class="header-flex-container">
                    <a id="d-foto-link" target="_blank">
                        <img id="d-foto" src="/img/default-user.png" class="profile-circle-frame" title="Lihat Foto">
                    </a>
                    <div class="header-text-info">
                        <div id="d-status-badge-container"></div>
                        <h2 id="d-nama"></h2>
                        <span class="opacity-75 small"><i class="fas fa-clock me-1"></i> Terdaftar: <span id="d-created-at"></span></span>
                    </div>
                </div>
            </div>

            <div class="detail-body">
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="info-label"><i class="fas fa-id-card me-2"></i>Kontak & Pribadi</div>
                        <div class="info-card-premium">
                            <div class="info-label">Email</div><div id="d-email" class="info-value"></div>
                            <div class="info-label">WhatsApp</div>
                            <div class="info-value">
                                <a id="d-hp-link" target="_blank" style="color: #1e293b; text-decoration: none;">
                                    <span id="d-hp"></span>
                                </a>
                            </div>
                            <div class="info-label">Tempat, Tgl Lahir</div><div class="info-value"><span id="d-tempat"></span>, <span id="d-tgl-lahir"></span></div>
                            <div class="info-label">Instagram</div>
                            <div class="info-value">
                                <a href="#" id="d-ig-link" target="_blank" class="fw-bold" style="text-decoration: underline !important; color: #1e293b;">@@<span id="d-ig-text"></span></a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label"><i class="fas fa-graduation-cap me-2"></i>Akademik & Unit</div>
                        <div class="info-card-premium">
                            <div class="info-label">Kampus (NIM)</div><div class="info-value"><span id="d-univ"></span> (<span id="d-nim"></span>)</div>
                            <div class="info-label">Fakultas / Jurusan</div><div class="info-value"><span id="d-fakultas"></span> / <span id="d-jurusan"></span></div>
                            <div class="info-label">Penempatan</div><div class="info-value text-primary fw-bold"><span id="d-company"></span> - <span id="d-lokasi"></span></div>
                            <div class="info-label">Periode Magang</div><div id="d-periode" class="info-value text-danger"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label"><i class="fas fa-file-alt me-2"></i>Berkas Digital</div>
                        <a id="link-cv" href="#" target="_blank" class="doc-link"><span><i class="fas fa-file-pdf text-danger me-2"></i> CV Mahasiswa</span> <i class="fas fa-external-link-alt fa-xs"></i></a>
                        <a id="link-surat" href="#" target="_blank" class="doc-link"><span><i class="fas fa-file-contract text-primary me-2"></i> Surat Pengantar</span> <i class="fas fa-external-link-alt fa-xs"></i></a>
                        <a id="link-proposal" href="#" target="_blank" class="doc-link"><span><i class="fas fa-file-signature text-success me-2"></i> Proposal Magang</span> <i class="fas fa-external-link-alt fa-xs"></i></a>
                    </div>
                </div>
            </div>

            <div class="action-area">
                <input type="hidden" id="d-id">
                <div id="detail-actions" class="d-flex justify-content-end align-items-center w-100">
                    <div id="quick-actions">
                        @if (adminRole != "SuperAdmin")
                        {
                            <button id="btn-tolak-quick" onclick="updateStatus('Ditolak')" class="btn btn-danger-light fw-bold me-2"><i class="fas fa-user-times me-2"></i>Tolak</button>
                            <button id="btn-terima-quick" onclick="updateStatus('Diterima')" class="btn btn-primary-modern"><i class="fas fa-user-check me-2"></i>Terima Mahasiswa</button>
                        }
                        else
                        {
                            <div class="text-muted small fw-bold"><i class="fas fa-info-circle me-1"></i> Super Admin Mode: Read-Only</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    let currentStatusFilter = 'all';

    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const highlightId = urlParams.get('highlightId');
        if (highlightId) {
            const targetRow = $(`#row-${highlightId}`);
            if (targetRow.length) {
                $('html, body').animate({ scrollTop: targetRow.offset().top - 150 }, 800);
                targetRow.addClass('row-highlight');
                setTimeout(() => targetRow.removeClass('row-highlight'), 3000);
            }
        }
    });

    function changeRegion(region) {
        Swal.fire({
            title: 'Memproses...',
            text: 'Mengambil data region ' + region,
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });
        window.location.href = `/Admin/Mahasiswa/Index?selectedRegion=${encodeURIComponent(region)}`;
    }

    $("#tableSearch").on("keyup", function() {
        applyAllFilters();
    });

    function filterByStatus(status, cardId) {
        currentStatusFilter = status;
        $(".stat-card").removeClass("active");
        $("#" + cardId).addClass("active");
        applyAllFilters();
    }

    function applyAllFilters() {
        const searchText = $("#tableSearch").val().toLowerCase();
        $(".magang-row").each(function() {
            const rowStatus = $(this).attr("data-status");
            const rowText = $(this).text().toLowerCase();
            const matchSearch = rowText.indexOf(searchText) > -1;
            const matchStatus = currentStatusFilter === 'all' || rowStatus === currentStatusFilter;
            $(this).toggle(matchSearch && matchStatus);
        });
    }

    // UPDATE: Langsung download tanpa pop-up
    function exportExcel() {
        const currentRegion = "@selectedRegion";
        const activeStatus = currentStatusFilter;
        window.location.href = `/Admin/Mahasiswa/ExportMahasiswa?selectedRegion=${encodeURIComponent(currentRegion)}&status=${encodeURIComponent(activeStatus)}`;
    }

    function showDetail(data) {
        $("#d-id").val(data.Id || data.id);
        $("#d-nama").text(data.NamaLengkap || data.namaLengkap);
        $("#d-created-at").text(formatDate(data.CreatedAt || data.createdAt));
        
        const st = data.Status || data.status;
        updateModalStatusUI(st);
        
        const pf = data.FotoProfil || data.fotoProfil;
        const finalFoto = pf ? "/uploads/foto/" + pf.split('/').pop() : "/img/default-user.png";
        $("#d-foto").attr("src", finalFoto);
        $("#d-foto-link").attr("href", finalFoto);

        $("#d-email").text(data.EmailPribadi || data.emailPribadi);
        const rawHp = data.NoHp || "";
        let cleanHp = rawHp.replace(/\D/g, '');
        if (cleanHp.startsWith('0')) cleanHp = '62' + cleanHp.slice(1);
        $("#d-hp").text(rawHp || "-");
        $("#d-hp-link").attr("href", cleanHp ? `https://wa.me/${cleanHp}` : "#");

        $("#d-tempat").text(data.TempatLahir || "-");
        $("#d-tgl-lahir").text(formatDate(data.TanggalLahir || data.tanggalLahir));
        
        let rawIg = (data.Instagram || data.instagram || "").replace(/@@/g, '').trim();
        $("#d-ig-text").text(rawIg || "-");
        $("#d-ig-link").attr("href", rawIg ? `https://instagram.com/${rawIg}` : "#");
        
        $("#d-univ").text(data.NamaPerguruanTinggi || data.namaPerguruanTinggi || "-");
        $("#d-nim").text(data.NIM || data.nim || "-");
        $("#d-fakultas").text(data.Fakultas || data.fakultas || "-");
        $("#d-jurusan").text(data.Jurusan || data.jurusan || "-");
        $("#d-company").text(data.Company || data.company || "-");
        $("#d-lokasi").text(data.Region || data.region || "-"); 
        $("#d-periode").text(formatDate(data.MulaiMagang || data.mulaiMagang) + " - " + formatDate(data.SelesaiMagang || data.selesaiMagang));

        $("#link-cv").attr("href", "/uploads/cv/" + (data.FileCv || data.fileCv || "").split('/').pop());
        $("#link-surat").attr("href", "/uploads/surat/" + (data.FileSuratPengantar || data.fileSuratPengantar || "").split('/').pop());
        $("#link-proposal").attr("href", "/uploads/proposal/" + (data.FileProposal || data.fileProposal || "").split('/').pop());

        $("#modalDetail").modal('show');
    }

    function updateModalStatusUI(st) {
        $("#d-status-badge-container").html(`<span class="status-pill-modal status-${st}">${st}</span>`);
        const isAdmin = "@adminRole" !== "SuperAdmin";
        if (st === "Menunggu" && isAdmin) {
            $("#quick-actions").show();
        } else {
            $("#quick-actions").hide();
        }
    }

    function formatDate(d) {
        if(!d) return "-";
        return new Date(d).toLocaleDateString('id-ID', { day:'2-digit', month:'long', year:'numeric' });
    }

    function updateStatus(s) {
        const id = $("#d-id").val();
        const oldStatus = $(`#row-${id}`).attr("data-status");

        Swal.fire({
            title: 'Konfirmasi',
            text: `Ubah status menjadi ${s}?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#00549B',
            confirmButtonText: 'Ya, Simpan'
        }).then((result) => {
            if (result.isConfirmed) {
                const row = $(`#row-${id}`);
                row.attr("data-status", s);
                row.find(".badge-status").attr("class", `badge-status status-${s}`).text(s);
                updateModalStatusUI(s);

                if (oldStatus !== s) {
                    updateStatCount(oldStatus, -1);
                    updateStatCount(s, 1);
                }

                $("#modalDetail").modal('hide');
                $.post("/Admin/Mahasiswa/UpdateStatus", { id: id, status: s }, function(res) {
                    if(!res.success) {
                        Swal.fire('Error', res.message || 'Gagal update ke server.', 'error');
                    } else {
                        Swal.fire('Berhasil', res.message, 'success');
                    }
                });
            }
        });
    }

    function updateStatCount(status, change) {
        let el = "";
        if (status === "Menunggu") el = "#val-proses";
        else if (status === "Diterima") el = "#val-terima";
        else if (status === "Ditolak") el = "#val-tolak";
        if (el) {
            const currentVal = parseInt($(el).text()) || 0;
            $(el).text(Math.max(0, currentVal + change));
        }
    }
</script>