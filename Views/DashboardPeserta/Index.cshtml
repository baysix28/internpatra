                                    <i class="fas fa-external-link-alt fa-xs"></i>
                                </a>
                                <a id="link-proposal" href="#" target="_blank" class="doc-link">
                                    <span><i class="fas fa-file-lines text-warning me-2"></i> Proposal Magang</span>
                                    <i class="fas fa-external-link-alt fa-xs"></i>
                                </a>
                            </div>
                        </div>

                        <!-- PANEL REVISI MAHASISWA — hanya muncul saat status Revisi -->
                        <input type="hidden" id="d-magang-id">

                        <div id="revisiPanelMhs" class="revisi-panel-mhs" style="display:none;">
                            <!-- Header banner -->
                            <div class="d-flex align-items-start" style="gap:12px; margin-bottom:12px;">
                                <i class="fas fa-exclamation-triangle" 
                                style="color:#f59e0b; font-size:20px; margin-top:2px; flex-shrink:0;"></i>
                                <div>
                                    <div style="font-size:12px; font-weight:800; color:#92400e; text-transform:uppercase;">
                                        Admin meminta revisi pada:
