@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    // Ambil Username: Jika Authenticated ambil Name, jika tidak pakai "Guest"
    // Ditambah .ToString() atau null-coalescing agar tidak dianggap null oleh compiler
    var namaUser = (User.Identity?.IsAuthenticated == true 
                   ? (User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User.Identity.Name) 
                   : "Guest") ?? "Guest";

    // Ambil Email secara dinamis
    var userEmail = (User.Identity?.IsAuthenticated == true 
                    ? (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name) 
                    : "belum_login@mail.com") ?? "user@mail.com";

    // Gunakan ! (null-forgiving operator) pada namaUser agar EscapeDataString tidak error
    var avatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(namaUser)}&background=00549B&color=fff";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Peserta | SINTA Pertamina</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --p-blue: #00549B;
            --p-red: #ec1c24;
            --p-green: #28a745;
            --sidebar-width: 280px;
            --topbar-height: 80px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --p-gray-bg: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--p-gray-bg);
            overflow-x: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed;
            left: 0; top: 0; background: #fff; border-right: 1px solid #e2e8f0;
            z-index: 1000; padding: 30px 20px; display: flex; flex-direction: column;
        }

        .brand-container { margin-bottom: 50px; padding: 0 10px; }
        .brand-logo-pertamina { height: 50px; }

        .nav-link-custom {
            display: flex; align-items: center; padding: 12px 16px; color: #64748b;
            border-radius: 12px; text-decoration: none !important; margin-bottom: 6px;
            font-weight: 600; transition: var(--transition); border: none; background: transparent;
            width: 100%; text-align: left; cursor: pointer;
        }

        .nav-link-custom:hover { background: rgba(0, 84, 155, 0.05); color: var(--p-blue); transform: translateX(5px); }
        .nav-link-custom.active { 
            background: var(--p-blue); color: #fff !important; 
            box-shadow: 0 4px 12px rgba(0, 84, 155, 0.2); 
        }

        .nav-link-logout { color: var(--p-red) !important; border: 1px solid #fee2e2; background: #fffafa; margin-top: auto; }

        /* Topbar Styling */
        .topbar {
            height: var(--topbar-height); position: fixed; top: 0; right: 0; left: var(--sidebar-width);
            background: #fff; border-bottom: 1px solid #e2e8f0; z-index: 999;
            display: flex; align-items: center; justify-content: space-between; padding: 0 30px;
        }

        .main-content { margin-left: var(--sidebar-width); padding-top: var(--topbar-height); padding-bottom: 40px; }

        /* Card Styling - Equal Height Fix */
        .glass-card {
            background: white; border-radius: 16px; border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); padding: 25px;
            height: 100%; display: flex; flex-direction: column;
        }

        .status-badge { padding: 5px 12px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; }
        .status-approved { background: #dcfce7; color: #166534; }
        .status-review { background: #fef9c3; color: #854d0e; }

        .page-section { display: none; }
        .page-section.active { display: block; animation: slideUp 0.4s ease-out; }

        @@keyframes slideUp { 
            from { opacity: 0; transform: translateY(15px); } 
            to { opacity: 1; transform: translateY(0); } 
        }

        /* Notifikasi ala Tokopedia */
        .notification-btn { position: relative; cursor: pointer; padding: 10px; border-radius: 10px; border: 1px solid #e2e8f0; transition: 0.2s; }
        .notification-btn:hover { background: #f8fafc; }
        .notification-badge-dot { width: 10px; height: 10px; background: var(--p-red); border-radius: 50%; position: absolute; top: -2px; right: -2px; border: 2px solid white; }

        #notiTab .nav-link { border: none; color: #64748b; font-weight: 700; font-size: 13px; padding: 12px; }
        #notiTab .nav-link.active { color: var(--p-green); border-bottom: 3px solid var(--p-green) !important; background: transparent; }
        .dropdown-menu-right {
            right: 0 !important;
            left: auto !important;
        }

        /* Pastikan dropdown tidak menempel terlalu atas */
        .dropdown-menu {
            margin-top: 10px !important;
            display: none; /* Default hidden */
        }

        /* Saat dropdown terbuka (class show dari bootstrap), jalankan animasi */
        .dropdown-menu.show {
            display: block;
            animation: slideDown 0.2s ease-out forwards;
        }
        
        @@keyframes slideDown {
        from { 
            opacity: 0; 
            transform: translateY(0);}
        to { 
            opacity: 1; 
            transform: translateY(10px);}
    </style>
</head>
<body>

<nav class="sidebar">
    <div class="brand-container">
        <img src="~/images/logo-pertamina.png" class="brand-logo-pertamina" alt="Pertamina">
    </div>

    <div style="flex-grow: 1;">
        <button onclick="showPage('dashboard')" class="nav-link-custom active" id="nav-dashboard">
            <i class="fa-solid fa-house mr-3"></i> Dashboard
        </button>
        <button onclick="showPage('riwayat')" class="nav-link-custom" id="nav-riwayat">
            <i class="fa-solid fa-clipboard-list mr-3"></i> Riwayat Magang
        </button>
        <button onclick="showPage('penelitian')" class="nav-link-custom" id="nav-penelitian">
            <i class="fa-solid fa-flask mr-3"></i> Riwayat Riset
        </button>
        <button onclick="showPage('profil')" class="nav-link-custom" id="nav-profil">
            <i class="fa-solid fa-user-gear mr-3"></i> Pengaturan Profil
        </button>
    </div>

    <button onclick="window.location.href='/'" class="nav-link-custom nav-link-kembali">
        <i class="fa-solid fa-house mr-3"></i> Kembali ke Home
    </button>
</nav>

<header class="topbar">
    <div class="d-flex align-items-center">
        <i class="fa-solid fa-bars-staggered mr-3 text-muted"></i>
        <span class="font-weight-bold text-muted" id="page-breadcrumb">Panel Peserta / Dashboard</span>
    </div>

    <div class="d-flex align-items-center">
        <img src="~/images/logo-sinta.png" style="height:40px;" class="mr-4">
        
        <div class="dropdown mr-3">
            <div class="notification-btn" id="notiDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fa-solid fa-bell text-muted"></i>
                <div class="notification-badge-dot"></div>
            </div>
            
            <div class="dropdown-menu dropdown-menu-right shadow border-0 p-0" style="width: 360px;">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 font-weight-bold">Notifikasi</h6>
                </div>
                
                <div class="tab-content" style="max-height: 400px; overflow-y: auto;">
                    <div class="tab-pane fade show active" id="pendaftaran">
                        <div class="list-group list-group-flush">
                            
                            <div class="list-group-item p-3 border-bottom" style="background-color: #f0f9ff;">
                                <div class="d-flex align-items-start">
                                    <div class="mr-3 mt-1">
                                        <i class="fa-solid fa-envelope-open-text text-primary" style="font-size: 20px;"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 small font-weight-bold">Konfirmasi Email Dikirim</h6>
                                        <p class="mb-1 text-muted" style="font-size: 12px; line-height: 1.4;">
                                            Pendaftaran <strong>Magang Industri</strong> berhasil. Silakan cek email <span class="text-primary">@userEmail</span> untuk langkah verifikasi selanjutnya.
                                        </p>
                                        <small class="text-muted" style="font-size: 10px;">Baru saja</small>
                                    </div>
                                </div>
                            </div>

                            <div class="list-group-item p-3 border-bottom">
                                <div class="d-flex align-items-start">
                                    <div class="mr-3 mt-1">
                                        <i class="fa-solid fa-file-circle-check text-warning" style="font-size: 20px;"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 small font-weight-bold">Dokumen Sedang Ditinjau</h6>
                                        <p class="mb-1 text-muted" style="font-size: 12px; line-height: 1.4;">
                                            Berkas pendaftaran Anda di unit <strong>IT Semarang</strong> sedang diperiksa oleh tim HC.
                                        </p>
                                        <small class="text-muted" style="font-size: 10px;">2 jam yang lalu</small>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    
                    <div class="tab-pane fade p-4 text-center" id="update">
                        <img src="https://cdni.iconscout.com/illustration/premium/thumb/empty-state-2130362-1800923.png" width="100" class="mb-2 opacity-50">
                        <p class="text-muted small">Belum ada pembaruan sistem.</p>
                    </div>
                </div>

                <div class="p-2 border-top text-center bg-light">
                    <a href="#" class="small font-weight-bold text-success" style="text-decoration:none;">Tandai semua dibaca</a>
                </div>
            </div>
        </div>

        <div class="text-right mr-3 border-left pl-3">
            <div class="small font-weight-bold">@namaUser</div>
            <small class="text-success font-weight-bold">
                <i class="fa-solid fa-circle text-success mr-1" style="font-size: 8px;"></i> Online
            </small>
        </div>

        <div class="dropdown">
        <div style="cursor: pointer;" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <img src="@avatarUrl" class="rounded-circle shadow-sm border" width="45">
        </div>
        
        <div class="dropdown-menu dropdown-menu-right shadow border-0" style="border-radius: 12px; min-width: 200px;">
            <div class="dropdown-header font-weight-bold text-dark">Menu Akun</div>
            
            <a class="dropdown-item py-2" href="javascript:void(0)" onclick="showPage('profil')">
                <i class="fa-solid fa-user-gear mr-2 text-muted"></i> Kelola Akun
            </a>
            
            <div class="dropdown-divider"></div>
            
            <a class="dropdown-item py-2 text-danger" href="javascript:void(0)" onclick="handleLogout()">
                <i class="fa-solid fa-right-from-bracket mr-2"></i> Logout
            </a>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="container-fluid py-4">
        
        <div id="page-dashboard" class="page-section active">
            <div class="mb-4">
                <h3 style="font-weight: 800; color: #00549B; margin-bottom: 0;">
                    Selamat Datang, @namaUser!
                </h3>
                <p class="subtitle-portal" style="font-size: 14px; color: #64748b; margin-top: 2px;">
                    Portal SINTA Pertamina Panel Peserta
                </p>
            </div>

            <div class="row">
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="glass-card">
                        <small class="text-muted font-weight-bold text-uppercase" style="font-size: 10px;">Aktivitas Terakhir</small>
                        <h4 class="font-weight-bold mt-2">Magang Industri</h4>
                        <div class="mt-auto pt-3">
                            <a href="javascript:void(0)" onclick="showPage('riwayat')" class="text-primary small font-weight-bold">Lihat detail →</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-5 mb-4">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <small class="text-muted font-weight-bold text-uppercase" style="font-size: 10px;">Status Verifikasi Data</small>
                            <button onclick="showPage('profil')" class="btn btn-link p-0 text-primary font-weight-bold" style="font-size: 11px; text-decoration: none;">
                                Lengkapi <i class="fa-solid fa-chevron-right ml-1"></i>
                            </button>
                        </div>
                        <div class="d-flex align-items-baseline mt-2">
                            <h4 class="font-weight-bold mb-0 mr-2" style="font-size: 1.5rem;">60%</h4>
                            <span class="status-badge status-review" style="font-size: 10px;">Belum Lengkap</span>
                        </div>
                        <div class="mt-3">
                            <div class="progress" style="height: 6px; border-radius: 10px; background-color: #f1f5f9;">
                                <div class="progress-bar" role="progressbar" style="width: 60%; background-color: var(--p-blue);"></div>
                            </div>
                            <p class="text-muted mt-2 mb-0" style="font-size: 10.5px;">Lengkapi profil Anda untuk verifikasi.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div> <div id="page-riwayat" class="page-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="font-weight-bold" style="color: var(--p-blue); margin-bottom: 0;">Riwayat Pengajuan Magang</h4>
                    <p class="subtitle-portal" style="font-size: 14px; color: #64748b; margin-top: 4px; margin-bottom: 0;">Pantau status pengajuan magang industri Anda secara real-time.</p>
                </div>
                <button class="btn btn-primary px-4 shadow-sm" style="border-radius:10px; background: var(--p-blue);" onclick="window.location.href='/PendaftaranMagang/DataMagang'">
                    <i class="fa fa-plus mr-2"></i> Daftar Magang Baru
                </button>
            </div>
            <div class="glass-card p-0 overflow-hidden">
                <table class="table mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 px-4">Program</th>
                            <th class="border-0">Unit Kerja</th>
                            <th class="border-0">Tanggal</th>
                            <th class="border-0">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="4" class="text-center py-4 text-muted">Belum ada riwayat magang.</td></tr>
                    </tbody>
                </table>
            </div>
        </div> <div id="page-penelitian" class="page-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="font-weight-bold" style="color: var(--p-blue); margin-bottom: 0;">Riwayat Pengajuan Riset</h4>
                    <p class="subtitle-portal" style="font-size: 14px; color: #64748b; margin-top: 4px; margin-bottom: 0;">Daftar pengajuan riset dan penelitian yang telah Anda ajukan.</p>
                </div>
                <button class="btn btn-primary px-4 shadow-sm" style="border-radius:10px; background: var(--p-blue);" onclick="window.location.href='/Penelitian/Daftar'">
                    <i class="fa fa-plus mr-2"></i> Ajukan Riset Baru
                </button>
            </div>
            <div class="glass-card p-0 overflow-hidden">
                <table class="table mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 px-4">Judul Riset</th>
                            <th class="border-0">Instansi</th>
                            <th class="border-0">Tanggal</th>
                            <th class="border-0">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                         <tr><td colspan="4" class="text-center py-4 text-muted">Belum ada riwayat riset.</td></tr>
                    </tbody>
                </table>
            </div>
        </div> <div id="page-profil" class="page-section">
            <div class="glass-card">
                <div class="mb-4">
                    <h4 class="font-weight-bold" style="color: var(--p-blue); margin-bottom: 0;">Pengaturan Informasi Profil</h4>
                    <p class="subtitle-portal" style="font-size: 14px; color: #64748b; margin-top: 4px; margin-bottom: 0;">Pastikan data diri Anda valid untuk mempercepat verifikasi.</p>
                </div>
                <div class="row">
                    <div class="col-md-6"><div class="form-group"><label class="small font-weight-bold">Nama Lengkap</label><input type="text" class="form-control" placeholder="Nama Lengkap"></div></div>
                    <div class="col-md-6"><div class="form-group"><label class="small font-weight-bold">Email</label><input type="email" class="form-control" placeholder="Masukkan Email"></div></div>
                    <div class="col-md-6"><div class="form-group"><label class="small font-weight-bold">No Hp</label><input type="text" class="form-control" placeholder="Contoh: 088834637577"></div></div>
                    <div class="col-md-6"><div class="form-group"><label class="small font-weight-bold">Nama Perguruan Tinggi</label><input type="text" class="form-control" placeholder="Perguruan Tinggi"></div></div>
                </div>
                <hr class="my-4">
                <div class="text-right">
                    <button class="btn btn-primary px-5" onclick="saveProfile()" style="border-radius:10px; background: var(--p-blue);">Simpan Perubahan</button>
                </div>
            </div>
        </div> </div>
</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function showPage(pageId) {
        $('.page-section').removeClass('active');
        $('#page-' + pageId).addClass('active');
        $('.nav-link-custom').removeClass('active');
        $('#nav-' + pageId).addClass('active');

        const breadcrumbs = {
            'dashboard': 'Panel Peserta / Dashboard',
            'riwayat': 'Panel Peserta / Riwayat Magang',
            'penelitian': 'Panel Peserta / Riwayat Riset',
            'profil': 'Panel Peserta / Pengaturan Profil'
        };
        $('#page-breadcrumb').text(breadcrumbs[pageId]);
    }

    function saveProfile() { Swal.fire('Berhasil', 'Data profil diperbarui.', 'success'); }
    function handleLogout() {
        Swal.fire({
            title: 'Keluar?', text: "Sesi akan berakhir.", icon: 'warning',
            showCancelButton: true, confirmButtonColor: '#ec1c24', confirmButtonText: 'Logout'
        }).then((r) => { if (r.isConfirmed) window.location.href = '/Auth/Logout'; });
    }
</script>
</body>
</html>