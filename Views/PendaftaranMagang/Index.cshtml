@{
    ViewData["Title"] = "Portal Magang SINTA - Pertamina";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/Tooltip.js"></script>


<style>
    :root {
        --p-biru: #003B76;
        --p-merah: #E30613;
        --p-abu: #f1f5f9;
        --p-gelap: #1e293b;
        --p-gray: #64748b;
    }

    body {
        background-color: #f8fafc;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .hero-instansi {
        background: linear-gradient(rgba(0, 59, 118, 0.9), rgba(0, 59, 118, 0.8)), url('/img/pertamina bg.jpg');
        background-size: cover;
        background-position: center;
        padding: 100px 0 140px;
        color: white;
        clip-path: ellipse(150% 100% at 50% 0%);
    }

    .wadah-statistik {
        margin-top: -70px;
        position: relative;
        z-index: 10;
    }

    @@media (min-width: 1400px) {
        .wadah-statistik {
            max-width: 1400px;
        }
    }

    .kartu-statistik {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        padding: 30px;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .kartu-formal {
        background: white;
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 25px;
        border: 1px solid #e2e8f0;
    }

    .label-bagian {
        display: inline-block;
        background: rgba(0, 59, 118, 0.05);
        color: var(--p-biru);
        padding: 8px 18px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 20px;
        border-left: 5px solid var(--p-biru);
    }

    .grid-lowongan {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        width: 100%;
    }

    .flip-card {
        background-color: transparent;
        height: 280px;
        perspective: 1000px;
    }

    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.6s;
        transform-style: preserve-3d;
    }

    .flip-card:hover .flip-card-inner {
        transform: rotateY(180deg);
    }

    .flip-card-front,
    .flip-card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        border-radius: 15px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        border: 1px solid #e2e8f0;
    }

    .flip-card-front {
        background-color: white;
        color: var(--p-gelap);
    }

    .flip-card-back {
        background-color: var(--p-biru);
        color: white;
        transform: rotateY(180deg);
        justify-content: center;
    }

    .wadah-ikon-sm {
        width: 40px;
        height: 40px;
        background: #f1f5f9;
        color: var(--p-biru);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        font-size: 16px;
        flex-shrink: 0;
    }

    .judul-posisi {
        font-size: 13px;
        font-weight: 700;
        color: var(--p-biru);
        line-height: 1.4;
        min-height: 55px;
        margin-bottom: 8px;
        overflow: hidden;
        word-break: break-word;
        overflow-wrap: anywhere;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .syarat-dokumen {
        background: rgba(0, 59, 118, 0.05);
        border-radius: 8px;
        padding: 6px 8px;
        font-size: 9px;
    }

    .tombol-daftar {
        background: var(--p-merah);
        color: white;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s;
        display: inline-block;
        border: none;
    }

    .tombol-daftar:hover {
        background: #b90510;
        color: white;
        transform: translateY(-3px);
    }

    .swal2-title {
        font-size: 1.1rem !important;
        padding-top: 10px !important;
    }

    .swal2-html-container {
        font-size: 0.85rem !important;
        margin: 10px 20px !important;
    }

    .swal2-styled {
        font-size: 0.8rem !important;
    }

    .swal2-small-text {
        font-size: 0.85rem !important;
        line-height: 1.4 !important;
    }
</style>

<div class="hero-instansi text-center">
    <div class="container animate__animated animate__fadeIn">
        <h1 class="display-4 fw-bold mb-3">Program Magang</h1>
        <p class="lead opacity-75 mb-5 mx-auto" style="max-width: 750px;">Kembangkan potensi profesional Anda melalui program magang terstruktur di PT Pertamina (Persero).</p>
        <button onclick="handleMulaiDaftar()" class="tombol-daftar" style="border:none; cursor:pointer;">
            MULAI PENDAFTARAN
        </button>
    </div>
</div>

<div class="container wadah-statistik">
    <div class="kartu-statistik shadow-sm">
        <div class="row text-center g-4">
            <div class="col-md-4 border-end">
                <small class="text-muted d-block mb-1 fw-bold">STATUS PORTAL</small>
                <span class="fw-bold text-success"><span class="titik-aktif animate__animated animate__pulse animate__infinite"></span>PENDAFTARAN DIBUKA</span>
            </div>
            <div class="col-md-4 border-end">
                <small class="text-muted d-block mb-1 fw-bold">PERIODE MAGANG</small>
                <span class="fw-bold text-dark">2026</span>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block mb-1 fw-bold">SISTEM KERJA</small>
                <span class="fw-bold text-primary">ONSITE</span>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="kartu-formal border-0 shadow-sm">
                <div class="label-bagian">Peluang Magang</div>
                <h5 class="fw-bold mb-4">Informasi Posisi</h5>

                <div class="row g-3 mb-5 p-3 bg-light rounded-4 border">
                    <div class="col-md-6">
                        <label class="small fw-bold text-muted mb-1">Cari Posisi</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" id="searchPosisi" class="form-control border-start-0 ps-0" placeholder="Ketik posisi...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-muted mb-1">Company</label>
                        <select id="filterCompany" class="form-select shadow-sm">
                            <option value="">Pilih</option>
                            <option value="KPI">PT Kilang Pertamina Internasional</option>
                            <option value="PPN">PT Pertamina Patra Niaga</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-muted mb-1">Region</label>
                        <select id="filterRegion" class="form-select shadow-sm" disabled><option value="">Pilih</option></select>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-muted mb-1">Lokasi</label>
                        <select id="filterLokasi" class="form-select shadow-sm" disabled><option value="">Pilih</option></select>
                    </div>
                </div>

                <div id="emptyState" class="empty-state text-center py-5">
                    <i class="fas fa-filter fa-3x mb-3 text-muted"></i>
                    <p>Pilih filter untuk memunculkan lowongan.</p>
                </div>

                <div class="grid-lowongan" id="containerLowongan"></div>
            </div>
        </div>
    </div>
</div>

