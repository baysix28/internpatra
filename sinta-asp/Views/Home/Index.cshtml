@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    <div class="row text-center">

        <div class="col-md-4">
            <h4>Magang Kerja</h4>
            <p>Mau merasakan magang di PT. Pertamina (Persero)?</p>
            <a asp-controller="PendaftaranMagang" asp-action="Index" class="btn btn-primary w-100">
                Informasi Magang Kerja
            </a>
        </div>

        <div class="col-md-4">
            <h4>Penelitian</h4>
            <p>Penelitianmu berkaitan dengan Pertamina?</p>
            <a href="@Url.Action("DataDiri", "Penelitian")" class="btn btn-info text-white w-100">
                Daftar Penelitian
            </a>
        </div>

        <div class="col-md-4">
            <h4>Hasil Pendaftaran</h4>
            <p>Penasaran apakah pendaftaranmu diterima?</p>
            <a href="@Url.Action("Index", "Hasil")" class="btn btn-success w-100">
                Periksa Hasil Pendaftaran
            </a>
        </div>

    </div>
</div>