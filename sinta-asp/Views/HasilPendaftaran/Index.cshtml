@{
    ViewData["Title"] = "Monitoring Status Pendaftaran - SINTA";
}

<style>
    :root {
        --pertamina-blue: #005EB8;
        --pertamina-green: #00A859;
        --pertamina-red: #E30613;
        --pertamina-dark: #003B76;
        --shadow-medium: rgba(0, 94, 184, 0.15);
    }

    /* 1. MEMPERKECIL HEADER BIRU */
    .header-status {
        background: linear-gradient(135deg, var(--pertamina-blue) 0%, var(--pertamina-dark) 100%);
        color: white;
        padding: 40px 0 60px 0; /* Diperkecil dari 70px/98px */
        text-align: center;
        position: relative;
    }

    .header-status h2 {
        font-weight: 800;
        font-size: 35px; /* Ukuran font diperkecil sedikit */
        margin-bottom: 5px;
    }

    /* 2. PENYESUAIAN JARAK KOTAK SEARCH */
    .search-container {
        margin-top: 50px; /* Diatur agar pas melayang di header yang lebih kecil */
        margin-bottom: 30px;
        position: relative;
        z-index: 3;
    }

    .status-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 10px 30px var(--shadow-medium);
        border-top: 5px solid var(--pertamina-green);
    }

    .input-group-custom {
        display: flex;
        background: #f8fbff;
        border: 2px solid #e1e8f0;
        border-radius: 50px;
        padding: 5px 5px 5px 20px;
    }

    .input-group-custom input {
        border: none;
        background: transparent;
        width: 100%;
        outline: none;
    }

    .btn-periksa {
        background: linear-gradient(135deg, var(--pertamina-green), #008a49);
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 700;
        cursor: pointer;
    }

    /* 3. STYLE UNTUK HASIL PENCARIAN (HIDDEN BY DEFAULT) */
    #searchResult {
        display: none;
        margin-top: 20px;
    }

    .result-box {
        border: 1px solid #e1e8f0;
        border-radius: 12px;
        padding: 20px;
        background-color: #ffffff;
    }

    .status-badge {
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 14px;
    }

    .status-pending { background: #fff3cd; color: #856404; }
</style>

<section class="header-status">
    <div class="container">
        <h2>Monitoring Status Pendaftaran</h2>
        <p style="opacity: 0.9; font-size: 14px;">Cek progres lamaran magang Anda</p>
    </div>
</section>

<div class="container search-container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="status-card">
                <form id="searchForm">
                    <div class="input-group-custom">
                        <input type="text" id="searchInput" placeholder="Masukkan Nomor Pendaftaran atau Email Anda" required>
                        <button type="submit" class="btn-periksa">
                            <i class="fas fa-search"></i> Periksa
                        </button>
                    </div>
                </form>

                <div id="searchResult">
                    <hr>
                    <div class="result-box">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">Hasil Pencarian:</h6>
                            <span class="status-badge status-pending">Sedang Diproses</span>
                        </div>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td width="150" class="text-muted">Nama Pelamar</td>
                                <td id="resName">: -</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Email</td>
                                <td id="resEmail">: -</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Posisi Magang</td>
                                <td>: Regional Jawa Bagian Tengah</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded-3" style="background-color: #fff9e6; border-left: 4px solid #ffc107;">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i> 
                        Gunakan email yang terdaftar pada sistem SINTA.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchForm').addEventListener('submit', function(e) {
            e.preventDefault(); // Mencegah refresh halaman
            
            const emailValue = document.getElementById('searchInput').value;
            
            // Simulasi memunculkan hasil (Nanti bisa dihubungkan ke Database)
            document.getElementById('resEmail').innerText = ": " + emailValue;
            document.getElementById('resName').innerText = ": Peserta Magang SINTA";
            
            // Tampilkan kotak hasil
            document.getElementById('searchResult').style.display = 'block';
        });
    </script>
}