@model sinta_asp.Models.PendaftaranPenelitianModel
@{
    ViewData["Title"] = "Formulir Pendaftaran";
    
    // 1. TANGKAP DATA DARI URL (JALUR VIP)
    var preCompany = Context.Request.Query["preCompany"].ToString();
    var preRegion = Context.Request.Query["preRegion"].ToString();
    var preTargetLokasi = Context.Request.Query["preTargetLokasi"].ToString();
    var preTargetJurusan = Context.Request.Query["preTargetJurusan"].ToString();

    // 2. DETEKTIF: APAKAH INI JALUR KHUSUS (SAKLEK)?
    // Kalau ada isinya, berarti Jalur VIP. Kalau kosong, Jalur Umum.
    bool isJalurKhusus = !string.IsNullOrEmpty(preCompany);
}
<style>
    @("@")import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
    
    :root { --p-red: #ED1B24; --p-blue: #00529C; --p-green: #5CB85C; }
    
    .penelitian-wrapper { background-color: #ffffff; font-family: 'Poppins', sans-serif; color: #444; }

    /* HEADER */
    .page-title-section { position: relative; margin-top: 50px; margin-bottom: 40px; text-align: center; }
    .page-title-section h2 { font-weight: 700; color: var(--p-blue); margin-bottom: 10px; }
    .btn-back-home {
        position: absolute; left: 0; top: 0%; transform: translateY(-50%); display: inline-flex; align-items: center; 
        padding: 10px 20px; background: #fff; border: 1px solid #dee2e6; border-radius: 50px; 
        color: var(--p-blue); text-decoration: none; font-weight: 600; gap: 8px; transition: 0.3s;
    }
    .btn-back-home:hover { background: var(--p-blue); color: white; border-color: var(--p-blue); }

    /* STEP INDICATOR */
    .step-indicator { display: flex; justify-content: center; flex-wrap: wrap; gap: 15px; border: none; margin-bottom: 30px; }
    .step-indicator .nav-link {
        display: flex; align-items: center; padding: 12px 30px; background: #fff;
        border: 1px solid #dee2e6; border-radius: 50px !important; color: #666;
        font-weight: 600; transition: all 0.3s ease;
    }
    .step-marker { display: inline-flex; align-items: center; justify-content: center; margin-right: 8px; font-weight: 700; width: 20px; }

    /* STATE WARNA TAB */
    .nav-pills .nav-link.active { background-color: var(--p-blue); color: white !important; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,82,156,0.25); border-color: var(--p-blue); }
    
    .nav-link.done { background-color: #f0fff4; border-color: var(--p-green); color: var(--p-green) !important; }
    
    .nav-link.error { 
        background-color: #fff5f5; border-color: var(--p-red); color: var(--p-red) !important; 
        animation: shake 0.4s ease-in-out; 
    }
    .nav-link.error .step-marker { color: var(--p-red); }

    @("@")keyframes shake { 0%, 100% {transform: translateX(0);} 25% {transform: translateX(-5px);} 75% {transform: translateX(5px);} }

    /* FORM STYLES */
    .card-form { border: none; border-radius: 20px; box-shadow: 0 0 40px rgba(0,0,0,0.08); background: #fff; }
    .form-control, .form-select { border-radius: 10px; padding: 12px 15px; border: 1px solid #e0e0e0; }
    .form-control:focus { border-color: var(--p-blue); box-shadow: 0 0 0 4px rgba(0,82,156,0.1); }
    
    .form-control.is-invalid, .form-select.is-invalid { 
        border-color: var(--p-red); 
        background-image: none; 
    }
    .invalid-feedback { font-size: 0.85rem; color: var(--p-red); }
    
    .btn-next, .btn-submit { border: none; color: white; padding: 12px 40px; border-radius: 50px; font-weight: 500; }
    .btn-next { background: linear-gradient(135deg, var(--p-blue), #003d75); }
    .btn-submit { background: linear-gradient(135deg, var(--p-green), #4cae4c); }
    .btn-back { border: 1px solid #ddd; background: #fff; color: #666; padding: 12px 30px; border-radius: 50px; }

    @("@")media (max-width: 768px) {
        .step-indicator { flex-direction: column; }
        .nav-link { justify-content: center; }
    }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="penelitian-wrapper">
    <div class="container mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-md-11"> 
                
                <div class="page-title-section">
                    <a asp-action="Index" class="btn-back-home"><i class="bi bi-arrow-left"></i> Back</a>
                    <h2>Pendaftaran Penelitian</h2>
                    <p>Lengkapi formulir di bawah ini dengan data yang benar.</p>
                </div>

                <form asp-action="SubmitPendaftaran" ... >
                    <input type="hidden" name="TargetLokasi" value="@preTargetLokasi" />
                    <input type="hidden" name="TargetJurusan" value="@preTargetJurusan" />  

                    <ul class="nav nav-pills step-indicator" id="pills-tab" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="tab-1" data-bs-toggle="pill" data-bs-target="#step-1" type="button">
                                <span class="step-marker">1</span> Personal
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="tab-2" data-bs-toggle="pill" data-bs-target="#step-2" type="button">
                                <span class="step-marker">2</span> Education
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="tab-3" data-bs-toggle="pill" data-bs-target="#step-3" type="button">
                                <span class="step-marker">3</span> Research
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="tab-4" data-bs-toggle="pill" data-bs-target="#step-4" type="button">
                                <span class="step-marker">4</span> Files
                            </button>
                        </li>
                    </ul>
                    
                    <div class="card card-form">
                        <div class="card-body p-4 p-md-5"> 
                            <div class="tab-content" id="pills-tabContent">
                                
                                <div class="tab-pane fade show active" id="step-1">
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <label class="form-label">Nama Lengkap</label>
                                            <input type="text" class="form-control" asp-for="Nama" required>
                                            <div class="invalid-feedback">Nama wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" asp-for="Email" required>
                                            <div class="invalid-feedback">Email tidak valid.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">No. WhatsApp</label>
                                            <input type="number" class="form-control" asp-for="NoHp" placeholder="08..." required>
                                            <div class="invalid-feedback">Harus diawali 08 (min 10 digit).</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Tempat Lahir</label>
                                            <input type="text" class="form-control" asp-for="TempatLahir" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Tanggal Lahir</label>
                                            <input type="date" class="form-control" asp-for="TglLahir" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Instagram</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light text-muted">@("@")</span>
                                                <input type="text" class="form-control" asp-for="Instagram" required>
                                                <div class="invalid-feedback">Wajib diisi.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-5 text-center">
                                        <button type="button" class="btn btn-next" onclick="nextStep('tab-1', 'tab-2')">
                                            Selanjutnya <i class="bi bi-arrow-right ms-2"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="step-2">
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <label class="form-label">Universitas</label>
                                            <input type="text" class="form-control" asp-for="Universitas" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Fakultas</label>
                                            <input type="text" class="form-control" asp-for="Fakultas" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Jurusan</label>
                                            <input type="text" class="form-control" asp-for="Jurusan" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">NIM</label>
                                            <input type="text" class="form-control" asp-for="Nim" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                    </div>
                                    <div class="mt-5 d-flex justify-content-center gap-3">
                                        <button type="button" class="btn btn-back" onclick="prevStep('tab-1')">Kembali</button>
                                        <button type="button" class="btn btn-next" onclick="nextStep('tab-2', 'tab-3')">Selanjutnya <i class="bi bi-arrow-right"></i></button>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="step-3">
                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <label class="form-label">Company Tujuan</label>

                                            @if (isJalurKhusus)
                                            {
                                                <input type="text" class="form-control bg-light" value="@preCompany" readonly>
                                                <input type="hidden" asp-for="Company" value="@preCompany">
                                            }
                                            else
                                            {
                                                <select class="form-select" asp-for="Company" required id="companySelect">
                                                    <option value="">Pilih Company...</option>
                                                    <option value="PT Pertamina Patra Niaga (C&T)">PT Pertamina Patra Niaga (C&T)</option>
                                                    <option value="PT Kilang Pertamina Internasional (KPI)">PT Kilang Pertamina Internasional (KPI)</option>
                                                </select>
                                            }
                                            <div class="invalid-feedback">Wajib dipilih.</div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Region / Unit Operasi</label>

                                            @if (isJalurKhusus)
                                            {
                                                <input type="text" class="form-control bg-light" value="@preRegion" readonly>
                                                <input type="hidden" asp-for="Region" value="@preRegion">
                                            }
                                            else
                                            {
                                                <select class="form-select" asp-for="Region" required id="regionSelect">
                                                    <option value="">Pilih Company Dahulu...</option>
                                                </select>
                                            }
                                            <div class="invalid-feedback">Wajib dipilih.</div>
                                        </div>

                                        <script>
                                            // Kita jalankan saat user mengubah pilihan di Company
                                            document.getElementById('companySelect')?.addEventListener('change', function() {
                                                
                                                // 1. Ambil Nilai
                                                var perusahaan = this.value;
                                                var targetDropdown = document.getElementById("regionSelect");

                                                // 2. Debugging (Cek apakah nilai masuk?)
                                                // alert("Script Jalan! Kamu memilih: " + perusahaan);

                                                // 3. Reset Dropdown Region
                                                targetDropdown.innerHTML = '<option value="">Pilih Region...</option>';

                                                // 4. Cek Logika (Copy-Paste Text Value harus SAMA PERSIS)
                                                if (perusahaan === "PT Pertamina Patra Niaga (C&T)") {
                                                    
                                                    var opsi = [
                                                        "Regional Jatimbalinus",
                                                        "Regional Jawa Bagian Tengah",
                                                        "Regional Jawa Bagian Barat",
                                                        "Regional Kalimantan",
                                                        "Regional Maluku Papua",
                                                        "Regional Sumbagut"
                                                    ];
                                                    
                                                    opsi.forEach(function(item) {
                                                        var option = document.createElement("option");
                                                        option.text = item;
                                                        option.value = item;
                                                        targetDropdown.add(option);
                                                    });

                                                } else if (perusahaan === "PT Kilang Pertamina Internasional (KPI)") {
                                                    
                                                    var option = document.createElement("option");
                                                    option.text = "Refinery Unit VI Balongan";
                                                    option.value = "Refinery Unit VI Balongan";
                                                    targetDropdown.add(option);
                                                    
                                                } else {
                                                    targetDropdown.innerHTML = '<option value="">Pilih Company Dahulu...</option>';
                                                }
                                            });
                                        </script>
                                        <div class="col-12">
                                            <label class="form-label">Lokasi Penelitian</label>
                                            <input type="text" class="form-control" asp-for="LokasiPenelitian" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Judul Penelitian</label>
                                            <input type="text" class="form-control" asp-for="JudulPenelitian" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Mulai</label>
                                            <input type="date" class="form-control" asp-for="TglMulai" required>
                                            <div class="invalid-feedback">Wajib diisi.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Selesai</label>
                                            <input type="date" class="form-control" asp-for="TglSelesai" required>
                                            <div class="invalid-feedback">Wajib diisi.</div> </div>
                                    </div>
                                    <div class="mt-5 d-flex justify-content-center gap-3">
                                        <button type="button" class="btn btn-back" onclick="prevStep('tab-2')">Kembali</button>
                                        <button type="button" class="btn btn-next" onclick="nextStep('tab-3', 'tab-4')">Selanjutnya <i class="bi bi-arrow-right"></i></button>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="step-4">
                                    <div class="row g-4">
                                        <div class="col-12 alert alert-info">
                                            <small><i class="bi bi-info-circle"></i> Pastikan file berformat PDF dan ukuran maks 2MB.</small>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-bold">Resume / CV (PDF)</label>
                                            <input type="file" class="form-control" asp-for="FileCV" accept=".pdf" required>
                                            <div class="invalid-feedback">Wajib upload.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-bold">Proposal (PDF)</label>
                                            <input type="file" class="form-control" asp-for="FileProposal" accept=".pdf" required>
                                            <div class="invalid-feedback">Wajib upload.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-bold">Surat Pengantar (PDF)</label>
                                            <input type="file" class="form-control" asp-for="FileSurat" accept=".pdf" required>
                                            <div class="invalid-feedback">Wajib upload.</div>
                                        </div>
                                    </div>
                                    <div class="mt-5 d-flex justify-content-center gap-3">
                                        <button type="button" class="btn btn-back" onclick="prevStep('tab-3')">Kembali</button>
                                        <button type="submit" class="btn btn-submit" id="btnSubmit">Kirim Pendaftaran <i class="bi bi-send-fill"></i></button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
    function nextStep(currentTabId, nextTabId) {
        if (validatePane(currentTabId)) {
            triggerTab(nextTabId);
        } else {
            const tabBtn = document.getElementById(currentTabId);
            tabBtn.classList.add('error'); 
        }
    }

    function prevStep(prevTabId) {
        triggerTab(prevTabId);
    }

    function triggerTab(tabId) {
        var triggerEl = document.querySelector('#' + tabId)
        if(typeof bootstrap !== 'undefined'){
            var tab = bootstrap.Tab.getOrCreateInstance(triggerEl)
            tab.show()
        } else {
            triggerEl.click();
        }
        window.scrollTo(0, 0);
    }

    function validatePane(tabBtnId) {
        const paneId = tabBtnId.replace('tab', 'step'); 
        const pane = document.getElementById(paneId);
        const inputs = pane.querySelectorAll('input[required], select[required]');
        let isPaneValid = true;

        inputs.forEach(input => {
            // Reset state
            input.setCustomValidity(""); 
            input.classList.remove('is-invalid'); 

            // Validasi Khusus: No HP
            if (input.name === "NoHp") {
                const indoRegex = /^08[0-9]{8,11}$/;
                if (input.value && !indoRegex.test(input.value)) {
                    input.classList.add('is-invalid'); 
                    isPaneValid = false;
                }
            }

            // Validasi Khusus: Tanggal (LOGIKA BARU DI SINI)
            if (input.name === "TglSelesai") {
                const tglMulai = pane.querySelector('input[name="TglMulai"]').value;
                // Ambil div pesan error di bawah input ini
                const feedbackDiv = input.parentElement.querySelector('.invalid-feedback');
                
                if (tglMulai && input.value) {
                    if (new Date(tglMulai) >= new Date(input.value)) {
                        // 1. Ubah teks pesan error secara dinamis
                        if(feedbackDiv) feedbackDiv.textContent = "Tanggal Selesai harus lebih besar dari Tanggal Mulai!";
                        
                        // 2. Set input jadi invalid
                        input.setCustomValidity("Invalid Range"); 
                        input.classList.add('is-invalid');
                        isPaneValid = false;
                    } else {
                        // Kalau sudah benar, kembalikan pesan ke default (jaga-jaga)
                        if(feedbackDiv) feedbackDiv.textContent = "Wajib diisi.";
                        input.setCustomValidity(""); 
                    }
                }
            }

            // Validasi Umum HTML5 (Wajib Isi / Required)
            if (!input.checkValidity()) {
                input.classList.add('is-invalid');
                isPaneValid = false;
            }
        });

        updateTabVisual(tabBtnId, isPaneValid);

        if (!isPaneValid) {
            const firstError = pane.querySelector('.is-invalid, :invalid');
            if(firstError) firstError.focus();
        }

        return isPaneValid;
    }

    function updateTabVisual(tabId, isValid) {
        const tabBtn = document.getElementById(tabId);
        const marker = tabBtn.querySelector('.step-marker');

        tabBtn.classList.remove('done', 'error');

        if (isValid) {
            tabBtn.classList.add('done');
            marker.innerHTML = '<i class="bi bi-check-lg"></i>';
        } else {
            tabBtn.classList.add('error');
            marker.innerHTML = '<i class="bi bi-exclamation-lg"></i>';
        }
    }

    const allTabs = document.querySelectorAll('button[data-bs-toggle="pill"]');
    allTabs.forEach(tab => {
        tab.addEventListener('hide.bs.tab', function (e) {
            const tabDitinggalkan = e.target.id;
            validatePane(tabDitinggalkan);
        });
    });

    document.getElementById('btnSubmit').addEventListener('click', function(e) {
        if(!validatePane('tab-4')) {
            e.preventDefault();
        }
    });

<script>
    // Fungsi ini dipanggil langsung dari HTML (onchange)
    function cekGantiCompany(elemenSelect) {
        
        // 1. Ambil Nilai yang dipilih user
        var perusahaan = elemenSelect.value;
        
        // DEBUG: Munculkan Pop-up biar yakin kodingan jalan (Nanti bisa dihapus)
        // alert("Kamu memilih: " + perusahaan); 

        // 2. Ambil elemen dropdown region
        var targetDropdown = document.getElementById("dropdownRegionKhusus");

        // 3. Reset isinya
        targetDropdown.innerHTML = '<option value="">Pilih Region...</option>';

        // 4. Cek Logika
        if (perusahaan === "PT Pertamina Patra Niaga") {
            // Isi Opsi Patra Niaga
            var opsi = [
                "Regional Jatimbalinus",
                "Regional Jawa Bagian Tengah",
                "Regional Jawa Bagian Barat",
                "Regional Kalimantan",
                "Regional Maluku Papua",
                "Regional Sumbagut"
            ];
            
            // Masukkan ke dropdown pakai Loop biasa
            for (var i = 0; i < opsi.length; i++) {
                var option = document.createElement("option");
                option.text = opsi[i];
                option.value = opsi[i];
                targetDropdown.add(option);
            }

        } else if (perusahaan === "PT Kilang Pertamina Internasional") {
            // Isi Opsi Kilang
            var option = document.createElement("option");
            option.text = "Refinery Unit VI Balongan";
            option.value = "Refinery Unit VI Balongan";
            targetDropdown.add(option);

        } else {
            // Kalau pilihannya kosong/reset
            targetDropdown.innerHTML = '<option value="">Pilih Company Dahulu...</option>';
        }
    }
</script>

</script>