                                    <i class="fas fa-id-card me-2"></i>KONTAK & PRIBADI
                                </div>
                                <div class="info-card-premium">
                                    <div class="info-label">Email</div>
                                    <div id="d-email" class="info-value"></div>
                                    <div class="info-label">WhatsApp</div>
                                    <div class="info-value">
                                        <a id="d-hp-link" target="_blank" class="text-decoration-none"></a>
                                    </div>
                                    <div class="info-label">Instagram</div>
                                    <div class="info-value">
                                        <a id="d-ig-link" target="_blank" class="text-decoration-none" style="color: var(--p-blue);"></a>
                                    </div>
                                    <div class="info-label">Tempat, Tgl Lahir</div>
