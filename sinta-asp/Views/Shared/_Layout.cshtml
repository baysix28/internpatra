<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - SINTA Pertamina</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Penambahan CSS agar body memenuhi layar */
        html, body {
            height: 100%;
            margin: 0;
        }

        /* Flexbox untuk memaksa footer ke bawah */
        body { 
            display: flex;
            flex-direction: column;
            background-color: #ffffff; 
        }

        .top-bar { border-bottom: 50px solid #e74c3c; padding: 15px 30px; background: white; }
        .logo-link { text-decoration: none; cursor: pointer; transition: transform 0.3s ease; display: inline-block; }
        .logo-link:hover { transform: scale(1.05); }

        /* Main akan mengambil sisa ruang yang kosong */
        main {
            flex: 1 0 auto;
        }

        footer { 
            flex-shrink: 0; /* Mencegah footer gepeng */
            border-top: 1px solid #ddd; 
            padding: 20px; 
            font-size: 16px; 
            text-align: center; 
            color: #555; 
            background: #f1f1f1; 
        }
    </style>
</head>
<body>

<div class="top-bar d-flex justify-content-between align-items-center">
    <a href="@Url.Action("Index", "Home")" class="logo-link">
        <img src="~/img/logo-pertaminaa.png" height="70" alt="Pertamina Logo">
    </a>
    <a href="@Url.Action("Index", "Home")" class="logo-link">
        <img src="~/img/logo-sinta.png" height="70" alt="SINTA Logo">
    </a>
</div>

<main role="main">
    @RenderBody() 
</main>

<footer>
    <p style="margin: 0; color: #555;">&copy; 2026 PT. Pertamina (Persero) | All Rights Reserved. | Contact Us : 135</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>