<!-- ===== PROFIL PAGE ===== -->
<!-- ================================================================ -->
<div id="page-profil" class="page-section">
    <div class="mb-4">
        <h4 class="font-weight-bold" style="color: var(--p-blue); margin-bottom: 0;">Pengaturan Akun</h4>
        <p class="subtitle-portal" style="font-size: 14px; color: #64748b; margin-top: 4px;">
            Kelola informasi kredensial dan keamanan <span class="text-danger">@namaUser</span>
        </p>
    </div>

    <div class="profile-card">
        <div class="profile-nav-tabs">
            <ul class="nav" id="profileTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="data-tab" data-toggle="tab" href="#tab-data" role="tab">
                        <i class="fa-solid fa-address-card mr-2"></i> Profil Saya
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="security-tab" data-toggle="tab" href="#tab-security" role="tab">
                        <i class="fa-solid fa-shield-halved mr-2"></i> Keamanan
                    </a>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="profileTabContent">
            <div class="tab-pane fade show active" id="tab-data" role="tabpanel">
                <div class="p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="position-relative">
                            <div class="dropdown">
                                <input type="file" id="fileInputFoto" hidden accept="image/*" onchange="uploadFoto(this)">
                                <div id="avatarContainer" class="avatar-box mr-3 shadow-sm"
                                    style="cursor: pointer; overflow: hidden; width: 80px; height: 80px; border: 2px solid #e2e8f0;"
                                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    @if (Model != null && !string.IsNullOrEmpty(Model.FotoProfil))
                                    {
                                        <img src="/uploads/profile/@Model.FotoProfil" id="imgPreview" style="width:100%; height:100%; object-fit:cover;">
                                    }
                                    else
                                    {
                                        <span id="initialsText">
                                            @{
                                                var inisial = "??";
                                                if (!string.IsNullOrEmpty(namaUser))
                                                {
                                                    inisial = namaUser.Length >= 2 ? namaUser.Substring(0, 2).ToUpper() : namaUser.ToUpper();
                                                }
                                            }
                                            @inisial
                                        </span>
                                    }
                                </div>
                                <div class="dropdown-menu shadow border-0" style="border-radius: 12px; font-size: 14px; min-width: 160px; margin-top: 10px;">
                                    <a class="dropdown-item py-2" href="javascript:void(0)" onclick="document.getElementById('fileInputFoto').click()"><i class="fa-solid fa-file-import mr-2 text-muted"></i> Pilih Foto</a>
                                    <a class="dropdown-item py-2" href="javascript:void(0)" onclick="viewPhoto()"><i class="fa-solid fa-image mr-2 text-muted"></i> Lihat Foto</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item py-2 text-danger" href="javascript:void(0)" onclick="deletePhoto()"><i class="fa-solid fa-trash-can mr-2"></i> Hapus Foto</a>
                                </div>
                            </div>
                        </div>
                        <div>
                            <h5 class="font-weight-bold mb-1">@namaUser</h5>
                        </div>
                    </div>
                    <hr class="my-4 opacity-50">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="label-custom">NAMA LENGKAP PESERTA</label>
                            <div class="input-group-security"><input type="text" id="inputNama" class="form-control input-security-clean" value="@Model?.NamaLengkap" placeholder="Nama Lengkap" readonly></div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="label-custom">USERNAME / EMAIL</label>
                            <div class="input-group-security"><input type="email" id="inputEmail" class="form-control input-security-clean" value="@userEmail" readonly></div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="label-custom">NOMOR HANDPHONE</label>
                            <div class="input-group-security"><input type="text" id="inputNoHP" class="form-control input-security-clean" value="@Model?.NoHP" placeholder="Contoh: 08123456789" readonly></div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="label-custom">INSTANSI / PERGURUAN TINGGI</label>
                            <div class="input-group-security"><input type="text" id="inputUniv" class="form-control input-security-clean" value="@Model?.NamaPerguruanTinggi" placeholder="Nama Perguruan Tinggi" readonly></div>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-12 text-right">
                            <button type="button" id="btnBatal" class="btn btn-batal-custom mr-2" style="display: none;"><i class="fa-solid fa-xmark"></i> Batal</button>
                            <button type="button" id="btnSimpan" class="btn btn-simpan-pertamina" onclick="saveProfile()" style="display: none;"><i class="fa-solid fa-floppy-disk me-2"></i> Simpan Perubahan</button>
                            <button type="button" id="btnEditTrigger" class="btn-edit-link"><i class="fa-solid fa-pencil mr-1"></i> Edit Informasi</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-security" role="tabpanel">
                <div class="p-4">
                    <div class="mb-4">
                        <h5 class="font-weight-bold">Keamanan Akun</h5>
                        <p class="text-muted small">Disarankan untuk mengganti kata sandi secara berkala untuk menjaga keamanan akun Anda.</p>
                    </div>
                    <form id="securityForm" onsubmit="updatePassword(event)" style="max-width: 100%;">
                        <div class="mb-4">
                            <label class="label-custom">KATA SANDI SAAT INI</label>
                            <div class="input-group-security">
                                <input type="password" id="oldPass" class="form-control input-security-clean" placeholder="••••••••" readonly required>
                                <div class="append-security" style="display: none;">
                                    <span onclick="togglePassword('oldPass')" style="cursor: pointer;"><i class="fa-solid fa-eye" id="icon-oldPass"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="label-custom">KATA SANDI BARU</label>
                                <div class="input-group-security">
                                    <input type="password" id="newPass" class="form-control input-security-clean" placeholder="••••••••" readonly required>
                                    <div class="append-security" style="display: none;">
                                        <span onclick="togglePassword('newPass')" style="cursor: pointer;"><i class="fa-solid fa-eye" id="icon-newPass"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="label-custom">KONFIRMASI PASSWORD</label>
                                <div class="input-group-security">
                                    <input type="password" id="confirmPass" class="form-control input-security-clean" placeholder="••••••••" readonly required>
                                    <div class="append-security" style="display: none;">
                                        <span onclick="togglePassword('confirmPass')" style="cursor: pointer;"><i class="fa-solid fa-eye" id="icon-confirmPass"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-right mt-4">
                            <button type="button" id="btnBatalPassword" class="btn btn-batal-custom mr-2" style="display: none;"><i class="fa-solid fa-xmark"></i> Batal</button>
                            <button type="submit" id="btnSimpanPassword" class="btn btn-simpan-pertamina px-4" style="display: none;"><i class="fa-solid fa-check-circle me-2"></i> Perbarui Kata Sandi</button>
                            <button type="button" id="btnEditPassword" class="btn-edit-link"><i class="fa-solid fa-key mr-1"></i> Ubah Kata Sandi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

</div><!-- /container-fluid -->
</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/Tooltip.js"></script>
<script src="~/js/site.js"></script>
<script>
// ================================================================
// GLOBAL STATE & HELPERS
// ================================================================
var isEditing    = false;
var originalData = "";
var informasiData  = [];
var penelitianData = [];

function getSnapshot() {
    return JSON.stringify({
        nama: $('#inputNama').val(), noHp: $('#inputNoHP').val(), univ: $('#inputUniv').val(),
        old: $('#oldPass').val(), newp: $('#newPass').val(), conf: $('#confirmPass').val()
    });
}
function isDirty() { return isEditing && getSnapshot() !== originalData; }

function forceReset() {
    isEditing = false; originalData = "";
    $('.input-security-clean').prop('readonly', true).css('background-color', '#f8fafc');
    $('#btnSimpan, #btnBatal').hide(); $('#btnEditTrigger').show();
    $('.append-security').hide(); $('#btnSimpanPassword, #btnBatalPassword').hide(); $('#btnEditPassword').show();
}

function _navigatePage(pageId) {
    document.querySelectorAll('.page-section').forEach(function(s) { s.classList.remove('active'); });
    var target = document.getElementById('page-' + pageId);
    if (target) target.classList.add('active');
    document.querySelectorAll('.nav-link-custom').forEach(function(n) { n.classList.remove('active'); });
    var navTarget = document.getElementById('nav-' + pageId);
    if (navTarget) navTarget.classList.add('active');
    localStorage.setItem('lastOpenedPage', pageId);
}

function showPage(pageId) {
    if (isDirty()) {
        Swal.fire({
            title: 'Simpan Perubahan?', text: "Jika pindah, perubahanmu akan hilang.", icon: 'warning',
            showCancelButton: true, confirmButtonColor: '#00549B', confirmButtonText: 'Ya, Pindah', cancelButtonText: 'Tetap di Sini'
        }).then(function(result) {
            if (result.isConfirmed) { forceReset(); _navigatePage(pageId); }
        });
    } else { forceReset(); _navigatePage(pageId); }
}

function toggleSidebar() {
    document.querySelector('.sidebar').classList.toggle('collapsed');
    document.querySelector('.main-content').classList.toggle('expanded');
    document.querySelector('.topbar').classList.toggle('expanded');
}

function togglePassword(inputId) {
    var input = document.getElementById(inputId);
    var icon  = document.getElementById('icon-' + inputId);
    if (input.type === "password") { input.type = "text"; icon.classList.replace('fa-eye', 'fa-eye-slash'); }
    else { input.type = "password"; icon.classList.replace('fa-eye-slash', 'fa-eye'); }
}

function handleLogout() {
    Swal.fire({ title: 'Keluar?', text: "Sesi akan berakhir", icon: 'warning', showCancelButton: true, confirmButtonColor: '#ec1c24', confirmButtonText: 'Logout' })
    .then(function(r) {
        if (r.isConfirmed) { localStorage.removeItem('form_magang_draft'); localStorage.clear(); sessionStorage.clear(); window.location.href = '/Auth/Logout'; }
    });
}

// ================================================================
// TAB SWITCHERS
// ================================================================
function switchRiwayatTab(tab) {
    document.getElementById('riwayat-content-magang').style.display     = tab === 'magang'     ? 'block' : 'none';
    document.getElementById('riwayat-content-penelitian').style.display = tab === 'penelitian' ? 'block' : 'none';
    document.getElementById('rtab-magang').classList.toggle('active-tab',     tab === 'magang');
    document.getElementById('rtab-penelitian').classList.toggle('active-tab', tab === 'penelitian');
    localStorage.setItem('lastRiwayatTab', tab);
}

function switchProgramTab(tab) {
    document.getElementById('program-content-magang').style.display     = tab === 'magang'     ? 'block' : 'none';
    document.getElementById('program-content-penelitian').style.display = tab === 'penelitian' ? 'block' : 'none';
    document.getElementById('ptab-magang').classList.toggle('active-ptab',     tab === 'magang');
    document.getElementById('ptab-penelitian').classList.toggle('active-ptab', tab === 'penelitian');
    localStorage.setItem('lastProgramTab', tab);
    if (tab === 'penelitian' && penelitianData.length === 0) loadPenelitianTersedia();
}

// ================================================================
// FILTER TABEL RIWAYAT
// ================================================================
function filterTabelMagang(status, element) {
    document.querySelectorAll('#riwayat-content-magang [data-color]').forEach(function(card) {
        var c = card.getAttribute('data-color');
        card.style.background = '#fff'; card.style.transform = 'none';
        card.style.border = 'none'; card.style.borderTop = '4px solid ' + c;
    });
    element.style.background  = element.getAttribute('data-color') + '18';
    element.style.transform   = 'translateY(-2px)';
    element.style.borderTop   = '4px solid ' + element.getAttribute('data-color');
    document.querySelectorAll('#tabelBodyRiwayat .baris-magang').forEach(function(row) {
        row.style.display = (status === 'Semua' || row.getAttribute('data-status') === status) ? '' : 'none';
    });
}

function filterTabelPenelitian(status, element) {
    document.querySelectorAll('#riwayat-content-penelitian [data-color]').forEach(function(card) {
        var c = card.getAttribute('data-color');
        card.style.background = '#fff'; card.style.transform = 'none';
        card.style.border = 'none'; card.style.borderTop = '4px solid ' + c;
    });
    element.style.background  = element.getAttribute('data-color') + '18';
    element.style.transform   = 'translateY(-2px)';
    element.style.borderTop   = '4px solid ' + element.getAttribute('data-color');
    document.querySelectorAll('#tabelBodyPenelitian .baris-penelitian').forEach(function(row) {
        var s = row.getAttribute('data-status');
        var match = status === 'Semua' || s === status ||
                    (status === 'Menunggu' && (s === 'Menunggu' || s === 'Dalam Proses'));
        row.style.display = match ? '' : 'none';
    });
}

// ================================================================
// INFORMASI MAGANG
// ================================================================
function loadInformasiTersedia() {
    fetch('/DashboardPeserta/GetInformasiTersedia')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            informasiData = (data || []).map(function(item) {
                var isKPI = (item.region || '').trim() === 'Refinery Unit VI Balongan';
                return Object.assign({}, item, {
                    companyCode: isKPI ? 'KPI' : 'PPN',
                    companyName: isKPI ? 'PT Kilang Pertamina Internasional' : 'PT Pertamina Patra Niaga'
                });
            });
            updateSummaryMagang(informasiData);
            populateCompanyFilter(informasiData, 'filterCompanyInformasi');
            renderGroupedInformasi(informasiData);
            bindInformasiFilterEvents();
        })
        .catch(function() {
            document.getElementById('informasiGroupedContainer').innerHTML =
                '<div class="info-empty-state"><i class="fa fa-circle-exclamation mb-3" style="font-size:32px;"></i><div class="font-weight-bold mb-1">Gagal memuat data lokasi magang</div><div class="small">Silakan coba beberapa saat lagi.</div></div>';
        });
}

function updateSummaryMagang(data) {
    document.getElementById('summaryTotalLokasi').textContent  = data.length;
    document.getElementById('summaryTotalCompany').textContent = new Set(data.map(function(x) { return x.companyCode; })).size;
    document.getElementById('summaryTotalRegion').textContent  = new Set(data.map(function(x) { return x.region; })).size;
}

function populateCompanyFilter(data, selectId) {
    var sel = document.getElementById(selectId);
    if (!sel) return;
    var selected  = sel.value;
    var companies = Array.from(new Set(data.map(function(x) { return x.companyName; }))).sort();
    sel.innerHTML = '<option value="">Semua Company</option>' +
        companies.map(function(x) { return '<option value="' + x + '">' + x + '</option>'; }).join('');
    sel.value = selected;
}

function populateRegionFilter(data, companySelectId, regionSelectId) {
    var cSel = document.getElementById(companySelectId);
    var rSel = document.getElementById(regionSelectId);
    if (!cSel || !rSel) return;
    var selectedCompany = cSel.value;
    var prevRegion = rSel.value;
    if (!selectedCompany) {
        rSel.innerHTML = '<option value="">Pilih company terlebih dahulu</option>';
        rSel.value = ''; rSel.disabled = true; return;
    }
    var regions = Array.from(new Set(data.filter(function(x) { return x.companyName === selectedCompany; }).map(function(x) { return x.region; }))).sort();
    rSel.disabled = false;
    rSel.innerHTML = '<option value="">Semua Regional</option>' +
        regions.map(function(x) { return '<option value="' + x + '">' + x + '</option>'; }).join('');
    rSel.value = regions.indexOf(prevRegion) !== -1 ? prevRegion : '';
}

function resetInformasiFilter() {
    document.getElementById('filterSearchInformasi').value = '';
    document.getElementById('filterCompanyInformasi').value = '';
    populateRegionFilter(informasiData, 'filterCompanyInformasi', 'filterRegionInformasi');
    renderGroupedInformasi(informasiData);
}

function renderGroupedInformasi(data) {
    var container = document.getElementById('informasiGroupedContainer');
    var search    = document.getElementById('filterSearchInformasi').value.toLowerCase().trim();
    var company   = document.getElementById('filterCompanyInformasi').value;
    var region    = document.getElementById('filterRegionInformasi').value;

    var filtered = data.filter(function(item) {
        var matchS = (item.lokasi||'').toLowerCase().includes(search) || (item.region||'').toLowerCase().includes(search) || (item.companyName||'').toLowerCase().includes(search);
        return matchS && (!company || item.companyName === company) && (!region || item.region === region);
    });

    if (!filtered.length) {
        container.innerHTML = '<div class="info-empty-state"><i class="fa fa-folder-open mb-3" style="font-size:32px;"></i><div class="font-weight-bold mb-1">Data tidak ditemukan</div><div class="small">Coba ubah kata kunci pencarian atau filter yang dipilih.</div></div>';
        return;
    }

    var grouped = { KPI: [], PPN: [] };
    filtered.forEach(function(item) { if (item.companyCode === 'KPI') grouped.KPI.push(item); else grouped.PPN.push(item); });

    var meta = {
        KPI: { code: 'KPI', name: 'PT Kilang Pertamina Internasional', labelClass: 'kpi' },
        PPN: { code: 'PPN', name: 'PT Pertamina Patra Niaga',           labelClass: 'ppn' }
    };

    function groupByRegion(items) {
        var m = {};
        items.forEach(function(item) { if (!m[item.region]) m[item.region] = []; m[item.region].push(item); });
        return m;
    }

    function renderCompanyCard(code, items) {
        var byRegion = groupByRegion(items);
        var regionHtml = Object.keys(byRegion).sort().map(function(regionName) {
            var lokasiHtml = byRegion[regionName].map(function(item) {
                return '<div class="info-lokasi-item"><div><div class="info-lokasi-name font-weight-bold" style="color:#334155;">' + item.lokasi + '</div><div class="text-success small d-flex align-items-center" style="font-weight:700;"><i class="fa-solid fa-circle-check mr-1"></i> Terbuka</div></div>' +
                    '<button class="btn btn-sm btn-detail-lokasi" style="background-color:var(--p-blue); color:white; border-radius:20px; font-weight:800; font-size:10px; padding:5px 15px; border:none;" data-lokasi="' + item.lokasi + '" data-region="' + item.region + '" data-company="' + code + '" onclick="showDetailLokasi(this, \'magang\')">DETAIL</button></div>';
            }).join('');
            return '<div class="info-region-card"><div class="info-region-header"><div class="info-region-title font-weight-bold">' + regionName + '</div><div class="info-region-count">' + byRegion[regionName].length + ' lokasi / unit</div></div><div class="info-lokasi-list">' + lokasiHtml + '</div></div>';
        }).join('');

        return '<div class="col-lg-6 mb-4"><div class="info-company-main-card"><div class="info-company-header"><span class="info-company-label ' + meta[code].labelClass + '">' + code + '</span><div class="info-company-name">' + meta[code].name + '</div><div class="info-company-code">Daftar lokasi magang yang sedang membuka pendaftaran</div><div class="info-company-stats"><span class="info-stat-pill"><i class="fa-solid fa-location-dot mr-1"></i>' + items.length + ' lokasi / unit</span><span class="info-stat-pill"><i class="fa-solid fa-map mr-1"></i>' + Object.keys(byRegion).length + ' regional</span><span class="info-stat-pill"><i class="fa-solid fa-circle-check mr-1"></i> Membuka pendaftaran</span></div></div><div class="info-company-body">' + (regionHtml || '<div class="info-empty-state">Belum ada data lokasi yang tampil untuk filter ini.</div>') + '</div></div></div>';
    }

    container.innerHTML = '<div class="row info-company-row">' + renderCompanyCard('KPI', grouped.KPI) + renderCompanyCard('PPN', grouped.PPN) + '</div>';
}

function bindInformasiFilterEvents() {
    var s = document.getElementById('filterSearchInformasi');
    var c = document.getElementById('filterCompanyInformasi');
    var r = document.getElementById('filterRegionInformasi');
    if (!s || !c || !r) return;
    s.oninput  = function() { renderGroupedInformasi(informasiData); };
    c.onchange = function() { populateRegionFilter(informasiData, 'filterCompanyInformasi', 'filterRegionInformasi'); renderGroupedInformasi(informasiData); };
    r.onchange = function() { renderGroupedInformasi(informasiData); };
}

// ================================================================
// INFORMASI PENELITIAN
// ================================================================
function loadPenelitianTersedia() {
    fetch('/DashboardPeserta/GetInformasiTersedia')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            penelitianData = data || [];
            document.getElementById('summaryTotalTopik').textContent             = penelitianData.length;
            document.getElementById('summaryTotalCompanyPenelitian').textContent = new Set(penelitianData.map(function(x) { return x.companyCode; })).size;
            document.getElementById('summaryTotalRegionPenelitian').textContent  = new Set(penelitianData.map(function(x) { return x.region; })).size;
            populateCompanyFilter(penelitianData, 'filterCompanyPenelitian');
            renderGroupedPenelitian(penelitianData);
            bindPenelitianFilterEvents();
        })
        .catch(function() {
            document.getElementById('penelitianGroupedContainer').innerHTML =
                '<div class="info-empty-state"><i class="fa fa-circle-exclamation mb-3" style="font-size:32px;"></i><div class="font-weight-bold mb-1">Gagal memuat data</div></div>';
        });
}

function resetPenelitianFilter() {
    document.getElementById('filterSearchPenelitian').value = '';
    document.getElementById('filterCompanyPenelitian').value = '';
    populateRegionFilter(penelitianData, 'filterCompanyPenelitian', 'filterRegionPenelitian');
    renderGroupedPenelitian(penelitianData);
}

function renderGroupedPenelitian(data) {
    var container = document.getElementById('penelitianGroupedContainer');
    var search    = document.getElementById('filterSearchPenelitian').value.toLowerCase().trim();
    var company   = document.getElementById('filterCompanyPenelitian').value;
    var region    = document.getElementById('filterRegionPenelitian').value;

    var filtered = data.filter(function(item) {
        var matchS = (item.lokasi||'').toLowerCase().includes(search) || (item.region||'').toLowerCase().includes(search) || (item.companyName||'').toLowerCase().includes(search);
        return matchS && (!company || item.companyName === company) && (!region || item.region === region);
    });

    if (!filtered.length) {
        container.innerHTML = '<div class="info-empty-state"><i class="fa fa-folder-open mb-3" style="font-size:32px;"></i><div class="font-weight-bold mb-1">Data tidak ditemukan</div></div>';
        return;
    }

    var grouped = { KPI: [], PPN: [] };
    filtered.forEach(function(item) { if (item.companyCode === 'KPI') grouped.KPI.push(item); else grouped.PPN.push(item); });

    function groupByRegion(items) {
        var m = {};
        items.forEach(function(item) { if (!m[item.region]) m[item.region] = []; m[item.region].push(item); });
        return m;
    }

    function renderCard(code, items, companyName, labelClass) {
        var byRegion = groupByRegion(items);
        var regionHtml = Object.keys(byRegion).sort().map(function(regionName) {
            var lokasiHtml = byRegion[regionName].map(function(item) {
                return '<div class="info-lokasi-item"><div><div class="info-lokasi-name">' + item.lokasi + '</div><div class="small" style="font-weight:700; color:#6366f1;"><i class="fa-solid fa-flask mr-1"></i> Tersedia</div></div>' +
                    '<button class="btn btn-sm" style="background:#6366f1; color:white; border-radius:20px; font-weight:800; font-size:10px; padding:5px 15px; border:none;" data-lokasi="' + item.lokasi + '" data-region="' + item.region + '" data-company="' + code + '" onclick="showDetailLokasi(this, \'penelitian\')">DETAIL</button></div>';
            }).join('');
            return '<div class="info-region-card"><div class="info-region-header"><div class="info-region-title font-weight-bold">' + regionName + '</div><div class="info-region-count">' + byRegion[regionName].length + ' topik</div></div><div class="info-lokasi-list">' + lokasiHtml + '</div></div>';
        }).join('');
        return '<div class="col-lg-6 mb-4"><div class="info-company-main-card penelitian-card"><div class="info-company-header"><span class="info-company-label ' + labelClass + '">' + code + '</span><div class="info-company-name">' + companyName + '</div><div class="info-company-code">Topik penelitian yang tersedia</div><div class="info-company-stats"><span class="info-stat-pill"><i class="fa-solid fa-flask mr-1"></i>' + items.length + ' topik</span><span class="info-stat-pill"><i class="fa-solid fa-map mr-1"></i>' + Object.keys(byRegion).length + ' regional</span></div></div><div class="info-company-body">' + (regionHtml || '<div class="info-empty-state">Belum ada data.</div>') + '</div></div></div>';
    }

    container.innerHTML = '<div class="row info-company-row">' +
        renderCard('KPI', grouped.KPI, 'PT Kilang Pertamina Internasional', 'kpi-penelitian') +
        renderCard('PPN', grouped.PPN, 'PT Pertamina Patra Niaga',           'ppn-penelitian') + '</div>';
}

function bindPenelitianFilterEvents() {
    var s = document.getElementById('filterSearchPenelitian');
    var c = document.getElementById('filterCompanyPenelitian');
    var r = document.getElementById('filterRegionPenelitian');
    if (!s || !c || !r) return;
    s.oninput  = function() { renderGroupedPenelitian(penelitianData); };
    c.onchange = function() { populateRegionFilter(penelitianData, 'filterCompanyPenelitian', 'filterRegionPenelitian'); renderGroupedPenelitian(penelitianData); };
    r.onchange = function() { renderGroupedPenelitian(penelitianData); };
}

// ================================================================
// DETAIL LOKASI MODAL (DINAMIS SINKRON DESKRIPSI)
// ================================================================
function showDetailLokasi(el, jenisProgram) {
    var lokasi       = (el.getAttribute('data-lokasi') || '').trim();
    var region       = el.getAttribute('data-region') || '';
    var company      = el.getAttribute('data-company') || '';
    var isPenelitian = jenisProgram === 'penelitian';

    document.getElementById('modalTitle').innerText    = lokasi;
    document.getElementById('modalSubtitle').innerText = (region ? region + ' — ' : '') + (company === 'KPI' ? 'PT Kilang Pertamina Internasional' : 'PT Pertamina Patra Niaga');

    var icon    = document.getElementById('modalLokasiIcon');
    var btn     = document.getElementById('modalLokasiBtn');
    var descBox = document.getElementById('modalDescriptionContainer');

    // 1️⃣ Ambil deskripsi dasar berdasarkan Company (KPI atau PPN)
    let baseDeskripsi = "";
    if (company === 'KPI') {
        baseDeskripsi = deskripsiPosisi[lokasi] || "Unit operasional pendukung teknis kilang.";
    } else {
        baseDeskripsi = generateDeskripsiPPN(lokasi);
    }

    // 2️⃣ Atur tampilan UI & Format Teks berdasarkan Jenis Program
    if (isPenelitian) {
        icon.innerHTML = '<i class="fa-solid fa-flask" style="font-size:50px; color:#6366f1;"></i>';
        btn.style.backgroundColor = '#6366f1';
        descBox.style.borderColor = '#6366f1';
        descBox.querySelector('h6').style.color = '#6366f1';
        
        // Ubah huruf pertama deskripsi menjadi kecil untuk menyambung prefix penelitian
        var lowerBase = baseDeskripsi.charAt(0).toLowerCase() + baseDeskripsi.slice(1);
        document.getElementById('modalDescriptionText').innerText = 'Penelitian mengenai ' + lowerBase;
    } else {
        icon.innerHTML = '<i class="fa-solid fa-circle-info" style="font-size:50px; color:#00549B;"></i>';
        btn.style.backgroundColor = '#00549B';
        descBox.style.borderColor = '#00549B';
        descBox.querySelector('h6').style.color = '#00549B';
        
        // Tampilkan deskripsi asli untuk program magang
        document.getElementById('modalDescriptionText').innerText = baseDeskripsi;
    }

    $('#modalDetailLokasi').modal('show');
}

// ================================================================
// DETAIL MAGANG (REVIEW)
// ================================================================
function showReviewDetail(id) {
    $.ajax({
        url: '/PendaftaranMagang/GetDetailMagang/' + id,
        type: 'GET',
        success: function(m) {
            // HAPUS baris ini jika tidak mau tambah hidden input:
            // document.getElementById('d-magang-id').value = id;

            document.getElementById('d-nama').innerText       = m.nama || '-';
            document.getElementById('d-email').innerText      = m.email || '-';
            document.getElementById('d-univ').innerText       = m.univ || '-';
            document.getElementById('d-nim').innerText        = m.nim || '-';
            document.getElementById('d-jurusan').innerText    = m.jurusan || '-';
            document.getElementById('d-fakultas').innerText   = m.fakultas || '-';
            document.getElementById('d-company').innerText    = m.company || '-';
            document.getElementById('d-lokasi').innerText     = m.lokasi || '-';
            document.getElementById('d-tempat').innerText     = m.tempatLahir || '-';
            document.getElementById('d-tgl-lahir').innerText  = m.tglLahir || '-';
            document.getElementById('d-created-at').innerText = m.createdAtFormatted || '-';
            document.getElementById('d-periode').innerText    = (m.tglMulai || '-') + ' s/d ' + (m.tglSelesai || '-');
            document.getElementById('d-foto').src             = m.fotoProfil || '/img/default-user.png';
            document.getElementById('link-cv').href           = m.pathCV      || '#';
            document.getElementById('link-surat').href        = m.pathSurat   || '#';
            document.getElementById('link-proposal').href     = m.pathProposal || '#';

            var hpElem = document.getElementById('d-hp-link');
            if (m.wa) {
                hpElem.innerText = m.wa;
                hpElem.href = 'https://wa.me/' + m.wa.replace(/[^0-9]/g, '');
            } else {
                hpElem.innerText = '-';
            }
            var igElem = document.getElementById('d-ig-link');
            if (m.instagram) {
                igElem.innerText = m.instagram;
                igElem.href = 'https://instagram.com/' + m.instagram.replace(String.fromCharCode(64), '');
            } else {
                igElem.innerText = '-';
            }

            var sClass = m.status === 'Diterima' ? 'bg-light-green' :
                         m.status === 'Ditolak'  ? 'bg-light-red'   : 'bg-light-orange';
            document.getElementById('d-status-badge-container').innerHTML =
                '<span class="status-pill-modal ' + sClass + '">' + m.status + '</span>';

            $('#modalDetail').modal('show');
        },
        error: function(xhr) {
            console.log('Error:', xhr.responseText);
            Swal.fire('Error', 'Data tidak ditemukan', 'error');
        }
    });
}
// ================================================================
// DETAIL PENELITIAN
// ================================================================
function showDetailPenelitian(id) {
    $.ajax({
        url: '/Penelitian/GetDetail/' + id,
        type: 'GET',
        success: function(m) {
            document.getElementById('dp-nama').innerText       = m.nama || '-';
            document.getElementById('dp-email').innerText      = m.email || '-';
            document.getElementById('dp-univ').innerText       = m.universitas || '-';
            document.getElementById('dp-nim').innerText        = m.nim || '-';
            document.getElementById('dp-jurusan').innerText    = m.jurusan || '-';
            document.getElementById('dp-fakultas').innerText   = m.fakultas || '-';
            document.getElementById('dp-company').innerText    = m.company || '-';
            document.getElementById('dp-lokasi').innerText     = m.lokasiPenelitian || '-';
            document.getElementById('dp-judul').innerText      = m.judulPenelitian || '-';
            document.getElementById('dp-tempat').innerText     = m.tempatLahir || '-';
            document.getElementById('dp-tgl-lahir').innerText  = m.tglLahir || '-';
            document.getElementById('dp-created-at').innerText = m.createdAtFormatted || '-';
            document.getElementById('dp-periode').innerText    = (m.tglMulai || '-') + ' s/d ' + (m.tglSelesai || '-');
            document.getElementById('dp-foto').src             = m.pathFoto || '/img/default-user.png';
            document.getElementById('dp-link-cv').href         = m.pathCV      || '#';
            document.getElementById('dp-link-surat').href      = m.pathSurat   || '#';
            document.getElementById('dp-link-proposal').href   = m.pathProposal || '#';

            var hpEl = document.getElementById('dp-hp');
            hpEl.innerText = m.noHp || '-';
            if (m.noHp) hpEl.href = 'https://wa.me/' + m.noHp.replace(/[^0-9]/g, '');

            var igEl = document.getElementById('dp-ig');
            igEl.innerText = m.instagram || '-';
            if (m.instagram) igEl.href = 'https://instagram.com/' + m.instagram.replace(String.fromCharCode(64), '');

            var sClass = m.status === 'Diterima' ? 'bg-light-green' : 
                         m.status === 'Ditolak'  ? 'bg-light-red'   : 'bg-light-orange';
            document.getElementById('dp-status-badge').innerHTML = 
                '<span class="status-pill-modal ' + sClass + '">' + (m.status || 'Menunggu') + '</span>';

            // Bootstrap 4
            $('#modalDetailPenelitian').modal('show');
        },
        error: function(xhr) {
            console.log('Status:', xhr.status);
            console.log('Response:', xhr.responseText);
            Swal.fire('Error', 'Data penelitian tidak ditemukan', 'error');
        }
    });
}



function previewNamaFile(input, targetId) {
    var el = document.getElementById(targetId);
    if (input.files && input.files[0]) { el.innerText = input.files[0].name; el.style.color = '#00549B'; el.style.fontWeight = '700'; }
}


// ================================================================
// PROFIL
// ================================================================
function saveProfile() {
    Swal.fire({ title: 'Menyimpan...', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    $.ajax({
        url: '/DashboardPeserta/UpdateProfil', type: 'POST',
        data: { nama: $('#inputNama').val(), noHp: $('#inputNoHP').val(), univ: $('#inputUniv').val() },
        success: function(res) {
            if (res.success) Swal.fire('Berhasil', 'Profil diperbarui!', 'success').then(function() { forceReset(); $('.font-weight-bold.mb-1').text($('#inputNama').val()); });
            else Swal.fire('Gagal', res.message, 'error');
        },
        error: function() { Swal.fire('Error', 'Gagal tersambung ke server', 'error'); }
    });
}

function updatePassword(e) {
    e.preventDefault();
    var oldP = $('#oldPass').val(), newP = $('#newPass').val(), confirmP = $('#confirmPass').val();
    if (!oldP || !newP || !confirmP) { Swal.fire('Opps!', 'Semua kolom password wajib diisi.', 'warning'); return; }
    if (newP !== confirmP) { Swal.fire('Error', 'Konfirmasi password tidak cocok!', 'error'); return; }
    Swal.fire({ title: 'Memproses...', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    $.ajax({
        url: '/DashboardPeserta/UpdatePassword', type: 'POST',
        data: { oldPass: oldP, newPass: newP, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
        success: function(res) {
            if (res.success) { Swal.fire('Berhasil!', 'Password diperbarui.', 'success'); $('#securityForm')[0].reset(); forceReset(); }
            else Swal.fire('Gagal!', res.message, 'error');
        },
        error: function(xhr) { console.log(xhr.responseText); Swal.fire('Error!', 'Terjadi kesalahan sistem.', 'error'); }
    });
}

function uploadFoto(input) {
    if (!input.files || !input.files[0]) return;
    var file = input.files[0];
    if (file.size > 2 * 1024 * 1024) { Swal.fire('Opps!', 'Ukuran file terlalu besar (Max 2MB)', 'error'); input.value = ''; return; }
    var formData = new FormData();
    formData.append('fotoProfil', file);
    $.ajax({
        url: '/DashboardPeserta/UpdateFoto', type: 'POST', data: formData, processData: false, contentType: false,
        success: function(res) {
            if (res.success) {
                var newPath = res.filePath + '?t=' + new Date().getTime();
                if ($('#imgPreview').length) $('#imgPreview').attr('src', newPath);
                else $('#avatarContainer').html('<img src="' + newPath + '" id="imgPreview" style="width:100%; height:100%; object-fit:cover;">');
                $('#navbarAvatar').attr('src', newPath);
                Swal.fire({ icon: 'success', title: 'Berhasil!', text: 'Foto profil diperbarui.', timer: 1500, showConfirmButton: false });
            } else Swal.fire('Gagal!', res.message, 'error');
        },
        error: function() { Swal.fire('Error!', 'Gagal menghubungi server.', 'error'); }
    });
}

function deletePhoto() {
    Swal.fire({ title: 'Hapus foto?', text: 'Foto profil akan dihapus.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Ya, Hapus' })
    .then(function(result) {
        if (result.isConfirmed) $.post('/DashboardPeserta/DeleteFoto', function(res) { if (res.success) location.reload(); });
    });
}

function viewPhoto() {
    var photoUrl = $('#imgPreview').attr('src');
    if (!photoUrl) { Swal.fire('Info', 'Anda belum mengunggah foto profil.', 'info'); return; }
    Swal.fire({ imageUrl: photoUrl, imageAlt: 'Foto Profil', showCloseButton: true, showConfirmButton: false, background: '#fff' });
}

// ================================================================
// NOTIFIKASI
// ================================================================
function loadNotifications() {
    $.get('/Notification/GetUserNotifications', function(data) {
        var html = '';
        if (!data || data.length === 0) {
            $('#notifList').html('<div class="p-4 text-center text-muted"><i class="fa fa-bell-slash mb-2" style="font-size:28px; opacity:0.3;"></i><div class="small">Tidak ada notifikasi</div></div>');
            return;
        }
        data.forEach(function(n) {
            var iconHtml = '', borderColor = '';
            if (n.type === 'success') {
                iconHtml = '<div style="width:36px;height:36px;border-radius:10px;background:#dcfce7;display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;"><i class="fa fa-check text-success" style="font-size:14px;"></i></div>';
                borderColor = 'border-left: 3px solid #22c55e;';
            } else if (n.type === 'error') {
                iconHtml = '<div style="width:36px;height:36px;border-radius:10px;background:#fee2e2;display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;"><i class="fa fa-times text-danger" style="font-size:14px;"></i></div>';
                borderColor = 'border-left: 3px solid #ef4444;';
            } else if (n.type === 'new') {
                iconHtml = '<div style="width:36px;height:36px;border-radius:10px;background:#dbeafe;display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;"><i class="fa fa-paper-plane text-primary" style="font-size:14px;"></i></div>';
                borderColor = 'border-left: 3px solid #3b82f6;';
            } else {
                iconHtml = '<div style="width:36px;height:36px;border-radius:10px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;"><i class="fa fa-bell text-muted" style="font-size:14px;"></i></div>';
                borderColor = 'border-left: 3px solid #94a3b8;';
            }
            var unreadBg = n.isRead ? 'background:#fff;' : 'background:#f0f7ff;';
            var dotHtml  = n.isRead ? '' : '<span style="width:8px;height:8px;background:#00549B;border-radius:50%;flex-shrink:0;margin-left:8px;display:inline-block;"></span>';
            html += '<a href="/Notification/GoTo/' + n.id + '" class="d-flex align-items-start text-decoration-none" style="padding:12px 16px; border-bottom:1px solid #f1f5f9; ' + unreadBg + ' ' + borderColor + ' transition:background 0.2s;">' + iconHtml + '<div style="flex:1; min-width:0;"><div style="font-size:13px;font-weight:700;color:#1e293b;line-height:1.3;">' + n.title + '</div><div style="font-size:12px;color:#64748b;margin-top:2px;line-height:1.4;">' + n.message + '</div><div style="font-size:10px;color:#94a3b8;margin-top:4px;"><i class="fa fa-clock mr-1"></i>' + n.timeAgo + '</div></div>' + dotHtml + '</a>';
        });
        $('#notifList').html(html);
    }).fail(function() {
        $('#notifList').html('<div class="p-3 text-center text-muted small">Gagal memuat notifikasi.</div>');
    });
}

function loadUnreadCount() {
    $.get('/Notification/UnreadCount', function(count) {
        if (count > 0) $('#notifBadge').text(count).show(); else $('#notifBadge').hide();
    });
}

// ================================================================
// INIT
// ================================================================
loadInformasiTersedia();
loadUnreadCount();

$(document).ready(function() {
    loadNotifications();
    loadUnreadCount();

    setInterval(function() { loadUnreadCount(); loadNotifications(); }, 5000);

    $('#markAllReadBtn').on('click', function(e) {
        e.preventDefault();
        $.ajax({
            url: '/DashboardPeserta/MarkAllRead', type: 'POST',
            success: function() { $('#notifBadge').hide().text(''); loadNotifications(); },
            error: function(xhr) { console.log('Status:', xhr.status); Swal.fire('Error ' + xhr.status, xhr.responseText, 'error'); }
        });
    });

    // Navigasi awal
    var params      = new URLSearchParams(window.location.search);
    var tabFromUrl  = params.get('tab');
    var highlightId = params.get('highlight');

    if (tabFromUrl) { showPage(tabFromUrl); localStorage.setItem('lastOpenedPage', tabFromUrl); }
    else { showPage(localStorage.getItem('lastOpenedPage') || 'dashboard'); }

    // Restore sub-tab riwayat
    var lastRTab = localStorage.getItem('lastRiwayatTab') || 'magang';
    switchRiwayatTab(lastRTab);

    // Restore sub-tab program
    var lastPTab = localStorage.getItem('lastProgramTab') || 'magang';
    switchProgramTab(lastPTab);

    if (highlightId) {
        setTimeout(function() {
            var targetRow = document.querySelector('tr[data-id="' + highlightId + '"]');
            if (targetRow) { targetRow.scrollIntoView({ behavior: 'smooth', block: 'center' }); targetRow.classList.add('highlight-row'); }
        }, 450);
    }

    // Profile tabs
    var activeTab = localStorage.getItem('activeProfileTab');
    if (activeTab) $('#' + activeTab).tab('show');
    $('a[data-toggle="tab"]').on('shown.bs.tab', function(e) { localStorage.setItem('activeProfileTab', $(e.target).attr('id')); });

    $('#profileTab a').on('click', function(e) {
        if (isDirty()) {
            e.preventDefault();
            var targetTab = $(this);
            Swal.fire({
                title: 'Data Belum Disimpan', text: "Jika pindah tab, perubahan ketikanmu akan hilang.", icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#00549B', confirmButtonText: 'Ya, Pindah', cancelButtonText: 'Tetap di Sini'
            }).then(function(result) { if (result.isConfirmed) { forceReset(); targetTab.tab('show'); } });
        } else { forceReset(); }
    });

    // Edit Profil
    $('#btnEditTrigger').on('click', function() {
        isEditing = true; originalData = getSnapshot();
        $('.input-security-clean').not('#inputEmail, #oldPass, #newPass, #confirmPass').prop('readonly', false).css('background-color', '#fff');
        $(this).hide(); $('#btnSimpan, #btnBatal').fadeIn(300);
    });

    // Edit Password
    $('#btnEditPassword').on('click', function() {
        isEditing = true; originalData = getSnapshot();
        $('#oldPass, #newPass, #confirmPass').prop('readonly', false).css('background-color', '#fff');
        $('.append-security').fadeIn(); $(this).hide(); $('#btnSimpanPassword, #btnBatalPassword').fadeIn(300);
    });

    // Input focus effect
    $('.input-security-clean, .input-custom').on('focus', function() {
        if ($(this).prop('readonly') === false) {
            $(this).closest('.input-group-security').css({ 'border-color': '#00529C', 'box-shadow': '0 0 0 3px rgba(0, 82, 156, 0.1)' });
        }
    }).on('blur', function() {
        $(this).closest('.input-group-security').css({ 'border-color': '#e2e8f0', 'box-shadow': 'none' });
    });

    // Batal
    $('#btnBatal, #btnBatalPassword').on('click', function() { forceReset(); });
});
</script>

</body>
</html>
