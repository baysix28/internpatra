@model IEnumerable<sinta_asp.Models.Mahasiswa>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manajemen Pendaftaran | SINTA";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">

<style>
    :root {
        --primary: #00549B;
        --primary-light: #e6f0f8;
        --primary-gradient: linear-gradient(135deg, #00549B 0%, #0086D6 100%);
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-400: #94a3b8;
        --slate-600: #475569;
        --slate-900: #0f172a;
        --radius-lg: 20px;
        --radius-md: 12px;
        --radius-sm: 8px;
        --shadow-sm: 0 4px 12px rgba(0, 84, 155, 0.08);
        --shadow-md: 0 8px 32px rgba(0, 84, 155, 0.12);
        --shadow-lg: 0 16px 48px rgba(0, 84, 155, 0.16);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f7ff 100%);
        color: var(--slate-900);
        min-height: 100vh;
    }

    /* Animations */
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes slideInRight {
        from { transform: translateX(30px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }

    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(0, 84, 155, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(0, 84, 155, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 84, 155, 0); }
    }

    /* Main Container */
    .admin-container {
        padding: 2.5rem 2rem;
        max-width: 1600px;
        margin: 0 auto;
        animation: fadeIn 0.6s ease-out;
    }

    /* Header dengan Statistik Cards */
    .header-section {
        background: white;
        border-radius: var(--radius-lg);
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--slate-100);
        animation: slideInRight 0.5s ease-out;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: var(--radius-md);
        padding: 1.5rem;
        border: 1px solid var(--slate-100);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--primary);
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
    }

    .stat-card.pending::before { background: var(--warning); }
    .stat-card.approved::before { background: var(--success); }
    .stat-card.rejected::before { background: var(--danger); }
    .stat-card.total::before { background: var(--primary); }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.5rem;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--slate-600);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .stat-change {
        font-size: 0.75rem;
        color: var(--slate-400);
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.5rem;
    }

    .stat-change.positive { color: var(--success); }
    .stat-change.negative { color: var(--danger); }

    /* Advanced Search & Filters */
    .advanced-search-card {
        background: white;
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--slate-100);
    }

    .filter-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .filter-tag {
        background: var(--primary-light);
        color: var(--primary);
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid var(--primary);
    }

    .filter-tag .remove-filter {
        cursor: pointer;
        opacity: 0.7;
        transition: opacity 0.2s;
    }

    .filter-tag .remove-filter:hover {
        opacity: 1;
    }

    /* Enhanced Search Bar */
    .search-input-group {
        position: relative;
        width: 100%;
    }

    .search-input-group i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--slate-400);
        z-index: 2;
    }

    .search-input-group input {
        width: 100%;
        padding: 0.875rem 1rem 0.875rem 3rem;
        border-radius: var(--radius-md);
        border: 2px solid var(--slate-200);
        background: white;
        font-size: 0.875rem;
        transition: all 0.3s;
        font-weight: 500;
    }

    .search-input-group input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px var(--primary-light);
        outline: none;
    }

    /* Action Buttons Modern */
    .btn-primary-modern {
        background: var(--primary-gradient);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: var(--shadow-sm);
    }

    .btn-primary-modern:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        color: white;
    }

    .btn-secondary-modern {
        background: white;
        color: var(--slate-600);
        border: 2px solid var(--slate-200);
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-secondary-modern:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-light);
        transform: translateY(-1px);
    }

    /* Enhanced Table */
    .custom-card {
        background: white;
        border-radius: var(--radius-lg);
        border: 1px solid var(--slate-100);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        animation: fadeIn 0.6s ease-out 0.2s both;
    }

    .table-modern {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-modern thead {
        background: linear-gradient(135deg, var(--primary) 0%, #0086D6 100%);
    }

    .table-modern thead th {
        padding: 1.25rem 1.5rem;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: white;
        border: none;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .table-modern tbody tr {
        transition: all 0.3s ease;
        border-bottom: 1px solid var(--slate-100);
    }

    .table-modern tbody tr:hover {
        background: linear-gradient(90deg, rgba(0, 84, 155, 0.02) 0%, rgba(0, 134, 214, 0.02) 100%);
        transform: scale(1.002);
        box-shadow: var(--shadow-sm);
    }

    .table-modern td {
        padding: 1.25rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--slate-100);
        font-size: 0.875rem;
    }

    /* Enhanced Status Badges */
    .badge-status {
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: 2px solid;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: all 0.3s;
    }

    .badge-status:hover {
        transform: scale(1.05);
    }

    .status-approve { 
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        color: white;
        border-color: #10b981;
        animation: pulse 2s infinite;
    }

    .status-pending { 
        background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
        color: white;
        border-color: #f59e0b;
    }

    .status-reject { 
        background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
        color: white;
        border-color: #ef4444;
    }

    /* Enhanced Avatar */
    .avatar-wrapper {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .avatar-img {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        object-fit: cover;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 1.25rem;
        box-shadow: var(--shadow-sm);
    }

    /* Action Buttons with Dropdown */
    .action-buttons {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        justify-content: center;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: 2px solid var(--slate-200);
        background: white;
        color: var(--slate-600);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-sm);
    }

    .btn-action.view:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-light); }
    .btn-action.edit:hover { border-color: var(--warning); color: var(--warning); background: #fffbeb; }
    .btn-action.delete:hover { border-color: var(--danger); color: var(--danger); background: #fef2f2; }

    /* Quick Actions Bar */
    .quick-actions-bar {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        background: white;
        border-radius: var(--radius-lg);
        padding: 1rem;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--slate-100);
        z-index: 1000;
        display: flex;
        gap: 0.5rem;
        animation: slideInRight 0.5s ease-out;
    }

    /* Bulk Actions Panel */
    .bulk-actions-panel {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        background: white;
        border-radius: var(--radius-lg);
        padding: 1rem 1.5rem;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--slate-100);
        z-index: 1001;
        display: none;
        align-items: center;
        gap: 1rem;
        animation: fadeIn 0.3s ease-out;
    }

    /* Modal Styles */
    .modal-custom {
        border-radius: var(--radius-lg);
        border: none;
        box-shadow: var(--shadow-lg);
    }

    .modal-custom .modal-header {
        background: var(--primary-gradient);
        color: white;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: 1.5rem 2rem;
        border: none;
    }

    .modal-custom .modal-body {
        padding: 2rem;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .admin-container {
            padding: 1rem;
        }
        
        .stats-grid {
            grid-template-columns: 1fr;
        }
        
        .table-modern {
            display: block;
            overflow-x: auto;
        }
        
        .quick-actions-bar {
            bottom: 1rem;
            right: 1rem;
        }
    }

    /* Loading Skeleton */
    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        border-radius: var(--radius-sm);
    }

    @@keyframes loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>

<div class="admin-container">
    <!-- Header with Stats -->
    <div class="header-section">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-4">
            <div>
                <h1 class="fw-800 mb-2" style="font-size: 2.5rem; letter-spacing: -1.5px; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Registrations Management
                </h1>
                <p class="text-muted mb-0 fs-5">Kelola dan monitor seluruh pendaftaran mahasiswa dengan kontrol penuh</p>
            </div>
            <div class="d-flex gap-2 mt-3 mt-md-0">
                <button class="btn-primary-modern" onclick="showBulkActions()">
                    <i class="fas fa-layer-group"></i> Bulk Actions
                </button>
                <button class="btn-secondary-modern" data-bs-toggle="modal" data-bs-target="#importModal">
                    <i class="fas fa-file-import"></i> Import
                </button>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card total">
                <div class="stat-value" id="totalRegistrations">@Model?.Count()</div>
                <div class="stat-label">Total Pendaftar</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> 12% dari bulan lalu
                </div>
            </div>
            <div class="stat-card pending">
                <div class="stat-value" id="pendingCount">@Model?.Count(m => m.Status == "Pending")</div>
                <div class="stat-label">Menunggu Review</div>
                <div class="stat-change positive">
                    <i class="fas fa-clock"></i> Butuh perhatian
                </div>
            </div>
            <div class="stat-card approved">
                <div class="stat-value" id="approvedCount">@Model?.Count(m => m.Status == "Diterima")</div>
                <div class="stat-label">Diterima</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> 8% meningkat
                </div>
            </div>
            <div class="stat-card rejected">
                <div class="stat-value" id="rejectedCount">@Model?.Count(m => m.Status == "Ditolak")</div>
                <div class="stat-label">Ditolak</div>
                <div class="stat-change">
                    <i class="fas fa-minus"></i> Stabil
                </div>
            </div>
        </div>
    </div>

    <!-- Advanced Search & Filters -->
    <div class="advanced-search-card">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <div class="search-input-group" style="flex: 1;">
                <i class="fas fa-search"></i>
                <input type="text" id="customSearch" placeholder="Cari nama, NIM, email, universitas, atau jurusan...">
            </div>
            <div class="d-flex gap-2">
                <button class="btn-secondary-modern" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                    <i class="fas fa-sliders-h"></i> Advanced Filters
                </button>
                <button class="btn-secondary-modern" onclick="resetFilters()">
                    <i class="fas fa-redo"></i> Reset
                </button>
            </div>
        </div>

        <div class="collapse" id="advancedFilters">
            <div class="row g-3 mt-3">
                <div class="col-md-3">
                    <label class="form-label small fw-600">Status</label>
                    <select class="form-select" id="statusFilter" multiple>
                        <option value="Diterima">Diterima</option>
                        <option value="Pending">Pending</option>
                        <option value="Ditolak">Ditolak</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-600">Kategori</label>
                    <select class="form-select" id="categoryFilter" multiple>
                        <option value="Magang">Magang</option>
                        <option value="Penelitian">Penelitian</option>
                        <option value="KKN">KKN</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-600">Tanggal Pendaftaran</label>
                    <input type="text" class="form-control" id="dateRangeFilter" placeholder="Pilih rentang tanggal">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-600">Universitas</label>
                    <select class="form-select" id="universityFilter">
                        <option value="">Semua Universitas</option>
                        <!-- Options will be populated dynamically -->
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button class="btn-primary-modern" onclick="applyFilters()">
                    <i class="fas fa-check"></i> Terapkan Filter
                </button>
            </div>
        </div>

        <div class="filter-tags" id="activeFilters"></div>
    </div>

    <!-- Main Table -->
    <div class="custom-card">
        <div class="table-responsive position-relative">
            <table class="table-modern" id="registrationTable">
                <thead>
                    <tr>
                        <th width="50">
                            <input type="checkbox" class="form-check-input" id="selectAll">
                        </th>
                        <th>Mahasiswa</th>
                        <th>Institusi & Prodi</th>
                        <th>Kategori & Periode</th>
                        <th>Status</th>
                        <th>Tanggal Mulai</th>
                        <th class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr data-id="@item.Id">
                                <td>
                                    <input type="checkbox" class="form-check-input row-checkbox" value="@item.Id">
                                </td>
                                <td>
                                    <div class="avatar-wrapper">
                                        <div class="avatar-img">
                                            @item.NamaLengkap?.Substring(0, 1)
                                        </div>
                                        <div>
                                            <div class="name-bold">@item.NamaLengkap</div>
                                            <div class="email-sub">@item.Email</div>
                                            <div class="small text-muted">NIM: @item.NIM</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-700 text-dark">@item.NamaKampus</div>
                                    <div class="text-muted small">@item.Fakultas - @item.Jurusan</div>
                                    <div class="badge bg-primary bg-opacity-10 text-primary small mt-1">
                                        @item.Jurusan
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-600" style="color: var(--primary);">
                                        <i class="fas fa-tag me-1"></i> @item.TipePendaftaran
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fas fa-map-marker-alt me-1"></i> @item.Lokasi
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fas fa-building me-1"></i> @item.Company
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var s = item.Status ?? "Pending";
                                        var (cls, icon) = s switch {
                                            "Diterima" => ("status-approve", "fa-check-circle"),
                                            "Ditolak" => ("status-reject", "fa-times-circle"),
                                            _ => ("status-pending", "fa-hourglass-half")
                                        };
                                    }
                                    <span class="badge-status @cls">
                                        <i class="fas @icon"></i> @s
                                    </span>
                                </td>
                                <td>
                                    @if (item.TanggalMulai.HasValue)
                                    {
                                        <div class="small fw-600">@item.TanggalMulai?.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted x-small">@item.TanggalMulai?.ToString("HH:mm")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <a href="/Admin/Mahasiswa/Details/@item.Id" class="btn-action view" title="Detail">
                                            <i class="far fa-eye"></i>
                                        </a>
                                        <a href="/Admin/Mahasiswa/Edit/@item.Id" class="btn-action edit" title="Edit">
                                            <i class="far fa-edit"></i>
                                        </a>
                                        <button class="btn-action delete" onclick="deleteRegistration('@item.Id')" title="Hapus">
                                            <i class="far fa-trash-alt"></i>
                                        </button>
                                        <div class="dropdown d-inline-block">
                                            <button class="btn-action" type="button" data-bs-toggle="dropdown" title="Lainnya">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick="changeStatus('@item.Id', 'Diterima')">
                                                        <i class="fas fa-check text-success me-2"></i> Terima
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick="changeStatus('@item.Id', 'Ditolak')">
                                                        <i class="fas fa-times text-danger me-2"></i> Tolak
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick="sendEmail('@item.Email')">
                                                        <i class="fas fa-envelope text-primary me-2"></i> Kirim Email
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="#" onclick="deleteRegistration('@item.Id')">
                                                        <i class="fas fa-trash me-2"></i> Hapus Permanen
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="text-center py-5">
                                    <div class="mb-4">
                                        <i class="fas fa-clipboard-list fa-4x text-muted opacity-25"></i>
                                    </div>
                                    <h5 class="fw-700 text-dark mb-2">Belum ada data pendaftaran</h5>
                                    <p class="text-muted mb-4">Data mahasiswa yang mendaftar akan muncul di sini secara otomatis.</p>
                                    <button class="btn-primary-modern" onclick="location.reload()">
                                        <i class="fas fa-sync-alt me-2"></i> Refresh Halaman
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-4 border-top bg-light">
            <div class="mb-3 mb-md-0">
                <span class="text-muted small" id="selectedCount">0 item dipilih</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">Tampilkan:</span>
                    <select class="form-select form-select-sm w-auto" id="pageLength">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div id="paginationInfo" class="text-muted small"></div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions Bar -->
<div class="quick-actions-bar">
    <button class="btn-action view" onclick="exportToExcel()" title="Export Excel">
        <i class="fas fa-file-excel"></i>
    </button>
    <button class="btn-action edit" onclick="exportToPDF()" title="Export PDF">
        <i class="fas fa-file-pdf"></i>
    </button>
    <button class="btn-action delete" onclick="printTable()" title="Print">
        <i class="fas fa-print"></i>
    </button>
    <button class="btn-primary-modern btn-sm" onclick="showQuickStats()" title="Statistik Cepat">
        <i class="fas fa-chart-bar"></i>
    </button>
</div>

<!-- Bulk Actions Panel -->
<div class="bulk-actions-panel" id="bulkActionsPanel">
    <span class="fw-600" id="bulkSelectionCount">0 item dipilih</span>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-success" onclick="bulkApprove()">
            <i class="fas fa-check me-1"></i> Terima
        </button>
        <button class="btn btn-sm btn-danger" onclick="bulkReject()">
            <i class="fas fa-times me-1"></i> Tolak
        </button>
        <button class="btn btn-sm btn-warning" onclick="bulkSendEmail()">
            <i class="fas fa-envelope me-1"></i> Email
        </button>
        <button class="btn btn-sm btn-outline-danger" onclick="clearSelection()">
            <i class="fas fa-times me-1"></i> Batal
        </button>
    </div>
</div>

<!-- Import Modal -->
<div class="modal fade modal-custom" id="importModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-file-import me-2"></i> Import Data Pendaftaran</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <i class="fas fa-file-excel fa-3x text-success mb-3"></i>
                    <h5 class="fw-700">Upload File Excel</h5>
                    <p class="text-muted">Unggah file Excel dengan format yang sesuai untuk mengimpor data pendaftaran</p>
                </div>
                
                <div class="border-dashed p-5 text-center mb-4" id="dropZone">
                    <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-3"></i>
                    <p class="mb-2">Drag & drop file Excel di sini</p>
                    <p class="text-muted small mb-3">Atau klik untuk memilih file</p>
                    <input type="file" id="fileInput" accept=".xlsx,.xls" class="d-none">
                    <button class="btn-primary-modern btn-sm" onclick="document.getElementById('fileInput').click()">
                        <i class="fas fa-folder-open me-2"></i> Pilih File
                    </button>
                </div>
                
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Format yang didukung:</strong> .xlsx, .xls
                    <br>
                    <small>Pastikan file memiliki kolom yang sesuai dengan struktur database.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-modern" data-bs-dismiss="modal">Batal</button>
                <button type="button" class="btn-primary-modern" onclick="processImport()">
                    <i class="fas fa-upload me-2"></i> Import Data
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Quick Stats Modal -->
<div class="modal fade modal-custom" id="statsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-chart-pie me-2"></i> Statistik Pendaftaran</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <canvas id="statsChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize DataTable with enhanced options
            var table = $('#registrationTable').DataTable({
                "dom": 'rt<"d-flex justify-content-between align-items-center p-4"ip>',
                "pageLength": 10,
                "ordering": true,
                "order": [[5, 'desc']],
                "language": {
                    "info": "Menampilkan _START_ sampai _END_ dari _TOTAL_ data",
                    "infoEmpty": "Menampilkan 0 sampai 0 dari 0 data",
                    "infoFiltered": "(disaring dari _MAX_ total data)",
                    "lengthMenu": "Tampilkan _MENU_ data",
                    "search": "Cari:",
                    "paginate": {
                        "first": "«",
                        "last": "»",
                        "next": "›",
                        "previous": "‹"
                    }
                },
                "drawCallback": function(settings) {
                    updatePaginationInfo();
                    updateSelectionCount();
                }
            });

            // Initialize Flatpickr for date range
            flatpickr("#dateRangeFilter", {
                mode: "range",
                dateFormat: "Y-m-d",
                locale: "id"
            });

            // Initialize Select2 for multi-select filters
            $('#statusFilter, #categoryFilter').select2({
                placeholder: "Pilih filter",
                width: '100%'
            });

            // Search functionality
            $('#customSearch').on('keyup', function() {
                table.search(this.value).draw();
            });

            // Page length change
            $('#pageLength').on('change', function() {
                table.page.len(this.value).draw();
            });

            // Row selection
            $('#selectAll').on('change', function() {
                $('.row-checkbox').prop('checked', this.checked);
                updateSelectionCount();
                toggleBulkActionsPanel();
            });

            $('.row-checkbox').on('change', function() {
                updateSelectionCount();
                toggleBulkActionsPanel();
            });

            // Initialize drag and drop for import
            initializeDragAndDrop();
            
            // Populate university filter with unique values
            populateUniversityFilter();
        });

        function populateUniversityFilter() {
            const universities = [...new Set(@Html.Raw(Json.Serialize(Model?.Select(m => m.NamaKampus).Distinct())))];
            const select = $('#universityFilter');
            
            universities.forEach(univ => {
                if (univ) {
                    select.append(new Option(univ, univ));
                }
            });
        }

        function updatePaginationInfo() {
            var info = $('#registrationTable').DataTable().page.info();
            $('#paginationInfo').text(`Halaman ${info.page + 1} dari ${info.pages}`);
        }

        function updateSelectionCount() {
            var selected = $('.row-checkbox:checked').length;
            $('#selectedCount').text(`${selected} item dipilih`);
            $('#bulkSelectionCount').text(`${selected} item dipilih`);
        }

        function toggleBulkActionsPanel() {
            var selected = $('.row-checkbox:checked').length;
            if (selected > 0) {
                $('#bulkActionsPanel').show();
            } else {
                $('#bulkActionsPanel').hide();
            }
        }

        function showBulkActions() {
            $('.row-checkbox').prop('checked', true);
            updateSelectionCount();
            toggleBulkActionsPanel();
        }

        function clearSelection() {
            $('.row-checkbox').prop('checked', false);
            $('#selectAll').prop('checked', false);
            updateSelectionCount();
            toggleBulkActionsPanel();
        }

        function bulkApprove() {
            var selected = $('.row-checkbox:checked').map(function() {
                return $(this).val();
            }).get();
            
            Swal.fire({
                title: 'Terima Pendaftaran?',
                text: `Anda akan menerima ${selected.length} pendaftaran`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Ya, Terima',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    // AJAX call to approve
                    $.ajax({
                        url: '/Admin/Mahasiswa/BulkApprove',
                        method: 'POST',
                        data: { ids: selected },
                        success: function(response) {
                            Swal.fire('Berhasil!', 'Pendaftaran telah diterima', 'success');
                            location.reload();
                        },
                        error: function() {
                            Swal.fire('Error!', 'Terjadi kesalahan saat memproses', 'error');
                        }
                    });
                }
            });
        }

        function bulkReject() {
            var selected = $('.row-checkbox:checked').map(function() {
                return $(this).val();
            }).get();
            
            Swal.fire({
                title: 'Tolak Pendaftaran?',
                text: `Anda akan menolak ${selected.length} pendaftaran`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Ya, Tolak',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    // AJAX call to reject
                    $.ajax({
                        url: '/Admin/Mahasiswa/BulkReject',
                        method: 'POST',
                        data: { ids: selected },
                        success: function(response) {
                            Swal.fire('Berhasil!', 'Pendaftaran telah ditolak', 'success');
                            location.reload();
                        },
                        error: function() {
                            Swal.fire('Error!', 'Terjadi kesalahan saat memproses', 'error');
                        }
                    });
                }
            });
        }

        function bulkSendEmail() {
            var selected = $('.row-checkbox:checked').map(function() {
                return $(this).val();
            }).get();
            
            Swal.fire({
                title: 'Kirim Email',
                input: 'textarea',
                inputLabel: 'Isi pesan email untuk semua penerima',
                inputPlaceholder: 'Tulis pesan anda di sini...',
                showCancelButton: true,
                confirmButtonText: 'Kirim',
                cancelButtonText: 'Batal',
                inputAttributes: {
                    'rows': 5
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // AJAX call to send emails
                    $.ajax({
                        url: '/Admin/Mahasiswa/BulkSendEmail',
                        method: 'POST',
                        data: { 
                            ids: selected,
                            message: result.value 
                        },
                        success: function(response) {
                            Swal.fire('Berhasil!', 'Email telah dikirim', 'success');
                        },
                        error: function() {
                            Swal.fire('Error!', 'Terjadi kesalahan saat mengirim email', 'error');
                        }
                    });
                }
            });
        }

        function changeStatus(id, status) {
            Swal.fire({
                title: 'Ubah Status?',
                text: `Ubah status menjadi "${status}"?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Ya, Ubah',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/Mahasiswa/ChangeStatus',
                        method: 'POST',
                        data: { id: id, status: status },
                        success: function(response) {
                            Swal.fire('Berhasil!', 'Status telah diubah', 'success');
                            location.reload();
                        },
                        error: function() {
                            Swal.fire('Error!', 'Terjadi kesalahan saat mengubah status', 'error');
                        }
                    });
                }
            });
        }

        function deleteRegistration(id) {
            Swal.fire({
                title: 'Hapus Pendaftaran?',
                text: "Data yang dihapus tidak dapat dikembalikan!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Ya, Hapus',
                cancelButtonText: 'Batal',
                confirmButtonColor: '#d33'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/Mahasiswa/Delete/' + id,
                        method: 'POST',
                        success: function(response) {
                            Swal.fire('Terhapus!', 'Data telah dihapus', 'success');
                            location.reload();
                        },
                        error: function() {
                            Swal.fire('Error!', 'Terjadi kesalahan saat menghapus', 'error');
                        }
                    });
                }
            });
        }

        function sendEmail(email) {
            Swal.fire({
                title: 'Kirim Email',
                input: 'textarea',
                inputLabel: `Email akan dikirim ke: ${email}`,
                inputPlaceholder: 'Tulis pesan anda di sini...',
                showCancelButton: true,
                confirmButtonText: 'Kirim',
                cancelButtonText: 'Batal',
                inputAttributes: {
                    'rows': 5
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/Mahasiswa/SendEmail',
                        method: 'POST',
                        data: { 
                            email: email,
                            message: result.value 
                        },
                        success: function(response) {
                            Swal.fire('Berhasil!', 'Email telah dikirim', 'success');
                        },
                        error: function() {
                            Swal.fire('Error!', 'Terjadi kesalahan saat mengirim email', 'error');
                        }
                    });
                }
            });
        }

        function initializeDragAndDrop() {
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');

            if (dropZone) {
                dropZone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    dropZone.style.borderColor = 'var(--primary)';
                    dropZone.style.backgroundColor = 'var(--primary-light)';
                });

                dropZone.addEventListener('dragleave', (e) => {
                    e.preventDefault();
                    dropZone.style.borderColor = '';
                    dropZone.style.backgroundColor = '';
                });

                dropZone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    dropZone.style.borderColor = '';
                    dropZone.style.backgroundColor = '';
                    
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        handleFile(files[0]);
                    }
                });
            }

            if (fileInput) {
                fileInput.addEventListener('change', (e) => {
                    if (e.target.files.length > 0) {
                        handleFile(e.target.files[0]);
                    }
                });
            }
        }

        function handleFile(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                    const jsonData = XLSX.utils.sheet_to_json(firstSheet);
                    
                    // Preview data
                    previewImportData(jsonData.slice(0, 5));
                } catch (error) {
                    Swal.fire('Error!', 'Format file tidak valid', 'error');
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function previewImportData(data) {
            let html = '<table class="table table-sm"><thead><tr>';
            if (data.length > 0) {
                Object.keys(data[0]).forEach(key => {
                    html += `<th>${key}</th>`;
                });
                html += '</tr></thead><tbody>';
                
                data.forEach(row => {
                    html += '<tr>';
                    Object.values(row).forEach(value => {
                        html += `<td>${value}</td>`;
                    });
                    html += '</tr>';
                });
                html += '</tbody></table>';
                
                Swal.fire({
                    title: 'Preview Data',
                    html: html,
                    showCancelButton: true,
                    confirmButtonText: 'Import',
                    cancelButtonText: 'Batal',
                    width: '800px'
                }).then((result) => {
                    if (result.isConfirmed) {
                        processImport(data);
                    }
                });
            }
        }

        function processImport(data) {
            // Show loading
            Swal.fire({
                title: 'Mengimport data...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // AJAX call to import data
            $.ajax({
                url: '/Admin/Mahasiswa/Import',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response) {
                    Swal.fire('Berhasil!', 'Data berhasil diimport', 'success');
                    $('#importModal').modal('hide');
                    location.reload();
                },
                error: function() {
                    Swal.fire('Error!', 'Terjadi kesalahan saat mengimport data', 'error');
                }
            });
        }

        function exportToExcel() {
            // Get table data
            const table = document.getElementById('registrationTable');
            const workbook = XLSX.utils.table_to_book(table, {sheet: "Sheet1"});
            XLSX.writeFile(workbook, `pendaftaran-${new Date().toISOString().split('T')[0]}.xlsx`);
        }

        function exportToPDF() {
            Swal.fire({
                title: 'Export ke PDF',
                text: 'Sedang membuat dokumen PDF...',
                icon: 'info',
                timer: 2000,
                showConfirmButton: false
            });
        }

        function printTable() {
            window.print();
        }

        function showQuickStats() {
            // Create chart data
            const ctx = document.getElementById('statsChart').getContext('2d');
            
            // Destroy existing chart if exists
            const existingChart = Chart.getChart('statsChart');
            if (existingChart) {
                existingChart.destroy();
            }
            
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Diterima', 'Pending', 'Ditolak'],
                    datasets: [{
                        data: [
                            $('#approvedCount').text(),
                            $('#pendingCount').text(),
                            $('#rejectedCount').text()
                        ],
                        backgroundColor: [
                            '#10b981',
                            '#f59e0b',
                            '#ef4444'
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                        }
                    }
                }
            });
            
            $('#statsModal').modal('show');
        }

        function applyFilters() {
            const status = $('#statusFilter').val();
            const category = $('#categoryFilter').val();
            const dateRange = $('#dateRangeFilter').val();
            const university = $('#universityFilter').val();
            
            // Update active filters display
            updateActiveFilters(status, category, dateRange, university);
            
            // Apply filters to DataTable
            const table = $('#registrationTable').DataTable();
            
            // Reset all filters first
            $.fn.dataTable.ext.search = [];
            
            // Add custom filters
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    const rowStatus = data[4]?.toLowerCase();
                    const rowCategory = data[3]?.toLowerCase();
                    const rowUniversity = data[2]?.toLowerCase();
                    
                    let statusMatch = true;
                    let categoryMatch = true;
                    let universityMatch = true;
                    
                    if (status && status.length > 0) {
                        statusMatch = status.some(s => rowStatus?.includes(s.toLowerCase()));
                    }
                    
                    if (category && category.length > 0) {
                        categoryMatch = category.some(c => rowCategory?.includes(c.toLowerCase()));
                    }
                    
                    if (university) {
                        universityMatch = rowUniversity?.includes(university.toLowerCase());
                    }
                    
                    return statusMatch && categoryMatch && universityMatch;
                }
            );
            
            table.draw();
        }

        function updateActiveFilters(status, category, dateRange, university) {
            const container = $('#activeFilters');
            container.empty();
            
            if (status && status.length > 0) {
                status.forEach(s => {
                    container.append(`
                        <span class="filter-tag">
                            Status: ${s}
                            <i class="fas fa-times remove-filter" onclick="removeFilter('status', '${s}')"></i>
                        </span>
                    `);
                });
            }
            
            if (category && category.length > 0) {
                category.forEach(c => {
                    container.append(`
                        <span class="filter-tag">
                            Kategori: ${c}
                            <i class="fas fa-times remove-filter" onclick="removeFilter('category', '${c}')"></i>
                        </span>
                    `);
                });
            }
            
            if (university) {
                container.append(`
                    <span class="filter-tag">
                        Universitas: ${university}
                        <i class="fas fa-times remove-filter" onclick="removeFilter('university', '${university}')"></i>
                    </span>
                `);
            }
        }

        function resetFilters() {
            $('#statusFilter').val(null).trigger('change');
            $('#categoryFilter').val(null).trigger('change');
            $('#dateRangeFilter').val('');
            $('#universityFilter').val('');
            
            $('#activeFilters').empty();
            
            // Reset DataTable filters
            $.fn.dataTable.ext.search = [];
            $('#registrationTable').DataTable().draw();
            
            Swal.fire('Reset!', 'Semua filter telah direset', 'success');
        }

        function removeFilter(type, value) {
            if (type === 'status') {
                const current = $('#statusFilter').val();
                $('#statusFilter').val(current.filter(v => v !== value)).trigger('change');
            } else if (type === 'category') {
                const current = $('#categoryFilter').val();
                $('#categoryFilter').val(current.filter(v => v !== value)).trigger('change');
            } else if (type === 'university') {
                $('#universityFilter').val('');
            }
            
            applyFilters();
        }
    </script>
}