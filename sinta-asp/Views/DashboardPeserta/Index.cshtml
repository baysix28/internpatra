                            <a href="javascript:void(0)" onclick="showPage('riwayat')" class="text-primary small font-weight-bold">Lihat detail →</a>
                        </div>
                    </div>
                </div> *@
                
                @* <div class="col-md-6 col-lg-5 mb-4">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <small class="text-muted font-weight-bold text-uppercase" style="font-size: 10px;">Status Verifikasi Data</small>
                            <button onclick="showPage('profil')" class="btn btn-link p-0 text-primary font-weight-bold" style="font-size: 11px; text-decoration: none;">
                                Lengkapi <i class="fa-solid fa-chevron-right ml-1"></i>
                            </button>
                        </div>
                        <div class="d-flex align-items-baseline mt-2">
                            <h4 class="font-weight-bold mb-0 mr-2" style="font-size: 1.5rem;">60%</h4>
                            <span class="status-badge status-review" style="font-size: 10px;">Belum Lengkap</span>
                        </div>
                        <div class="mt-3">
                            <div class="progress" style="height: 6px; border-radius: 10px; background-color: #f1f5f9;">
                                <div class="progress-bar" role="progressbar" style="width: 60%; background-color: var(--p-blue);"></div>
                            </div>
                            <p class="text-muted mt-2 mb-0" style="font-size: 10.5px;">Lengkapi profil Anda untuk verifikasi.</p>
                        </div>
                    </div>
                </div> *@
            </div>
        </div>
        <div id="page-riwayat" class="page-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="font-weight-bold" style="color: var(--p-blue);">Riwayat Pengajuan Magang</h4>
                    <p class="text-muted small">Pantau status pengajuan magang industri Anda.</p>
                </div>
                <button class="btn btn-primary px-4 shadow-sm" style="border-radius:10px; background: var(--p-blue); font-size: 14px;" onclick="window.location.href='/PendaftaranMagang/DataMagang'">
                    <i class="fa fa-plus mr-2"></i> Daftar Magang Baru
                </button>
            </div>

            <div class="glass-card p-0 overflow-hidden">
                <table class="table table-hover mb-0" style="table-layout: fixed; font-size: 13.5px;">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 px-4 text-secondary" style="width: 10%; font-weight: 600;">Company</th>
                            <th class="border-0 text-secondary" style="width: 25%; font-weight: 600;">Region</th>
                            <th class="border-0 text-secondary" style="width: 25%; font-weight: 600;">Posisi</th>
                            <th class="border-0 text-secondary text-center" style="width: 15%; font-weight: 600;">Tanggal</th>
                            <th class="border-0 text-secondary text-center" style="width: 15%; font-weight: 600;">Status</th>
                            <th class="border-0 text-secondary text-center" style="width: 10%; font-weight: 600;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RiwayatMagang != null) {
                            foreach (var item in ViewBag.RiwayatMagang) {
                                <tr>
                                    <td class="px-4 font-weight-bold" style="color: var(--p-blue);">@item.Company</td>
                                    
                                    <td style="color: #333;">@item.Region</td>
                                    <td style="color: #333;">@item.Lokasi</td>
                                    <td class="text-center" style="color: #333;">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                    
                                    <td class="text-center">
                                        @{
                                            var statusClass = item.Status == "Diterima" ? "status-success" : 
                                                            item.Status == "Ditolak" ? "status-danger" : 
                                                            "status-review";
                                        }
                                        <span class="status-badge @statusClass" style="display: inline-block; min-width: 80px; font-size: 11px; padding: 3px 8px; font-weight: 600;">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary" 
                                                style="border-radius: 8px; font-size: 11px; font-weight: bold; padding: 2px 10px;"
                                                onclick="showReviewDetail('@item.Id')">
                                            Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        } else {
                            <tr><td colspan="6" class="text-center py-5">Belum ada data.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="modalDetail" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header-premium">
                        <div class="header-flex-container">
                            <img id="d-foto" src="/img/default-user.png" class="profile-circle-frame" title="Klik untuk lihat foto asli" onclick="window.open(this.src, '_blank')">
                            <div class="header-text-info">
                                <div id="d-status-badge-container"></div>
                                <h2 id="d-nama" class="mb-1 fw-bold"></h2>
                                <span class="opacity-75 small"><i class="fas fa-clock me-1"></i> Terdaftar: <span id="d-created-at"></span></span>
                            </div>
                        </div>
                    </div>
                    <div class="detail-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="mb-2 px-2 fw-bold text-secondary" style="font-size:12px;"><i class="fas fa-id-card me-2"></i>KONTAK & PRIBADI</div>
                                <div class="info-card-premium">
                                    <div class="info-label">Email</div><div id="d-email" class="info-value"></div>
                                    <div class="info-label">WhatsApp</div><div class="info-value"><a id="d-hp-link" target="_blank" class="text-decoration-none"></a></div>
                                    <div class="info-label">Instagram</div><div class="info-value"><a id="d-ig-link" target="_blank" class="text-decoration-none" style="color: var(--p-blue);"></a></div>
                                    <div class="info-label">Tempat, Tgl Lahir</div><div class="info-value"><span id="d-tempat"></span>, <span id="d-tgl-lahir"></span></div>
                                </div>
                            </div>
                            <div class="col-md-4">
