<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="penelitian-wrapper">
    <header class="hero-section">
        <div class="hero-overlay"></div>

        <div class="container hero-content">
            
            <h1 class="hero-title">RESEARCH & INNOVATION</h1>
            
            <p class="hero-lead">Empowering the future of energy through your brilliant ideas.</p>
            
            <div class="d-flex justify-content-center align-items-center gap-3">
                <a asp-controller="Penelitian" asp-action="Daftar" class="btn-apply-hero">
                    DAFTAR SEKARANG
                </a>
            </div>
    </header>
    <div class="main-container" id="area-lowongan">
    
            <h2 class="animasi-naik" style="
                text-align: center; 
                font-family: 'Poppins', sans-serif;   
                font-size: 2.2rem;                 
                font-weight: 700;
                
                /* GANTI JADI WARNA INI (Abu Tua kehitaman) */
                color: #1e293b; 
                
                margin-bottom: 10px; /* Jarak ke sub-judul dirapatkan */
                letter-spacing: -0.5px;
                line-height: 1.2;
            ">
                Eksplorasi Peluang Riset & Inovasi
            </h2>

            <p class="animasi-naik" style="
                text-align: center;
                font-family: 'Inter', sans-serif;
                color: #64748b; /* Abu medium */
                margin-bottom: 45px;
                font-size: 1rem;
            ">
                Filter berdasarkan perusahaan atau wilayah kerja pilihan Anda
            </p>
        
        <div class="job-board-layout">

            
            <aside class="filters animasi-naik">
                <a href="..." style="
                    font-size: 0.8rem; 
                    color: #94a3b8;  
                    text-decoration: none; 
                    font-weight: 600; 
                    display: inline-block; 
                    margin-bottom: 20px;
                ">
                     Clear filters
                </a>

                <form onsubmit="return false;" style="width: 100%;">
                    <input type="hidden" name="lastScroll" id="lastScrollInput" value="" />

                    <div style="margin-bottom: 25px;">
                        <div style="font-size: 0.75rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; font-family: 'Inter', sans-serif;">
                            Can't find what you looking for?
                        </div>
                        <div class="search-wrapper">
                            <input type="text" id="inputCari" name="search" class="form-control" placeholder="Search..." autocomplete="off" value="@selectedSearch" style="font-size: 0.9rem;"> 
                            <i class="fas fa-search"></i>
                        </div>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <div style="font-size: 0.75rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; font-family: 'Inter', sans-serif;">
                            Filtered by Company
                        </div>

                        @{
                            // KITA BUAT VARIABEL DULU DI SINI BIAR HTML-NYA BERSIH
                            // Ini solusi ampuh biar ga error RZ1034
                            bool isAll = (selectedCompany == "All");
                            bool isKPI = (selectedCompany == "PT Kilang Pertamina Internasional (KPI)");
                            bool isPatra = (selectedCompany == "PT Pertamina Patra Niaga");
                        }

                        <select name="company" id="companySelect" class="form-control-custom" onchange="onCompanyChange()" style="font-size: 0.9rem;">
                            
                            <option value="All" selected="@isAll">
                                All Companies
                            </option>

                            <option value="PT Kilang Pertamina Internasional (KPI)" selected="@isKPI">
                                PT Kilang Pertamina Internasional (KPI)
                            </option>

                            <option value="PT Pertamina Patra Niaga" selected="@isPatra">
                                PT Pertamina Patra Niaga (C&T)
                            </option>

                        </select>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <div style="font-size: 0.75rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; font-family: 'Inter', sans-serif;">
                            By Region
                        </div>

                        <select name="region" id="regionSelect" class="form-control-custom" onchange="refreshData()" style="font-size: 0.9rem;">
                        </select>
                    </div>
                </form>
            </aside>

            <main id="area-konten">
               @if (Model.Lowongan == null || Model.Lowongan.Count == 0)
                {
                    <div style="text-align:center; padding: 60px; color:#999; border: 2px dashed #eee; border-radius:15px; background-color:#fafafa;">
                        <i class="fas fa-search fa-3x" style="margin-bottom:15px; color:#ddd;"></i>
                        <h3>Tidak Ada Lowongan</h3>
                        <p>Coba ubah filter atau kata kunci pencarian Anda.</p>
                    </div>
                }
                else
                {
                    <div class="row" id="containerKartu">
                        @foreach (var item in Model.Lowongan)
                        {
                            /* --- AREA CODE (Tanpa @{ ... }) --- */
                            /* Langsung tulis variabel C# di sini karena sudah di dalam foreach */
                            
                            string iconFileName = "workplace.png"; 
                            string textCheck = ((item.Title ?? "") + " " + (item.Region ?? "")).ToLower();

                            // 1. AVIATION
                            if (textCheck.Contains("aft") || textCheck.Contains("dppu") || textCheck.Contains("aviation")) 
                            { iconFileName = "airplane.png"; }
                            // 2. MINYAK & GAS
                            else if (textCheck.Contains("fuel") || textCheck.Contains("integrated") || textCheck.Contains("terminal") || textCheck.Contains("kilang")) 
                            { iconFileName = "gas.png"; }
                            // 3. KEUANGAN
                            else if (textCheck.Contains("finance") || textCheck.Contains("sales") || textCheck.Contains("marketing") || 
                                    textCheck.Contains("procurement") || textCheck.Contains("akuntansi") || textCheck.Contains("ekonomi") || textCheck.Contains("bisnis")) 
                            { iconFileName = "budget.png"; }
                            // 4. IT
                            else if (textCheck.Contains("ict") || textCheck.Contains("system") || textCheck.Contains("komputer") || textCheck.Contains("informatika")) 
                            { iconFileName = "computer.png"; }
                            // 5. SAFETY
                            else if (textCheck.Contains("medical") || textCheck.Contains("hsse") || textCheck.Contains("legal") || textCheck.Contains("risk")) 
                            { iconFileName = "labour.png"; }


                            /* --- AREA HTML (Otomatis deteksi saat ada tag <div...) --- */
                            <div class="col-12 col-md-6 col-lg-3 item-lowongan">
                                <div class="flip-card">
                                    <div class="flip-card-inner">
                                        
                                        <div class="flip-card-front">
    
                                            <div class="logo-corner">
                                                <img src="~/img/logo-pertaminaa.png">
                                            </div>

                                            <div class="card-icon-area" style="justify-content: flex-start !important;">
                                                <img src="~/img/icons/@iconFileName" class="category-icon" alt="icon" width="50" />
                                            </div>

                                            <div class="card-detail-area">
                                                <div class="split-title">@item.Title</div>
                                                
                                                <hr style="border: 0; height: 1px; background-color: rgba(255,255,255,0.3); margin: 8px 0; width: 100%;">

                                                <div class="split-info">
                                                    <span style="color: #ffffff; font-weight: 700; font-size: 0.85rem; font-family: 'Inter', sans-serif;">
                                                        @item.Region
                                                    </span>
                                                </div>

                                                <div class="split-info">
                                                    @if (item.Company != null && item.Company.Contains("Kilang"))
                                                    {
                                                        <span style="color: rgba(255, 255, 255, 0.8); font-weight: 400; font-size: 0.8rem;"> PT Kilang Pertamina Internasional</span>
                                                    }
                                                    else if (item.Company != null && item.Company.Contains("Patra"))
                                                    {
                                                        <span style="color: rgba(255, 255, 255, 0.8); font-weight: 400; font-size: 0.8rem;"> PT Pertamina Patra Niaga</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: rgba(255, 255, 255, 0.8); font-weight: 400; font-size: 0.8rem;">
                                                            @item.Company
                                                        </span>
                                                    }
                                                </div>
                                                <div class="split-info" style="margin-top: 8px;">
                                                    <span class="badge" style="background-color: #00A950; color: white; padding: 4px 10px; border-radius: 50px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.5px;">
                                                        <i class="fas fa-check-circle"></i> AVAILABLE
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flip-card-back">
                                            <h6 class="back-title" style="color: #003B76;">Detail Fungsi</h6>
                                            <p class="back-desc">@item.Description</p>
                                            <a asp-action="Daftar" 
                                            asp-route-preCompany="@item.Company" 
                                            asp-route-preRegion="@item.Region"
                                            asp-route-preTargetLokasi="@item.Title"   
                                            asp-route-preTargetJurusan="@item.Title"
                                            class="btn-card-clean"
                                            style="
                                                background-color: #003B76;  !important; 
                                                color: #ffffff !important; 
                                                border: 1px solid #003B76 !important;
                                            ">
                                            Pilih Fungsi
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div id="pesanKosong" style="display: none; text-align: center; padding: 40px; margin-top: 20px; color: #666;">
                        <i class="fas fa-search" style="font-size: 3rem; color: #ddd; margin-bottom: 15px;"></i>
                        <h3>Yah, nggak ketemu...</h3>
                        <p>Coba cari pakai kata kunci lain ya.</p>
                    </div>
                }

                @if (Model.TotalPages > 0)
                {
                    <div class="pagination-wrapper-flat">
                        <nav aria-label="Page navigation">
                            <ul class="pagination-flat">
                                
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link-flat page-link" 
                                    asp-action="Index" 
                                    asp-route-page="@(Model.CurrentPage - 1)"
                                    asp-route-search="@ViewData["SelectedSearch"]"
                                    asp-route-company="@ViewData["SelectedCompany"]"
                                    asp-route-region="@ViewData["SelectedRegion"]"
                                    aria-label="Previous">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link-flat page-link" 
                                        asp-action="Index" 
                                        asp-route-page="@i"
                                        asp-route-search="@ViewData["SelectedSearch"]"
                                        asp-route-company="@ViewData["SelectedCompany"]"
                                        asp-route-region="@ViewData["SelectedRegion"]">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link-flat page-link" 
                                    asp-action="Index" 
                                    asp-route-page="@(Model.CurrentPage + 1)"
                                    asp-route-search="@ViewData["SelectedSearch"]"
                                    asp-route-company="@ViewData["SelectedCompany"]"
                                    asp-route-region="@ViewData["SelectedRegion"]"
                                    aria-label="Next">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }

            </main>
        </div>
    </div>
</div>
<script>
    // ==========================================
    // BAGIAN 1: DATA & LOGIKA TAMPILAN (LOGIKA ASLI 100%)
    // ==========================================
    const dataRegion = {
        "PT Pertamina Patra Niaga": ["Regional Jatimbalinus", "Regional Jawa Bagian Tengah", "Regional Jawa Bagian Barat", "Regional Kalimantan", "Regional Maluku Papua", "Regional Sumbagut"],
        "PT Kilang Pertamina Internasional (KPI)": ["Refinery Unit VI Balongan"]
    };

    function updateRegionOptions() {
        const companySelect = document.getElementById('companySelect');
        const regionSelect = document.getElementById('regionSelect');
        const selectedCompany = companySelect.value;
        const currentRegion = regionSelect.value || '@ViewData["SelectedRegion"]' || "All"; 

        regionSelect.innerHTML = '';

        // Logika KPI (Balongan Only) vs Lainnya
        if (selectedCompany !== "PT Kilang Pertamina Internasional (KPI)") {
            const allOption = document.createElement('option');
            allOption.value = "All";
            allOption.text = "All Regions";
            regionSelect.appendChild(allOption);
        }

        if (selectedCompany && dataRegion[selectedCompany]) {
            dataRegion[selectedCompany].forEach(reg => {
                const option = document.createElement('option');
                option.value = reg; option.text = reg;
                regionSelect.appendChild(option);
            });
        }
        
        // Cek dulu, ini KPI bukan?
        if (selectedCompany === "PT Kilang Pertamina Internasional (KPI)") {
            regionSelect.selectedIndex = 0; 
        } else {
            // Kalau bukan KPI, baru jalankan logic lama
            Array.from(regionSelect.options).forEach(opt => {
                if (opt.value === currentRegion) regionSelect.value = currentRegion;
            });
        }
    }

    // ==========================================
    // BAGIAN 2: LOGIKA AJAX (LOGIKA ASLI + SISIPAN ANIMASI)
    // ==========================================

    // 1. FUNGSI INTI (LOAD DATA)
    function loadDataTanpaReload(customUrl = null) {
        const valSearch = document.getElementById('inputCari').value;
        const valCompany = document.getElementById('companySelect').value;
        const valRegion = document.getElementById('regionSelect').value;

        let url = customUrl;
        if (!url) {
            url = `/Penelitian/Index?search=${encodeURIComponent(valSearch)}&company=${encodeURIComponent(valCompany)}&region=${encodeURIComponent(valRegion)}&page=1`;
        }

        // Efek Loading
        const searchIcon = document.querySelector('.fa-search');
        if (searchIcon) {
            searchIcon.classList.remove('fa-search');
            searchIcon.classList.add('fa-circle-notch', 'fa-spin'); 
        }

        fetch(url)
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const kontenBaru = doc.getElementById('area-konten');
                const areaLama = document.getElementById('area-konten');
                
                if (areaLama && kontenBaru) {
                    areaLama.innerHTML = kontenBaru.innerHTML;
                    window.history.pushState({}, '', url);
                    
                    pasangEventPagination();
                    
                    // --- SISIPAN 1: Panggil Animasi Kartu setelah data masuk ---
                    jalankanAnimasiKartu(); 
                    // -----------------------------------------------------------
                }
            })
            .catch(err => console.error('Error:', err))
            .finally(() => {
                if (searchIcon) {
                    searchIcon.classList.remove('fa-circle-notch', 'fa-spin');
                    searchIcon.classList.add('fa-search');
                }
            });
    }

    // 2. TRIGGER DARI HTML
    window.onCompanyChange = function() { 
        document.getElementById('regionSelect').value = "All"; 
        updateRegionOptions(); 
        loadDataTanpaReload(); 
    };
    window.gantiCompany = window.onCompanyChange;

    window.refreshData = function() {
        loadDataTanpaReload();
    };

    window.submitFilter = function() { 
        loadDataTanpaReload(); 
    };

    // 3. PAGINATION HANDLING
    function pasangEventPagination() {
        const links = document.querySelectorAll('.page-link');
        links.forEach(link => {
            const newLink = link.cloneNode(true);
            link.parentNode.replaceChild(newLink, link);
            newLink.addEventListener('click', function(e) {
                e.preventDefault();
                const href = this.getAttribute('href');
                if (href && href !== '#') loadDataTanpaReload(href);
            });
        });
    }

    // ==========================================
    // BAGIAN 3: SETUP AWAL & SEMUA ANIMASI
    // ==========================================
    document.addEventListener("DOMContentLoaded", function() {
        // Init Fungsi Asli
        updateRegionOptions();
        pasangEventPagination();

        // Init Live Search
        const inputCari = document.getElementById('inputCari');
        if (inputCari) {
            let timeout = null;
            inputCari.addEventListener('input', function() {
                clearTimeout(timeout);
                timeout = setTimeout(function() { loadDataTanpaReload(); }, 300);
            });
            inputCari.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') { e.preventDefault(); loadDataTanpaReload(); }
            });
        }
        
        // --- JALANKAN SEMUA ANIMASI ---
        jalankanAnimasiContainer();    // <--- INI YANG BARU
        jalankanAnimasiKartu();
        jalankanAnimasiJudulFilter();
        jalankanAnimasiHero();
    });

    // =========================================================
    // FUNGSI ANIMASI BOLAK-BALIK (REPLAY)
    // =========================================================

    // 1. ANIMASI MAIN CONTAINER (BARU)
    function jalankanAnimasiContainer() {
        const container = document.querySelector('.main-container');
        if (!container) return;

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // Kelihatan -> Muncul (Naik)
                    entry.target.classList.add('muncul-container');
                } else {
                    // Gak Kelihatan (Scroll ke atas banget) -> Hilang
                    // Biar pas turun lagi, dia animasi lagi
                    entry.target.classList.remove('muncul-container');
                }
            });
        }, { threshold: 0.01 }); // 1% kelihatan langsung gas

        observer.observe(container);
    }

    // 2. ANIMASI KARTU LOWONGAN
    function jalankanAnimasiKartu() {
        const semuaKartu = document.querySelectorAll('.item-lowongan');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('muncul-boss');
                } else {
                    entry.target.classList.remove('muncul-boss');
                }
            });
        }, { threshold: 0.1 }); 
        semuaKartu.forEach(kartu => observer.observe(kartu));
    }

    // 3. ANIMASI JUDUL & FILTER
    function jalankanAnimasiJudulFilter() {
        const elemen = document.querySelectorAll('.animasi-naik');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('kelihatan');
                } else {
                    entry.target.classList.remove('kelihatan');
                }
            });
        }, { threshold: 0.1 });
        elemen.forEach(el => observer.observe(el));
    }

    // 4. ANIMASI HERO
    function jalankanAnimasiHero() {
        const elemenAnimasi = document.querySelectorAll('.hero-title, .hero-lead, .btn-apply-hero');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animasi-aktif');
                } else {
                    entry.target.classList.remove('animasi-aktif');
                }
            });
        }, { threshold: 0.1 });
        elemenAnimasi.forEach(el => observer.observe(el));
    }
</script>