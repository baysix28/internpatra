</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function showReviewDetail(id) {
        $.ajax({
            url: '/PendaftaranMagang/GetDetailMagang/' + id,
            type: 'GET',
            success: function (m) {
                // Mapping data dasar
                document.getElementById('d-nama').innerText = m.nama || '-';
                document.getElementById('d-email').innerText = m.email || '-';
                
                // WhatsApp Link (Ganti template literals ke string biasa)
                const hpElem = document.getElementById('d-hp-link');
                if(m.wa) {
                    var cleanWa = m.wa.replace(/[^0-9]/g, '');
                    hpElem.innerText = m.wa;
                    hpElem.href = 'https://wa.me/' + cleanWa;
                } else {
                    hpElem.innerText = '-';
                }

                // Instagram Link
                const igElem = document.getElementById('d-ig-link');
                if(m.instagram) {
                    var cleanIg = m.instagram.replace('@@', ''); 
                    igElem.innerText = m.instagram;
                    igElem.href = 'https://instagram.com/' + cleanIg;
                } else {
                    igElem.innerText = '-';
                }

                document.getElementById('d-univ').innerText = m.univ || '-';
                document.getElementById('d-nim').innerText = m.nim || '-';
                document.getElementById('d-jurusan').innerText = m.jurusan || '-';
                document.getElementById('d-fakultas').innerText = m.fakultas || '-';
                document.getElementById('d-company').innerText = m.company || '-';
                document.getElementById('d-lokasi').innerText = m.lokasi || '-';
                document.getElementById('d-tempat').innerText = m.tempatLahir || '-';
                document.getElementById('d-tgl-lahir').innerText = m.tglLahir || '-';
                document.getElementById('d-created-at').innerText = m.createdAtFormatted || '-';
                
                // Gabungkan string tanpa backtick
                document.getElementById('d-periode').innerText = m.tglMulai + ' s/d ' + m.tglSelesai;
                
                // Files & Photo
                document.getElementById('d-foto').src = m.fotoProfil || '/img/default-user.png';
                document.getElementById('link-cv').href = m.pathCV || '#';
                document.getElementById('link-surat').href = m.pathSurat || '#';
                document.getElementById('link-proposal').href = m.pathProposal || '#';

                // Status Badge (Hindari backtick di sini)
                const sClass = m.status === 'Diterima' ? 'bg-light-green' : (m.status === 'Ditolak' ? 'bg-light-red' : 'bg-light-orange');
                document.getElementById('d-status-badge-container').innerHTML = '<span class="status-pill-modal ' + sClass + '">' + m.status + '</span>';
                
                // Show Modal
                var myModal = new bootstrap.Modal(document.getElementById('modalDetail'));
                myModal.show();
            },
            error: function() {
                alert('Data tidak ditemukan');
            }
        });
    }

    function loadNotifications() {
        $.get('/DashboardPeserta/GetNotifications', function(data) {
            let html = '';
            if(data.length === 0) {
                html = '<div class="text-center p-4">Tidak ada notifikasi</div>';
            } else {
                data.forEach(n => {
                    html += `
                    <div class="list-group-item list-group-item-action border-0 mb-2 shadow-sm rounded ${n.isRead ? '' : 'bg-light'}">
                        <div class="d-flex align-items-center">
                            <div class="mr-3">
                                <i class="fas ${n.iconClass} ${n.iconColor} fa-2x"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1 font-weight-bold">${n.title}</h6>
                                <p class="small text-muted mb-1">${n.message}</p>
                                <small class="text-primary">${n.timeAgo}</small>
                            </div>
                        </div>
                    </div>`;
                });
            }
            $('#notification-container').html(html); // Ganti dengan ID kontainer notifikasi di HTML-mu
        });
    }

    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById('icon-' + inputId);
        
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = "password";
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    $(document).ready(function() {
        loadNotifications();
        const lastPage = localStorage.getItem('lastOpenedPage') || 'dashboard';
        showPage(lastPage);

        const activeTab = localStorage.getItem('activeProfileTab');
        if (activeTab) {
            // Aktifkan tab berdasarkan ID link-nya
            $(`#${activeTab}`).tab('show');
        }

        // 2. Simpan tab ke LocalStorage setiap kali tab diklik
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            const tabId = $(e.target).attr('id');
            localStorage.setItem('activeProfileTab', tabId);
        });

        // Fungsi ketika tombol Edit Informasi diklik
        $('#btnEditInfo').on('click', function() {
            const isReadOnly = $('#inputNama').prop('readonly');

            if (isReadOnly) {
                // AKTIFKAN MODE EDIT
                $('.input-custom').prop('readonly', false); // Lepas status readonly
                $('#btnSimpan').prop('disabled', false); 
                $('.input-custom').css('background-color', '#fff'); // Ubah background jadi putih agar kontras
                $('.input-custom').first().focus(); // Fokuskan ke input pertama
                
                $(this).html('<i class="fa-solid fa-xmark mr-1"></i> Batal Edit'); // Ganti teks tombol
                $(this).removeClass('text-muted').addClass('text-danger');
            } else {
                // KEMBALI KE MODE LOCK (Batal)
                $('.input-custom').prop('readonly', true);
                $('#btnSimpan').prop('disabled', true);
                $('.input-custom').css('background-color', '#f8fafc'); // Kembalikan warna abu-abu
                
                $(this).html('<i class="fa-solid fa-pencil mr-1"></i> Edit Informasi');
                $(this).removeClass('text-danger').addClass('text-muted');
            }
        });
    });

    function showPhotoOptions() {
        Swal.fire({
            title: 'Foto Profil',
            showDenyButton: true,
            showCancelButton: true,
            confirmButtonText: 'Unggah Foto Baru',
            denyButtonText: 'Hapus Foto',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#00549B',
            denyButtonColor: '#ec1c24',
        }).then((result) => {
            if (result.isConfirmed) {
                $('#fileInput').click();
            } else if (result.isDenied) {
                deletePhoto();
            }
        });
    }

    function uploadPhoto(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];

            // 1. Validasi Ukuran (Max 2MB)
            if (file.size > 2 * 1024 * 1024) {
                Swal.fire('Opps!', 'Ukuran file terlalu besar (Max 2MB)', 'error');
                return;
            }

            // 2. Preview Langsung di Browser
            const reader = new FileReader();
            reader.onload = function(e) {
                const container = document.getElementById('avatarContainer');
                container.innerHTML = `<img src="${e.target.result}" id="profileImage" style="width:100%; height:100%; object-fit:cover;">`;
            };
            reader.readAsDataURL(file);

            // 3. Kirim ke Backend pakai AJAX
            const formData = new FormData();
            formData.append("fotoProfil", file);

            @* // Tampilkan loading agar user tahu proses sedang berjalan
            Swal.fire({ title: 'Mengunggah...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } }); *@

            $.ajax({
                url: '/DashboardPeserta/UpdateFoto',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res.success) {
                        // Update semua elemen foto di halaman
                        const newPath = res.filePath + '?t=' + new Date().getTime();
                        
                        // Update gambar profil utama dan navbar
                        $('#profileImage, #navbarAvatar, .avatar-box img').attr('src', newPath);
                    @* 
                        Swal.fire({ 
                            icon: 'success', 
                            title: 'Berhasil!', 
                            text: 'Foto profil diperbarui.', 
                            timer: 1500, 
                            showConfirmButton: false 
                        }); *@
                    } else {
                        Swal.fire('Gagal!', res.message, 'error');
                    }
                },
                error: function(err) {
                    console.error("Error:", err);
                    Swal.fire('Error!', 'Gagal menghubungi server.', 'error');
                }
            }); 
        } 
    } 

    function deletePhoto() {
        Swal.fire({
            title: 'Hapus foto?',
            text: "Foto profil akan dihapus.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Ya, Hapus'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/DashboardPeserta/DeleteFoto', function(res) {
                    if(res.success) location.reload();
                });
            }
        });
    }

    // --- FUNGSI LIHAT FOTO ---
    function viewPhoto() {
        const photoUrl = $('#imgPreview').attr('src'); 
        
        console.log("Viewing photo from:", photoUrl);
        if (!photoUrl || photoUrl.includes("default-avatar.png")) {
            Swal.fire('Info', 'Anda belum mengunggah foto profil.', 'info');
            return;
        }
        Swal.fire({
            imageUrl: photoUrl,
            imageAlt: 'Foto Profil',
            showCloseButton: true,
            showConfirmButton: false,
            background: '#fff',
            customClass: { image: 'rounded shadow-lg border' }
        });
    }

    // --- FUNGSI PILIH FOTO ---
    function selectPhoto() {
        $('#fileInputFoto').click(); // Trigger klik pada input file tersembunyi
    }

    // Event listener saat file dipilih
    $('#fileInputFoto').on('change', function() {
        const file = this.files[0];
        if (file) {
            // 1. Tampilkan Loading
            Swal.fire({ title: 'Mengunggah...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            // 2. Kirim ke Server pake FormData
            const formData = new FormData();
            formData.append('fotoProfil', file);

            $.ajax({
                url: '/Profile/UploadFoto', // Sesuaikan dengan Route Controller kamu
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if(res.success) {
                        location.reload(); // Refresh untuk update foto di semua menu
                    } else {
                        Swal.fire('Gagal', res.message, 'error');
                    }
                }
            });
        }
    });

    function updatePassword(e) {
        e.preventDefault(); 

        const oldP = $('#oldPass').val();
        const newP = $('#newPass').val();
        const confirmP = $('#confirmPass').val();

        if (!oldP || !newP || !confirmP) {
            Swal.fire('Opps!', 'Semua kolom password wajib diisi.', 'warning');
            return;
        }

        if (newP !== confirmP) {
            Swal.fire('Error', 'Konfirmasi password tidak cocok!', 'error');
            return;
        }

        Swal.fire({ title: 'Memproses...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

        $.ajax({
            url: '/DashboardPeserta/UpdatePassword',
            type: 'POST',
            data: { 
                oldPass: oldP, 
                newPass: newP,
                // Token keamanan ASP.NET Core
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
            },
            success: function(res) {
                if (res.success) {
                    Swal.fire('Berhasil!', 'Password diperbarui.', 'success');
                    $('#securityForm')[0].reset(); 
                } else {
                    Swal.fire('Gagal!', res.message, 'error');
                }
            },
            error: function(xhr) {
                console.log(xhr.responseText);
                Swal.fire('Error!', 'Terjadi kesalahan sistem.', 'error');
            }
        });
    }

    function showPage(pageId) {
        $('.page-section').removeClass('active');
        $('#page-' + pageId).addClass('active');
        $('.nav-link-custom').removeClass('active');
        $('#nav-' + pageId).addClass('active');

        const breadcrumbs = {
            'dashboard': 'Panel Peserta / Dashboard',
            'riwayat': 'Panel Peserta / Riwayat Magang',
            'penelitian': 'Panel Peserta / Riwayat Riset',
            'profil': 'Panel Peserta / Pengaturan Profil'
        };
        $('#page-breadcrumb').text(breadcrumbs[pageId]);

        localStorage.setItem('lastOpenedPage', pageId);
    }

    function saveProfile() {
        // Tampilkan loading
        Swal.fire({ 
            title: 'Menyimpan...', 
            allowOutsideClick: false, 
            didOpen: () => { Swal.showLoading() } 
        });

        $.ajax({
            url: '/DashboardPeserta/UpdateProfil',
            type: 'POST',
            data: {
                nama: $('#inputNama').val(),
                noHp: $('#inputNoHP').val(),
                univ: $('#inputUniv').val()
            },
            success: function(res) {
                if(res.success) {
                    Swal.fire('Berhasil', 'Profil diperbarui!', 'success').then(() => {
                        // Hanya mengunci input yang ada di tab profil
                        $('#tab-data .input-custom').prop('readonly', true);
                        
                        // Kembalikan tombol edit ke mode normal
                        $('#btnEditInfo').html('<i class="fa-solid fa-pencil mr-1"></i> Edit Informasi');
                        $('#btnEditInfo').removeClass('text-danger');
                        
                        // Update nama di header agar sinkron
                        $('.font-weight-bold.mb-1').text($('#inputNama').val());
                    });
                } else {
                    Swal.fire('Gagal', res.message, 'error');
                }
            }, // Tutup success
            error: function() {
                Swal.fire('Error', 'Gagal tersambung ke server', 'error');
            }
        }); // Tutup $.ajax
    }

    function handleLogout() {
        Swal.fire({title: 'Keluar?', text: "Sesi akan berakhir.", icon: 'warning', showCancelButton: true, confirmButtonColor: '#ec1c24', confirmButtonText: 'Logout'
        }).then((r) => { 
            if (r.isConfirmed) {
                localStorage.removeItem('lastOpenedPage');
                window.location.href = '/Auth/Logout'; 
            }
        });
    }
</script>
</body>
</html>