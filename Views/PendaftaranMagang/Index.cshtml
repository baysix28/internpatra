            "Asset Operation Region Sumbagut","Branch Marketing Aceh",
            "Branch Marketing Kepulauan Riau","Branch Marketing Sibolga",
            "Branch Marketing Sumbar","Communication & CSR Region Sumbagut",
            "Corp Operation & Serv Region Sumbagut","Corporate Sales Region Sumbagut",
            "DPPU Hang Nadim Group","DPPU Kualanamu Group","DPPU Minangkabau",
            "DPPU SIM","DPPU SSK II","Finance Region Sumbagut",
            "Fuel Terminal Batam","Fuel Terminal Gunung Sitoli",
            "Fuel Terminal Kijang Group","Fuel Terminal Kisaran",
            "Fuel Terminal Krueng Raya","Fuel Terminal Medan Group",
            "Fuel Terminal Meulaboh","Fuel Terminal Natuna Group",
            "Fuel Terminal Pematang Siantar","Fuel Terminal Sabang",
            "Fuel Terminal Sei Siak","Fuel Terminal Sibolga",
            "Fuel Terminal Simeulue","Fuel Terminal Tembilahan",
            "HC Region Sumbagut","HSSE Region Sumbagut",
            "IA Region I","Integrated Terminal Dumai",
            "Integrated Terminal Lhokseumawe","Integrated Terminal Tanjung Uban",
            "Integrated Terminal Teluk Kabung","Legal Counsel Region Sumbagut",
            "Medical Region Sumbagut","Procurement Region Sumbagut",
            "Rel & Project Dev Region Sumbagut",
            "Retail Sales Region Sumbagut",
            "SSC ICT I Region Sumbagut",
            "Supply & Distribution Region Sumbagut"
        ]};

    const dataMagang = { "KPI": dataKPI, "PPN": dataPPN };

    const companySelect = document.getElementById('filterCompany');
    const regionSelect = document.getElementById('filterRegion');
    const lokasiSelect = document.getElementById('filterLokasi');
    const container = document.getElementById('containerLowongan');
    const emptyState = document.getElementById('emptyState');
    const searchInput = document.getElementById('searchPosisi');

    function getDefaultCards() {
        const company = "PPN";
        const region = "Regional Jawa Bagian Tengah";

        return dataMagang[company][region]
            .slice(0, 8)
            .map(pos => ({
                company: company,
                region: region,
                lokasi: region,
                posisi: pos
            }));
    }

    function renderCards() {
        const company = companySelect.value;
        const region = regionSelect.value;
        const search = searchInput.value.toLowerCase().trim();

        container.innerHTML = '';
        let itemsToRender = [];

        if (!company && !region && !search) {
            emptyState.style.display = 'none';
            itemsToRender = getDefaultCards();
        } else {
            Object.keys(dataMagang).forEach(comp => {
                if (company && comp !== company) return;

                Object.keys(dataMagang[comp]).forEach(reg => {
                    if (region && reg !== region) return;

                    dataMagang[comp][reg].forEach(pos => {
                        if (search) {
                            const words = pos.toLowerCase().split(/\s+/);
                            const match = words.some(word => word.startsWith(search));

                            if (!match) return;
                        }

                        itemsToRender.push({
                            company: comp,
                            region: reg,
                            lokasi: reg,
                            posisi: pos
                        });
                    });
                });
            });
        }

        if (itemsToRender.length === 0) {
            emptyState.style.display = 'block';
            emptyState.innerHTML = `
                <i class="fas fa-search fa-3x mb-3 text-muted"></i>
                <p>Tidak ada lowongan yang sesuai.</p>
            `;
            return;
        } else {
            emptyState.style.display = 'none';
        }

        itemsToRender.forEach(item => {
            let deskripsi = "";

            if (item.company === "KPI") {
                deskripsi = typeof deskripsiPosisi !== "undefined" && deskripsiPosisi[item.posisi]
                    ? deskripsiPosisi[item.posisi]
                    : "Mendukung operasional unit kerja sesuai fungsi dan standar perusahaan.";
            }

            if (item.company === "PPN") {
                deskripsi = typeof generateDeskripsiPPN === "function"
                    ? generateDeskripsiPPN(item.posisi)
                    : "Mendukung operasional unit kerja sesuai fungsi dan standar perusahaan.";
            }

            const card = `
                <div class="flip-card animate__animated animate__fadeInUp">
                    <div class="flip-card-inner">
                        <div class="flip-card-front shadow-sm">
                            <div class="wadah-ikon-sm">
                                <i class="${getIcon(item.posisi)}"></i>
                            </div>
                            <div class="judul-posisi">${item.posisi}</div>
                            <small class="text-muted d-block mb-2">
                                <i class="fas fa-building me-1 text-primary"></i>${item.company}
                            </small>
                            <small class="text-muted d-block mb-3">
                                <i class="fas fa-map-marker-alt me-1 text-danger"></i>${item.lokasi}
                            </small>
                            <div class="syarat-dokumen mb-2">
                                <small class="fw-bold text-muted d-block mb-1">Dokumen:</small>
                                <small class="text-muted">CV, Proposal, Surat Kampus</small>
                            </div>
                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-muted" style="font-size: 11px;">KUOTA</span>
                                    <span class="fw-bold text-primary" style="font-size: 11px;">TERSEDIA</span>
                                </div>
                            </div>
                        </div>

                        <div class="flip-card-back shadow-lg">
                            <h6 class="fw-bold mb-2" style="font-size: 13px;">Fungsi Bidang</h6>
                            <p style="font-size: 11px; line-height: 1.4; opacity: 0.9;">${deskripsi}</p>
                            <button onclick="pilihPosisi('${item.company}', '${item.region}', '${item.posisi.replace(/'/g, "\\'")}')"
                                    class="btn-pilih mt-3">
                                Pilih Posisi
                            </button>
                        </div>
                    </div>
                </div>`;

            container.insertAdjacentHTML('beforeend', card);
        });
    }

    function getIcon(pos) {
        pos = pos.toLowerCase();
        if (pos.includes('elektro')) return 'fas fa-bolt';
        if (pos.includes('informatika') || pos.includes('ict')) return 'fas fa-code';
        if (pos.includes('hukum')) return 'fas fa-gavel';
        if (pos.includes('akuntansi') || pos.includes('finance')) return 'fas fa-file-invoice-dollar';
        if (pos.includes('kimia')) return 'fas fa-flask';
        return 'fas fa-briefcase';
    }

    companySelect.addEventListener('change', function() {
        regionSelect.innerHTML = '<option value="">Pilih</option>';
        lokasiSelect.innerHTML = '<option value="">Pilih</option>';
        lokasiSelect.disabled = true;

        if (this.value) {
            regionSelect.disabled = false;
            Object.keys(dataMagang[this.value]).forEach(r => {
                regionSelect.innerHTML += `<option value="${r}">${r}</option>`;
            });
        } else {
            regionSelect.disabled = true;
        }
        renderCards();
    });

    regionSelect.addEventListener('change', function() {
        lokasiSelect.innerHTML = '<option value="">Pilih</option>';
        if (this.value) {
            lokasiSelect.disabled = false;
            lokasiSelect.innerHTML += `<option value="${this.value}">${this.value}</option>`;
        } else {
            lokasiSelect.disabled = true;
        }
        renderCards();
    });

    // ✅ PERBAIKAN: gunakan boolean agar tidak ada risiko escaping string
    const isLoggedIn = @(Context.User.Identity?.IsAuthenticated == true ? "true" : "false");

    function showLoginWarning() {
        Swal.fire({
            title: 'Akses Terbatas',
            text: 'Silakan login untuk mengakses formulir pendaftaran magang.',
            icon: 'info',
            iconColor: '#003B76',
            width: '340px',
            showCancelButton: true,
            confirmButtonText: 'Login Sekarang',
            cancelButtonText: 'Kembali',
            confirmButtonColor: '#003B76',
            cancelButtonColor: '#6c757d',
            reverseButtons: true,
            padding: '1.5rem',
            customClass: {
                popup: 'rounded-3 shadow',
                title: 'fs-5 fw-bold text-dark',
                htmlContainer: 'small text-muted',
                confirmButton: 'btn btn-primary btn-sm px-3 py-2',
                cancelButton: 'btn btn-link btn-sm text-decoration-none text-muted'
            },
            buttonsStyling: true,
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/Auth/Login';
            }
        });
    }

    function pilihPosisi(company, region, lokasi) {
        // ✅ Cek login sebelum redirect ke formulir
        if (!isLoggedIn) {
            showLoginWarning();
            return;
        }

        localStorage.setItem('magang_company', company);
        localStorage.setItem('magang_region', region);
        localStorage.setItem('magang_lokasi', lokasi);
        localStorage.setItem('magang_locked_from_card', 'true');

        window.location.href = '/PendaftaranMagang/DataMagang';
    }

    function handleMulaiDaftar() {
        // ✅ Cek login sebelum redirect ke formulir
        if (!isLoggedIn) {
            showLoginWarning();
        } else {
            window.location.href = '/PendaftaranMagang/DataMagang';
        }
    }

    lokasiSelect.addEventListener('change', renderCards);
    searchInput.addEventListener('input', renderCards);

    document.addEventListener('DOMContentLoaded', function () {
        renderCards();
    });
</script>
