@{
    ViewData["Title"] = "Home - SINTA";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="container-fluid py-4" style="background-color: #f8fafc; font-family: 'Inter', sans-serif; min-height: 72vh;">
    <div class="container" style="max-width: 900px;">
        
        <div class="d-flex justify-content-between align-items-end mb-4 px-1">
            <div>
                <p class="fw-bold mb-0"
                style="font-size: 0.65rem; letter-spacing: 1px; text-transform: uppercase; color: #00549B;">
                    Sistem Informasi Internship
                </p>

                <h4 class="fw-bold text-dark mb-0">
                    Portal Pendaftaran
                </h4>
            </div>
            
            <div class="d-flex gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn btn-white shadow-sm border px-3 py-2 btn-sm fw-bold" type="button" style="border-radius: 4px;">
                            <i class="fas fa-user-circle me-1 text-primary"></i> @User.Identity.Name
                        </button>
                        
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-0">
                            <li><a class="dropdown-item py-2 small" href="@Url.Action("Index", "DashboardPeserta")">Dashboard</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item small text-danger">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Auth")" class="btn btn-white border px-4 py-2 btn-sm fw-bold shadow-sm" style="border-radius: 6px; color: #475569;">Masuk</a>
                    <a href="@Url.Action("Register", "Auth")" class="btn btn-primary px-4 py-2 btn-sm fw-bold shadow-sm" style="border-radius: 6px; background-color: #00549B; border: none;">Daftar Akun</a>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mx-auto" style="border-radius: 8px; border: 1px solid #e2e8f0 !important;">
            <div class="card-body p-0">
                
                <div class="p-4 bg-white border-bottom position-relative">
                    <div class="row align-items-center">
                        <div class="col-md-10">
                            <h4 class="fw-bold text-dark mb-1">Selamat Datang di SINTA</h4>
                            <p class="text-muted mb-0 small">Layanan pendaftaran magang dan penelitian PT Pertamina.</p>
                        </div>
                        <div class="col-md-2 text-end d-none d-md-block">
                            <i class="fas fa-briefcase fa-2x text-light opacity-25"></i>
                        </div>
                    </div>
                </div>

                <div class="p-4 bg-light">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card border-0 h-100 p-3 service-card shadow-sm">
                                <div class="mb-3">
                                    <span class="label-badge"
                                        style="background-color: rgba(0, 84, 155, 0.12); color: #00549B;">
                                        Magang
                                    </span>
                                    <h6 class="fw-bold mt-2 mb-2">Magang Kerja</h6>
                                    <p class="text-muted mb-0" style="font-size: 0.75rem;">Program praktis mahasiswa aktif.</p>
                                </div>
                                <div class="mt-auto pt-2 border-top">
                                    <a href="@Url.Action("Index", "PendaftaranMagang")"
                                    class="text-decoration-none fw-bold small"
                                    style="color: #00549B;">
                                        Buka Program
                                        <i class="fas fa-chevron-right ms-1" style="font-size: 0.6rem;"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-0 h-100 p-3 service-card shadow-sm">
                                <div class="mb-3">
                                    <span class="label-badge"
                                        style="background-color: rgba(227, 30, 36, 0.12); color: #E31E24;">
                                        Riset
                                    </span>
                                    <h6 class="fw-bold mt-2 mb-2">Penelitian</h6>
                                    <p class="text-muted mb-0" style="font-size: 0.75rem;">Akses data untuk tugas akhir.</p>
                                </div>
                                <div class="mt-auto pt-2 border-top">
                                    <a href="@Url.Action("Index", "Penelitian")"
                                    class="text-decoration-none fw-bold small"
                                    style="color: #E31E24;">
                                        Buka Riset
                                        <i class="fas fa-chevron-right ms-1" style="font-size: 0.6rem;"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-0 h-100 p-3 service-card shadow-sm">
                                <div class="mb-3">
                                    <span class="label-badge"
                                        style="background-color: rgba(108, 194, 74, 0.12); color: #6CC24A;">
                                        Status
                                    </span>
                                    <h6 class="fw-bold mt-2 mb-2">Hasil Seleksi</h6>
                                    <p class="text-muted mb-0" style="font-size: 0.75rem;">Pantau pengumuman pendaftaran.</p>
                                </div>
                                <div class="mt-auto pt-2 border-top">
                                    <a href="@Url.Action("Index", "HasilPendaftaran")"
                                    class="btn btn-sm w-100 fw-bold shadow-sm"
                                    style="border-radius: 4px; font-size: 0.7rem; background-color: #6CC24A; border-color: #6CC24A; color: white;">
                                        Periksa Hasil
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<style>
    .btn-white { background-color: #fff; border-color: #e2e8f0; }
    .btn-white:hover { background-color: #f8fafc; }

    .label-badge {
        font-size: 0.6rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
        text-transform: uppercase;
    }
    .bg-primary-soft { background-color: #eff6ff; }
    .bg-info-soft { background-color: #f0f9ff; }
    .bg-success-soft { background-color: #f0fdf4; }

    .service-card {
        background-color: #ffffff;
        border-radius: 6px;
        transition: all 0.2s ease;
        border: 1px solid #f1f5f9 !important;
    }

    .service-card:hover {
        transform: translateY(-2px);
        border-color: #e2e8f0 !important;
    }

    h4 { font-size: 1.2rem; }
    h6 { font-size: 0.85rem; color: #0f172a; }
</style>
