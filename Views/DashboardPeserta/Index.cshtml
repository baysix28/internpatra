                                    <div id="revisiChipsMhs" class="revisi-chips-wrap"></div>
                                </div>
                            </div>

                            <!-- Catatan admin -->
                            <div id="revisiCatatanBox" class="revisi-catatan-box">
                                <strong style="font-size:11px; color:#92400e; text-transform:uppercase;">
                                    Catatan dari Admin:
                                </strong><br>
                                <span id="revisiCatatanText"></span>
                            </div>

                            <div style="font-size:12px; color:#64748b; margin-bottom:16px;">
                                Field yang ditandai <strong style="color:#00549B;">biru</strong> bisa diedit. 
                                Sisanya terkunci dan tidak perlu diubah.
                            </div>

                            <!-- Field-field revisi (2 kolom) -->
                            <div class="row">
                                <div class="col-md-6">
                                    <!-- NIM -->
                                    <div id="rowRevisiNIM" class="revisi-field-row">
                                        <div class="revisi-field-label">
                                            <i class="fas fa-id-badge"></i> NIM
                                            <span id="badgeNIM" class="badge-terkunci">TERKUNCI</span>
                                        </div>
                                        <input id="revisiNIM" type="text" class="revisi-input" disabled>
                                    </div>

                                    <!-- No HP -->
