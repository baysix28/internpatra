@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using sinta_asp.Models
@model sinta_asp.Models.UserProfile
@inject IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    // Ambil Username: Jika Authenticated ambil Name, jika tidak pakai "Guest"
    // Ditambah .ToString() atau null-coalescing agar tidak dianggap null oleh compiler
    var namaUser = (User.Identity?.IsAuthenticated == true 
                   ? (User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User.Identity.Name) 
                   : "Guest") ?? "Guest";

    // Ambil Email secara dinamis
    var userEmail = (User.Identity?.IsAuthenticated == true 
                    ? (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name) 
                    : "belum_login@mail.com") ?? "user@mail.com";

    // Ambil Foto Profil dari Model
    var fotoUser = Model?.FotoProfil;
    var avatarUrl = !string.IsNullOrEmpty(fotoUser) 
                   ? $"/uploads/profile/{fotoUser}" 
                   : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(namaUser)}&background=00549B&color=fff";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Peserta | SINTA Pertamina</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --p-blue: #00549B;
            --p-red: #ec1c24;
            --p-green: #28a745;
            --sidebar-width: 280px;
            --topbar-height: 80px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --p-gray-bg: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--p-gray-bg);
            overflow-x: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed;
            left: 0; top: 0; background: #fff; border-right: 1px solid #e2e8f0;
            z-index: 1000; padding: 30px 20px; display: flex; flex-direction: column;
        }

        .brand-container { margin-bottom: 50px; padding: 0 10px; }
        .brand-logo-pertamina { height: 50px; }

        .nav-link-custom {
            display: flex; align-items: center; padding: 12px 16px; color: #64748b;
            border-radius: 12px; text-decoration: none !important; margin-bottom: 6px;
            font-weight: 600; transition: var(--transition); border: none; background: transparent;
            width: 100%; text-align: left; cursor: pointer;
        }

        .nav-link-custom:hover { background: rgba(0, 84, 155, 0.05); color: var(--p-blue); transform: translateX(5px); }
        .nav-link-custom.active { 
            background: var(--p-blue); color: #fff !important; 
            box-shadow: 0 4px 12px rgba(0, 84, 155, 0.2); 
        }

        .nav-link-logout { color: var(--p-red) !important; border: 1px solid #fee2e2; background: #fffafa; margin-top: auto; }

        /* Topbar Styling */
        .topbar {
            height: var(--topbar-height); position: fixed; top: 0; right: 0; left: var(--sidebar-width);
            background: #fff; border-bottom: 1px solid #e2e8f0; z-index: 999;
            display: flex; align-items: center; justify-content: space-between; padding: 0 30px;
        }

        .main-content { margin-left: var(--sidebar-width); padding-top: var(--topbar-height); padding-bottom: 40px; }

        /* Card Styling - Equal Height Fix */
        .glass-card {
            background: white; border-radius: 16px; border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); padding: 25px;
            height: 100%; display: flex; flex-direction: column;
        }

                /* Warna Default (Kuning) */
        .status-badge.status-review { background: #fff3cd; color: #856404; }

        /* Warna Diterima (Hijau) */
        .status-badge.status-success { background: #d4edda; color: #155724; }

        /* Warna Ditolak (Merah) */
        .status-badge.status-danger { background: #f8d7da; color: #721c24; }

        .badge-count {
            position: absolute;
            top: -6px;
            right: -6px;
            background: #ec1c24;
            color: white;
            font-size: 11px;
            font-weight: 700;
            border-radius: 50%;
            padding: 2px 6px;
            min-width: 18px;
            text-align: center;
        }

        .noti-unread {
            background: #eef6ff;
            border-left: 4px solid #00549B;
        }

        .noti-read {
            background: #f8fafc;
            opacity: 0.7;
        }


        .status-badge { padding: 5px 12px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; }
        .status-approved { background: #dcfce7; color: #166534; }
        .status-review { background: #fef9c3; color: #854d0e; }

        .page-section { display: none; }
        .page-section.active { display: block; animation: slideUp 0.4s ease-out; }

        @@keyframes slideUp { 
            from { opacity: 0; transform: translateY(15px); } 
            to { opacity: 1; transform: translateY(0); } 
        }

        /* Styling tambahan untuk Profil ala Gambar 2 */
        .profile-card {
            background: white;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }

        .profile-nav-tabs {
            border-bottom: 1px solid #f1f5f9;
            padding: 0 20px;
        }

        .profile-nav-tabs .nav-link {
            border: none;
            font-weight: 700;
            font-size: 13px;
            padding: 15px 20px;
            color: #64748b;
            text-transform: uppercase;
        }

        .profile-nav-tabs .nav-link.active {
            color: var(--p-blue);
            border-bottom: 3px solid var(--p-blue);
            background: transparent;
        }

        .avatar-box {
            width: 70px;
            height: 70px;
            background-color: var(--p-blue);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 800;
            border-radius: 12px;
        }

        .badge-role-peserta {
            background: #e0efff;
            color: #00549b;
            font-size: 10px;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 5px;
        }

        .label-custom {
            font-size: 11px;
            font-weight: 800;
            color: #94a3b8;
            margin-bottom: 8px;
            display: block;
        }

        .input-custom {
            background-color: #f8fafc !important;
            border: none !important;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 14px;
            color: #334155;
        }

        #informasi-tersedia {
            border: none;
            border-radius: 18px;
            overflow: hidden;
        }

        #informasi-tersedia .card-body {
            padding: 24px;
        }

        #informasi-tersedia table th {
            font-weight: 700;
            color: #0b4f93;
            white-space: nowrap;
        }

        #informasi-tersedia table td {
            vertical-align: middle;
        }

        /* Styling Modal Premium */
        .modal-content { border-radius: 24px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); }
        .modal-header-premium { background: var(--p-blue); padding: 30px; color: white; position: relative; }
        .header-flex-container { display: flex; align-items: center; gap: 20px; }

        .profile-circle-frame { 
            width: 90px; height: 90px; border-radius: 50%; border: 4px solid rgba(255,255,255,0.3); 
            object-fit: cover; cursor: pointer; transition: transform 0.3s; background: white;
        }
        .profile-circle-frame:hover { transform: scale(1.05); }

        .status-pill-modal {
            padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.5px; display: inline-block; margin-bottom: 8px;
        }
        .bg-light-green { background: #d1fae5; color: #065f46; }
        .bg-light-orange { background: #fef3c7; color: #92400e; }
        .bg-light-red { background: #fee2e2; color: #991b1b; }

        .detail-body { padding: 30px; background: #f8fafc; }
        .info-card-premium { 
            background: white; border-radius: 16px; padding: 20px; 
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); height: 100%;
        }
        .info-label { color: #64748b; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px; margin-top: 12px; }
        .info-value { color: #1e293b; font-size: 14px; font-weight: 600; line-height: 1.4; }

        .doc-link {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px 16px; background: white; border-radius: 12px; 
            margin-bottom: 10px; text-decoration: none; color: #334155;
            border: 1px solid #e2e8f0; transition: all 0.2s;
        }
        .doc-link:hover { background: #f1f5f9; border-color: var(--p-blue); transform: translateY(-2px); }
        .doc-link span { font-size: 13px; font-weight: 600; }

        /* Efek saat input terkunci (readonly) */
        .input-custom[readonly] {
            cursor: not-allowed;
            opacity: 0.7;
            background-color: #f8fafc !important; /* Warna abu-abu panel */
        }

        /* Efek saat input aktif */
        .input-custom:not([readonly]) {
            background-color: #ffffff !important;
            border: 1px solid var(--p-blue) !important;
            box-shadow: 0 0 0 3px rgba(0, 84, 155, 0.1);
        }

        .notif-item {
            padding: 12px 16px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
            transition: 0.2s;
        }

        .notif-item:hover {
            background: #f5f7fa;
        }

        .notif-unread {
            background: #eef4ff;
        }

        .notif-title {
            font-weight: 600;
            font-size: 14px;
        }

        .notif-msg {
            font-size: 13px;
            color: #666;
        }

        /* Notifikasi ala Tokopedia */
        .notification-btn { position: relative; cursor: pointer; padding: 10px; border-radius: 10px; border: 1px solid #e2e8f0; transition: 0.2s; }
        .notification-btn:hover { background: #f8fafc; }
        .notification-badge-dot { width: 10px; height: 10px; background: var(--p-red); border-radius: 50%; position: absolute; top: -2px; right: -2px; border: 2px solid white; }

        #notiTab .nav-link { border: none; color: #64748b; font-weight: 700; font-size: 13px; padding: 12px; }
        #notiTab .nav-link.active { color: var(--p-green); border-bottom: 3px solid var(--p-green) !important; background: transparent; }
        .dropdown-menu-right {
            right: 0 !important;
            left: auto !important;
        }

        /* Pastikan dropdown tidak menempel terlalu atas */
        .dropdown-menu {
            margin-top: 10px !important;
            display: none; /* Default hidden */
        }

        /* Saat dropdown terbuka (class show dari bootstrap), jalankan animasi */
        .dropdown-menu.show {
            display: block;
            animation: slideDown 0.2s ease-out forwards;
        }

        .stat-card {
            border: none !important;
            border-radius: 20px; /* Pojokan bulat modern */
            background: #ffffff;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* Efek membal/3D */
            position: relative;
            overflow: hidden;
            /* Bayangan halus berlapis */
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 
                        0 2px 4px -1px rgba(0, 0, 0, 0.04);
        }

        /* Efek saat kursor nempel (Hover) */
        .stat-card:hover {
            transform: translateY(-8px); /* Melayang ke atas */
            box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.1), 
                        0 8px 10px -5px rgba(0, 0, 0, 0.04);
            background: linear-gradient(145deg, #ffffff, #fdfdfd);
        }

        /* Efek saat diklik (Active) - Seolah ditekan ke bawah */
        .stat-card:active {
            transform: translateY(-2px) scale(0.95);
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
            transition: all 0.1s;
        }

        /* Gaya Card saat aktif/terpilih */
        .active-filter {
            background: #f0f7ff !important;
            border: 2px solid #00549B !important;
            box-shadow: 0 5px 15px rgba(0, 84, 155, 0.1) !important;
        }

        /* Penyesuaian teks di dalam */
        .stat-card p {
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        /* ===== Informasi Tersedia - 2 Card KPI & PPN Tanpa Logo ===== */
        .info-summary-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
            padding: 22px;
            height: 100%;
        }

        .info-summary-title {
            font-size: 12px;
            font-weight: 800;
            color: #94a3b8;
            text-transform: uppercase;
            margin-bottom: 8px;
            letter-spacing: .4px;
        }

        .info-summary-value {
            font-size: 34px;
            font-weight: 800;
            color: #0f172a;
            line-height: 1;
            margin-bottom: 8px;
        }

        .info-summary-desc {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 0;
        }

        .info-filter-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
            padding: 18px;
        }

        .info-company-main-card {
            background: #fff;
            border: 1px solid #dbe7f3;
            border-radius: 22px;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
            overflow: hidden;
            height: auto;
        }

        .info-company-row {
            align-items: flex-start;
        }

        .info-company-header {
            padding: 22px 22px 16px 22px;
            border-bottom: 1px solid #eef2f7;
            background: linear-gradient(135deg, #f8fbff 0%, #eef6ff 100%);
        }

        .info-company-label {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .4px;
            margin-bottom: 8px;
        }

        .info-company-label.kpi {
            background: rgba(0, 84, 155, 0.10);
            color: #00549B;
        }

        .info-company-label.ppn {
            background: rgba(0, 168, 89, 0.10);
            color: #0f8a4b;
        }

        .info-company-name {
            font-size: 20px;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 4px;
        }

        .info-company-code {
            font-size: 13px;
            font-weight: 700;
            color: #64748b;
        }

        .info-company-stats {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 14px;
        }

        .info-stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 999px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            font-size: 12px;
            font-weight: 700;
            color: #334155;
            cursor: default;
            pointer-events: none;
            box-shadow: none;
        }

        .info-company-body {
            padding: 18px;
        }

        .info-region-card {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
            background: #fff;
        }

        .info-region-card:last-child {
            margin-bottom: 0;
        }

        .info-region-header {
            padding: 14px 16px;
            background: #f8fafc;
            border-bottom: 1px solid #eef2f7;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .info-region-title {
            font-size: 15px;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 0;
        }

        .info-region-count {
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
        }

        .info-lokasi-list {
            padding: 14px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .info-lokasi-item {
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 12px 14px;
            background: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            transition: .2s ease;
        }

        .info-lokasi-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
            border-color: #bfd7f2;
        }

        .info-lokasi-name {
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.4;
        }

        .info-open-badge {
            white-space: nowrap;
            background: #dcfce7;
            color: #166534;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 11px;
            font-weight: 800;
        }

        .info-empty-state {
            background: #fff;
            border: 1px dashed #cbd5e1;
            border-radius: 18px;
            padding: 36px 20px;
            text-align: center;
            color: #64748b;
        }

        @@media (max-width: 768px) {
            .info-lokasi-item {
                flex-direction: column;
                align-items: flex-start;
            }
        }
        
        @@keyframes slideDown {
        from { 
            opacity: 0; 
            transform: translateY(0);}
        to { 
            opacity: 1; 
            transform: translateY(10px);}
        }
    </style>
</head>
<body>

<nav class="sidebar">
    <div class="brand-container">
        <img src="~/images/logo-pertamina.png"
            class="brand-logo-pertamina
            alt="Pertamina"
            onclick="window.location.href='/'">
    </div>

    <div style="flex-grow: 1;">
        <button onclick="showPage('dashboard')" class="nav-link-custom active" id="nav-dashboard">
            <i class="fa-solid fa-house mr-3"></i> Dashboard
        </button>
        <button onclick="showPage('informasi')" class="nav-link-custom" id="nav-informasi">
            <i class="fa-solid fa-info-circle mr-3"></i> Informasi Tersedia
        </button>
        <button onclick="showPage('riwayat')" class="nav-link-custom" id="nav-riwayat">
            <i class="fa-solid fa-clipboard-list mr-3"></i> Riwayat Magang
        </button>
        @* <button onclick="showPage('penelitian')" class="nav-link-custom" id="nav-penelitian">
            <i class="fa-solid fa-flask mr-3"></i> Riwayat Riset
        </button> *@
        <button onclick="showPage('profil')" class="nav-link-custom" id="nav-profil">
            <i class="fa-solid fa-user-gear mr-3"></i> Pengaturan Profil
        </button>
    </div>

    <button onclick="window.location.href='/'" class="nav-link-custom nav-link-kembali">
        <i class="fa-solid fa-house mr-3"></i> Kembali ke Home
    </button>
</nav>

<header class="topbar">
    <div class="d-flex align-items-center">
        <i class="fa-solid fa-bars-staggered mr-3 text-muted"></i>
        <span class="font-weight-bold text-muted" id="page-breadcrumb">Panel Peserta / Dashboard</span>
    </div>

    <div class="d-flex align-items-center">
        <img src="~/images/logo-sinta.png" style="height:40px;" class="mr-4">
        
        <div class="dropdown mr-3">
            <div class="notification-btn position-relative" id="notiDropdown" data-toggle="dropdown">
                <i class="fa-solid fa-bell text-muted"></i>
                <span id="notifBadge" class="badge badge-danger position-absolute" 
                    style="top:-5px; right:-5px; font-size:10px;"></span>
            </div>
            
            <div class="dropdown-menu dropdown-menu-right shadow border-0 p-0" style="width: 360px;">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 font-weight-bold">Notifikasi</h6>
                </div>
                
                <div class="tab-content" style="max-height: 400px; overflow-y: auto;">
                    <div class="tab-pane fade show active" id="pendaftaran">
                        <div class="list-group list-group-flush" id="notifList">
                        </div>
                    </div>
                    
                    <div class="tab-pane fade p-4 text-center" id="update">
                        <img src="https://cdni.iconscout.com/illustration/premium/thumb/empty-state-2130362-1800923.png" width="100" class="mb-2 opacity-50">
                    </div>
                </div>

                <div class="p-2 border-top text-center bg-light">
                    <a href="#" id="markAllReadBtn" class="small font-weight-bold text-success" style="text-decoration:none;">
                        Tandai semua dibaca
                    </a>
                </div>
            </div>
        </div>

        <div class="text-right mr-3 border-left pl-3">
            <div class="small font-weight-bold">@namaUser</div>
            <small class="text-success font-weight-bold">
                <i class="fa-solid fa-circle text-success mr-1" style="font-size: 8px;"></i> Online
            </small>
        </div>

        <div class="dropdown">
        <div style="cursor: pointer;" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <img src="@avatarUrl" id="navbarAvatar" class="rounded-circle shadow-sm border" width="45">
        </div>
        
        <div class="dropdown-menu dropdown-menu-right shadow border-0" style="border-radius: 12px; min-width: 200px;">
            <div class="dropdown-header font-weight-bold text-dark">Menu Akun</div>
            
            <a class="dropdown-item py-2" href="javascript:void(0)" onclick="showPage('profil')">
                <i class="fa-solid fa-user-gear mr-2 text-muted"></i> Kelola Akun
            </a>
            
            <div class="dropdown-divider"></div>
            
            <a class="dropdown-item py-2 text-danger" href="javascript:void(0)" onclick="handleLogout()">
                <i class="fa-solid fa-right-from-bracket mr-2"></i> Logout
            </a>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="container-fluid py-4">
        
        <div id="page-dashboard" class="page-section active">
            <div class="mb-4">
                <h3 style="font-weight: 800; color: #00549B; margin-bottom: 0;">
                    Selamat Datang, @namaUser!
                </h3>
                <p class="subtitle-portal" style="font-size: 14px; color: #64748b; margin-top: 2px;">
                    Portal SINTA Pertamina Panel Peserta
                </p>
            </div>

            @if (ViewBag.MagangAktif != null)
            {
                // --- KONDISI 1: BIRU PERTAMINA (SEDANG AKTIF) ---
                var aktif = (sinta_asp.Models.Magang)ViewBag.MagangAktif;
                var sisaHari = (aktif.SelesaiMagang - DateTime.Now).Days;
                var warnaBadge = sisaHari <= 7 ? "#dc3545" : "#FFC107";
                var warnaTeks = sisaHari <= 7 ? "white" : "#212529";

                <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px; background: linear-gradient(135deg, #00549B 0%, #00a8e8 100%); color: white;">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="badge badge-pill badge-light mb-2" style="color: #00549B; font-weight: bold; padding: 5px 15px;">
                                    <i class="fa fa-check-circle mr-1"></i> SEDANG AKTIF MAGANG
                                </div>
                                <h4 class="font-weight-bold mb-1">@aktif.Company</h4>
                                <p class="mb-2 opacity-90" style="font-size: 14px;">
                                    <i class="fa fa-map-marker-alt mr-2"></i> Penempatan: <strong>@aktif.Region</strong> (@aktif.Lokasi)
                                </p>
                                <div class="p-2 px-3 d-inline-block" style="background: rgba(255,255,255,0.15); border-radius: 12px; border: 1px solid rgba(255,255,255,0.2);">
                                    <p class="mb-0" style="font-size: 13px;">
                                        <i class="fa fa-calendar-alt mr-2"></i> Periode: 
                                        <strong>@aktif.MulaiMagang.ToString("dd MMM yyyy")</strong> — <strong>@aktif.SelesaiMagang.ToString("dd MMM yyyy")</strong>
                                    </p>
                                </div>
                                <div class="mt-3">
                                    <span class="badge shadow-sm" style="background: @warnaBadge; color: @warnaTeks; border-radius: 8px; padding: 6px 12px; font-weight: 700;">
                                        ⌛ @(sisaHari > 0 ? sisaHari + " Hari Tersisa" : "Masa Magang Berakhir")
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-4 text-right d-none d-md-block">
                                <i class="fa fa-id-card" style="font-size: 80px; opacity: 0.15;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                // --- KONDISI 2: TIDAK ADA MAGANG AKTIF (MENUNGGU/DITOLAK/BELUM DAFTAR) ---
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px; background: linear-gradient(135deg, #8e9eab 0%, #eef2f3 100%); color: #4b5563;">
                    <div class="card-body p-4 text-center text-md-left">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="badge badge-pill badge-secondary mb-2" style="font-weight: bold; padding: 5px 15px;">
                                    <i class="fa fa-times-circle mr-1"></i> SEDANG TIDAK AKTIF MAGANG
                                </div>
                                <h4 class="font-weight-bold mb-1" style="color: #1f2937;">Status Magang: Tidak Aktif</h4>
                                <p class="mb-0 opacity-80" style="font-size: 14px;">
                                    Anda belum terdaftar dalam program magang aktif. Silakan lakukan pendaftaran atau pantau riwayat lamaran Anda.
                                </p>
                            </div>
                            <div class="col-md-4 text-right d-none d-md-block">
                                <i class="fa fa-user-slash" style="font-size: 80px; opacity: 0.1;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="glass-card shadow-sm p-4 dashboard-mini-card" style="border-radius: 18px; background: #fff; border-left: 6px solid #00549B; min-height: 160px; display: flex; flex-direction: column;">
                        <small class="text-muted font-weight-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.8px;">Pendaftaran</small>
                        <h4 class="font-weight-bold mt-2 mb-3" style="color: #333;">Magang Industri</h4>

                        <div class="mt-auto">
                            <a href="javascript:void(0)" onclick="window.location.href='/PendaftaranMagang/DataMagang'" class="text-primary font-weight-bold" style="font-size: 14px; text-decoration: none;">
                                Daftar Sekarang <i class="fa fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="glass-card shadow-sm p-4 dashboard-mini-card" style="border-radius: 18px; background: #fff; border-left: 6px solid #00A859; min-height: 160px; display: flex; flex-direction: column;">
                        <small class="text-muted font-weight-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.8px;">Informasi</small>
                        <h4 class="font-weight-bold mt-2 mb-3" style="color: #333;">Informasi Magang</h4>

                        <div class="mt-auto">
                            <a href="javascript:void(0)" onclick="showPage('informasi')" class="text-success font-weight-bold" style="font-size: 14px; text-decoration: none;">
                                Lihat informasi tersedia <i class="fa fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="glass-card shadow-sm p-4 dashboard-mini-card" style="border-radius: 18px; background: #fff; border-left: 6px solid #ec1c24; min-height: 160px; display: flex; flex-direction: column;">
                        <small class="text-muted font-weight-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.8px;">Riwayat</small>
                        <h4 class="font-weight-bold mt-2 mb-3" style="color: #333;">Riwayat Magang</h4>

                        <div class="mt-auto">
                            <a href="javascript:void(0)" onclick="showPage('riwayat')" class="text-danger font-weight-bold" style="font-size: 14px; text-decoration: none;">
                                Lihat riwayat pengajuan <i class="fa fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="page-informasi" class="page-section">
            <div class="mb-4">
                <h4 class="font-weight-bold" style="color: var(--p-blue); margin-bottom: 5px;">
                    Lokasi Magang Tersedia
                </h4>
                <p class="text-muted small mb-0">
                    Daftar unit/lokasi magang yang saat ini membuka pendaftaran berdasarkan data magang yang tersedia.
                </p>
            </div>

            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="info-summary-card text-center">
                        <div class="info-summary-title">Total Unit / Lokasi</div>
                        <div class="info-summary-value" id="summaryTotalLokasi">0</div>
                        <p class="info-summary-desc">Lokasi magang yang bisa dipilih peserta</p>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="info-summary-card text-center">
                        <div class="info-summary-title">Total Company</div>
                        <div class="info-summary-value" id="summaryTotalCompany">0</div>
                        <p class="info-summary-desc">Entitas perusahaan yang membuka pendaftaran</p>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="info-summary-card text-center">
                        <div class="info-summary-title">Total Regional</div>
                        <div class="info-summary-value" id="summaryTotalRegion">0</div>
                        <p class="info-summary-desc">Sebaran wilayah penempatan magang</p>
                    </div>
                </div>
            </div>

            <div class="info-filter-card mb-4">
                <div class="row align-items-end">
                    <div class="col-md-5 mb-2">
                        <label class="small font-weight-bold text-muted mb-2">Cari lokasi / unit</label>
                        <input type="text" id="filterSearchInformasi" class="form-control" placeholder="Contoh: Balongan, Teknik Informatika, Kalimantan...">
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="small font-weight-bold text-muted mb-2">Company</label>
                        <select id="filterCompanyInformasi" class="form-control">
                            <option value="">Semua Company</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="small font-weight-bold text-muted mb-2">Regional</label>
                        <select id="filterRegionInformasi" class="form-control" disabled>
                            <option value="">Pilih company terlebih dahulu</option>
                        </select>
                    </div>
                    <div class="col-md-1 mb-2">
                        <button type="button" class="btn btn-light border w-100" onclick="resetInformasiFilter()" title="Reset filter">
                            <i class="fa fa-rotate-left"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div id="informasiGroupedContainer"></div>
        </div>

        <div id="page-riwayat" class="page-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="font-weight-bold" style="color: var(--p-blue); margin-bottom: 5px;">Riwayat Pengajuan Magang</h4>
                    <p class="text-muted small mb-0">Pantau status pengajuan magang industri Anda.</p>
                </div>
                <button class="btn btn-primary px-4 shadow-sm" style="border-radius:10px; background: var(--p-blue); font-size: 14px;" onclick="window.location.href='/PendaftaranMagang/DataMagang'">
                    <i class="fa fa-plus mr-2"></i> Daftar Magang Baru
                </button>
            </div>

            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <div class="card stat-card shadow-sm text-center p-3" onclick="filterTabel('Semua', this)">
                        <p class="text-muted mb-1" style="font-size: 13px;">📝 Total Magang</p>
                        <h3 class="font-weight-bold mb-0">@ViewBag.TotalMagang</h3>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card stat-card shadow-sm text-center p-3" onclick="filterTabel('Menunggu', this)">
                        <p class="text-muted mb-1" style="font-size: 13px;">⏳ Menunggu</p>
                        <h3 class="font-weight-bold text-warning mb-0">@ViewBag.Menunggu</h3>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card stat-card shadow-sm text-center p-3" onclick="filterTabel('Diterima', this)">
                        <p class="text-muted mb-1" style="font-size: 13px;">✔️ Diterima</p>
                        <h3 class="font-weight-bold text-success mb-0">@ViewBag.Diterima</h3>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card stat-card shadow-sm text-center p-3" onclick="filterTabel('Ditolak', this)">
                        <p class="text-muted mb-1" style="font-size: 13px;">❌ Ditolak</p>
                        <h3 class="font-weight-bold text-danger mb-0">@ViewBag.Ditolak</h3>
                    </div>
                </div>
            </div>

            <div class="glass-card p-0 overflow-hidden">
                <table class="table table-hover mb-0" style="table-layout: fixed; font-size: 13.5px;">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 px-4 text-secondary" style="width: 10%; font-weight: 600;">Company</th>
                            <th class="border-0 text-secondary" style="width: 25%; font-weight: 600;">Region</th>
                            <th class="border-0 text-secondary" style="width: 25%; font-weight: 600;">Posisi</th>
                            <th class="border-0 text-secondary text-center" style="width: 15%; font-weight: 600;">Tanggal</th>
                            <th class="border-0 text-secondary text-center" style="width: 15%; font-weight: 600;">Status</th>
                            <th class="border-0 text-secondary text-center" style="width: 10%; font-weight: 600;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="tabelBodyRiwayat">
                        @if (ViewBag.RiwayatMagang != null && ((List<sinta_asp.Models.Magang>)ViewBag.RiwayatMagang).Count > 0) 
                        {
                            foreach (var item in (List<sinta_asp.Models.Magang>)ViewBag.RiwayatMagang) 
                            {
                                <tr class="baris-magang" data-status="@item.Status">
                                    <td class="px-4 font-weight-bold" style="color: var(--p-blue);">@item.Company</td>
                                    <td style="color: #333;">@item.Region</td>
                                    <td style="color: #333;">@item.Lokasi</td>
                                    <td class="text-center" style="color: #333;">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        @{
                                            var statusClass = item.Status == "Diterima" ? "status-success" : 
                                                            item.Status == "Ditolak" ? "status-danger" : 
                                                            "status-review";
                                        }
                                        <span class="status-badge @statusClass" style="display: inline-block; min-width: 80px; font-size: 11px; padding: 3px 8px; font-weight: 600;">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary" style="border-radius: 8px; font-size: 11px; font-weight: bold; padding: 2px 10px;" onclick="showReviewDetail('@item.Id')">
                                            Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            @* Blok ini sekarang akan muncul jika list null ATAU list kosong *@
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="fa fa-folder-open mb-3" style="font-size: 50px; color: #dee2e6;"></i>
                                        <h6 class="font-weight-bold text-muted">Tidak terdapat riwayat magang</h6>
                                        <p class="small text-muted">Anda belum pernah melakukan pengajuan magang.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="modalDetail" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header-premium">
                        <div class="header-flex-container">
                            <img id="d-foto" src="/img/default-user.png" class="profile-circle-frame" title="Klik untuk lihat foto asli" onclick="window.open(this.src, '_blank')">
                            <div class="header-text-info">
                                <div id="d-status-badge-container"></div>
                                <h2 id="d-nama" class="mb-1 fw-bold"></h2>
                                <span class="opacity-75 small"><i class="fas fa-clock me-1"></i> Terdaftar: <span id="d-created-at"></span></span>
                            </div>
                        </div>
                    </div>
                    <div class="detail-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="mb-2 px-2 fw-bold text-secondary" style="font-size:12px;"><i class="fas fa-id-card me-2"></i>KONTAK & PRIBADI</div>
                                <div class="info-card-premium">
                                    <div class="info-label">Email</div><div id="d-email" class="info-value"></div>
                                    <div class="info-label">WhatsApp</div><div class="info-value"><a id="d-hp-link" target="_blank" class="text-decoration-none"></a></div>
                                    <div class="info-label">Instagram</div><div class="info-value"><a id="d-ig-link" target="_blank" class="text-decoration-none" style="color: var(--p-blue);"></a></div>
                                    <div class="info-label">Tempat, Tgl Lahir</div><div class="info-value"><span id="d-tempat"></span>, <span id="d-tgl-lahir"></span></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-2 px-2 fw-bold text-secondary" style="font-size:12px;"><i class="fas fa-graduation-cap me-2"></i>AKADEMIK & PENEMPATAN</div>
                                <div class="info-card-premium">
                                    <div class="info-label">Kampus (NIM)</div><div class="info-value"><span id="d-univ"></span> (<span id="d-nim"></span>)</div>
                                    <div class="info-label">Fakultas / Jurusan</div><div class="info-value"><span id="d-fakultas"></span> / <span id="d-jurusan"></span></div>
                                    <div class="info-label">Unit Penempatan</div><div class="info-value text-primary fw-bold"><span id="d-company"></span> - <span id="d-lokasi"></span></div>
                                    <div class="info-label">Periode Magang</div><div id="d-periode" class="info-value text-danger"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-2 px-2 fw-bold text-secondary" style="font-size:12px;"><i class="fas fa-file-alt me-2"></i>BERKAS DIGITAL</div>
                                <a id="link-cv" href="#" target="_blank" class="doc-link"><span><i class="fas fa-file-pdf text-danger me-2"></i> CV Mahasiswa</span> <i class="fas fa-external-link-alt fa-xs"></i></a>
                                <a id="link-surat" href="#" target="_blank" class="doc-link"><span><i class="fas fa-file-contract text-primary me-2"></i> Surat Pengantar</span> <i class="fas fa-external-link-alt fa-xs"></i></a>
                                <a id="link-proposal" href="#" target="_blank" class="doc-link"><span><i class="fas fa-file-lines text-warning me-2"></i> Proposal Magang</span> <i class="fas fa-external-link-alt fa-xs"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        

