@using System.Text.Json
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Konfigurasi Email SINTA";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root { 
        --p-blue: #00549B; --p-red: #EC1C24; --p-green: #10b981; --p-bg: #F8FAFC;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body { background-color: var(--p-bg); font-family: 'Plus Jakarta Sans', sans-serif; color: #334155; }
    .dashboard-wrapper { padding: 1.2rem 1.8rem; margin-top: -20px; }
    .title-bold { font-weight: 800; color: var(--p-blue); letter-spacing: -0.8px; font-size: 1.5rem; }

    .editor-card { 
        background: #fff; border-radius: 16px; border: 1px solid #e2e8f0; 
        overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
        margin-bottom: 2rem;
    }
    .card-header-premium {
        padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between;
        background: #fff; border-bottom: 1px solid #f1f5f9;
    }
    
    .textarea-editor { 
        width: 100%; min-height: 250px; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 1.2rem; font-size: 0.95rem; line-height: 1.7; color: #475569;
        background: #f8fafc; resize: vertical; transition: var(--transition);
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .textarea-editor.editing { background: #fff; border-color: var(--p-blue); color: #1e293b; }
    .textarea-editor:disabled { cursor: not-allowed; opacity: 0.8; }

    .btn-action {
        padding: 8px 20px; border-radius: 8px; font-weight: 700; font-size: 0.8rem;
        display: flex; align-items: center; gap: 8px; transition: var(--transition); border: none;
    }
    .btn-edit { background: #f1f5f9; color: #64748b; }
    .btn-edit:hover { background: #e2e8f0; color: #1e293b; }
    .btn-save-blue { background: var(--p-blue); color: white; display: none; }
    .btn-save-red { background: var(--p-red); color: white; display: none; }
    .btn-save-revisi { background: #6366f1; color: white; display: none; }
    .var-pill { background: #f1f5f9; color: #64748b; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 700; }
    
    /* Tambahan agar judul benar-benar bold */
    .fw-800 { font-weight: 800 !important; }
</style>

<div class="dashboard-wrapper">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h3 class="title-bold mb-0">Format Konfirmasi Email</h3>
            <p class="text-muted small mb-0">Portal Kendali <span class="fw-bold text-danger">Internship Pertamina</span></p>
        </div>
        </div>

    <div class="editor-card">
        <div class="card-header-premium">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-800 text-uppercase small letter-spacing-1" style="color: var(--p-green);">Email Penerimaan (Diterima)</span>
            </div>
            <div class="d-flex gap-2">
                <button id="btnEditDiterima" class="btn-action btn-edit" onclick="enableEdit('Diterima')">
                    <i class="fas fa-edit"></i> Edit Format
                </button>
                <button id="btnSaveDiterima" class="btn-action btn-save-blue" onclick="saveTemplate('Diterima')">
                    <i class="fas fa-save"></i> Simpan Perubahan
                </button>
            </div>
        </div>
        <div class="p-4">
            <textarea id="textDiterima" class="textarea-editor" disabled>@ViewBag.DiterimaRaw</textarea>
            <textarea id="htmlDiterima" style="display:none;">@ViewBag.DiterimaHtml</textarea>
        </div>
    </div>

    <div class="editor-card">
        <div class="card-header-premium">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-800 text-uppercase small letter-spacing-1" style="color: var(--p-red);">Email Penolakan (Ditolak)</span>
            </div>
            <div class="d-flex gap-2">
                <button id="btnEditDitolak" class="btn-action btn-edit" onclick="enableEdit('Ditolak')">
                    <i class="fas fa-edit"></i> Edit Format
                </button>
                <button id="btnSaveDitolak" class="btn-action btn-save-red" onclick="saveTemplate('Ditolak')">
                    <i class="fas fa-save"></i> Simpan Perubahan
                </button>
            </div>
        </div>
        <div class="p-4">
            <textarea id="textDitolak" class="textarea-editor" disabled>@ViewBag.DitolakRaw</textarea>
            <textarea id="htmlDitolak" style="display:none;">@ViewBag.DitolakHtml</textarea>
        </div>
    </div>

    <!-- Email Revisi (Tambahan Baru) -->
    <div class="editor-card">
        <div class="card-header-premium">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-800 text-uppercase small letter-spacing-1" style="color: #6366f1;">Email Permintaan Revisi</span>
            </div>
            <div class="d-flex gap-2">
                <button id="btnEditRevisi" class="btn-action btn-edit" onclick="enableEdit('Revisi')">
                    <i class="fas fa-edit"></i> Edit Format
                </button>
                <button id="btnSaveRevisi" class="btn-action btn-save-blue" style="background: #6366f1;" onclick="saveTemplate('Revisi')">
                    <i class="fas fa-save"></i> Simpan Perubahan
                </button>
            </div>
        </div>
        <div class="p-4">
            <textarea id="textRevisi" class="textarea-editor" disabled>@ViewBag.RevisiRaw</textarea>
            <textarea id="htmlRevisi" style="display:none;">@ViewBag.RevisiHtml</textarea>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function enableEdit(type) {
        $(`#text${type}`).prop('disabled', false).addClass('editing').focus();
        $(`#btnEdit${type}`).hide();
        $(`#btnSave${type}`).fadeIn();
        
        Swal.fire({
            icon: 'info',
            title: 'Mode Edit Aktif',
            text: 'Silakan ubah teks pesan. Gunakan {Nama}, {Unit}, dll sebagai variabel.',
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000
        });
    }

    function saveTemplate(type) {
        const textContent = $(`#text${type}`).val();
        const btn = $(`#btnSave${type}`);
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Memproses...');

        $.post('/Admin/EmailTemplate/SaveTemplate', { type: type, content: textContent }, function (res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: 'Berhasil Diperbarui', showConfirmButton: false, timer: 1500 });
                $(`#text${type}`).prop('disabled', true).removeClass('editing');
                $(`#btnSave${type}`).hide();
                $(`#btnEdit${type}`).fadeIn();
            } else {
                Swal.fire('Gagal', res.message, 'error');
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Simpan Perubahan');
            }
        });
    }

    $('textarea[id^="text"]').on('input', function() {
        const type = this.id.replace('text', '');
        $(`#html${type}`).val($(this).val());
    });
</script>