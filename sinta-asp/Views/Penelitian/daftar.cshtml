    // --- [MODIFIKASI] UPDATE DROPDOWN LOKASI ---
    // Sekarang menerima parameter kedua optional: preSelectedLoc
    function updateLokasiDropdown(selectedRegion, preSelectedLoc = null) {
        const lokasiSelect = document.getElementById('lokasiSelect');
        if (!lokasiSelect) return; 

        lokasiSelect.innerHTML = '<option value="">Pilih Lokasi...</option>'; // Reset

        if (dataLokasi[selectedRegion]) {
            dataLokasi[selectedRegion].forEach(function(loc) {
                var option = document.createElement("option");
                option.text = loc;
                option.value = loc;
                
                // [LOGIKA BARU] Cek apakah ini lokasi VIP? Jika ya, pilih dia.
                if (preSelectedLoc && loc === preSelectedLoc) {
                    option.selected = true;
                }
                
                lokasiSelect.add(option);
            });
            lokasiSelect.disabled = false;
        } else {
            lokasiSelect.innerHTML = '<option value="">Lokasi tidak tersedia di region ini</option>';
        }
    }

    // --- NAVIGASI & VALIDASI (TETAP SAMA) ---
    function nextStep(currentTabId, nextTabId) {
        if (validatePane(currentTabId)) { triggerTab(nextTabId); } 
        else { document.getElementById(currentTabId).classList.add('error'); }
    }
    function prevStep(prevTabId) { triggerTab(prevTabId); }
    function triggerTab(tabId) {
        var triggerEl = document.querySelector('#' + tabId)
        if(typeof bootstrap !== 'undefined'){ var tab = bootstrap.Tab.getOrCreateInstance(triggerEl); tab.show(); } 
        else { triggerEl.click(); }
        window.scrollTo(0, 0);
    }
    function validatePane(tabBtnId) {
        const paneId = tabBtnId.replace('tab', 'step'); const pane = document.getElementById(paneId);
        const inputs = pane.querySelectorAll('input[required], select[required]');
        let isPaneValid = true;
        inputs.forEach(input => {
            input.setCustomValidity(""); input.classList.remove('is-invalid'); 
            if (input.name === "NoHp") {
                const indoRegex = /^08[0-9]{8,13}$/;
                if (input.value && !indoRegex.test(input.value)) { input.classList.add('is-invalid'); isPaneValid = false; }
            }
            if (input.name === "TglSelesai") {
                const tglMulai = pane.querySelector('input[name="TglMulai"]').value;
                const feedbackDiv = input.parentElement.querySelector('.invalid-feedback');
                if (tglMulai && input.value) {
                    if (new Date(tglMulai) >= new Date(input.value)) {
                        if(feedbackDiv) feedbackDiv.textContent = "Tanggal Selesai harus lebih besar dari Mulai!";
                        input.setCustomValidity("Invalid Range"); input.classList.add('is-invalid'); isPaneValid = false;
                    } else { if(feedbackDiv) feedbackDiv.textContent = "Wajib diisi."; }
                }
            }
            if (!input.checkValidity()) { input.classList.add('is-invalid'); isPaneValid = false; }
        });
        updateTabVisual(tabBtnId, isPaneValid);
        if (!isPaneValid) { const firstError = pane.querySelector('.is-invalid, :invalid'); if(firstError) firstError.focus(); }
        return isPaneValid;
    }
    function updateTabVisual(tabId, isValid) {
        const tabBtn = document.getElementById(tabId); const marker = tabBtn.querySelector('.step-marker');
        tabBtn.classList.remove('done', 'error');
        if (isValid) { tabBtn.classList.add('done'); marker.innerHTML = '<i class="bi bi-check-lg"></i>'; } 
        else { tabBtn.classList.add('error'); marker.innerHTML = '<i class="bi bi-exclamation-lg"></i>'; }
    }

    // --- MAIN SCRIPT ---
    document.addEventListener("DOMContentLoaded", function() {
        const allTabs = document.querySelectorAll('button[data-bs-toggle="pill"]');
        allTabs.forEach(tab => { tab.addEventListener('hide.bs.tab', function (e) { validatePane(e.target.id); }); });
        const btnSubmit = document.getElementById('btnSubmit');
        if(btnSubmit){ btnSubmit.addEventListener('click', function(e) { if(!validatePane('tab-4')) e.preventDefault(); }); }

        const companySelect = document.getElementById('companySelect'); 
        const regionSelect = document.getElementById('regionSelect');   
        const regionInputLocked = document.getElementById('regionInputLocked');
        const lokasiSelect = document.getElementById('lokasiSelect');
        
        // [BARU] Ambil data lokasi VIP dari hidden input
        const vipLokasiData = document.getElementById('vipLokasiData');

        // 1. CEK UNTUK VIP: Apakah Region sudah terkunci?
        if (regionInputLocked && regionInputLocked.value) {
            // [LOGIKA BARU] Panggil updateLokasiDropdown dengan parameter kedua (Lokasi VIP)
            var preSelected = vipLokasiData ? vipLokasiData.value : null;
            updateLokasiDropdown(regionInputLocked.value, preSelected);
        }

        // 2. CEK UNTUK NON-VIP: Kalau Company berubah -> Update list Region (TETAP SAMA)
        if (companySelect && regionSelect) {
            companySelect.addEventListener('change', function() {
                var perusahaan = this.value;
                regionSelect.innerHTML = '<option value="">Pilih Region...</option>';
                if(lokasiSelect) lokasiSelect.innerHTML = '<option value="">Pilih Region Dahulu...</option>';

                if (perusahaan === "PT Pertamina Patra Niaga (C&T)") {
                    var opsi = ["Regional Jatimbalinus", "Regional Jawa Bagian Tengah", "Regional Jawa Bagian Barat", "Regional Kalimantan", "Regional Maluku Papua", "Regional Sumbagut"];
                    opsi.forEach(function(item) {
                        var option = document.createElement("option"); option.text = item; option.value = item; regionSelect.add(option);
                    });
                } else if (perusahaan === "PT Kilang Pertamina Internasional (KPI)") {
                    var option = document.createElement("option"); option.text = "Refinery Unit VI Balongan"; option.value = "Refinery Unit VI Balongan"; regionSelect.add(option);
                } else {
                    regionSelect.innerHTML = '<option value="">Pilih Company Dahulu...</option>';
                }
            });
        }

        // 3. CEK UNTUK NON-VIP: Kalau Region berubah -> Update list Lokasi (TETAP SAMA)
        if (regionSelect) {
            regionSelect.addEventListener('change', function() {
                updateLokasiDropdown(this.value);
            });
        }
    });

    
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // --- 1. FUNGSI PREVIEW FOTO (Supaya gambar muncul saat dipilih) ---
        function tampilkanPreview(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    // Ganti gambar placeholder dengan foto yg dipilih
                    document.getElementById('previewFoto').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);

                // Hapus pesan error jika user sudah pilih foto
                document.getElementById('pesanErrorFoto').style.display = 'none';
                input.classList.remove('is-invalid');
            }
        }

        // --- 2. FUNGSI CEK VALIDASI STEP 1 (Supaya gak bisa lanjut kalau kosong) ---
        function cekStep1() {
            var aman = true; // Anggap dulu semua aman
            
            // A. CEK FOTO (Manual karena hidden)
            var inputFoto = document.getElementById('inputFoto');
            var pesanErrorFoto = document.getElementById('pesanErrorFoto');
            
            if (inputFoto.files.length === 0) {
                pesanErrorFoto.innerText = "Wajib upload foto 3x4!";
                pesanErrorFoto.style.display = "block";
                aman = false;
            } else {
                pesanErrorFoto.style.display = 'none';
            }

            // B. CEK INPUTAN LAIN (Nama, Email, dll)
            // Cari semua input/select yang 'required' di Step 1
            var inputStep1 = document.querySelectorAll('#step-1 input[required], #step-1 select[required]');

            inputStep1.forEach(function(input) {
                if (!input.value) {
                    // Kalau KOSONG: Tambahkan class 'is-invalid' (Biar jadi merah)
                    input.classList.add('is-invalid');
                    aman = false; 
                } else {
                    // Kalau ADA ISI: Hapus merahnya
                    input.classList.remove('is-invalid');
                }
            });

            // C. KEPUTUSAN FINAL
            if (aman) {
                // Semua aman? Pindah ke Tab 2
                nextStep('tab-1', 'tab-2');
            } else {
                // Ada yang error? Scroll ke atas
                document.getElementById('step-1').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    </script>
}