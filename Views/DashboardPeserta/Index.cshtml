                                        <span id="d-fakultas"></span> / <span id="d-jurusan"></span>
                                    </div>
                                    <div class="info-label">Unit Penempatan</div>
                                    <div class="info-value text-primary fw-bold">
                                        <span id="d-company"></span> - <span id="d-lokasi"></span>
                                    </div>
                                    <div class="info-label">Periode Magang</div>
                                    <div id="d-periode" class="info-value text-danger"></div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-2 px-2 fw-bold text-secondary" style="font-size:12px;">
                                    <i class="fas fa-file-alt me-2"></i>BERKAS DIGITAL
                                </div>
                                <a id="link-cv" href="#" target="_blank" class="doc-link">
                                    <span><i class="fas fa-file-pdf text-danger me-2"></i> CV Mahasiswa</span>
                                    <i class="fas fa-external-link-alt fa-xs"></i>
                                </a>
                                <a id="link-surat" href="#" target="_blank" class="doc-link">
