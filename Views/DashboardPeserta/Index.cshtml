                                    <!-- Proposal -->
                                    <div id="rowRevisiProposal" class="revisi-field-row">
                                        <div class="revisi-field-label">
                                            <i class="fas fa-file-signature"></i> Proposal Magang
                                            <span id="badgeProposal" class="badge-terkunci">TERKUNCI</span>
                                        </div>
