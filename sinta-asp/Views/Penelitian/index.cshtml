@model List<sinta_asp.Controllers.LowonganKerja>
@{
    ViewData["Title"] = "Dashboard Penelitian";
    
    // Ambil data filter
    var selectedCompany = ViewData["SelectedCompany"] as string;
    var selectedSearch = ViewData["SelectedSearch"] as string;
    var selectedRegion = ViewData["SelectedRegion"] as string;

    // AMBIL POSISI SCROLL DARI URL
    var lastScroll = Context.Request.Query["lastScroll"].ToString();
}

<style>
    /* MATIKAN SCROLL OTOMATIS BROWSER */
    html { scroll-behavior: auto !important; }
    
    /* GLOBAL STYLE */
    .penelitian-wrapper * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
    .penelitian-wrapper { background-color: #fff; color: #333; min-height: 100vh; }

    /* HERO HEADER */
    .hero-section {
        background: 
            linear-gradient(to left, rgba(220, 30, 30, 0.7) 0%, transparent 60%),
            linear-gradient(rgba(40, 0, 0, 0.85), rgba(20, 0, 0, 0.95)),
            url('/img/pekerja.jpg'); 
        
        background-size: cover; 
        background-position: center; 
        background-blend-mode: soft-light, normal, normal;

        /* Layout */
        padding: 60px 5%; color: white; 
        height: 350px;
        display: flex; 
        align-items: center; 
        margin-bottom: 40px;
        width: 100vw;           
        position: relative;     
        left: 50%;              
        right: 50%;
        margin-left: -50vw; margin-right: -50vw;    
    }
    .hero-content h1 { font-size: 2.5rem; font-weight: 700; line-height: 1.2; margin-bottom: 15px; }
    
    /* LAYOUT UTAMA */
    .main-container { max-width: 1200px; margin: 0 auto; padding: 0 20px 80px 20px; }
    .job-board-layout { display: grid; grid-template-columns: 280px 1fr; gap: 50px; }

    /* COMPONENTS */
    .intro-header { display: flex; justify-content: space-between; margin-bottom: 30px; padding-bottom: 30px; border-bottom: 1px solid #eee; }
    .btn-apply {
        background-color: #00a048; color: white; padding: 10px 25px;
        border-radius: 50px; text-decoration: none; font-weight: 600;
        display: inline-block;
    }
    .filters label { font-size: 0.85rem; color: #888; font-weight: 600; margin-bottom: 8px; display: block; }
    
    /* FORM STYLING */
    .form-control-custom {
        width: 100%; padding: 12px 15px; font-size: 0.95rem;
        border: 1px solid #e0e0e0; border-radius: 8px; outline: none; background: white;
        appearance: none; -webkit-appearance: none; -moz-appearance: none;
    }

    /* DROPDOWN ARROW */
    select.form-control-custom {
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23d81c22' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 15px center; 
        background-size: 16px; padding-right: 40px; 
        cursor: pointer;
    }

    /* SEARCH INPUT (NO ARROW) */
    input.form-control-custom {
        background-image: none !important; 
        padding-right: 40px;
    }

    .search-wrapper { position: relative; }
    .search-wrapper i { 
        position: absolute; right: 15px; top: 50%; 
        transform: translateY(-50%); color: #d81c22; 
        pointer-events: none; 
    }

    /* FLIP CARD */
    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
    .flip-card { background: transparent; width: 100%; height: 320px; perspective: 1000px; cursor: pointer; }
    .flip-card-inner {
        position: relative; width: 100%; height: 100%; text-align: center;
        transition: transform 0.6s; transform-style: preserve-3d;
        border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }
    .flip-card:hover .flip-card-inner { transform: rotateY(180deg); }
    .flip-card-front, .flip-card-back {
        position: absolute; width: 100%; height: 100%;
        -webkit-backface-visibility: hidden; backface-visibility: hidden;
        border-radius: 12px; overflow: hidden;
    }
    .flip-card-front {
        background-size: cover; background-position: center;
        display: flex; flex-direction: column; justify-content: flex-end;
        padding: 20px; text-align: left;
        background-image: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 60%);
    }
    .flip-card-front h3 { color: white; font-size: 1.2rem; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
    .flip-card-back {
        background: white; color: #333; transform: rotateY(180deg);
        display: flex; flex-direction: column; justify-content: center; align-items: center;
        padding: 20px; border: 2px solid #d81c22;
    }
    .flip-card-back h4 { color: #d81c22; margin-bottom: 15px; font-weight: bold; }
    .detail-item { margin: 6px 0; font-size: 0.9rem; color: #555; }
    .btn-card-action { margin-top: 20px; background: #d81c22; color: white; padding: 8px 20px; border-radius: 20px; text-decoration: none; font-size: 0.85rem; }

    @@media (max-width: 768px) { .job-board-layout { grid-template-columns: 1fr; } }
</style>

<script>
    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }
</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="penelitian-wrapper">
    <header class="hero-section">
        <div class="hero-content">
            <h1>Mewujudkan Kedaulatan Energi hingga Pelosok Negeri</h1>
            <p>Bergabunglah bersama kami dalam perjalanan membangun kemandirian energi nasional.</p>
        </div>
    </header>

    <div class="main-container">
        <div class="intro-header">
            <div>
                <h2 style="font-size:1.5rem; margin-bottom:5px;">Help us shape the future of energy.</h2>
                <p style="color:#666;">Explore and apply for opportunities that align with your skills.</p>
            </div>
            <a asp-action="Daftar" class="btn-apply">Apply for Opportunities &rarr;</a>
        </div>

        <div class="job-board-layout">
            
            <aside class="filters">
                <a href="/Penelitian" style="text-decoration:none; color:#666; font-size:0.9rem; margin-bottom:15px; display:inline-block;">Clear filters</a>

                <form method="get" asp-action="Index">
                    <input type="hidden" name="lastScroll" id="lastScrollInput" value="" />

                    <div style="margin-bottom: 25px;">
                        <label>Can't find what you looking for?</label>
                        <div class="search-wrapper">
                            <input type="text" name="search" class="form-control-custom" placeholder="Search..." 
                                   value="@selectedSearch" onkeypress="handleEnter(event, this.form)">
                            <i class="fas fa-search"></i>
                        </div>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <label>Filtered by Company</label>
                        <select name="company" id="companySelect" class="form-control-custom" onchange="submitFilter(this.form)">
                            <option value="">All Companies</option>
                            <option value="PT Kilang Pertamina Internasional" 
                                    selected="@(selectedCompany == "PT Kilang Pertamina Internasional" ? "selected" : null)">
                                PT Kilang Pertamina Internasional (KPI)
                            </option>
                            <option value="PT Pertamina Patra Niaga" 
                                    selected="@(selectedCompany == "PT Pertamina Patra Niaga" ? "selected" : null)">
                                PT Pertamina Patra Niaga (C&T)
                            </option>
                        </select>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <label>By Region</label>
                        <select name="region" id="regionSelect" class="form-control-custom" onchange="submitFilter(this.form)">
                            </select>
                    </div>
                </form>
            </aside>

            <main>
                @if (Model == null || Model.Count == 0)
                {
                    <div style="text-align:center; padding: 60px; color:#999; border: 2px dashed #eee; border-radius:15px; background-color:#fafafa;">
                        <i class="fas fa-search fa-3x" style="margin-bottom:15px; color:#ddd;"></i>
                        <h3>Tidak Ada Lowongan</h3>
                        <p>Coba ubah filter atau kata kunci pencarian Anda.</p>
                    </div>
                }
                else
                {
                    <div class="card-grid">
                        @foreach (var item in Model)
                        {
                            <div class="flip-card">
                                <div class="flip-card-inner">
                                    <div class="flip-card-front" style="background-image: linear-gradient(to top, rgba(0,0,0,0.9) 10%, rgba(0,0,0,0) 60%), url('@item.ImageUrl');">
                                        
                                        @if (item.Company != null && item.Company.Contains("Kilang"))
                                        {
                                            // KPI (BIRU) -> Tampilkan Region
                                            <span style="background: #00529C; color: white; padding: 5px 12px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; width: fit-content; margin-bottom: 10px;">
                                                <i class="fas fa-map-marker-alt"></i> @item.Region
                                            </span>
                                        }
                                        else
                                        {
                                            // PATRA NIAGA (HIJAU) -> Tampilkan Region
                                            <span style="background: #00a048; color: white; padding: 5px 12px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; width: fit-content; margin-bottom: 10px;">
                                                <i class="fas fa-map-marker-alt"></i> @item.Region
                                            </span>
                                        }

                                        <h3 style="margin-top: 0; font-size: 1.3rem;">
                                            @item.Title
                                        </h3>

                                        <small style="color: #ddd; font-weight: 500;">
                                            <i class="fas fa-building me-1"></i> @item.Company
                                        </small>

                                    </div>

                                    <div class="flip-card-back">
                                        <h4 style="color: #d81c22; margin-bottom: 10px;">Tentang Posisi</h4>
                                        
                                        <p style="font-size: 0.9rem; color: #555; padding: 0 15px; line-height: 1.5; margin-bottom: 20px;">
                                            @item.Description
                                        </p>
                                        
                                        <a asp-action="Daftar" 
                                            asp-route-preCompany="@item.Company" 
                                            asp-route-preRegion="@item.Region" 
                                            asp-route-preTargetLokasi="@item.Lokasi"   asp-route-preTargetJurusan="@item.Jurusan" class="btn-card-action">
                                            Daftar Sekarang <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </main>
        </div>
    </div>
</div>

<script>
    // --- LOGIKA UPDATE REGION ---
    
    const dataRegion = {
        "PT Pertamina Patra Niaga": [
            "Regional Jatimbalinus",
            "Regional Jawa Bagian Tengah",
            "Regional Jawa Bagian Barat",
            "Regional Kalimantan",
            "Regional Maluku Papua",
            "Regional Sumbagut"
        ],
        "PT Kilang Pertamina Internasional": [
            "Refinery Unit VI Balongan"
        ]
    };

    function updateRegionOptions() {
        const companySelect = document.getElementById('companySelect');
        const regionSelect = document.getElementById('regionSelect');
        
        const selectedCompany = companySelect.value;
        const currentRegion = '@selectedRegion'; 

        // 1. Kosongkan dulu isinya
        regionSelect.innerHTML = '';

        // 2. LOGIKA BARU: Cek Company-nya apa?
        if (selectedCompany === "PT Kilang Pertamina Internasional") {
            // Kalau KPI -> JANGAN tambah opsi "All Regions". Langsung kosongin aja biar loop di bawah ngisi Balongan.
        } else {
            // Kalau Patra Niaga / Belum Pilih -> Tambah opsi "All Regions"
            const allOption = document.createElement('option');
            allOption.value = "";
            allOption.text = "All Regions";
            regionSelect.appendChild(allOption);
        }

        // 3. Isi Opsi Regionnya
        if (selectedCompany && dataRegion[selectedCompany]) {
            dataRegion[selectedCompany].forEach(reg => {
                const option = document.createElement('option');
                option.value = reg;
                option.text = reg;
                
                if (reg === currentRegion) {
                    option.selected = true;
                }
                
                regionSelect.appendChild(option);
            });
        }
    }

    // Jalankan saat halaman dibuka
    document.addEventListener('DOMContentLoaded', updateRegionOptions);


    // --- FUNGSI BAWAAN ---
    function submitFilter(form) {
        document.getElementById('lastScrollInput').value = window.scrollY;
        form.submit();
    }
    
    function handleEnter(e, form) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('lastScrollInput').value = window.scrollY;
            form.submit();
        }
    }

    (function() {
        var targetScroll = '@lastScroll';
        if (targetScroll && targetScroll !== "") {
            window.scrollTo(0, parseInt(targetScroll));
        }
    })();
</script>