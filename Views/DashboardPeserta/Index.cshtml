                            </div>

                            <!-- Tombol submit -->
                            <div class="text-right mt-3">
                                <button class="btn-submit-revisi" onclick="submitRevisiMahasiswa()">
                                    <i class="fas fa-paper-plane mr-2"></i> Submit Revisi ke Admin
                                </button>
                            </div>
                        </div>

                    </div><!-- /detail-body -->
                </div>
            </div>
        </div>

        <!-- ===== PROFIL PAGE ===== -->
        <div id="page-profil" class="page-section">
    <div class="mb-4">
        <h4 class="font-weight-bold" style="color: var(--p-blue); margin-bottom: 0;">Pengaturan Akun</h4>
        <p class="subtitle-portal" style="font-size: 14px; color: #64748b; margin-top: 4px;">
            Kelola informasi kredensial dan keamanan <span class="text-danger">@namaUser</span>
        </p>
    </div>

    <div class="profile-card">
        <div class="profile-nav-tabs">
            <ul class="nav" id="profileTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="data-tab" data-toggle="tab" href="#tab-data" role="tab">
                        <i class="fa-solid fa-address-card mr-2"></i> Profil Saya
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="security-tab" data-toggle="tab" href="#tab-security" role="tab">
                        <i class="fa-solid fa-shield-halved mr-2"></i> Keamanan
                    </a>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="profileTabContent">
            
            <div class="tab-pane fade show active" id="tab-data" role="tabpanel">
                <div class="p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="position-relative">
                            <div class="dropdown">
                                <input type="file" id="fileInputFoto" hidden accept="image/*" onchange="uploadFoto(this)">

                                <div id="avatarContainer" class="avatar-box mr-3 shadow-sm"
                                    style="cursor: pointer; overflow: hidden; width: 80px; height: 80px; border: 2px solid #e2e8f0;"
                                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">

                                    @if (Model != null && !string.IsNullOrEmpty(Model.FotoProfil))
                                    {
                                        <img src="/uploads/profile/@Model.FotoProfil" id="imgPreview" style="width:100%; height:100%; object-fit:cover;">
                                    }
                                    else
                                    {
                                        <span id="initialsText">
                                            @{
                                                var inisial = "??";
                                                if (!string.IsNullOrEmpty(namaUser))
                                                {
                                                    inisial = namaUser.Length >= 2 ? namaUser.Substring(0, 2).ToUpper() : namaUser.ToUpper();
                                                }
                                            }
                                            @inisial
                                        </span>
                                    }
                                </div>

                                <div class="dropdown-menu shadow border-0" style="border-radius: 12px; font-size: 14px; min-width: 160px; margin-top: 10px;">
                                    <a class="dropdown-item py-2" href="javascript:void(0)" onclick="document.getElementById('fileInputFoto').click()">
                                        <i class="fa-solid fa-file-import mr-2 text-muted"></i> Pilih Foto
                                    </a>
                                    <a class="dropdown-item py-2" href="javascript:void(0)" onclick="viewPhoto()">
                                        <i class="fa-solid fa-image mr-2 text-muted"></i> Lihat Foto
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item py-2 text-danger" href="javascript:void(0)" onclick="deletePhoto()">
                                        <i class="fa-solid fa-trash-can mr-2"></i> Hapus Foto
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <div>
                            <h5 class="font-weight-bold mb-1">@namaUser</h5>
                            <div class="d-flex align-items-center">
                                <span class="badge-role-peserta mr-2">PESERTA MAGANG</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 opacity-50">
                    <div class="row">
