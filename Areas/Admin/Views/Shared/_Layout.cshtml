@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var adminNama = HttpContextAccessor.HttpContext?.Session.GetString("AdminNama") ?? "Admin";
    var adminEmail = HttpContextAccessor.HttpContext?.Session.GetString("AdminEmail");
    var adminRole = HttpContextAccessor.HttpContext?.Session.GetString("AdminRole");
    var adminRegion = HttpContextAccessor.HttpContext?.Session.GetString("AdminRegion");
    var avatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(adminNama)}&background=00549B&color=fff";
    
    // ✅ Cek akses untuk menu Manajemen Admin (SuperAdmin ATAU Jawa Tengah)
    bool canAccessAdminMenu = (adminRole == "SuperAdmin") || (adminRegion == "Regional Jawa Bagian Tengah");
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin SINTA</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">

    <style>
        :root {
            --p-blue: #00549B;
            --p-red: #ec1c24;
            --sidebar-width: 280px;
            --topbar-height: 80px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            overflow-x: hidden;
            transition: var(--transition);
        }

        /* --- Sidebar Styling --- */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #fff;
            border-right: 1px solid #e2e8f0;
            z-index: 1000;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
        }

        .brand-container { margin-bottom: 50px; padding: 0 10px; }
        .brand-logo-pertamina { height: 60px; }

        .nav-link-custom {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #64748b;
            border-radius: 12px;
            text-decoration: none !important;
            margin-bottom: 6px;
            font-weight: 600;
            transition: var(--transition);
        }

        .nav-link-custom:hover {
            background: rgba(0, 84, 155, 0.05);
            color: var(--p-blue);
            transform: translateX(5px);
        }

        .nav-link-custom.active {
            background: var(--p-blue);
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(0, 84, 155, 0.2);
        }

        .nav-link-logout {
            color: var(--p-red) !important;
            border: 1px solid #fee2e2;
            background: #fffafa;
            margin-top: auto;
        }

        /* --- Topbar Styling --- */
        .topbar {
            height: var(--topbar-height);
            position: fixed; top: 0; right: 0; left: var(--sidebar-width);
            background: #fff; border-bottom: 1px solid #e2e8f0;
            z-index: 999; display: flex; align-items: center;
            justify-content: space-between; padding: 0 30px;
            transition: var(--transition);
        }

        .brand-logo-sinta { height: 45px; }
        .main-content { 
            margin-left: var(--sidebar-width); 
            padding-top: var(--topbar-height); 
            transition: var(--transition);
        }

        /* --- Sidebar Toggle Logic --- */
        #sidebarToggle {
            cursor: pointer;
            font-size: 1.2rem;
            transition: var(--transition);
            padding: 10px;
            border-radius: 8px;
        }
        #sidebarToggle:hover { background: #f1f5f9; color: var(--p-blue) !important; }

        body.sidebar-toggled .sidebar {
            left: calc(var(--sidebar-width) * -1);
        }
        body.sidebar-toggled .topbar {
            left: 0;
        }
        body.sidebar-toggled .main-content {
            margin-left: 0;
        }

        /* --- Notifications --- */
        .notif-dropdown-wrapper { position: relative; }
        .notif-btn {
            background: transparent; border: none; font-size: 1.25rem;
            color: #64748b; cursor: pointer; padding: 5px; transition: var(--transition);
            outline: none !important;
        }
        .notif-btn:hover { color: var(--p-blue); }
        .notif-dropdown-wrapper:hover .notif-dropdown {
            display: block; opacity: 1; visibility: visible; transform: translateY(0);
        }
        .notif-dropdown {
            display: block; opacity: 0; visibility: hidden;
            transform: translateY(10px); transition: var(--transition);
            position: absolute; right: 0; top: 100%; width: 330px;
            background: white; border-radius: 16px; border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08); padding: 8px 0; z-index: 1001;
        }
        .notif-header { padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; background: #fff; }
        .notif-badge {
            position: absolute; top: 0px; right: 0px; background: var(--p-red); color: white; 
            font-size: 9px; padding: 1px 5px; border-radius: 50px; border: 1.5px solid #fff;
            min-width: 18px; text-align: center;
        }
        .notif-item { padding: 12px 20px; display: flex; align-items: center; text-decoration: none !important; transition: 0.2s; }
        .notif-item:hover { background-color: #f8fafc; }
        .notif-item.unread { background-color: rgba(0, 84, 155, 0.03); }
        .notif-dot { width: 7px; height: 7px; background: var(--p-blue); border-radius: 50%; margin-left: auto; }
        .notif-icon-circle { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 12px; background: #f1f5f9; font-size: 14px; }
        .sidebar-notif-bubble { background: var(--p-red); color: white; font-size: 10px; padding: 2px 7px; border-radius: 20px; margin-left: auto; font-weight: 700; }

        /* --- Tombol Tandai Dibaca --- */
        .btn-mark-all-read {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: calc(100% - 24px);
            margin: 8px 12px;
            padding: 9px 16px;
            background: var(--p-blue);
            color: #fff !important;
            border: none;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
            font-family: 'Plus Jakarta Sans', sans-serif;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none !important;
        }
        .btn-mark-all-read:hover:not(:disabled) {
            background: #004080;
            box-shadow: 0 4px 12px rgba(0, 84, 155, 0.3);
            transform: translateY(-1px);
        }
        .btn-mark-all-read:disabled {
            background: #cbd5e1;
            color: #94a3b8 !important;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* --- Animations --- */
        .row-highlight-flash { animation: flashHighlight 2s ease-out; }
        @@keyframes flashHighlight {
            0% { background-color: rgba(0, 84, 155, 0.3) !important; }
            100% { background-color: transparent; }
        }
    </style>
</head>
<body>

<nav class="sidebar">
    <div class="brand-container">
        <img src="~/images/logo-pertamina.png" class="brand-logo-pertamina" alt="Pertamina">
    </div>

    <ul style="list-style:none; padding:0; flex-grow:1;">
        <li><a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-house mr-2"></i> Dashboard</a></li>
        <li>
            <a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mahasiswa" ? "active" : "")" asp-area="Admin" asp-controller="Mahasiswa" asp-action="Index">
                <i class="fa-solid fa-users mr-2"></i> Data Mahasiswa
                <span id="sidebarNotifBadge" class="sidebar-notif-bubble d-none">0</span>
            </a>
        </li>
        
        <!-- ✅ DIUBAH: Menu Manajemen Admin bisa diakses SuperAdmin ATAU Admin Jawa Tengah -->
        @if (canAccessAdminMenu)
        {
            <li><a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admins" ? "active" : "")" asp-area="Admin" asp-controller="Admins" asp-action="Index"><i class="fa-solid fa-user-gear mr-2"></i> Manajemen Admin</a></li>
        }

        @if (adminRole != "SuperAdmin")
        {
            <li><a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "EmailTemplate" ? "active" : "")" asp-area="Admin" asp-controller="EmailTemplate" asp-action="Index"><i class="fa-solid fa-envelope-open-text mr-2"></i> Format Konfirmasi</a></li>
        }

        <li><a class="nav-link-custom @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="fa-solid fa-gear mr-2"></i> Pengaturan</a></li>
    </ul>

    <a href="javascript:void(0)" data-toggle="modal" data-target="#modalKonfirmasiKeluar" class="nav-link-custom nav-link-logout">
        <i class="fa-solid fa-right-from-bracket mr-2"></i> Keluar
    </a>
</nav>

<header class="topbar">
    <div class="d-flex align-items-center">
        @* Tombol Toggle Sidebar *@
        <i class="fa-solid fa-bars-staggered mr-3 text-muted d-none d-md-block" id="sidebarToggle"></i>
        <img src="~/images/logo-sinta.png" class="brand-logo-sinta">
    </div>

    <div class="d-flex align-items-center">
        <div class="notif-dropdown-wrapper mr-3">
            <button class="notif-btn" type="button">
                <i class="fa-solid fa-bell"></i>
                <span id="notifBadge" class="notif-badge d-none">0</span>
            </button>
            <div class="notif-dropdown shadow border-0">
                <div class="notif-header">
                    <span class="small font-weight-bold text-dark">Notifikasi Terbaru</span>
                    <span id="notifCountLabel" class="badge badge-pill badge-light text-primary small" style="font-size: 10px;">0</span>
                </div>
                <div id="notificationList" style="max-height: 300px; overflow-y: auto;">
                    <div class="text-center p-3 text-muted small">Memuat...</div>
                </div>
                <button type="button" id="btnMarkAllRead" class="btn-mark-all-read" onclick="markAllAsRead()">
                    <i class="fas fa-check-double"></i> Tandai Sudah Dibaca
                </button>
            </div>
        </div>

        <div class="text-right mr-3" style="border-left:1px solid #e2e8f0; padding-left:15px;">
            <div class="small font-weight-bold" style="line-height: 1;">@adminNama</div>
            <small class="text-success font-weight-bold" style="font-size: 10px;">Online</small>
        </div>

        <div class="dropdown profile-dropdown">
            <a data-toggle="dropdown" style="cursor: pointer;">
                <img src="@avatarUrl" class="rounded-circle shadow-sm border" width="38">
            </a>
            <div class="dropdown-menu dropdown-menu-right shadow border-0" style="border-radius:10px">
                <a class="dropdown-item small" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="fa-solid fa-user-shield mr-2"></i> Profil</a>
                <a href="javascript:void(0)" data-toggle="modal" data-target="#modalKonfirmasiKeluar" class="dropdown-item small text-danger"><i class="fa-solid fa-power-off mr-2"></i> Keluar</a>
            </div>
        </div>
    </div>
</header>

<main class="main-content">
    <div class="container-fluid py-4">
        @RenderBody()
    </div>
</main>

@* Modal Notifications *@
<div class="modal fade" id="modalAllNotifications" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-primary text-white border-0">
                <h6 class="modal-title font-weight-bold mb-0"><i class="fas fa-bell mr-2"></i> Riwayat Notifikasi</h6>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0" id="fullNotifContainer" style="max-height: 60vh; overflow-y: auto;">
                <div class="text-center p-4 text-muted small">Memuat riwayat...</div>
            </div>
        </div>
    </div>
</div>

@* Modal Konfirmasi Keluar *@
<div class="modal fade" id="modalKonfirmasiKeluar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-body text-center p-4">
                <div style="width:60px;height:60px;background:#fff0f0;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                    <i class="fas fa-right-from-bracket" style="font-size:22px;color:var(--p-red);"></i>
                </div>
                <h6 class="font-weight-bold mb-1">Konfirmasi Keluar</h6>
                <p class="text-muted small mb-4">Apakah Anda yakin ingin keluar dari sesi ini?</p>
                <div class="d-flex" style="gap:10px;">
                    <button type="button" class="btn btn-light btn-sm flex-fill" data-dismiss="modal" style="border-radius:8px;">Batal</button>
                    <a asp-area="Admin" asp-controller="Login" asp-action="Logout" class="btn btn-danger btn-sm flex-fill" style="border-radius:8px;">Ya, Keluar</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        // Toggle Sidebar Script
        $("#sidebarToggle").on('click', function() {
            $("body").toggleClass("sidebar-toggled");
        });

        // Notifications
        fetchAdminNotifications();
        setInterval(fetchAdminNotifications, 60000);

        const urlParams = new URLSearchParams(window.location.search);
        const highlightId = urlParams.get('highlightId');
        if (highlightId) {
            setTimeout(() => {
                const targetRow = $(`#row-${highlightId}`);
                if (targetRow.length) {
                    $('html, body').animate({
                        scrollTop: targetRow.offset().top - 150
                    }, 500);
                    targetRow.addClass('row-highlight-flash').removeClass('unread');
                    setTimeout(() => targetRow.removeClass('row-highlight-flash'), 2000);
                }
            }, 500);
        }
    });

    function fetchAdminNotifications() {
        $.ajax({
            url: '/Admin/Dashboard/GetNotifications',
            type: 'GET',
            success: function (data) {
                renderNotifDropdown(data);
            }
        });
    }

    // Render notif di dropdown (ringkas, 7 hari terakhir)
    function renderNotifDropdown(data) {
        const list         = $('#notificationList');
        const badge        = $('#notifBadge');
        const sidebarBadge = $('#sidebarNotifBadge');
        const countLabel   = $('#notifCountLabel');
        const btnMarkAll   = $('#btnMarkAllRead');

        list.empty();

        let unreadCount = data.filter(n => !n.isRead).length;

        if (unreadCount > 0) {
            badge.text(unreadCount).removeClass('d-none');
            sidebarBadge.text(unreadCount).removeClass('d-none');
            countLabel.text(unreadCount + ' Baru');
            btnMarkAll.prop('disabled', false);
        } else {
            badge.addClass('d-none');
            sidebarBadge.addClass('d-none');
            countLabel.text('Semua dibaca');
            // Tombol disabled & abu-abu kalau sudah semua dibaca
            btnMarkAll.prop('disabled', true);
        }

        if (data.length === 0) {
            list.append(`
                <div class="text-center p-4 text-muted">
                    <i class="fa fa-bell-slash mb-2" style="font-size:28px;opacity:0.3;"></i>
                    <div class="small">Tidak ada notifikasi 7 hari terakhir</div>
                </div>
            `);
            return;
        }

        data.forEach(n => {
            let iconBg    = '#f1f5f9';
            let iconColor = 'text-muted';
            let iconClass = 'fa-bell';
            let borderLeft = '#94a3b8';

            if (n.type === 'Baru') {
                iconBg = '#dbeafe'; iconColor = 'text-primary';
                iconClass = 'fa-user-plus'; borderLeft = '#3b82f6';
            } else if (n.type === 'Diterima') {
                iconBg = '#dcfce7'; iconColor = 'text-success';
                iconClass = 'fa-check'; borderLeft = '#22c55e';
            } else if (n.type === 'Ditolak') {
                iconBg = '#fee2e2'; iconColor = 'text-danger';
                iconClass = 'fa-times'; borderLeft = '#ef4444';
            } else if (n.type === 'update') {
                iconBg = '#fef9c3'; iconColor = 'text-warning';
                iconClass = 'fa-rotate'; borderLeft = '#eab308';
            }

            const unreadBg  = n.isRead ? '#fff' : '#f0f7ff';
            const dotHtml   = n.isRead ? '' : `<span style="width:8px;height:8px;background:var(--p-blue);border-radius:50%;flex-shrink:0;margin-left:8px;"></span>`;

            const itemHtml = `
                <a href="javascript:void(0)"
                   onclick="handleNotifClick(${n.id}, ${n.magangId})"
                   class="d-flex align-items-start text-decoration-none"
                   style="padding:12px 16px; border-bottom:1px solid #f1f5f9;
                          background:${unreadBg}; border-left:3px solid ${borderLeft};
                          transition:background 0.2s;">
                    <div style="width:36px;height:36px;border-radius:10px;background:${iconBg};
                                display:flex;align-items:center;justify-content:center;
                                margin-right:12px;flex-shrink:0;">
                        <i class="fas ${iconClass} ${iconColor}" style="font-size:13px;"></i>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="font-size:13px;font-weight:700;color:#1e293b;line-height:1.3;">${n.title}</div>
                        <div style="font-size:12px;color:#64748b;margin-top:2px;line-height:1.4;">${n.message}</div>
                        <div style="font-size:10px;color:#94a3b8;margin-top:4px;">
                            <i class="fas fa-clock mr-1"></i>${n.timeAgo}
                        </div>
                    </div>
                    ${dotHtml}
                </a>
            `;
            list.append(itemHtml);
        });
    }

    // Render notif di modal "Lihat Semua" — ambil semua tanpa filter tanggal
    function fetchAllNotifications() {
        const container = $('#fullNotifContainer');
        container.html('<div class="text-center p-4 text-muted small">Memuat riwayat...</div>');

        $.ajax({
            url: '/Admin/Dashboard/GetNotifications?take=100&allTime=true',
            type: 'GET',
            success: function (data) {
                container.empty();

                if (data.length === 0) {
                    container.html('<div class="p-4 text-center text-muted small">Belum ada riwayat notifikasi.</div>');
                    return;
                }

                // Group by tanggal
                const grouped = {};
                data.forEach(n => {
                    const tgl = n.createdAt.split(',')[0]; // "dd MMM yyyy"
                    if (!grouped[tgl]) grouped[tgl] = [];
                    grouped[tgl].push(n);
                });

                Object.keys(grouped).forEach(tgl => {
                    // Header tanggal
                    container.append(`
                        <div style="padding:8px 16px; background:#f8fafc; 
                                    border-bottom:1px solid #e2e8f0;
                                    font-size:11px; font-weight:800; 
                                    color:#94a3b8; letter-spacing:0.5px;">
                            ${tgl}
                        </div>
                    `);

                    grouped[tgl].forEach(n => {
                        let iconBg = '#f1f5f9', iconColor = 'text-muted', iconClass = 'fa-bell', borderLeft = '#94a3b8';

                        if (n.type === 'Baru')     { iconBg='#dbeafe'; iconColor='text-primary'; iconClass='fa-user-plus'; borderLeft='#3b82f6'; }
                        if (n.type === 'Diterima') { iconBg='#dcfce7'; iconColor='text-success'; iconClass='fa-check';     borderLeft='#22c55e'; }
                        if (n.type === 'Ditolak')  { iconBg='#fee2e2'; iconColor='text-danger';  iconClass='fa-times';     borderLeft='#ef4444'; }
                        if (n.type === 'update')   { iconBg='#fef9c3'; iconColor='text-warning'; iconClass='fa-rotate';   borderLeft='#eab308'; }

                        const unreadBg = n.isRead ? '#fff' : '#f0f7ff';
                        const dotHtml  = n.isRead ? '' : `<span style="width:8px;height:8px;background:var(--p-blue);border-radius:50%;flex-shrink:0;margin-left:8px;"></span>`;
                        const jam      = n.createdAt.split(', ')[1]; // "HH:mm"

                        container.append(`
                            <a href="javascript:void(0)"
                            onclick="handleNotifClick(${n.id}, ${n.magangId})"
                            class="d-flex align-items-start text-decoration-none"
                            style="padding:12px 16px; border-bottom:1px solid #f8fafc;
                                    background:${unreadBg}; border-left:3px solid ${borderLeft};
                                    transition:background 0.2s;">
                                <div style="width:36px;height:36px;border-radius:10px;background:${iconBg};
                                            display:flex;align-items:center;justify-content:center;
                                            margin-right:12px;flex-shrink:0;">
                                    <i class="fas ${iconClass} ${iconColor}" style="font-size:13px;"></i>
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:13px;font-weight:700;color:#1e293b;">${n.title}</div>
                                    <div style="font-size:12px;color:#64748b;margin-top:2px;line-height:1.4;">${n.message}</div>
                                    <div style="font-size:10px;color:#94a3b8;margin-top:4px;">
                                        <i class="fas fa-clock mr-1"></i>${jam}
                                    </div>
                                </div>
                                ${dotHtml}
                            </a>
                        `);
                    });
                });
            }
        });
    }

    function handleNotifClick(notifId, magangId) {
        $.post('/Admin/Dashboard/MarkAsRead', { id: notifId }, function () {
            window.location.href = '/Admin/Mahasiswa?highlightId=' + magangId;
        });
    }

    // Tandai semua notifikasi sudah dibaca
    function markAllAsRead() {
        const btn = $('#btnMarkAllRead');
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Memproses...');

        $.ajax({
            url: '/Admin/Dashboard/MarkAllAsRead',
            type: 'POST',
            success: function (res) {
                if (res.success) {
                    fetchAdminNotifications(); // refresh otomatis, badge hilang, titik biru hilang
                } else {
                    // Kalau gagal, kembalikan tombol
                    btn.prop('disabled', false).html('<i class="fas fa-check-double"></i> Tandai Sudah Dibaca');
                }
            },
            error: function () {
                btn.prop('disabled', false).html('<i class="fas fa-check-double"></i> Tandai Sudah Dibaca');
            }
        });
    }
</script>

@RenderSection("Scripts", required: false)
</body>
</html>